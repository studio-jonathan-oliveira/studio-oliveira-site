---
/*
 * ScrollNav — mini-sommaire éditorial latéral qui évolue au scroll.
 *
 * Refonte 2026-04-29 (Morgan, retours bloc) :
 *  - Plus de mix-blend-difference : le rail/thumb/text utilisent des
 *    couleurs explicites (Klein sur fond cream, cream sur dark-section)
 *    via body.is-dark-section.
 *  - Plus de numéros : ni dans les items, ni dans le compteur. Le compteur
 *    en bas est supprimé entièrement. Seuls les noms de sections restent.
 *  - Marge réservée : à partir de 1400px (où la sidebar s'affiche), le
 *    body reçoit un padding-left global pour empêcher tout visuel de page
 *    d'empiéter sur la zone sidebar.
 *
 * Auto-alimenté via sections[id][data-section-label] au runtime.
 */
---

<nav id="scroll-nav" class="scroll-nav" aria-label="Navigation des sections">
  <span class="scroll-nav-rail" aria-hidden="true"></span>
  <span class="scroll-nav-thumb" id="scroll-nav-thumb" aria-hidden="true"></span>
  <ol id="scroll-nav-list" class="scroll-nav-list" role="list"></ol>
</nav>

<!-- Indicateur mobile discret (≤1023px) -->
<div id="scroll-nav-mobile" class="scroll-nav-mobile" aria-hidden="true">
  <span class="scroll-nav-mobile-label" data-mobile-label>Accueil</span>
  <span class="scroll-nav-mobile-bar">
    <span class="scroll-nav-mobile-fill" data-mobile-fill></span>
  </span>
</div>

<style is:global>
  /* Marge réservée pour la sidebar (Morgan 2026-04-29 retours bloc 2 :
     « la marge doit être presque invisible, juste si des informations
     doivent y passer elles doivent disparaître à travers ; au passage
     la marge doit être légèrement augmentée pour faire la taille du
     texte affiché sur la sidebar »).
     → Variable globale --sidebar-gutter accessible partout. Body padding
        gauche = ce gutter. Sections qui veulent déborder (hero, accents
        plein-écran) appliquent .full-bleed. */
  :root {
    --sidebar-gutter: 0px;
  }
  @media (min-width: 1400px) {
    :root {
      --sidebar-gutter: 11rem;
    }
    body {
      padding-left: var(--sidebar-gutter);
    }
  }
  /* Sections plein-écran qui ignorent le gutter sidebar — fond et contenu
     ramenés en pleine largeur du viewport. */
  .full-bleed {
    margin-left: calc(-1 * var(--sidebar-gutter));
    width: calc(100% + var(--sidebar-gutter));
  }
</style>

<style>
  /* ─────────── Sidebar desktop ───────────
     Refonte 2026-04-29 (Morgan « sidebar invisible blanc sur blanc ») :
     couleurs explicites par sous-élément, pas d'héritage via currentColor.
     Default = Klein (visible sur fond cream du site), cream sur dark-section. */
  .scroll-nav {
    position: fixed;
    left: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.8s var(--ease-out-editorial);
    display: none;
    padding: 0.5rem 0 0.5rem 1rem;
  }
  @media (min-width: 1400px) {
    .scroll-nav {
      display: block;
      left: 1.75rem;
    }
  }
  .scroll-nav.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* Rail vertical continu — Klein/45% sur cream, cream/40% sur dark. */
  .scroll-nav-rail {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1.5px;
    background-color: color-mix(in oklab, var(--color-klein) 45%, transparent);
  }
  :global(body.is-dark-section) .scroll-nav-rail {
    background-color: color-mix(in oklab, var(--color-cream) 40%, transparent);
  }

  /* Thumb — TOUJOURS Klein sur cream, cream sur dark (Morgan 2026-04-29). */
  .scroll-nav-thumb {
    position: absolute;
    left: -1px;
    top: 0;
    width: 3px;
    height: 36px;
    background-color: var(--color-klein);
    transform: translateY(0);
    transition:
      transform 0.8s var(--ease-out-editorial),
      background-color 0.4s ease;
    will-change: transform;
    opacity: 0;
  }
  .scroll-nav.is-visible .scroll-nav-thumb {
    opacity: 1;
  }
  :global(body.is-dark-section) .scroll-nav-thumb {
    background-color: var(--color-cream);
  }

  /* Liste items */
  .scroll-nav-list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .scroll-nav-item {
    display: block;
    position: relative;
  }

  .scroll-nav-link {
    display: flex;
    align-items: baseline;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    padding: 0.2rem 0;
  }

  /* Titre — italique serif, couleur Klein explicite (visible sur cream).
     Sur dark-section : cream. Opacité par défaut élevée pour rester visible. */
  .scroll-nav-title {
    font-family: var(--font-heading), serif;
    font-size: 14px;
    font-style: italic;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    color: var(--color-klein);
    opacity: 0.7;
    transform: translateX(0);
    transition:
      opacity 0.5s var(--ease-out-editorial),
      font-weight 0.4s ease,
      color 0.4s ease;
    font-variation-settings:
      'opsz' 144,
      'SOFT' 80;
  }
  :global(body.is-dark-section) .scroll-nav-title {
    color: var(--color-cream);
  }
  .scroll-nav-item:hover .scroll-nav-title,
  .scroll-nav-item:focus-within .scroll-nav-title {
    opacity: 1;
  }

  /* État actif : bold + opacité pleine. */
  .scroll-nav-item.is-active .scroll-nav-title {
    opacity: 1;
    font-weight: 700;
  }

  /* Sections passées : opacité intermédiaire. */
  .scroll-nav-item.is-passed .scroll-nav-title {
    opacity: 0.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-nav,
    .scroll-nav-mobile,
    .scroll-nav-thumb,
    .scroll-nav-title {
      transition: none !important;
    }
  }

  /* ─────────── Indicateur mobile (≤1023px) ─────────── */
  .scroll-nav-mobile {
    position: fixed;
    top: 72px;
    left: 0;
    right: 0;
    z-index: 35;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1.25rem;
    background-color: color-mix(in srgb, var(--color-cream) 92%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid color-mix(in srgb, var(--color-klein) 12%, transparent);
    opacity: 0;
    transform: translateY(-100%);
    transition:
      opacity 0.5s var(--ease-out-editorial),
      transform 0.5s var(--ease-out-editorial);
    color: var(--color-ink);
  }
  @media (min-width: 1024px) {
    .scroll-nav-mobile {
      display: none;
    }
  }
  .scroll-nav-mobile.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .scroll-nav-mobile-label {
    font-family: var(--font-heading), serif;
    font-style: italic;
    font-size: 13px;
    line-height: 1;
    color: var(--color-klein);
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .scroll-nav-mobile-bar {
    flex-shrink: 0;
    width: 80px;
    height: 1px;
    background-color: color-mix(in srgb, var(--color-klein) 18%, transparent);
    position: relative;
    overflow: hidden;
  }
  .scroll-nav-mobile-fill {
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    background-color: var(--color-klein);
    width: 0;
    transition: width 0.3s linear;
  }
  :global(body.is-dark-section) .scroll-nav-mobile {
    background-color: color-mix(in srgb, var(--color-klein) 88%, transparent);
    color: var(--color-cream);
    border-bottom-color: color-mix(in srgb, var(--color-cream) 12%, transparent);
  }
  :global(body.is-dark-section) .scroll-nav-mobile-label {
    color: var(--color-cream);
  }
  :global(body.is-dark-section) .scroll-nav-mobile-fill {
    background-color: var(--color-cream);
  }
</style>

<script>
  type NavItemRefs = {
    li: HTMLLIElement;
    link: HTMLAnchorElement;
  };

  function initScrollNav() {
    const nav = document.getElementById('scroll-nav');
    const list = document.getElementById('scroll-nav-list');
    const thumb = document.getElementById('scroll-nav-thumb');
    const mobile = document.getElementById('scroll-nav-mobile');
    const mobileLabel = document.querySelector<HTMLElement>('[data-mobile-label]');
    const mobileFill = document.querySelector<HTMLElement>('[data-mobile-fill]');

    if (!nav || !list) return;
    if (nav.dataset.wired === 'true') return;
    nav.dataset.wired = 'true';

    const sections = Array.from(
      document.querySelectorAll<HTMLElement>('section[id][data-section-label]'),
    );
    if (sections.length === 0) {
      nav.style.display = 'none';
      if (mobile) mobile.style.display = 'none';
      return;
    }

    // Construction items — uniquement le titre, plus de numéro (Morgan 2026-04-29)
    list.innerHTML = '';
    const items: Record<string, NavItemRefs> = {};
    sections.forEach((section) => {
      const id = section.id;
      const label = section.dataset.sectionLabel || id;

      const li = document.createElement('li');
      li.className = 'scroll-nav-item';
      li.dataset.target = id;

      const link = document.createElement('a');
      link.href = `#${id}`;
      link.className = 'scroll-nav-link';
      link.setAttribute('aria-label', `Aller à la section ${label}`);
      link.innerHTML = `<span class="scroll-nav-title">${label}</span>`;
      li.appendChild(link);
      items[id] = { li, link };
      list.appendChild(li);
    });

    // Smooth scroll au clic. Pour le 1er item (hero), force scroll-to-top
    // robuste (sticky hero rend scrollIntoView insuffisant).
    Object.entries(items).forEach(([id, { link }], i) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const lenis = window.__lenis;
        if (i === 0) {
          if (lenis && typeof lenis.scrollTo === 'function') {
            lenis.scrollTo(0, { duration: 1.2, immediate: false, force: true });
          } else {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
          window.setTimeout(() => {
            if (window.scrollY > 8) {
              window.scrollTo(0, 0);
              document.documentElement.scrollTop = 0;
              document.body.scrollTop = 0;
            }
          }, 1500);
          history.replaceState(null, '', window.location.pathname);
          return;
        }
        const target = document.getElementById(id);
        if (!target) return;
        if (lenis && typeof lenis.scrollTo === 'function') {
          lenis.scrollTo(target, { duration: 1.2 });
        } else {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        history.replaceState(null, '', `#${id}`);
      });
    });

    // Visibilité : apparait après 40% du 1er viewport
    const onScroll = () => {
      const show = window.scrollY > window.innerHeight * 0.4;
      nav.classList.toggle('is-visible', show);
      if (mobile) mobile.classList.toggle('is-visible', show);

      if (mobileFill) {
        const total = document.documentElement.scrollHeight - window.innerHeight;
        const pct = total > 0 ? Math.min(100, (window.scrollY / total) * 100) : 0;
        mobileFill.style.width = `${pct}%`;
      }
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Positionne le thumb sur l'item actif
    const positionThumb = (activeIndex: number) => {
      if (!thumb) return;
      const targetLi = list.children[activeIndex] as HTMLElement | undefined;
      if (!targetLi) return;
      const thumbHeight = targetLi.offsetHeight;
      thumb.style.height = `${thumbHeight}px`;
      thumb.style.transform = `translateY(${targetLi.offsetTop}px)`;
    };

    let activeId: string | null = null;
    const setActive = (id: string) => {
      if (activeId === id) return;
      activeId = id;
      const activeIndex = sections.findIndex((s) => s.id === id);
      if (activeIndex < 0) return;

      Object.entries(items).forEach(([itemId, { li }], i) => {
        li.classList.toggle('is-active', itemId === id);
        li.classList.toggle('is-passed', i < activeIndex);
      });

      positionThumb(activeIndex);

      const section = sections[activeIndex];
      if (!section) return;
      const label = section.dataset.sectionLabel || section.id;
      if (mobileLabel) mobileLabel.textContent = label;
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
        if (visible.length > 0 && visible[0]) {
          setActive((visible[0].target as HTMLElement).id);
        }
      },
      { rootMargin: '-40% 0px -40% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] },
    );
    sections.forEach((s) => observer.observe(s));

    requestAnimationFrame(() => positionThumb(0));
    window.addEventListener('resize', () => {
      const i = sections.findIndex((s) => s.id === activeId);
      if (i >= 0) positionThumb(i);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollNav, { once: true });
  } else {
    initScrollNav();
  }
  document.addEventListener('astro:page-load', initScrollNav);
</script>
