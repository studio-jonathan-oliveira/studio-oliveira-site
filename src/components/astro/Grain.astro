---
/*
 * Grain SVG overlay — texture papier artisanale, inspirée Aesop / Kinfolk.
 * Fixé en viewport, non-interactif, très discret (2-3% d'opacité).
 * Désactivé par défaut en prefers-reduced-motion (purement esthétique, pas critique).
 */
---

<svg
  class="grain-overlay"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
  width="100%"
  height="100%"
>
  <filter id="grain-noise">
    <feTurbulence type="fractalNoise" baseFrequency="1.8" numOctaves="2" stitchTiles="stitch"
    ></feTurbulence>
    <feColorMatrix
      values="0 0 0 0 0.10
              0 0 0 0 0.17
              0 0 0 0 0.12
              0 0 0 0.9 0"
    ></feColorMatrix>
  </filter>
  <rect width="100%" height="100%" filter="url(#grain-noise)"></rect>
</svg>

<style>
  .grain-overlay {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: 0.025;
    z-index: 50;
  }

  @media (prefers-reduced-motion: reduce) {
    .grain-overlay {
      display: none;
    }
  }

  /* Perf 2026-05-17 (Morgan : lag scroll iOS) — le `mix-blend-mode: multiply`
     full-viewport en `position: fixed` force le compositeur à recalculer le
     blend sur tout l'écran à chaque frame de scroll. À 2.5% d'opacité le
     grain est imperceptible sur petit écran (signature esthétique pensée
     pour desktop), on le désactive sur mobile/tablette pour libérer
     entièrement le compositeur. Zéro impact visuel observable. */
  @media (max-width: 1023px) {
    .grain-overlay {
      display: none;
    }
  }
</style>
