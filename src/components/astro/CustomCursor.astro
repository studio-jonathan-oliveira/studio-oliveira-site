---
/**
 * CustomCursor — disque pastille forêt qui suit le curseur, s'étend sur
 * liens/CTA/éléments magnétiques. Masqué sur touch (pointer: coarse) et
 * sur appareils sans fine pointer.
 *
 * Activé uniquement sur pointer: fine pour ne pas empiéter sur le cursor natif mobile.
 */
---

<div id="cursor" class="custom-cursor" aria-hidden="true">
  <div class="cursor-dot" id="cursor-dot"></div>
  <div class="cursor-ring" id="cursor-ring">
    <span class="cursor-label" id="cursor-label"></span>
    <!-- Tooltip flottant haut-droite du ring (refonte 2026-04-30 Jonathan).
         Utilisation : <a data-cursor-tooltip="LIGNE1 / LIGNE2 / LIGNE3"> -
         le séparateur " / " produit des sauts de ligne. Suit le ring (lerp). -->
    <div class="cursor-tooltip" id="cursor-tooltip"></div>
  </div>
</div>

<style>
  .custom-cursor {
    display: none;
  }

  @media (pointer: fine) {
    .custom-cursor {
      position: fixed;
      left: 0;
      top: 0;
      pointer-events: none;
      z-index: 9999;
      display: block;
      /* Refonte 2026-04-29 (Morgan retours bloc 4) : détection live du theme
         sous le pointeur (pas via theme-observer scroll-based, qui est trop
         lent). Le JS toggle .is-on-dark sur le cursor dès que la section
         data-theme="dark" passe sous lui — bascule instantanée latérite↔cream. */
      --cursor-fill: var(--color-laterite);
      --cursor-text: var(--color-cream);
    }
    .custom-cursor.is-on-dark {
      --cursor-fill: var(--color-cream);
      --cursor-text: var(--color-laterite);
    }

    /* Masque le curseur natif uniquement en fine pointer. */
    :global(html),
    :global(body) {
      cursor: none;
    }
    :global(a),
    :global(button),
    :global([role='button']),
    :global(input),
    :global(textarea),
    :global(select),
    :global([data-magnetic]) {
      cursor: none;
    }

    /* Dot central — point de contact précis pour bien viser les liens
       (feedback Morgan 2026-04-24 : « on a du mal à cibler les liens »).
       Plus gros qu'avant (6 → 9px) pour servir de vrai crosshair. */
    .cursor-dot {
      position: absolute;
      top: -4.5px;
      left: -4.5px;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background-color: var(--cursor-fill);
      transition:
        transform 0.18s var(--ease-out-editorial),
        opacity 0.2s ease,
        background-color 0.4s ease;
    }

    /* Ring plus petit (36 → 24px) pour laisser le dot central dominer
       comme point de mire précis. Moins d'obstruction visuelle. */
    .cursor-ring {
      position: absolute;
      top: -12px;
      left: -12px;
      width: 24px;
      height: 24px;
      /* Refonte 2026-04-29 — disque latérite sur cream, cream sur latérite, via
         --cursor-fill piloté par body.is-dark-section. */
      background-color: var(--cursor-fill);
      border-radius: 50%;
      transition:
        width 0.35s var(--ease-out-editorial),
        height 0.35s var(--ease-out-editorial),
        top 0.35s var(--ease-out-editorial),
        left 0.35s var(--ease-out-editorial),
        background-color 0.3s ease,
        opacity 0.2s ease;
    }

    /* État hover : ring se gonfle. Pas de changement de couleur —
       en mix-blend-mode: difference, le ring garde sa magie d'inversion.
       Taille réduite 44 → 32px (Morgan 2026-04-27) : le ring trop large
       en difference effaçait visuellement le texte des liens longs (CTA
       contact). 32px reste visible sans recouvrir un mot entier. */
    .custom-cursor.is-hover .cursor-ring {
      width: 32px;
      height: 32px;
      top: -16px;
      left: -16px;
    }
    .custom-cursor.is-hover .cursor-dot {
      opacity: 0;
    }

    /* Label contextuel centré dans le ring ; devient visible en mode is-labeled.
       Le ring s'agrandit pour accueillir le mot (max ~5 lettres). Typo mono,
       couleur inversée via le mix-blend du parent → lisible sur tout fond.
       Signature designbyad.com.au : « VIEW » / « VOIR » sur vignettes projets. */
    .cursor-label {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-mono), ui-monospace, monospace;
      font-size: 9px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      /* Texte cream sur ring latérite (default) ; sur dark-section : latérite sur cream. */
      color: var(--cursor-text);
      font-weight: 600;
      opacity: 0;
      transition: opacity 0.2s ease;
      pointer-events: none;
    }
    .custom-cursor.is-labeled .cursor-ring {
      width: 96px;
      height: 96px;
      top: -48px;
      left: -48px;
    }
    .custom-cursor.is-labeled .cursor-dot {
      opacity: 0;
    }
    .custom-cursor.is-labeled .cursor-label {
      opacity: 1;
    }

    /* Tooltip flottant — ajouté 2026-04-30 (Jonathan, typologies).
       Positionné au-delà du bord droit du ring (left: 100% + offset) et
       au-dessus (translateY -100% + petite marge) pour ne PAS chevaucher
       la bulle CTA "Choisir/Explorer" affichée dans le ring agrandi.
       Refonte v3 (retours 2026-04-30) : fond ink fixe + texte cream pour
       contraste lisible quel que soit le fond de section.
       Refonte v4 : font 14px + white-space: pre pour que chaque ligne
       tienne sur une seule ligne sans wrap (largeur auto-fit). */
    .cursor-tooltip {
      position: absolute;
      left: 100%;
      top: 0;
      transform: translate(20px, -100%);
      margin-top: -8px;
      padding: 14px 20px;
      background-color: var(--color-ink);
      color: var(--color-cream);
      font-family: var(--font-mono), ui-monospace, monospace;
      font-size: 14px;
      letter-spacing: 0.16em;
      line-height: 1.7;
      text-transform: uppercase;
      white-space: pre;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s var(--ease-out-editorial);
      will-change: transform, opacity;
      z-index: 1;
    }
    .custom-cursor.is-tooltipped .cursor-tooltip {
      opacity: 1;
    }

    /* État pressed */
    .custom-cursor.is-active .cursor-ring {
      width: 24px;
      height: 24px;
      top: -12px;
      left: -12px;
    }

    /* État hidden lors d'un pointerout window */
    .custom-cursor.is-hidden .cursor-dot,
    .custom-cursor.is-hidden .cursor-ring {
      opacity: 0;
    }
  }
</style>

<script>
  function initCursor() {
    // L'observer dark-section est maintenant unique dans src/scripts/theme-observer.ts
    // (importé depuis BaseLayout). Le cursor se contente de lire html[data-theme].

    if (!window.matchMedia('(pointer: fine)').matches) return;

    const cursor = document.getElementById('cursor');
    const dot = document.getElementById('cursor-dot');
    const ring = document.getElementById('cursor-ring');
    if (!cursor || !dot || !ring) return;

    let mouseX = window.innerWidth / 2;
    let mouseY = window.innerHeight / 2;
    let ringX = mouseX;
    let ringY = mouseY;

    // Détection live du theme sous le pointer (Morgan 2026-04-29 : « le
    // cursor devrait basculer au PASSAGE dans une autre couleur, pas quand
    // on a assez scrollé »). On cherche la section[data-theme] sous le
    // pointeur via elementsFromPoint, et on bascule la classe is-on-dark
    // sur le cursor → le CSS choisit alors latérite/cream pile poil.
    let lastTheme: 'light' | 'dark' | null = null;
    const detectThemeUnderPointer = () => {
      // Le cursor est position:fixed z=9999 → il faut le cacher temporairement
      // pour que elementsFromPoint ne le retourne pas en premier.
      const prevPe = cursor.style.pointerEvents;
      cursor.style.pointerEvents = 'none';
      const els = document.elementsFromPoint(mouseX, mouseY);
      cursor.style.pointerEvents = prevPe;
      let theme: 'light' | 'dark' = 'light';
      for (const el of els) {
        if (!(el instanceof HTMLElement)) continue;
        const sec = el.closest('[data-theme]') as HTMLElement | null;
        if (sec) {
          theme = sec.dataset.theme === 'dark' ? 'dark' : 'light';
          break;
        }
      }
      if (theme !== lastTheme) {
        lastTheme = theme;
        cursor.classList.toggle('is-on-dark', theme === 'dark');
      }
    };

    const onMove = (e: PointerEvent) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      dot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0)`;
      cursor.classList.remove('is-hidden');
      detectThemeUnderPointer();
    };

    const loop = () => {
      // Ring trainant (lerp léger pour effet de suivi)
      ringX += (mouseX - ringX) * 0.18;
      ringY += (mouseY - ringY) * 0.18;
      ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0)`;
      requestAnimationFrame(loop);
    };
    loop();

    window.addEventListener('pointermove', onMove);
    window.addEventListener('pointerdown', () => cursor.classList.add('is-active'));
    window.addEventListener('pointerup', () => cursor.classList.remove('is-active'));
    window.addEventListener('pointerout', (e) => {
      if (!e.relatedTarget) cursor.classList.add('is-hidden');
    });

    // Détection hover sur cibles interactives via event delegation.
    // On restreint aux vrais CTA pour ne pas déclencher le hover latérite
    // sur chaque label/input traversé (feedback 2026-04-24 : cursor rouge
    // « quasiment tout le temps »).
    const hoverSelectors = 'a[href], button:not([disabled]), [data-magnetic]';
    // Label contextuel : tout élément [data-cursor-label="VOIR"] affiche ce mot
    // dans le ring agrandi. Fallback : 'LIRE' sur gallery-item, 'VOIR' sur les
    // liens vers /projets /realisations /conceptions, flèche '→' sinon.
    const labelEl = document.getElementById('cursor-label');
    const tooltipEl = document.getElementById('cursor-tooltip');
    document.addEventListener(
      'pointerover',
      (e) => {
        const target = e.target as HTMLElement | null;
        const labeledAncestor = target?.closest?.('[data-cursor-label]') as HTMLElement | null;
        const tooltipAncestor = target?.closest?.('[data-cursor-tooltip]') as HTMLElement | null;
        const interactive = target?.closest?.(hoverSelectors);
        // [data-cursor-skip] : éléments où le ring NE doit PAS s'élargir.
        // Cas typique : CtaLink size="lg" dont le label long est rendu
        // illisible quand le ring 32px en mix-blend difference le recouvre
        // (Morgan 2026-04-27 : « le CTA Démarrer un projet devient tout
        // blanc »). Le cursor reste en mode normal (dot + ring petit).
        const cursorSkip = target?.closest?.('[data-cursor-skip]');
        // Tooltip flottant 3 lignes (refonte 2026-04-30 typologies). Affiché
        // au-dessus du ring sans agrandir ce dernier — coexiste avec is-labeled.
        if (tooltipAncestor && tooltipEl) {
          const raw = tooltipAncestor.dataset.cursorTooltip || '';
          tooltipEl.textContent = raw.split(' / ').join('\n');
          cursor.classList.add('is-tooltipped');
        }
        if (labeledAncestor && labelEl) {
          labelEl.textContent = labeledAncestor.dataset.cursorLabel || '→';
          cursor.classList.add('is-labeled');
          cursor.classList.remove('is-hover');
        } else if (interactive && !cursorSkip) {
          cursor.classList.add('is-hover');
        }
      },
      true,
    );
    document.addEventListener(
      'pointerout',
      (e) => {
        const target = e.target as HTMLElement | null;
        const labeledAncestor = target?.closest?.('[data-cursor-label]');
        const tooltipAncestor = target?.closest?.('[data-cursor-tooltip]');
        const interactive = target?.closest?.(hoverSelectors);
        if (labeledAncestor) cursor.classList.remove('is-labeled');
        if (tooltipAncestor) cursor.classList.remove('is-tooltipped');
        if (interactive) cursor.classList.remove('is-hover');
      },
      true,
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCursor, { once: true });
  } else {
    initCursor();
  }
  document.addEventListener('astro:page-load', initCursor);
</script>
