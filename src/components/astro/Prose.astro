---
/*
 * Prose — wrapper typographique pour contenu rich (Portable Text, MDX).
 *
 * Applique une hiérarchie Hn, espacement, règles de veuves/orphelines.
 * Styles scopés pour ne pas polluer les autres blocs du layout.
 */

interface Props {
  size?: 'default' | 'lg';
  class?: string;
}

const { size = 'default', class: className = '' } = Astro.props;
---

<div class:list={['prose-studio', size === 'lg' && 'prose-studio--lg', className]}>
  <slot />
</div>

<style is:global>
  .prose-studio {
    max-width: 68ch;
    color: color-mix(in oklab, var(--color-cream) 88%, transparent);
    font-size: var(--text-base);
    line-height: 1.7;
  }
  .prose-studio--lg {
    font-size: var(--text-lg);
    line-height: 1.65;
  }

  .prose-studio h2 {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--color-cream);
    margin-top: 3.5rem;
    margin-bottom: 1.5rem;
    text-wrap: balance;
  }

  .prose-studio h3 {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-cream);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    text-wrap: balance;
  }

  .prose-studio h4 {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-cream);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    letter-spacing: 0.01em;
  }

  .prose-studio p {
    margin-bottom: 1.25rem;
    text-wrap: pretty;
  }

  .prose-studio a {
    color: var(--color-cream);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-decoration-color: color-mix(in oklab, var(--color-cream) 40%, transparent);
    transition: text-decoration-color 0.2s var(--ease-out-editorial);
  }
  .prose-studio a:hover {
    text-decoration-color: var(--color-cream);
  }

  .prose-studio ul,
  .prose-studio ol {
    margin: 1.25rem 0;
    padding-left: 1.5rem;
  }
  .prose-studio ul {
    list-style: none;
  }
  .prose-studio ul > li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .prose-studio ul > li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-cream);
  }
  .prose-studio ol {
    list-style: decimal;
  }
  .prose-studio ol > li {
    margin-bottom: 0.5rem;
    padding-left: 0.5rem;
  }

  .prose-studio blockquote {
    margin: 2.5rem 0;
    padding-left: 1.5rem;
    border-left: 2px solid var(--color-cream);
    font-family: var(--font-heading);
    font-style: italic;
    font-size: var(--text-xl);
    color: var(--color-cream);
    line-height: 1.4;
  }

  .prose-studio figure {
    margin: 3rem 0;
  }
  .prose-studio figure img {
    width: 100%;
    height: auto;
    display: block;
  }
  .prose-studio figcaption {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: color-mix(in oklab, var(--color-cream) 60%, transparent);
  }

  .prose-studio hr {
    margin: 3rem auto;
    width: 4rem;
    border: 0;
    border-top: 1px solid color-mix(in oklab, var(--color-cream) 20%, transparent);
  }

  .prose-studio strong {
    font-weight: 600;
    color: var(--color-cream);
  }

  .prose-studio em {
    font-style: italic;
  }

  .prose-studio code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: color-mix(in oklab, var(--color-cream) 10%, transparent);
    padding: 0.1em 0.35em;
    border-radius: 0.25rem;
  }
</style>
