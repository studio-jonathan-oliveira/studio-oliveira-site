---
/*
 * <DemarrerStep> — section "L'APPEL DE …" partagée par les 2 étapes
 * (qualification + validation).
 *
 * Pattern (trame Jonathan 2026-05-22) :
 *   - Fond ink, texte cream
 *   - Photo aside (unique, partagée par les 2 sections) collée bas-gauche,
 *     déborde full-bleed à gauche, format portrait
 *   - Eyebrow "L'APPEL DE" Bold UPPERCASE + titre oversized ("QUALIFICATION"
 *     ou "VALIDATION") ExtraLight UPPERCASE, alignés en haut-gauche du bloc
 *     accordéons (à droite de la photo)
 *   - Liste d'accordéons (FaqAccordion réutilisé : single-open, flèche
 *     Jonathan, wave reveal mot-par-mot)
 *
 * Le titre eyebrow + oversized se cale naturellement au-dessus du 1er
 * accordéon de chaque section (flow flex/grid natif — pas de sticky).
 * Quand QUALIFICATION s'ouvre, VALIDATION descend mécaniquement avec.
 */
import { Image } from 'astro:assets';
import FaqAccordion, { type FaqItem } from '@/components/islands/FaqAccordion';
import asideImg from '@/assets/demarrer-un-projet/02-aside.jpg';

interface Props {
  id: string;
  /** Eyebrow au-dessus du titre — ex: "L'APPEL DE" */
  eyebrow: string;
  /** Titre oversized — ex: "QUALIFICATION" */
  title: string;
  /** Étiquette pour ScrollNav latéral */
  sectionLabel: string;
  /** Items accordéon : question (titre fermé) + answer (contenu ouvert) */
  accordions: ReadonlyArray<FaqItem>;
  /**
   * Masquer la photo aside en mobile (<1024px) pour éviter le doublon
   * visuel quand 2 sections enchaînées partagent la même photo.
   * Sur desktop la photo reste toujours visible (layout latéral).
   * Défaut : false (photo visible mobile + desktop).
   */
  hideAsideMobile?: boolean;
}

const { id, eyebrow, title, sectionLabel, accordions, hideAsideMobile = false } = Astro.props;
---

<section
  id={id}
  data-section-label={sectionLabel}
  data-theme="dark"
  class:list={['dem-step', hideAsideMobile && 'dem-step--hide-aside-mobile']}
  aria-labelledby={`${id}-title`}
>
  <div class="dem-step__inner">
    <aside class="dem-step__aside" aria-hidden="true">
      {
        /* Photo décorative pure (le pattern compositionnel porte le sens) :
          alt vide + aria-hidden sur l'aside parent = pas de pollution AT. */
      }
      <Image
        src={asideImg}
        alt=""
        widths={[640, 960, 1400, 1800]}
        sizes="(min-width: 1024px) 38vw, 100vw"
        quality={88}
        format="webp"
        loading="lazy"
        class="dem-step__aside-img"
      />
    </aside>

    <div class="dem-step__content">
      <header class="dem-step__head">
        <p class="dem-step__eyebrow">{eyebrow}</p>
        <h2 id={`${id}-title`} class="dem-step__title">{title}</h2>
      </header>

      <div class="dem-step__faq">
        <FaqAccordion items={accordions} client:visible />
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* ════════════════════════════════════════════════════════════════════
   * <DemarrerStep> — section accordéons "L'APPEL DE …"
   * is:global pour pouvoir cibler `.faq-acc__*` injecté par l'island
   * FaqAccordion (hors scope local Astro).
   * ═══════════════════════════════════════════════════════════════════ */
  .dem-step {
    background-color: var(--color-black-deep);
    color: var(--color-cream);
    padding: clamp(4rem, 9vw, 7rem) 0 0 0;
    width: 100%;
    overflow: hidden;
  }
  .dem-step__inner {
    display: grid;
    grid-template-columns: 1fr;
    align-items: end;
    gap: 0;
  }
  @media (min-width: 1024px) {
    .dem-step__inner {
      grid-template-columns: minmax(0, 0.42fr) minmax(0, 0.58fr);
      column-gap: clamp(2rem, 4vw, 4rem);
    }
  }

  /* Photo aside — collée bas-gauche, déborde full-bleed gauche.
     Sur desktop : portrait ~80vh max. Sur mobile : pleine largeur en haut. */
  .dem-step__aside {
    width: 100%;
    overflow: hidden;
    line-height: 0;
  }
  @media (max-width: 1023px) {
    .dem-step__aside {
      aspect-ratio: 4 / 3;
      margin-bottom: clamp(2rem, 5vw, 3rem);
    }
    /* Sur mobile : la 2e section (VALIDATION) hide sa photo aside pour
       éviter le doublon visuel — sur desktop l'aside latérale reste OK
       car elle est dans une colonne distincte du flow vertical. */
    .dem-step--hide-aside-mobile .dem-step__aside {
      display: none;
    }
    .dem-step--hide-aside-mobile {
      padding-top: clamp(3rem, 7vw, 5rem);
    }
  }
  @media (min-width: 1024px) {
    .dem-step__aside {
      align-self: end;
      height: clamp(28rem, 56vh, 44rem);
    }
  }
  .dem-step__aside-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Bloc contenu — titre + accordéons.
     Sur desktop : padding right généreux, titre + accordéons alignés à gauche
     du bloc droit (ie. tout contre la photo aside). */
  .dem-step__content {
    padding: 0 clamp(1.5rem, 5vw, 4rem) clamp(4rem, 9vw, 7rem) clamp(1.5rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3.5rem);
  }
  @media (min-width: 1024px) {
    .dem-step__content {
      padding-left: 0;
      padding-bottom: clamp(3rem, 6vw, 5rem);
    }
  }
  .dem-step__head {
    display: flex;
    flex-direction: column;
    gap: clamp(0.4rem, 0.8vw, 0.8rem);
  }
  .dem-step__eyebrow {
    font-family: var(--font-heading), sans-serif;
    font-weight: 700;
    font-size: clamp(1rem, 1.5vw, 1.55rem);
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-cream);
    margin: 0;
  }
  .dem-step__title {
    font-family: var(--font-heading), sans-serif;
    font-weight: 200;
    font-size: clamp(3rem, 8.5vw, 9rem);
    line-height: 0.92;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--color-cream);
    margin: 0;
  }

  .dem-step__faq {
    width: 100%;
  }
</style>
