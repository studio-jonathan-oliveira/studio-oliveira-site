---
/*
 * <DemarrerRedBlock> — bandeau rouge transition + formulaire intégré
 * (trame Jonathan 2026-05-22).
 *
 * Pattern :
 *   - Fond rouge plein continu sur 2 sous-blocs :
 *       1. Bandeau intro : phrase verbatim Jonathan UPPERCASE centrée
 *       2. Formulaire : champs Jonathan + bouton ENVOYER ↗
 *   - PAS de séparation visuelle entre les 2 sous-blocs (même `var(--color-red)`)
 *   - Annotation Jonathan sur la trame "Animation en apparition suivant le
 *     scroll" → bandeau intro reçoit `data-words-fade` (fade séquentiel mot
 *     par mot, pattern motion-enhance existant).
 *   - Curseur bascule automatiquement sur tone "red" via data-theme="red"
 *     (logique CustomCursor déjà branchée).
 */
import DemarrerForm from '@/components/islands/DemarrerForm.tsx';

interface Props {
  /** Phrase d'invite verbatim Jonathan (UPPERCASE) */
  invite: string;
}

const { invite } = Astro.props;
---

<section
  id="formulaire"
  data-section-label="Formulaire"
  data-theme="light"
  class="dem-red"
  aria-labelledby="dem-red-title"
>
  <div class="dem-red__invite">
    <h2 id="dem-red-title" class="dem-red__invite-text">{invite}</h2>
  </div>

  <div class="dem-red__form">
    <DemarrerForm client:visible />
  </div>
</section>

<style>
  .dem-red {
    background-color: var(--color-violet);
    color: var(--color-ink);
    width: 100%;
    padding: clamp(4rem, 8vw, 7rem) clamp(1.5rem, 5vw, 4rem) clamp(5rem, 9vw, 8rem);
    /* Délimitation violet/noir arrondie juste au-dessus du titre (Morgan
       2026-06-08) : on arrondit le HAUT du bloc violet → le noir de la section
       photo apparaît dans les coins. */
    border-top-left-radius: clamp(24px, 4vw, 56px);
    border-top-right-radius: clamp(24px, 4vw, 56px);
  }
  .dem-red__invite {
    width: 100%;
    margin: 0 0 clamp(3rem, 6vw, 5rem);
  }
  /* Titre formulaire — gros, noir, gras, casse normale (trame). */
  .dem-red__invite-text {
    font-family: var(--font-heading), sans-serif;
    font-weight: 800;
    /* Plus grand pour occuper davantage de largeur d'écran (Morgan 2026-06-08). */
    font-size: clamp(2.3rem, 6.2vw, 6.6rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-transform: none;
    color: var(--color-ink);
    text-align: left;
    /* Titre élargi sur toute la page (Morgan 2026-06-05) — plus de max-width. */
    max-width: none;
    margin: 0;
    /* « \n » dans l'invite → 2 lignes, saut APRÈS « : » (Morgan 2026-06-08). */
    white-space: pre-line;
  }
  .dem-red__form {
    width: 100%;
  }
</style>
