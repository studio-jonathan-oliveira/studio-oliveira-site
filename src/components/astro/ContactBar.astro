---
/*
 * ContactBar — barre fixe en bas de viewport, exclusivement mobile.
 *
 * Justification (Morgan 2026-05-20) : ~60 % du trafic estimé est smartphone.
 * Le CTA principal du Header reste "Démarrer un projet" mais on garde les
 * 3 canaux de contact à portée du pouce en permanence (appel direct, mail,
 * formulaire), avec un visuel ramassé qui ne mange pas le contenu.
 *
 * - Masquée ≥ 768px (md:hidden) — desktop a déjà Header + Footer + curseur.
 * - Masquée sur /contact et /demarrer-un-projet (déjà sur formulaire — la
 *   barre dupliquerait l'action et écraserait le submit en bas de page).
 * - z-index 30 (sous Header z-40 et MenuPrimary z-100, jamais conflit).
 * - safe-area-inset-bottom pour notch / home-indicator iOS.
 * - SVG inline plutôt qu'icon-font (1 requête en moins, payload négligeable).
 */

import { siteSettings } from '@/lib/site-settings';

const currentPath = Astro.url.pathname;
const isFormPage =
  currentPath === '/contact' ||
  currentPath === '/contact/' ||
  currentPath === '/demarrer-un-projet' ||
  currentPath === '/demarrer-un-projet/';
---

{
  !isFormPage && (
    <nav class="contact-bar md:hidden" aria-label="Contact rapide" data-contact-bar>
      <a
        href={`tel:${siteSettings.contact.phone}`}
        class="contact-bar__btn"
        aria-label={`Appeler le ${siteSettings.contact.phoneDisplay}`}
        data-cursor-skip
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z" />
        </svg>
        <span>Appeler</span>
      </a>
      <a
        href={`mailto:${siteSettings.contact.email}`}
        class="contact-bar__btn"
        aria-label={`Écrire à ${siteSettings.contact.email}`}
        data-cursor-skip
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="5" width="18" height="14" rx="1" />
          <path d="m3 7 9 6 9-6" />
        </svg>
        <span>Email</span>
      </a>
      <a
        href="/contact"
        class="contact-bar__btn contact-bar__btn--accent"
        aria-label="Ouvrir le formulaire de contact"
        data-cursor-skip
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
        </svg>
        <span>Contact</span>
      </a>
    </nav>
  )
}

<style>
  .contact-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 30;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    background-color: var(--color-black-deep);
    color: var(--color-cream);
    border-top: 1px solid color-mix(in oklab, var(--color-cream) 18%, transparent);
    padding-bottom: env(safe-area-inset-bottom);
    /* Compositing-friendly : la barre reste sur sa propre couche, n'oblige
       pas le navigateur à repeindre le reste du document au scroll. */
    will-change: transform;
    transform: translateZ(0);
  }

  /* Fallback : Tailwind `md:hidden` masque déjà ≥ 768px, on garde une règle
     CSS pure pour éviter tout flash si Tailwind tarde à charger. */
  @media (min-width: 768px) {
    .contact-bar {
      display: none;
    }
  }

  .contact-bar__btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 10px 4px 12px;
    color: inherit;
    text-decoration: none;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 10.5px;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 500;
    min-height: 56px;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.2s ease;
  }
  .contact-bar__btn + .contact-bar__btn {
    border-left: 1px solid color-mix(in oklab, var(--color-cream) 14%, transparent);
  }
  .contact-bar__btn:active {
    background-color: color-mix(in oklab, var(--color-cream) 8%, transparent);
  }
  .contact-bar__btn:focus-visible {
    outline: 2px solid var(--color-cream);
    outline-offset: -3px;
  }
  .contact-bar__btn svg {
    width: 22px;
    height: 22px;
    display: block;
  }

  /* Bouton "Contact" en BEIGE plein (inversion DA finale 2026-06-16 : violet
     éradiqué) → pastille crème, libellé noir, sur la barre sombre. */
  .contact-bar__btn--accent {
    background-color: var(--color-cream);
    color: var(--color-ink);
  }
  .contact-bar__btn--accent:active {
    background-color: color-mix(in oklab, var(--color-cream) 86%, var(--color-ink));
  }
  .contact-bar__btn--accent + .contact-bar__btn,
  .contact-bar__btn + .contact-bar__btn--accent {
    border-left-color: color-mix(in oklab, var(--color-cream) 60%, var(--color-ink));
  }
</style>
