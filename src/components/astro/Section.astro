---
/*
 * Section — V2 avec variants immersifs (refonte systémique 2026-04-23).
 *
 * 5 variants visuels × 4 rythmes d'espacement canoniques.
 * Règle dure : les pages ne doivent PLUS écrire `py-XX md:py-YY` en dur.
 *
 * Variants :
 *   cream        : fond cream, texte ink (default — DA all-cream 2026-04-29)
 *   forest       : ALIAS de cream depuis 2026-04-29 (Morgan : « DA fond crème
 *                  partout »). Conservé pour ne pas avoir à éditer toutes
 *                  les pages, mais visuellement strictement équivalent à cream.
 *   klein        : fond bleu Klein, texte cream, data-theme="dark" auto.
 *                  Réservé aux sections d'accent intentionnelles (Morgan
 *                  choisit où le placer page par page).
 *   cream-accent : cream avec ruban décoratif discret
 *   immersive    : Klein + image de fond optionnelle + voile + data-theme="dark"
 *
 * Espacement (space prop) :
 *   compact      : sections secondaires (manifeste court, transitions)
 *   default      : sections classiques (majorité)
 *   spacious     : sections pilier (process, 3 piliers)
 *   hero         : hero de page pilier (min-height 90svh + padding généreux)
 *
 * Options :
 *   topDivider    : filet fin en haut
 *   size          : relayé à Container enfant (default/wide/narrow)
 *   labelledBy    : id de l'H2 pour aria-labelledby
 *   image         : ImageMetadata en fond (variant immersive seulement)
 *   imageOverlay  : opacité du voile forest sur l'image (défaut 88)
 */

import Container from './Container.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  variant?: 'cream' | 'forest' | 'klein' | 'cream-accent' | 'immersive';
  space?: 'compact' | 'default' | 'spacious' | 'hero';
  /** @deprecated utiliser `space="compact"` */
  tight?: boolean;
  topDivider?: boolean;
  size?: 'default' | 'wide' | 'narrow';
  labelledBy?: string;
  id?: string;
  /** Label pour ScrollNav (auto-alimenté par section[id][data-section-label]). */
  sectionLabel?: string;
  class?: string;
  image?: ImageMetadata;
  imageOverlay?: number;
  /** Si défini, annote la section avec data-theme=dark|light pour le theme observer. */
  theme?: 'dark' | 'light';
}

const {
  variant = 'cream',
  space,
  tight = false,
  topDivider = false,
  size = 'default',
  labelledBy,
  id,
  sectionLabel,
  class: className = '',
  image,
  imageOverlay = 88,
  theme,
} = Astro.props as Props;

// Migration progressive : tight → space="compact"
const effectiveSpace = space ?? (tight ? 'compact' : 'default');

// 2026-04-29 — DA all-cream : forest aliasé sur cream (Morgan : « DA fond
// crème partout »). Klein est le seul vrai accent sombre, à activer
// intentionnellement par variant="klein" sur les sections retenues.
const bgClass = {
  cream: 'bg-[var(--color-cream)] text-[var(--color-ink)]',
  forest: 'bg-[var(--color-cream)] text-[var(--color-ink)]',
  klein: 'bg-[var(--color-klein)] text-[var(--color-cream)]',
  'cream-accent': 'bg-[var(--color-cream)] text-[var(--color-ink)]',
  immersive: 'bg-[var(--color-klein)] text-[var(--color-cream)] relative isolate overflow-hidden',
}[variant];

// Espacement vertical via token canonique — pas de py-XX en dur
const spaceVar = {
  compact: 'var(--section-space-compact)',
  default: 'var(--section-space-default)',
  spacious: 'var(--section-space-spacious)',
  hero: 'var(--section-space-hero)',
}[effectiveSpace];

// Forest aliasé en cream → theme: light. Seuls klein et immersive sont sombres.
const isDark = variant === 'klein' || variant === 'immersive';
const effectiveTheme = theme ?? (isDark ? 'dark' : 'light');

const dividerClass = topDivider ? 'border-t border-current/10' : '';
---

<section
  class:list={[bgClass, dividerClass, className]}
  style={`padding-top: ${spaceVar}; padding-bottom: ${spaceVar};`}
  id={id}
  aria-labelledby={labelledBy}
  data-theme={effectiveTheme}
  data-section-label={sectionLabel}
>
  {
    variant === 'immersive' && image && (
      <div class="absolute inset-0 -z-10">
        <Image
          src={image}
          alt=""
          widths={[960, 1440, 1920, 2560]}
          sizes="100vw"
          quality={75}
          format="webp"
          class="h-full w-full object-cover object-center"
          loading="lazy"
        />
        <div
          class="absolute inset-0"
          style={`background-color: color-mix(in oklab, var(--color-forest) ${imageOverlay}%, transparent);`}
          aria-hidden="true"
        />
      </div>
    )
  }
  <Container size={size}>
    <slot />
  </Container>
</section>
