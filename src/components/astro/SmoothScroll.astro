---
/*
 * Smooth scroll global — Lenis 1.x
 *
 * Durée 1.2s, easing cinématique type springs.estate / felix-nieto.com.
 * Respecte `prefers-reduced-motion` (skip init, natif OS).
 * Compatible View Transitions Astro : re-init après `astro:page-load`.
 * Pas de smooth sur touch mobile (OS natif > smooth forcé, évite la friction).
 */
---

<script>
  import Lenis from 'lenis';

  declare global {
    interface Window {
      __lenis?: Lenis;
    }
  }

  function initLenis() {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;

    // Mobile / touch : pas de Lenis. iOS Safari et Android Chrome ont un
    // momentum scroll natif excellent ; Lenis tournait un rAF en continu pour
    // rien (avec syncTouch:false il n'orchestrait pas le touch, mais la boucle
    // tournait quand même → CPU/batterie + jank cumulé avec les scroll-driven
    // animations). Garde pointer:coarse OU viewport < 1024px pour couvrir
    // iPad portrait et tablette Android. (Morgan 2026-05-17.)
    const isMobile = window.matchMedia('(pointer: coarse), (max-width: 1023px)').matches;
    if (isMobile) return;

    // Si déjà initialisé, on détruit l'ancienne instance (navigation avec View Transitions)
    if (window.__lenis) {
      window.__lenis.destroy();
    }

    // Duration 1.1s — inertie cinématique type GSAP ScrollSmoother
    // (référence designbyad.com.au validée par Jonathan 2026-04-24). Sensation
    // "film" : glide long, easing expo.out. Si trop laggy retomber à 0.9s.
    const lenis = new Lenis({
      duration: 1.1,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      wheelMultiplier: 1,
      touchMultiplier: 1,
      smoothWheel: true,
      syncTouch: false,
    });

    window.__lenis = lenis;

    function raf(time: number) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }
    requestAnimationFrame(raf);

    // Cible les ancres internes : laisser Lenis gérer le scroll vers #id
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (!href || href === '#') return;
        const target = document.querySelector(href);
        if (!target) return;
        e.preventDefault();
        lenis.scrollTo(target as HTMLElement, { offset: -80 });
      });
    });
  }

  initLenis();
  document.addEventListener('astro:page-load', initLenis);
</script>
