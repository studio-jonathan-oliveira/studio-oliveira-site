---
/*
 * Gallery — grille photos éditoriale pour pages typologie / verticale.
 *
 * Layout : bento asymétrique (1 grande + 4 moyennes sur desktop, stack sur mobile).
 * S'adapte automatiquement au nombre d'images (1 à 6+).
 *
 * Usage :
 *   <Gallery images={getTypologieGallery(slug)} label="Parenthèse exotique" />
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  label?: string;
}

const { images, label } = Astro.props as Props;

if (!images || images.length === 0) {
  // Pas de photos mappées → on ne rend rien (placeholder géré au niveau de la page).
}
---

{
  images && images.length > 0 && (
    <div class="gallery" role="list">
      {images.map((img, i) => (
        <figure class={`gallery-item gallery-item-${i % 6}`} role="listitem">
          <Image
            src={img}
            alt={label ? `${label} — visuel ${i + 1}` : `Visuel ${i + 1}`}
            widths={[480, 768, 1200, 1600]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            quality={80}
            format="webp"
            loading={i === 0 ? 'eager' : 'lazy'}
            class="gallery-img"
          />
        </figure>
      ))}
    </div>
  )
}

<style>
  .gallery {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .gallery {
      grid-template-columns: repeat(6, 1fr);
      gap: 1.5rem;
      grid-auto-rows: minmax(240px, auto);
    }
    /* 1ʳᵉ image : plein-cadre sur 4 colonnes, 2 rangées */
    .gallery-item-0 {
      grid-column: span 4;
      grid-row: span 2;
    }
    /* 2ᵉ et 3ᵉ : colonne droite, 1 rangée chacune */
    .gallery-item-1,
    .gallery-item-2 {
      grid-column: span 2;
      grid-row: span 1;
    }
    /* 4ᵉ : moitié gauche */
    .gallery-item-3 {
      grid-column: span 3;
      grid-row: span 1;
    }
    /* 5ᵉ : moitié droite */
    .gallery-item-4 {
      grid-column: span 3;
      grid-row: span 1;
    }
    /* 6ᵉ et + : pleine largeur */
    .gallery-item-5 {
      grid-column: span 6;
      grid-row: span 1;
    }
  }

  .gallery-item {
    margin: 0;
    overflow: hidden;
    border-radius: 2px;
    background-color: color-mix(in srgb, var(--color-forest) 8%, transparent);
  }

  .gallery-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out-editorial);
  }

  .gallery-item:hover .gallery-img {
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-img {
      transition: none;
    }
  }
</style>
