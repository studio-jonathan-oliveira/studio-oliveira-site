---
/*
 * MenuPrimary — navigation primaire fullscreen overlay, déclenchée par le
 * bouton Menu du Header.
 *
 * Refonte 2026-04-30 (demande Jonathan, capture menu-01.png) :
 *  - Suppression de l'aside latéral (NAP / tel / email / Instagram / calendrier).
 *  - Suppression de la numérotation 01-07.
 *  - Sous-liens cachés par défaut, apparaissent au hover du titre + flèche ↗.
 *  - Lien CTA "Démarrer un projet" mis en avant en bas du menu.
 *  - Labels alignés à droite, fond plein latérite, texte cream.
 *
 * Contrôlé par [data-menu-trigger] dans Header.astro via aria-controls.
 */

const sections = [
  {
    href: '/architecture-paysagere',
    label: 'Architecture paysagère',
    sub: [
      { href: '/architecture-paysagere/micro-urbain', label: 'Micro urbain' },
      { href: '/architecture-paysagere/coeur-urbain', label: 'Cœur urbain' },
      { href: '/architecture-paysagere/frange-urbaine', label: 'Frange urbaine' },
      { href: '/architecture-paysagere/domaine-caractere', label: 'Domaine & Caractère' },
      { href: '/architecture-paysagere/architecture-publique', label: 'Architecture publique' },
    ],
  },
  {
    href: '/amenagement-vegetal-interieur',
    label: "Architecture végétale d'intérieur",
    sub: [
      { href: '/amenagement-vegetal-interieur/hotellerie', label: 'Hôtellerie' },
      { href: '/amenagement-vegetal-interieur/restauration', label: 'Restauration' },
      { href: '/amenagement-vegetal-interieur/bureaux', label: 'Bureaux' },
      { href: '/amenagement-vegetal-interieur/commerces', label: 'Commerces' },
    ],
  },
  {
    href: '/lcd-atypiques',
    label: 'LCD atypique',
    sub: [{ href: '/lcd-atypiques', label: 'Logements atypiques courte durée' }],
  },
  {
    href: '/pros',
    label: 'Pros',
    sub: [],
  },
  {
    href: '/projets',
    label: 'Projets',
    sub: [
      { href: '/conceptions', label: 'Études & Conceptions' },
      { href: '/realisations', label: 'Réalisations' },
    ],
  },
  {
    /* Pages locales (refonte 2026-05-11, audit SEO P0) : pilier SEO local
      Brive/Bordeaux/Limoges. Lien depuis le menu primaire pour
      sortir ces pages de l'orphelinat et activer le crawl. */
    href: '/zones',
    label: 'Territoires',
    sub: [
      { href: '/zones/brive-la-gaillarde', label: 'Brive-la-Gaillarde' },
      { href: '/zones/bordeaux', label: 'Bordeaux' },
      { href: '/zones/limoges', label: 'Limoges' },
    ],
  },
];

const cta = {
  href: '/demarrer-un-projet',
  label: 'Démarrer un projet',
};

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || currentPath.startsWith(href + '/');
---

<dialog id="primary-menu" class="primary-menu" aria-label="Menu principal" data-theme="dark">
  <div class="primary-menu__inner" data-lenis-prevent data-theme="dark">
    <!-- En-tête du menu : logo + close -->
    <header class="primary-menu__header">
      <a href="/" class="primary-menu__logo" aria-label="Accueil">
        <img
          src="/brand/wordmark-cream.png?v=3"
          alt="Studio J Oliveira"
          width="1200"
          height="288"
        />
      </a>
      <button type="button" class="primary-menu__close" aria-label="Fermer le menu" data-menu-close>
        <span>Fermer</span>
        <span class="primary-menu__close-x" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>
    </header>

    <!-- Corps : nav primaire alignée droite, sous-liens révélés au hover -->
    <div class="primary-menu__body">
      <nav aria-label="Navigation principale" class="primary-menu__nav">
        <ol>
          {
            sections.map((section) => (
              <li class:list={['primary-menu__item', isActive(section.href) && 'is-active']}>
                <a
                  href={section.href}
                  class="primary-menu__link"
                  data-menu-link
                  aria-current={currentPath === section.href ? 'page' : undefined}
                >
                  <span class="primary-menu__arrow" aria-hidden="true">
                    ↗
                  </span>
                  <span class="primary-menu__label-main">{section.label}</span>
                </a>

                {section.sub.length > 0 && (
                  <ul class="primary-menu__sub">
                    {section.sub.map((s) => (
                      <li>
                        <a
                          href={s.href}
                          data-menu-link
                          aria-current={currentPath === s.href ? 'page' : undefined}
                        >
                          {s.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }

          <li
            class:list={[
              'primary-menu__item primary-menu__item--cta',
              isActive(cta.href) && 'is-active',
            ]}
          >
            <a href={cta.href} class="primary-menu__link" data-menu-link>
              <span class="primary-menu__arrow" aria-hidden="true"> ↗ </span>
              <span class="primary-menu__label-main">{cta.label}</span>
            </a>
          </li>
        </ol>
      </nav>
    </div>
  </div>
</dialog>

<style>
  /* ───────── Dialog natif — plein écran transparent, panneau inner ─────────
     Pattern : le <dialog> couvre tout l'écran mais est transparent ; le
     vrai panneau est l'inner en absolute à droite. Clic dans le vide à
     gauche (sur le dialog lui-même) → close. Clic dans l'inner = OK. */
  .primary-menu {
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: 100vw;
    /* 100dvh pour que mobile barre URL rétractée ne casse pas la hauteur
       (bug audit 2026-04-23 : scroll impossible quand iOS Safari showait son url bar). */
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-forest);
    z-index: 100;
    overflow: hidden;
    justify-content: flex-end;
  }
  /* CRITIQUE : le <dialog> natif est `display: none` tant qu'il n'est pas
     `[open]`. En ayant forcé `display: flex` sans condition, le menu était
     visible en permanence même après .close() (bug 2026-04-23 soir : « menu
     ouvert à l'arrivée »). On passe display: flex SEULEMENT sur [open]. */
  .primary-menu[open] {
    display: flex;
  }
  .primary-menu::backdrop {
    background: color-mix(in oklab, var(--color-forest) 60%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  /* Curseur dans le menu : on garde le custom cursor visible en le
     déplaçant dans le dialog à l'ouverture (voir script plus bas). */
  .primary-menu,
  .primary-menu * {
    cursor: none;
  }
  /* Fallback : si le JS n'a pas déplacé le cursor (reduced motion, etc.),
     on rétablit le système natif dans le menu */
  .primary-menu:not(.has-cursor),
  .primary-menu:not(.has-cursor) * {
    cursor: auto;
  }
  .primary-menu:not(.has-cursor) a,
  .primary-menu:not(.has-cursor) button {
    cursor: pointer;
  }

  /* Animation entrée — curtain top→bottom (spec vidéo designbyad) :
     le fond cream « tombe » depuis le haut pour recouvrir l'écran. */
  .primary-menu[open] {
    animation: primary-menu-enter 0s linear;
  }
  .primary-menu[open] .primary-menu__inner {
    animation: primary-menu-panel 0.75s cubic-bezier(0.7, 0, 0.3, 1);
  }
  .primary-menu[open]::backdrop {
    animation: primary-menu-backdrop 0.4s var(--ease-out-editorial);
  }
  @keyframes primary-menu-enter {
    from {
      visibility: hidden;
    }
    to {
      visibility: visible;
    }
  }
  @keyframes primary-menu-panel {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes primary-menu-backdrop {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Stagger des items nav : chaque item entre par le bas avec fade. */
  .primary-menu[open] .primary-menu__item {
    opacity: 0;
    transform: translateY(60px);
    animation: primary-menu-item 0.9s var(--ease-out-editorial) forwards;
  }
  .primary-menu[open] .primary-menu__item:nth-child(1) {
    animation-delay: 0.25s;
  }
  .primary-menu[open] .primary-menu__item:nth-child(2) {
    animation-delay: 0.32s;
  }
  .primary-menu[open] .primary-menu__item:nth-child(3) {
    animation-delay: 0.39s;
  }
  .primary-menu[open] .primary-menu__item:nth-child(4) {
    animation-delay: 0.46s;
  }
  .primary-menu[open] .primary-menu__item:nth-child(5) {
    animation-delay: 0.53s;
  }
  .primary-menu[open] .primary-menu__item:nth-child(6) {
    animation-delay: 0.62s;
  }
  @keyframes primary-menu-item {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Sortie — Morgan 2026-04-27 : « la même animation à l'envers ».
     Open = clip-path inset(0 0 100% 0) → inset(0 0 0 0) (rideau qui
     descend d'en haut). Close = inset(0 0 0 0) → inset(0 0 100% 0)
     (rideau qui se rétracte vers le haut). Symétrique strict. */
  .primary-menu.is-closing .primary-menu__inner {
    animation: primary-menu-panel-exit 0.65s cubic-bezier(0.7, 0, 0.3, 1) forwards;
  }
  .primary-menu.is-closing::backdrop {
    animation: primary-menu-backdrop-exit 0.5s var(--ease-out-editorial) forwards;
  }
  @keyframes primary-menu-panel-exit {
    from {
      clip-path: inset(0 0 0 0);
    }
    to {
      clip-path: inset(0 0 100% 0);
    }
  }
  @keyframes primary-menu-backdrop-exit {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  /* Refonte 2026-04-28 (Jonathan) : MENU PLEIN partout, fond couleur signature.
     Plus de zone forest séparée pour l'aside — tout est en couleur signature unie,
     texte crème. Épuration : grain texture + radial-gradient retirés.
     2026-04-30 : bascule de bleu Klein vers rouge latérite (demande Jonathan). */
  .primary-menu__inner {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    min-height: 0;
    background: var(--color-laterite);
    color: var(--color-cream);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;
    touch-action: pan-y;
    -webkit-overflow-scrolling: touch;
  }

  /* ───────── En-tête menu ───────── */
  .primary-menu__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 1.5rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-cream) 18%, transparent);
    flex-shrink: 0;
  }
  @media (min-width: 768px) {
    .primary-menu__header {
      padding: 1.75rem 2.5rem;
    }
  }
  @media (min-width: 1024px) {
    .primary-menu__header {
      padding: 2rem 3rem;
    }
  }
  .primary-menu__logo img {
    height: 36px;
    width: auto;
  }
  @media (min-width: 768px) {
    .primary-menu__logo img {
      height: 44px;
    }
  }

  .primary-menu__close {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    background: transparent;
    border: 1px solid color-mix(in oklab, var(--color-cream) 35%, transparent);
    border-radius: 999px;
    padding: 0.5rem 1.15rem;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-cream);
    cursor: pointer;
    transition:
      color 0.3s ease,
      border-color 0.3s ease,
      background-color 0.3s ease;
  }
  .primary-menu__close:hover,
  .primary-menu__close:focus-visible {
    color: var(--color-laterite);
    background-color: var(--color-cream);
    border-color: var(--color-cream);
  }
  .primary-menu__close-x {
    position: relative;
    width: 12px;
    height: 12px;
  }
  .primary-menu__close-x > span {
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1px;
    background: currentColor;
    transform-origin: center;
  }
  .primary-menu__close-x > span:first-child {
    transform: rotate(45deg);
  }
  .primary-menu__close-x > span:last-child {
    transform: rotate(-45deg);
  }

  /* ───────── Body : nav pleine largeur, alignée droite ─────────
     Refonte 2026-04-30 — suppression de l'aside latéral, nav prend tout.
     2026-05-11 : justify-content `safe center` (Morgan : « les titres
     dépassent en haut sur le Fermer »). Avec 6 sections + sous-liens
     toujours visibles + Territoires, le contenu peut être plus grand
     que la zone body et le simple `center` le faisait remonter sous le
     header. `safe center` bascule en flex-start si overflow → plus de
     chevauchement. Fallback flex-start pour anciens browsers. */
  .primary-menu__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    justify-content: flex-start;
    justify-content: safe center;
  }

  .primary-menu__nav {
    padding: 2rem 1.5rem 3rem;
  }
  @media (min-width: 768px) {
    .primary-menu__nav {
      padding: 3rem 2.5rem 4rem;
      text-align: right;
    }
    .primary-menu__nav ol {
      max-width: 100%;
    }
    .primary-menu__link {
      justify-content: flex-end;
    }
  }
  @media (min-width: 1024px) {
    .primary-menu__nav {
      padding: 3rem 5rem 4rem;
    }
  }
  .primary-menu__nav ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .primary-menu__item {
    /* Refonte 2026-04-30 : pas de bordure systématique entre items (capture
       Jonathan menu-01.png) — épuration. */
  }

  .primary-menu__link {
    display: inline-flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.5rem 0;
    text-decoration: none;
    color: inherit;
    transition: color 0.35s ease;
  }
  @media (min-width: 768px) {
    .primary-menu__link {
      gap: 1.4rem;
      padding: 0.6rem 0;
    }
  }

  /* Label principal — Jost MAJ Gras, taille XL.
     Hover dim 2026-05-02 (Morgan : « plus d'animations au survol ») :
     quand on hover un item, les autres se dim à 0.35. Effet focus/blur
     classique designbyad — la nav reste vivante même avec tout visible. */
  .primary-menu__label-main {
    font-family: var(--font-heading), sans-serif;
    font-size: clamp(1.6rem, 4vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    font-weight: 700;
    text-transform: uppercase;
    transition:
      opacity 0.4s var(--ease-out-editorial),
      transform 0.45s var(--ease-out-editorial),
      color 0.4s var(--ease-out-editorial);
  }
  /* Flèche ↗ — toujours visible (capture Morgan). Sur hover de son
     propre lien : translate-X amont + scale léger pour un retour visuel. */
  .primary-menu__arrow {
    display: inline-block;
    font-family: var(--font-heading), sans-serif;
    font-size: clamp(1rem, 2vw, 1.55rem);
    line-height: 1;
    color: var(--color-cream);
    opacity: 0.85;
    transition:
      opacity 0.3s var(--ease-out-editorial),
      transform 0.5s var(--ease-out-editorial);
  }

  /* Hover focus/blur sur la nav — items non-survolés dim, item survolé
     reste à 1 + label glisse de 6px à droite, flèche vers le haut-droit. */
  @media (hover: hover) and (min-width: 768px) {
    .primary-menu__nav ol:hover .primary-menu__item .primary-menu__label-main,
    .primary-menu__nav ol:hover .primary-menu__item .primary-menu__arrow,
    .primary-menu__nav ol:hover .primary-menu__item .primary-menu__sub a {
      opacity: 0.35;
    }
    .primary-menu__nav ol .primary-menu__item:hover .primary-menu__label-main,
    .primary-menu__nav ol .primary-menu__item:hover .primary-menu__arrow,
    .primary-menu__nav ol .primary-menu__item:hover .primary-menu__sub a {
      opacity: 1;
    }
    .primary-menu__nav ol .primary-menu__item:hover .primary-menu__label-main {
      transform: translateX(-10px);
    }
    .primary-menu__nav ol .primary-menu__item:hover .primary-menu__arrow {
      transform: translate(-4px, -4px) scale(1.15);
    }
    /* Sous-sections : underline qui se trace au hover individuel. */
    .primary-menu__nav ol .primary-menu__item:hover .primary-menu__sub a:hover {
      border-bottom-color: var(--color-cream);
    }
  }

  /* CTA "Démarrer un projet" — mis en avant, plus gros, gras. */
  .primary-menu__item--cta {
    margin-top: clamp(1rem, 3vw, 2.5rem);
  }
  .primary-menu__item--cta .primary-menu__label-main {
    font-size: clamp(2rem, 5.5vw, 4.2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .primary-menu__item--cta .primary-menu__arrow {
    font-size: clamp(1.2rem, 2.6vw, 1.9rem);
    opacity: 0.95;
  }

  /* État actif : flèche fixe pleine opacité. */
  .primary-menu__item.is-active .primary-menu__arrow {
    opacity: 1;
  }

  /* Sous-sections — refonte 2026-05-02 (Morgan, capture) :
     toujours visibles, plus de reveal au hover. Alignées droite sous le
     titre principal. UPPERCASE Jost gras (au lieu de mono 11px). */
  .primary-menu__sub {
    list-style: none;
    margin: 0;
    padding: 0.6rem 0 0.4rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
  }
  @media (min-width: 768px) {
    .primary-menu__sub {
      justify-content: flex-end;
      gap: 0.6rem 2rem;
      padding: 0.5rem 0 1.2rem 0;
    }
  }
  .primary-menu__sub a {
    font-family: var(--font-heading), sans-serif;
    font-size: clamp(0.78rem, 0.95vw, 0.95rem);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-cream) 80%, transparent);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition:
      color 0.3s ease,
      border-color 0.3s ease;
  }
  .primary-menu__sub a:hover,
  .primary-menu__sub a:focus-visible {
    color: var(--color-cream);
    border-bottom-color: var(--color-cream);
  }

  @media (prefers-reduced-motion: reduce) {
    .primary-menu[open],
    .primary-menu[open]::backdrop,
    .primary-menu.is-closing,
    .primary-menu__label-main,
    .primary-menu__arrow,
    .primary-menu__sub {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  /*
   * Wire menu — robustesse anti-double-listener (bug 2026-04-23 soir :
   * « menu ouvert à l'arrivée, impossible à fermer, se réouvre »). Cause
   * probable : à chaque astro:page-load, un nouveau listener était attaché
   * au trigger (dataset.wired n'est pas fiable si le DOM est partiellement
   * persisté par ClientRouter). Nouveau pattern : AbortController jetable
   * remplacé à chaque wire → les anciens listeners sont garantis détruits.
   */
  let wireController: AbortController | null = null;

  function wirePrimaryMenu() {
    const dialog = document.getElementById('primary-menu') as HTMLDialogElement | null;
    const trigger = document.querySelector<HTMLButtonElement>('[data-menu-trigger]');
    if (!dialog || !trigger) return;

    // Jette tous les anciens listeners — garantit une seule source de vérité
    wireController?.abort();
    wireController = new AbortController();
    const { signal } = wireController;

    // Reset : si le dialog était open par erreur (état résiduel après HMR
    // ou view transition), on ferme en dur avant de re-wire.
    if (dialog.open) dialog.close();
    dialog.classList.remove('is-closing', 'has-cursor');
    trigger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';

    const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-menu-close]');
    const links = dialog.querySelectorAll<HTMLAnchorElement>('[data-menu-link]');

    const moveCursorInto = (target: ParentNode) => {
      const cursor = document.getElementById('cursor');
      if (cursor) target.appendChild(cursor);
    };

    const open = () => {
      if (dialog.open) return;
      dialog.classList.remove('is-closing');
      dialog.showModal();
      dialog.classList.add('has-cursor');
      moveCursorInto(dialog);
      trigger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      window.__lenis?.stop();
    };

    const close = () => {
      if (!dialog.open) return;
      dialog.classList.add('is-closing');
      moveCursorInto(document.body);
      dialog.classList.remove('has-cursor');
      // Aligné sur la durée de l'animation primary-menu-panel-exit (650ms).
      window.setTimeout(() => {
        dialog.close();
        dialog.classList.remove('is-closing');
        trigger.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        window.__lenis?.start();
      }, 650);
    };

    trigger.addEventListener(
      'click',
      (e) => {
        e.preventDefault();
        if (dialog.open) close();
        else open();
      },
      { signal },
    );
    closeBtn?.addEventListener('click', close, { signal });
    links.forEach((link) =>
      link.addEventListener('click', () => window.setTimeout(close, 100), { signal }),
    );
    dialog.addEventListener(
      'cancel',
      (e) => {
        e.preventDefault();
        close();
      },
      { signal },
    );
    dialog.addEventListener(
      'click',
      (e) => {
        if (e.target === dialog) close();
      },
      { signal },
    );
  }

  wirePrimaryMenu();
  document.addEventListener('astro:page-load', wirePrimaryMenu);
</script>
