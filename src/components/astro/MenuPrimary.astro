---
/*
 * MenuPrimary — navigation primaire fullscreen overlay, déclenchée par le
 * bouton Menu du Header.
 *
 * Refonte 2026-06-05 (trame « modif finales », colonne gauche home — Morgan) :
 *  - Bouton « Fermer » devenu un CTA PLEINE LARGEUR en haut, identique au CTA
 *    « Démarrer un projet » de la topbar. Au survol → fond beige.
 *  - Logo Oliveira beige (wordmark crème) en tête.
 *  - 4 liens principaux : Home / Studio / Projets / Démarrer un projet.
 *  - Un liseret fin sépare ces liens du bloc « Etudes par typologie de jardin ».
 *  - Les 4 typologies sont des pastilles entourées d'un liseret fin.
 *  - Plus aucune flèche (signature retirée sitewide).
 *
 * Contrôlé par [data-menu-trigger] dans Header.astro via aria-controls.
 */

const mainLinks = [
  { href: '/', label: 'Home' },
  { href: '/studio', label: 'Studio' },
  { href: '/projets', label: 'Projets' },
  { href: '/demarrer-un-projet', label: 'Démarrer un projet' },
];

const typologies = [
  { href: '/architecture-paysagere/micro-urbain', label: 'Micro urbain' },
  { href: '/architecture-paysagere/coeur-urbain', label: 'Coeur urbain' },
  { href: '/architecture-paysagere/frange-urbaine', label: 'Frange urbaine' },
  { href: '/architecture-paysagere/domaine-caractere', label: 'Domaine & Caractère' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(href + '/');
---

<dialog id="primary-menu" class="primary-menu" aria-label="Menu principal" data-theme="dark">
  <div class="primary-menu__inner" data-lenis-prevent data-theme="dark">
    {/* CTA Fermer — pleine largeur, miroir du CTA « Démarrer un projet ». */}
    <button
      type="button"
      class="primary-menu__close-cta"
      data-menu-close
      aria-label="Fermer le menu"
    >
      Fermer
    </button>

    {/* Logo Oliveira beige (crème). */}
    <header class="primary-menu__header">
      <a href="/" class="primary-menu__logo" aria-label="Accueil" data-menu-link>
        <img
          src="/brand/wordmark-cream.png?v=3"
          alt="Studio J Oliveira"
          width="1200"
          height="288"
        />
      </a>
    </header>

    {/* Corps : nav primaire alignée droite. */}
    <div class="primary-menu__body">
      <nav aria-label="Navigation principale" class="primary-menu__nav">
        <ol class="primary-menu__nav-list">
          {
            mainLinks.map((link) => (
              <li class:list={['primary-menu__item', isActive(link.href) && 'is-active']}>
                <a
                  href={link.href}
                  class="primary-menu__link"
                  data-menu-link
                  aria-current={currentPath === link.href ? 'page' : undefined}
                >
                  <span class="primary-menu__label-main">{link.label}</span>
                </a>
              </li>
            ))
          }
        </ol>

        {/* Liseret fin séparateur. */}
        <hr class="primary-menu__sep" />

        <section class="primary-menu__typo" aria-labelledby="menu-typo-title">
          <h2 id="menu-typo-title" class="primary-menu__typo-title">
            Etudes par typologie de jardin
          </h2>
          <ul class="primary-menu__typo-list">
            {
              typologies.map((t) => (
                <li>
                  <a
                    href={t.href}
                    class:list={['primary-menu__typo-pill', isActive(t.href) && 'is-active']}
                    data-menu-link
                    aria-current={currentPath === t.href ? 'page' : undefined}
                  >
                    {t.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </nav>
    </div>
  </div>
</dialog>

<style>
  /* ───────── Dialog natif — plein écran transparent, panneau inner ───────── */
  .primary-menu {
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-cream);
    z-index: 100;
    overflow: hidden;
    justify-content: flex-end;
  }
  .primary-menu[open] {
    display: flex;
  }
  .primary-menu::backdrop {
    background: color-mix(in oklab, var(--color-ink) 60%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  /* Liseret périphérique (trame : la top barre apparaît avec un léger liseret
     périphérique à l'ouverture du menu). */
  .primary-menu[open]::after {
    content: '';
    position: fixed;
    inset: clamp(0.6rem, 1.2vw, 1.1rem);
    border: 1px solid color-mix(in oklab, var(--color-cream) 45%, transparent);
    border-radius: clamp(10px, 1.4vw, 18px);
    pointer-events: none;
    z-index: 101;
  }

  /* Curseur custom déplacé dans le dialog à l'ouverture (cf. script). */
  .primary-menu,
  .primary-menu * {
    cursor: none;
  }
  .primary-menu:not(.has-cursor),
  .primary-menu:not(.has-cursor) * {
    cursor: auto;
  }
  .primary-menu:not(.has-cursor) a,
  .primary-menu:not(.has-cursor) button {
    cursor: pointer;
  }

  /* Animation entrée — rideau top→bottom (spec designbyad). */
  .primary-menu[open] {
    animation: primary-menu-enter 0s linear;
  }
  .primary-menu[open] .primary-menu__inner {
    animation: primary-menu-panel 0.75s cubic-bezier(0.7, 0, 0.3, 1);
  }
  .primary-menu[open]::backdrop {
    animation: primary-menu-backdrop 0.4s var(--ease-out-editorial);
  }
  @keyframes primary-menu-enter {
    from {
      visibility: hidden;
    }
    to {
      visibility: visible;
    }
  }
  @keyframes primary-menu-panel {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes primary-menu-backdrop {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Stagger des items nav. */
  .primary-menu[open] .primary-menu__item {
    opacity: 0;
    transform: translateY(60px);
    animation: primary-menu-item 0.9s var(--ease-out-editorial) forwards;
  }
  .primary-menu[open] .primary-menu__item:nth-child(1) {
    animation-delay: 0.25s;
  }
  .primary-menu[open] .primary-menu__item:nth-child(2) {
    animation-delay: 0.32s;
  }
  .primary-menu[open] .primary-menu__item:nth-child(3) {
    animation-delay: 0.39s;
  }
  .primary-menu[open] .primary-menu__item:nth-child(4) {
    animation-delay: 0.46s;
  }
  @keyframes primary-menu-item {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Sortie — rideau qui remonte (symétrique strict de l'entrée). */
  .primary-menu.is-closing .primary-menu__inner {
    animation: primary-menu-panel-exit 0.65s cubic-bezier(0.7, 0, 0.3, 1) forwards;
  }
  .primary-menu.is-closing::backdrop {
    animation: primary-menu-backdrop-exit 0.5s var(--ease-out-editorial) forwards;
  }
  @keyframes primary-menu-panel-exit {
    from {
      clip-path: inset(0 0 0 0);
    }
    to {
      clip-path: inset(0 0 100% 0);
    }
  }
  @keyframes primary-menu-backdrop-exit {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  /* Panneau plein écran — fond noir profond, texte crème. */
  .primary-menu__inner {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    min-height: 0;
    background: var(--color-black-deep);
    color: var(--color-cream);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;
    touch-action: pan-y;
    -webkit-overflow-scrolling: touch;
  }

  /* ───────── CTA « Fermer » — pleine largeur, miroir du CTA Démarrer ─────────
     Repos : transparent, liseré + libellé crème. Survol → fond beige, texte
     ink (Morgan 2026-06-05). Inset latéral aligné sur le liseret périphérique. */
  .primary-menu__close-cta {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    /* Carte pleine largeur, mais libellé « Fermer » aligné à DROITE
       (Morgan 2026-06-05). */
    justify-content: flex-end;
    text-align: right;
    margin: clamp(0.6rem, 1.2vw, 1.1rem) clamp(0.6rem, 1.2vw, 1.1rem) 0;
    padding: clamp(1.3rem, 2.6vw, 2.4rem) clamp(1.6rem, 3vw, 2.8rem);
    /* Pas de bordure au repos : le liseret périphérique du menu fait déjà le
       cadre. Une bordure ici créait un DOUBLE liseret aux coins haut (Morgan
       2026-06-05). Le radius sert au remplissage beige du survol. */
    border: none;
    border-radius: var(--radius-cta);
    background: transparent;
    color: var(--color-cream);
    font-family: var(--font-heading), sans-serif;
    font-weight: 700;
    font-size: clamp(1.1rem, 1.7vw, 1.6rem);
    letter-spacing: 0;
    cursor: pointer;
    transition:
      background-color 0.35s var(--ease-out-editorial),
      color 0.35s var(--ease-out-editorial),
      border-color 0.35s var(--ease-out-editorial);
  }
  @media (hover: hover) {
    .primary-menu__close-cta:hover {
      background-color: var(--color-cream);
      border-color: var(--color-cream);
      color: var(--color-ink);
    }
  }
  .primary-menu__close-cta:focus-visible {
    background-color: var(--color-cream);
    border-color: var(--color-cream);
    color: var(--color-ink);
  }

  /* ───────── En-tête menu : logo beige ───────── */
  .primary-menu__header {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: clamp(1.25rem, 2vw, 2rem) 1.5rem;
    flex-shrink: 0;
  }
  @media (min-width: 768px) {
    .primary-menu__header {
      padding: clamp(1.5rem, 2.2vw, 2.25rem) 2.5rem;
    }
  }
  @media (min-width: 1024px) {
    .primary-menu__header {
      padding: clamp(1.5rem, 2.2vw, 2.25rem) 3rem;
    }
  }
  .primary-menu__logo img {
    height: 36px;
    width: auto;
  }
  @media (min-width: 768px) {
    .primary-menu__logo img {
      height: 44px;
    }
  }

  /* ───────── Body : nav pleine largeur, alignée droite ───────── */
  .primary-menu__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    justify-content: flex-start;
    justify-content: safe center;
  }
  .primary-menu__nav {
    padding: 2rem 1.5rem 3rem;
  }
  @media (min-width: 768px) {
    .primary-menu__nav {
      padding: 3rem 2.5rem 4rem;
      text-align: right;
    }
  }
  @media (min-width: 1024px) {
    .primary-menu__nav {
      padding: 3rem 5rem 4rem;
    }
  }
  .primary-menu__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .primary-menu__link {
    display: inline-flex;
    align-items: baseline;
    padding: 0.5rem 0;
    text-decoration: none;
    color: inherit;
    transition: color 0.35s ease;
  }
  @media (min-width: 768px) {
    .primary-menu__link {
      padding: 0.6rem 0;
    }
  }
  /* Titres : minuscule (1re lettre maj, écrite telle quelle), graisse normale
     au repos → GRAS au survol (Morgan 2026-06-05). */
  .primary-menu__label-main {
    font-family: var(--font-heading), sans-serif;
    font-size: clamp(1.8rem, 4.4vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    font-weight: 400;
    text-transform: none;
    transition:
      opacity 0.4s var(--ease-out-editorial),
      font-weight 0.3s var(--ease-out-editorial),
      transform 0.45s var(--ease-out-editorial);
  }
  /* Focus/blur signature : au survol d'un item, les autres se dim ; l'item
     survolé passe en gras. */
  @media (hover: hover) and (min-width: 768px) {
    .primary-menu__nav-list:hover .primary-menu__item .primary-menu__label-main {
      opacity: 0.35;
    }
    .primary-menu__nav-list .primary-menu__item:hover .primary-menu__label-main {
      opacity: 1;
      font-weight: 700;
      transform: translateX(-10px);
    }
  }
  .primary-menu__item.is-active .primary-menu__label-main {
    font-weight: 700;
  }

  /* Liseret fin séparateur entre liens principaux et bloc typologies. */
  .primary-menu__sep {
    border: 0;
    border-top: 1px solid color-mix(in oklab, var(--color-cream) 22%, transparent);
    margin: clamp(1.5rem, 3vw, 2.5rem) 0;
  }

  /* ───────── Bloc typologies ───────── */
  .primary-menu__typo-title {
    font-family: var(--font-heading), sans-serif;
    font-weight: 200;
    font-size: clamp(1.2rem, 2.2vw, 1.9rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-transform: none;
    margin: 0 0 clamp(1rem, 2vw, 1.5rem);
    color: var(--color-cream);
  }
  .primary-menu__typo-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 0.85rem;
    justify-content: flex-start;
  }
  @media (min-width: 768px) {
    .primary-menu__typo-list {
      justify-content: flex-end;
    }
  }
  /* Pastilles entourées d'un liseret fin (trame). */
  .primary-menu__typo-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.25rem;
    border: 1px solid color-mix(in oklab, var(--color-cream) 40%, transparent);
    border-radius: clamp(12px, 1.4vw, 18px);
    font-family: var(--font-heading), sans-serif;
    font-weight: 700;
    font-size: clamp(1rem, 1.4vw, 1.35rem);
    letter-spacing: -0.005em;
    text-transform: none;
    color: var(--color-cream);
    text-decoration: none;
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease;
  }
  @media (hover: hover) {
    .primary-menu__typo-pill:hover,
    .primary-menu__typo-pill:focus-visible {
      background-color: var(--color-cream);
      border-color: var(--color-cream);
      color: var(--color-ink);
    }
  }
  .primary-menu__typo-pill.is-active {
    background-color: var(--color-cream);
    border-color: var(--color-cream);
    color: var(--color-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .primary-menu[open],
    .primary-menu[open]::backdrop,
    .primary-menu.is-closing,
    .primary-menu__label-main {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  /*
   * Wire menu — AbortController jetable remplacé à chaque wire (anti double
   * listener, bug 2026-04-23). Ouverture/fermeture + déplacement du curseur
   * custom dans le dialog.
   */
  let wireController: AbortController | null = null;

  function wirePrimaryMenu() {
    const dialog = document.getElementById('primary-menu') as HTMLDialogElement | null;
    const trigger = document.querySelector<HTMLButtonElement>('[data-menu-trigger]');
    if (!dialog || !trigger) return;

    wireController?.abort();
    wireController = new AbortController();
    const { signal } = wireController;

    if (dialog.open) dialog.close();
    dialog.classList.remove('is-closing', 'has-cursor');
    trigger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';

    const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-menu-close]');
    const links = dialog.querySelectorAll<HTMLAnchorElement>('[data-menu-link]');

    const moveCursorInto = (target: ParentNode) => {
      const cursor = document.getElementById('cursor');
      if (cursor) target.appendChild(cursor);
    };

    const open = () => {
      if (dialog.open) return;
      dialog.classList.remove('is-closing');
      dialog.showModal();
      dialog.classList.add('has-cursor');
      moveCursorInto(dialog);
      trigger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      window.__lenis?.stop();
    };

    const close = () => {
      if (!dialog.open) return;
      dialog.classList.add('is-closing');
      moveCursorInto(document.body);
      dialog.classList.remove('has-cursor');
      window.setTimeout(() => {
        dialog.close();
        dialog.classList.remove('is-closing');
        trigger.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        window.__lenis?.start();
      }, 650);
    };

    trigger.addEventListener(
      'click',
      (e) => {
        e.preventDefault();
        if (dialog.open) close();
        else open();
      },
      { signal },
    );
    closeBtn?.addEventListener('click', close, { signal });
    links.forEach((link) =>
      link.addEventListener('click', () => window.setTimeout(close, 100), { signal }),
    );
    dialog.addEventListener(
      'cancel',
      (e) => {
        e.preventDefault();
        close();
      },
      { signal },
    );
    dialog.addEventListener(
      'click',
      (e) => {
        if (e.target === dialog) close();
      },
      { signal },
    );
  }

  wirePrimaryMenu();
  document.addEventListener('astro:page-load', wirePrimaryMenu);
</script>
