---
/*
 * HeroSwipe v3 — slide horizontal propre (refonte 2026-05-15 retour Morgan :
 * « pas de flou, swipe gauche→droite comme sur une tablette »).
 *
 * Architecture :
 *  - Track horizontal qui translate à chaque changement d'index.
 *  - 4 slides côte à côte (04-pergola-palmiers retiré). flex 0 0 100% chacun.
 *  - Transition cubic-bezier 950ms, smooth pro.
 *  - Wordmark FIGÉ en overlay absolu (ne défile pas avec les slides).
 *  - 5s par image (durée d'arrêt) — le slide lui-même prend 950ms.
 *  - srcset 1x/2x pour piloter retina.
 *
 * Reste : drag pointer/touch (vrai swipe à la doigt), clavier ←/→, dots.
 */
// Palier 3 CMS (2026-06-29) : le carrousel lit en priorité les images Sanity
// `siteSettings.heroImages` (Jonathan peut en ajouter/réordonner depuis le
// Studio, recadrage piloté par le hotspot). Tant que Sanity n'est pas branché
// OU qu'aucune image n'y est ajoutée, on retombe sur les 8 visuels locaux
// optimisés ci-dessous (rendu strictement identique à avant). Le carrousel est
// désormais agnostique au nombre de slides (CSS piloté par --hero-count) :
// ajouter/retirer une image ne demande plus de toucher au CSS.
import { fetch, urlFor } from '@/lib/sanity';
import { heroImagesQuery } from '@/lib/queries';
import type { SanityImageSource } from '@sanity/image-url';

interface SanityHeroImage {
  asset?: { _ref?: string };
  hotspot?: { x: number; y: number };
  alt?: string;
}

type Slide =
  | { kind: 'local'; name: string; label: string; position: string }
  | { kind: 'sanity'; src1x: string; src2x: string; label: string; position: string };

// 8 photos hero fournies par Jonathan, optimisées → public/hero/0N-image.{webp,jpg}
// @1x/@2x. La 9e image (domaine) a été retirée le 2026-06-16 (pixelisation).
const LOCAL_SLIDES: Slide[] = Array.from({ length: 8 }, (_, i) => {
  const n = String(i + 1).padStart(2, '0');
  return {
    kind: 'local',
    name: `${n}-image`,
    label: `Projet Studio J Oliveira — visuel ${i + 1}`,
    position: '50% 50%',
  };
});

const sanityHero = await fetch<SanityHeroImage[]>(heroImagesQuery, {}, []);

const slides: Slide[] = sanityHero.length
  ? sanityHero
      .filter((img) => img.asset)
      .map((img, i) => ({
        kind: 'sanity' as const,
        src1x: urlFor(img as SanityImageSource)
          .width(1600)
          .quality(70)
          .auto('format')
          .url(),
        src2x: urlFor(img as SanityImageSource)
          .width(3200)
          .quality(62)
          .auto('format')
          .url(),
        label: img.alt ?? `Studio J Oliveira — visuel ${i + 1}`,
        position: img.hotspot
          ? `${Math.round(img.hotspot.x * 100)}% ${Math.round(img.hotspot.y * 100)}%`
          : '50% 50%',
      }))
  : LOCAL_SLIDES;
---

<div class="hero-slide" data-hero-slide>
  <div class="hero-slide__track" data-hero-slide-track style={`--hero-count: ${slides.length}`}>
    {
      slides.map((slide, i) => (
        <div
          class="hero-slide__panel"
          data-hero-slide-panel={i}
          aria-hidden={i === 0 ? 'false' : 'true'}
        >
          {slide.kind === 'sanity' ? (
            <img
              src={slide.src1x}
              srcset={`${slide.src1x} 1x, ${slide.src2x} 2x`}
              alt={slide.label}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              fetchpriority={i === 0 ? 'high' : 'auto'}
              draggable="false"
              style={`object-position: ${slide.position}`}
            />
          ) : (
            <picture>
              <source
                type="image/webp"
                srcset={`/hero/${slide.name}.webp 1x, /hero/${slide.name}@2x.webp 2x`}
              />
              <img
                src={`/hero/${slide.name}.jpg`}
                srcset={`/hero/${slide.name}.jpg 1x, /hero/${slide.name}@2x.jpg 2x`}
                alt={slide.label}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                fetchpriority={i === 0 ? 'high' : 'auto'}
                draggable="false"
                style={`object-position: ${slide.position}`}
              />
            </picture>
          )}
        </div>
      ))
    }
  </div>

  {/* Voile sombre subtil — au-dessus des images, sous le wordmark. */}
  <div class="hero-slide__veil" aria-hidden="true"></div>

  {
    /* Logo "Oliveira" en overlay haut-gauche — v12 2026-05-15 (retour Morgan).
      Le Header global est caché par défaut sur darkHero (auto-hide), donc le
      logo wordmark cream est dupliqué ici pour rester visible par-dessus
      les images. Cliquable vers /. */
  }
  <div class="hero-slide__topbar-mimic" aria-hidden="true">
    <a href="/" class="hero-slide__logo" aria-label="Studio J Oliveira — accueil">
      {
        /* Masque (et non <img>) pour garantir la couleur EXACTE --color-cream :
          le PNG « cream » était rendu blanc pur (retour Morgan 2026-06-08). */
      }
      <span class="hero-slide__logo-mark" aria-hidden="true"></span>
    </a>
  </div>

  {
    /* Wordmark FIGÉ — "STUDIO" / "J. OLIVEIRA" sur 2 lignes, taille réduite
      (retour Morgan : « un peu plus petit »). ExtraLight 200 UPPERCASE rouge. */
  }
  <p class="hero-slide__wordmark" aria-hidden="true">
    <span class="hero-slide__wordmark-line">Studio</span>
    <span class="hero-slide__wordmark-line">J. Oliveira</span>
  </p>

  {/* Dots indicateurs — bas-centre. */}
  <div class="hero-slide__dots" role="tablist" aria-label="Sélecteur de visuel hero">
    {
      slides.map((_, i) => (
        <button
          type="button"
          class="hero-slide__dot"
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-label={`Aller au visuel ${i + 1}`}
          data-hero-slide-dot={i}
        />
      ))
    }
  </div>
</div>

<style>
  .hero-slide {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    touch-action: pan-y;
  }
  /* Track horizontal — N panels juxtaposés, translateX piloté par JS.
     width = N × 100%, flex panel = 100% / N, dérivés de --hero-count (posé en
     inline depuis slides.length). Plus aucune valeur figée à maintenir quand le
     nombre de slides change (fallback 8 si la variable manque). */
  .hero-slide__track {
    display: flex;
    width: calc(var(--hero-count, 8) * 100%);
    height: 100%;
    will-change: transform;
    transition: transform 0.95s cubic-bezier(0.65, 0.05, 0.25, 1);
  }
  .hero-slide.is-dragging .hero-slide__track {
    transition: none;
  }
  .hero-slide__panel {
    flex: 0 0 calc(100% / var(--hero-count, 8));
    position: relative;
    height: 100%;
    overflow: hidden;
  }
  .hero-slide__panel picture,
  .hero-slide__panel img {
    width: 100%;
    height: 100%;
    display: block;
  }
  .hero-slide__panel img {
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  /* Voile vignette top + bottom — dilutions de l'ink via tokens overlay
     (suit tout swap de palette). */
  .hero-slide__veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--color-ink) 45%, transparent) 0%,
      var(--overlay-ink-veil) 12%,
      transparent 28%,
      transparent 55%,
      var(--overlay-ink-soft) 82%,
      var(--overlay-ink-strong) 100%
    );
  }

  /* Logo Oliveira — refonte v15 2026-05-15 : Header bascule en full-width
     (max-w retiré). On reproduit le wrapper .site-header__main mais sans
     contrainte de width → logo collé bord gauche, pile sous le logo Header
     quand la topbar apparaît. */
  .hero-slide__topbar-mimic {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 4;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 1.25rem var(--page-x);
    pointer-events: none;
    box-sizing: border-box;
  }
  @media (min-width: 768px) {
    .hero-slide__topbar-mimic {
      padding: 1.5rem var(--page-x);
    }
  }
  .hero-slide__logo {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    line-height: 0;
    pointer-events: auto;
    filter: drop-shadow(0 1px 6px color-mix(in oklab, var(--color-ink) 45%, transparent));
  }
  /* Wordmark en MASQUE coloré --color-cream (exact). Ratio source 1200×288. */
  .hero-slide__logo-mark {
    display: block;
    height: 36px;
    aspect-ratio: 1200 / 288;
    background-color: var(--color-cream);
    -webkit-mask: url('/brand/wordmark-black.png?v=3') left center / contain no-repeat;
    mask: url('/brand/wordmark-black.png?v=3') left center / contain no-repeat;
  }
  @media (min-width: 768px) {
    .hero-slide__logo-mark {
      height: 40px;
    }
  }
  @media (min-width: 1024px) {
    .hero-slide__logo-mark {
      height: 44px;
    }
  }

  /* Wordmark FIGÉ — réduit (Morgan : « un peu plus petit »). */
  .hero-slide__wordmark {
    position: absolute;
    /* Aligné au bord gauche du logo Oliveira = marge unique --page-x. */
    left: var(--page-x);
    bottom: clamp(4rem, 9vh, 7rem);
    margin: 0;
    pointer-events: none;
    z-index: 3;
    display: flex;
    flex-direction: column;
    /* Wordmark crème sur la photo hero (trame « modif finales »). */
    color: var(--color-cream);
    text-shadow: 0 2px 14px color-mix(in oklab, var(--color-ink) 40%, transparent);
  }
  .hero-slide__wordmark-line {
    font-family: var(--font-heading), sans-serif;
    font-weight: 200;
    /* Plus grand (trame « modif finales » : wordmark quasi pleine largeur) +
       casse douce « Studio / J. Oliveira » (text-transform retiré). */
    font-size: clamp(3.2rem, 12vw, 13rem);
    line-height: 0.9;
    letter-spacing: -0.01em;
    text-transform: none;
    display: block;
  }

  /* Dots — inchangé. */
  .hero-slide__dots {
    position: absolute;
    left: 50%;
    bottom: clamp(1rem, 3vh, 1.75rem);
    transform: translateX(-50%);
    display: flex;
    gap: 0.625rem;
    z-index: 3;
    padding: 0.5rem 0.75rem;
  }
  .hero-slide__dot {
    appearance: none;
    background: transparent;
    width: 8px;
    height: 8px;
    border: 1px solid color-mix(in oklab, var(--color-cream) 70%, transparent);
    border-radius: 50%;
    padding: 0;
    cursor: pointer;
    transition:
      background-color 0.35s var(--ease-out-editorial),
      transform 0.35s var(--ease-out-editorial),
      border-color 0.35s var(--ease-out-editorial);
  }
  .hero-slide__dot[aria-selected='true'] {
    background-color: var(--color-cream);
    border-color: var(--color-cream);
    transform: scale(1.25);
  }
  .hero-slide__dot:hover {
    border-color: var(--color-cream);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide__track {
      transition: none;
    }
  }
</style>

<script>
  /*
   * Wire hero slide horizontal — drag pointer + clavier + dots + auto 5s.
   * Le slide entier translate au changement d'index ; pas de cross-fade.
   */
  function wireHeroSlide() {
    const root = document.querySelector<HTMLElement>('[data-hero-slide]');
    if (!root) return;
    if (root.dataset.slideWired === 'true') return;
    root.dataset.slideWired = 'true';

    const track = root.querySelector<HTMLElement>('[data-hero-slide-track]');
    const panels = root.querySelectorAll<HTMLElement>('[data-hero-slide-panel]');
    const dots = root.querySelectorAll<HTMLButtonElement>('[data-hero-slide-dot]');
    if (!track || panels.length === 0) return;

    const total = panels.length;
    let index = 0;
    let autoTimer: number | null = null;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // v14 2026-05-15 (retour Morgan) : 3.5s par image, slide auto only,
    // pas d'interactivité manuelle.
    const AUTO_INTERVAL = 3500;

    const applyTransform = (extraPx = 0) => {
      const slideWidth = root.clientWidth;
      const x = -index * slideWidth + extraPx;
      track.style.transform = `translate3d(${x}px, 0, 0)`;
    };

    const updateA11y = () => {
      panels.forEach((p, i) => p.setAttribute('aria-hidden', i === index ? 'false' : 'true'));
      dots.forEach((d, i) => d.setAttribute('aria-selected', i === index ? 'true' : 'false'));
    };

    const goto = (next: number) => {
      index = (next + total) % total;
      applyTransform(0);
      updateA11y();
      restartAuto();
    };

    const startAuto = () => {
      if (reducedMotion) return;
      autoTimer = window.setInterval(() => goto(index + 1), AUTO_INTERVAL);
    };
    const stopAuto = () => {
      if (autoTimer !== null) {
        window.clearInterval(autoTimer);
        autoTimer = null;
      }
    };
    const restartAuto = () => {
      stopAuto();
      startAuto();
    };

    // v12 2026-05-15 (retour Morgan) : slideshow auto only, drag/clavier/
    // dots-click retirés. Les dots restent visuels (indicateur de progress).
    void dots;

    window.addEventListener('resize', () => applyTransform(0), { passive: true });

    applyTransform(0);
    updateA11y();
    startAuto();
  }

  wireHeroSlide();
  document.addEventListener('astro:page-load', wireHeroSlide);
</script>
