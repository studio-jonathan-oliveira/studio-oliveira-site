---
/*
 * HeroSwipe v3 — slide horizontal propre (refonte 2026-05-15 retour Morgan :
 * « pas de flou, swipe gauche→droite comme sur une tablette »).
 *
 * Architecture :
 *  - Track horizontal qui translate à chaque changement d'index.
 *  - 4 slides côte à côte (04-pergola-palmiers retiré). flex 0 0 100% chacun.
 *  - Transition cubic-bezier 950ms, smooth pro.
 *  - Wordmark FIGÉ en overlay absolu (ne défile pas avec les slides).
 *  - 5s par image (durée d'arrêt) — le slide lui-même prend 950ms.
 *  - srcset 1x/2x pour piloter retina.
 *
 * Reste : drag pointer/touch (vrai swipe à la doigt), clavier ←/→, dots.
 */
// Refonte v10 2026-05-15 : 01-villa retirée temporairement (retour Morgan).
// Reste 3 slides actifs. Les fichiers restent dans public/hero/ — on les
// ré-activera quand Jonathan validera ou fournira une autre 1re.
const slides = [
  {
    name: '02-cypres',
    label: 'Cyprès et statues méditerranéennes',
    position: '50% 85%',
  },
  {
    name: '03-terrasse-salon',
    label: 'Terrasse et salon outdoor végétalisé',
    position: '50% 85%',
  },
  {
    name: '05-ruelle',
    label: 'Ruelle végétalisée',
    position: '50% 85%',
  },
];
---

<div class="hero-slide" data-hero-slide>
  <div class="hero-slide__track" data-hero-slide-track>
    {
      slides.map((slide, i) => (
        <div
          class="hero-slide__panel"
          data-hero-slide-panel={i}
          aria-hidden={i === 0 ? 'false' : 'true'}
        >
          <picture>
            <source
              type="image/webp"
              srcset={`/hero/${slide.name}.webp 1x, /hero/${slide.name}@2x.webp 2x`}
            />
            <img
              src={`/hero/${slide.name}.jpg`}
              srcset={`/hero/${slide.name}.jpg 1x, /hero/${slide.name}@2x.jpg 2x`}
              alt={slide.label}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              fetchpriority={i === 0 ? 'high' : 'auto'}
              draggable="false"
              style={`object-position: ${slide.position}`}
            />
          </picture>
        </div>
      ))
    }
  </div>

  {/* Voile sombre subtil — au-dessus des images, sous le wordmark. */}
  <div class="hero-slide__veil" aria-hidden="true"></div>

  {
    /* Logo "Oliveira" en overlay haut-gauche — v12 2026-05-15 (retour Morgan).
      Le Header global est caché par défaut sur darkHero (auto-hide), donc le
      logo wordmark cream est dupliqué ici pour rester visible par-dessus
      les images. Cliquable vers /. */
  }
  <div class="hero-slide__topbar-mimic" aria-hidden="true">
    <a href="/" class="hero-slide__logo" aria-label="Studio J Oliveira — accueil">
      <img
        src="/brand/wordmark-cream.png?v=3"
        alt="Studio J Oliveira"
        width="1200"
        height="288"
        loading="eager"
        decoding="async"
      />
    </a>
  </div>

  {
    /* Wordmark FIGÉ — "STUDIO" / "J. OLIVEIRA" sur 2 lignes, taille réduite
      (retour Morgan : « un peu plus petit »). ExtraLight 200 UPPERCASE rouge. */
  }
  <p class="hero-slide__wordmark" aria-hidden="true">
    <span class="hero-slide__wordmark-line">STUDIO</span>
    <span class="hero-slide__wordmark-line">J. OLIVEIRA</span>
  </p>

  {/* Dots indicateurs — bas-centre. */}
  <div class="hero-slide__dots" role="tablist" aria-label="Sélecteur de visuel hero">
    {
      slides.map((_, i) => (
        <button
          type="button"
          class="hero-slide__dot"
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-label={`Aller au visuel ${i + 1}`}
          data-hero-slide-dot={i}
        />
      ))
    }
  </div>
</div>

<style>
  .hero-slide {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    touch-action: pan-y;
  }
  /* Track horizontal — 3 panels juxtaposés, translateX piloté par JS.
     v10 2026-05-15 : width 400→300%, panel 25→33.333% (suite retrait de
     01-villa). */
  .hero-slide__track {
    display: flex;
    width: 300%;
    height: 100%;
    will-change: transform;
    transition: transform 0.95s cubic-bezier(0.65, 0.05, 0.25, 1);
  }
  .hero-slide.is-dragging .hero-slide__track {
    transition: none;
  }
  .hero-slide__panel {
    flex: 0 0 33.3333%;
    position: relative;
    height: 100%;
    overflow: hidden;
  }
  .hero-slide__panel picture,
  .hero-slide__panel img {
    width: 100%;
    height: 100%;
    display: block;
  }
  .hero-slide__panel img {
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  /* Voile vignette top + bottom. */
  .hero-slide__veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.45) 0%,
      rgba(0, 0, 0, 0.15) 12%,
      rgba(0, 0, 0, 0) 28%,
      rgba(0, 0, 0, 0) 55%,
      rgba(0, 0, 0, 0.3) 82%,
      rgba(0, 0, 0, 0.65) 100%
    );
  }

  /* Logo Oliveira — refonte v15 2026-05-15 : Header bascule en full-width
     (max-w retiré). On reproduit le wrapper .site-header__main mais sans
     contrainte de width → logo collé bord gauche, pile sous le logo Header
     quand la topbar apparaît. */
  .hero-slide__topbar-mimic {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 4;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 1.25rem 1.5rem;
    pointer-events: none;
    box-sizing: border-box;
  }
  @media (min-width: 768px) {
    .hero-slide__topbar-mimic {
      padding: 1.5rem 2.5rem;
    }
  }
  .hero-slide__logo {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    line-height: 0;
    pointer-events: auto;
    filter: drop-shadow(0 1px 6px rgba(0, 0, 0, 0.45));
  }
  .hero-slide__logo img {
    display: block;
    height: 36px;
    width: auto;
  }
  @media (min-width: 768px) {
    .hero-slide__logo img {
      height: 40px;
    }
  }
  @media (min-width: 1024px) {
    .hero-slide__logo img {
      height: 44px;
    }
  }

  /* Wordmark FIGÉ — réduit (Morgan : « un peu plus petit »). */
  .hero-slide__wordmark {
    position: absolute;
    left: clamp(1.5rem, 4vw, 4rem);
    bottom: clamp(4rem, 9vh, 7rem);
    margin: 0;
    pointer-events: none;
    z-index: 3;
    display: flex;
    flex-direction: column;
    color: var(--color-red);
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.4);
  }
  .hero-slide__wordmark-line {
    font-family: var(--font-heading), sans-serif;
    font-weight: 200;
    font-size: clamp(2.4rem, 6.8vw, 7.5rem);
    line-height: 0.95;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    display: block;
  }

  /* Dots — inchangé. */
  .hero-slide__dots {
    position: absolute;
    left: 50%;
    bottom: clamp(1rem, 3vh, 1.75rem);
    transform: translateX(-50%);
    display: flex;
    gap: 0.625rem;
    z-index: 3;
    padding: 0.5rem 0.75rem;
  }
  .hero-slide__dot {
    appearance: none;
    background: transparent;
    width: 8px;
    height: 8px;
    border: 1px solid color-mix(in oklab, var(--color-cream) 70%, transparent);
    border-radius: 50%;
    padding: 0;
    cursor: pointer;
    transition:
      background-color 0.35s var(--ease-out-editorial),
      transform 0.35s var(--ease-out-editorial),
      border-color 0.35s var(--ease-out-editorial);
  }
  .hero-slide__dot[aria-selected='true'] {
    background-color: var(--color-red);
    border-color: var(--color-red);
    transform: scale(1.25);
  }
  .hero-slide__dot:hover {
    border-color: var(--color-cream);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide__track {
      transition: none;
    }
  }
</style>

<script>
  /*
   * Wire hero slide horizontal — drag pointer + clavier + dots + auto 5s.
   * Le slide entier translate au changement d'index ; pas de cross-fade.
   */
  function wireHeroSlide() {
    const root = document.querySelector<HTMLElement>('[data-hero-slide]');
    if (!root) return;
    if (root.dataset.slideWired === 'true') return;
    root.dataset.slideWired = 'true';

    const track = root.querySelector<HTMLElement>('[data-hero-slide-track]');
    const panels = root.querySelectorAll<HTMLElement>('[data-hero-slide-panel]');
    const dots = root.querySelectorAll<HTMLButtonElement>('[data-hero-slide-dot]');
    if (!track || panels.length === 0) return;

    const total = panels.length;
    let index = 0;
    let autoTimer: number | null = null;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // v13 2026-05-15 (retour Morgan) : 3s par image (était 2s), slide
    // auto only, pas d'interactivité manuelle.
    const AUTO_INTERVAL = 3000;

    const applyTransform = (extraPx = 0) => {
      const slideWidth = root.clientWidth;
      const x = -index * slideWidth + extraPx;
      track.style.transform = `translate3d(${x}px, 0, 0)`;
    };

    const updateA11y = () => {
      panels.forEach((p, i) => p.setAttribute('aria-hidden', i === index ? 'false' : 'true'));
      dots.forEach((d, i) => d.setAttribute('aria-selected', i === index ? 'true' : 'false'));
    };

    const goto = (next: number) => {
      index = (next + total) % total;
      applyTransform(0);
      updateA11y();
      restartAuto();
    };

    const startAuto = () => {
      if (reducedMotion) return;
      autoTimer = window.setInterval(() => goto(index + 1), AUTO_INTERVAL);
    };
    const stopAuto = () => {
      if (autoTimer !== null) {
        window.clearInterval(autoTimer);
        autoTimer = null;
      }
    };
    const restartAuto = () => {
      stopAuto();
      startAuto();
    };

    // v12 2026-05-15 (retour Morgan) : slideshow auto only, drag/clavier/
    // dots-click retirés. Les dots restent visuels (indicateur de progress).
    void dots;

    window.addEventListener('resize', () => applyTransform(0), { passive: true });

    applyTransform(0);
    updateA11y();
    startAuto();
  }

  wireHeroSlide();
  document.addEventListener('astro:page-load', wireHeroSlide);
</script>
