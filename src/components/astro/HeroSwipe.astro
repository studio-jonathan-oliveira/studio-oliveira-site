---
/*
 * HeroSwipe — slideshow hero (refonte v2 2026-05-15, retours Morgan/Jonathan).
 *
 * Changements vs v1 :
 *  - Cross-fade opacity (au lieu de slide horizontal qui faisait "mal aux yeux").
 *  - 3 secondes d'affichage par image (au lieu de défilement rapide).
 *  - Wordmark "STUDIO J. OLIVEIRA" SORTI des slides → figé en overlay,
 *    seules les images défilent dessous. "STUDIO" ligne 1, "J. OLIVEIRA" ligne 2.
 *  - Images en 2x density (srcset 1920/3840) via pipeline scripts/optimize-hero-images.ts.
 *  - object-position: 50% 85% (cadrage bas-centré la plupart du temps).
 *  - Drag/clavier/dots restent dispos pour naviguer manuellement.
 */
const slides = [
  { name: '01-villa', label: 'Villa et jardin paysager' },
  { name: '02-cypres', label: 'Cyprès et statues méditerranéennes' },
  { name: '03-terrasse-salon', label: 'Terrasse et salon outdoor végétalisé' },
  { name: '04-pergola-palmiers', label: 'Pergola et palmiers' },
  { name: '05-ruelle', label: 'Ruelle végétalisée' },
];
---

<div class="hero-fade" data-hero-fade>
  <div class="hero-fade__stack" data-hero-fade-stack>
    {
      slides.map((slide, i) => (
        <div
          class={i === 0 ? 'hero-fade__slide is-active' : 'hero-fade__slide'}
          data-hero-fade-slide={i}
          aria-hidden={i === 0 ? 'false' : 'true'}
        >
          <picture>
            <source
              type="image/webp"
              srcset={`/hero/${slide.name}.webp 1x, /hero/${slide.name}@2x.webp 2x`}
            />
            <img
              src={`/hero/${slide.name}.jpg`}
              srcset={`/hero/${slide.name}.jpg 1x, /hero/${slide.name}@2x.jpg 2x`}
              alt={slide.label}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              fetchpriority={i === 0 ? 'high' : 'auto'}
              draggable="false"
            />
          </picture>
        </div>
      ))
    }
  </div>

  {
    /* Voile sombre subtil — au-dessus des images, sous le wordmark.
      Garantit le contraste du wordmark et du Header quel que soit le visuel. */
  }
  <div class="hero-fade__veil" aria-hidden="true"></div>

  {
    /* Wordmark figé — ne défile PAS avec les images (retour Jonathan).
      "STUDIO" ligne 1, "J. OLIVEIRA" ligne 2. ExtraLight 200 UPPERCASE rouge. */
  }
  <p class="hero-fade__wordmark" aria-hidden="true">
    <span class="hero-fade__wordmark-line">STUDIO</span>
    <span class="hero-fade__wordmark-line">J. OLIVEIRA</span>
  </p>

  {/* Dots indicateurs — bas-centre, cliquables pour goto direct. */}
  <div class="hero-fade__dots" role="tablist" aria-label="Sélecteur de visuel hero">
    {
      slides.map((_, i) => (
        <button
          type="button"
          class="hero-fade__dot"
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-label={`Aller au visuel ${i + 1}`}
          data-hero-fade-dot={i}
        />
      ))
    }
  </div>
</div>

<style>
  .hero-fade {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }
  .hero-fade__stack {
    position: absolute;
    inset: 0;
  }
  /* Chaque slide superposé en absolute — visibilité pilotée par opacity.
     Cross-fade 1.2s (refonte douce, retour Morgan/Jonathan). */
  .hero-fade__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out-editorial);
    will-change: opacity;
  }
  .hero-fade__slide.is-active {
    opacity: 1;
  }
  .hero-fade__slide picture,
  .hero-fade__slide img {
    width: 100%;
    height: 100%;
    display: block;
  }
  .hero-fade__slide img {
    object-fit: cover;
    /* Cadrage bas-centré (retour Jonathan : « aligné au bas de l'image la
       plupart du temps »). 50% horizontal, 85% vertical — laisse 15% de
       haut visibles, le bas pleine résolution.. */
    object-position: 50% 85%;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  /* Voile gradient bord haut + bord bas, centre transparent. */
  .hero-fade__veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.45) 0%,
      rgba(0, 0, 0, 0.15) 12%,
      rgba(0, 0, 0, 0) 28%,
      rgba(0, 0, 0, 0) 55%,
      rgba(0, 0, 0, 0.3) 82%,
      rgba(0, 0, 0, 0.65) 100%
    );
  }

  /* Wordmark FIGÉ sur l'écran — ne dépend pas du stack des slides.
     Ligne 1 "STUDIO", ligne 2 "J. OLIVEIRA". ExtraLight 200 UPPERCASE rouge. */
  .hero-fade__wordmark {
    position: absolute;
    left: clamp(1.5rem, 4vw, 4rem);
    bottom: clamp(4rem, 9vh, 7rem);
    margin: 0;
    pointer-events: none;
    z-index: 3;
    display: flex;
    flex-direction: column;
    color: var(--color-red);
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.4);
  }
  .hero-fade__wordmark-line {
    font-family: var(--font-heading), sans-serif;
    font-weight: 200;
    font-size: clamp(3.2rem, 9.5vw, 11rem);
    line-height: 0.92;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    display: block;
  }

  /* Dots indicateurs — bas-centre. Inchangé vs v1 sauf nom de classe. */
  .hero-fade__dots {
    position: absolute;
    left: 50%;
    bottom: clamp(1rem, 3vh, 1.75rem);
    transform: translateX(-50%);
    display: flex;
    gap: 0.625rem;
    z-index: 3;
    padding: 0.5rem 0.75rem;
  }
  .hero-fade__dot {
    appearance: none;
    background: transparent;
    width: 8px;
    height: 8px;
    border: 1px solid color-mix(in oklab, var(--color-cream) 70%, transparent);
    border-radius: 50%;
    padding: 0;
    cursor: pointer;
    transition:
      background-color 0.35s var(--ease-out-editorial),
      transform 0.35s var(--ease-out-editorial),
      border-color 0.35s var(--ease-out-editorial);
  }
  .hero-fade__dot[aria-selected='true'] {
    background-color: var(--color-red);
    border-color: var(--color-red);
    transform: scale(1.25);
  }
  .hero-fade__dot:hover {
    border-color: var(--color-cream);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-fade__slide {
      transition: none;
    }
  }
</style>

<script>
  /*
   * Wire hero cross-fade — auto-advance 3s par image, dots cliquables, clavier.
   * Pas de drag (cross-fade, pas de slide horizontal à manipuler).
   */
  function wireHeroFade() {
    const root = document.querySelector<HTMLElement>('[data-hero-fade]');
    if (!root) return;
    if (root.dataset.fadeWired === 'true') return;
    root.dataset.fadeWired = 'true';

    const slides = root.querySelectorAll<HTMLElement>('[data-hero-fade-slide]');
    const dots = root.querySelectorAll<HTMLButtonElement>('[data-hero-fade-dot]');
    if (slides.length === 0) return;

    const total = slides.length;
    let index = 0;
    let autoTimer: number | null = null;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const AUTO_INTERVAL = 3000;

    const goto = (next: number) => {
      const target = (next + total) % total;
      if (target === index) return;
      slides[index]!.classList.remove('is-active');
      slides[index]!.setAttribute('aria-hidden', 'true');
      slides[target]!.classList.add('is-active');
      slides[target]!.setAttribute('aria-hidden', 'false');
      dots.forEach((d, i) => d.setAttribute('aria-selected', i === target ? 'true' : 'false'));
      index = target;
      restartAuto();
    };

    const startAuto = () => {
      if (reducedMotion) return;
      autoTimer = window.setInterval(() => goto(index + 1), AUTO_INTERVAL);
    };
    const stopAuto = () => {
      if (autoTimer !== null) {
        window.clearInterval(autoTimer);
        autoTimer = null;
      }
    };
    const restartAuto = () => {
      stopAuto();
      startAuto();
    };

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => goto(i));
    });

    document.addEventListener('keydown', (e) => {
      const rect = root.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > window.innerHeight) return;
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        goto(index - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        goto(index + 1);
      }
    });

    root.addEventListener('mouseenter', stopAuto);
    root.addEventListener('mouseleave', startAuto);

    startAuto();
  }

  wireHeroFade();
  document.addEventListener('astro:page-load', wireHeroFade);
</script>
