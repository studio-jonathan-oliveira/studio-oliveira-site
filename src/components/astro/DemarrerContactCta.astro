---
/*
 * <DemarrerContactCta> — bouton « Contacter » + popup natif <dialog>.
 *
 * Inséré après la section validation de /demarrer-un-projet (retour
 * Jonathan 2026-05-22 : « Peut être rajouter après l'appel de validation
 * un CTA « Contacter » qui envoie directement sur un petit pop up avec
 * adresse, numéro de tel et email »).
 *
 * Pattern : <dialog> HTML natif (a11y intégré : focus trap, ESC pour
 * fermer, role="dialog" auto). JS minimal inline pour open/close.
 * Style cohérent avec la page : fond ink, texte cream, accent rouge.
 */
import { SITE } from '@/lib/site-config';
---

<section data-theme="dark" class="dem-cta-contact" aria-label="Contact direct studio">
  <div class="dem-cta-contact__inner">
    <button
      type="button"
      class="dem-cta-contact__button"
      data-magnetic="0.25"
      aria-haspopup="dialog"
      aria-controls="dem-contact-dialog"
    >
      <span class="dem-cta-contact__label">Contacter</span>
      <img
        src="/brand/fleche-white.webp"
        alt=""
        aria-hidden="true"
        width="18"
        height="18"
        class="dem-cta-contact__arrow"
      />
    </button>
  </div>
</section>

<dialog
  id="dem-contact-dialog"
  class="dem-contact-dialog"
  aria-labelledby="dem-contact-dialog-title"
>
  <div class="dem-contact-dialog__inner">
    <header class="dem-contact-dialog__head">
      <p class="dem-contact-dialog__eyebrow">Contact direct</p>
      <h2 id="dem-contact-dialog-title" class="dem-contact-dialog__title">Studio J. Oliveira</h2>
    </header>

    <dl class="dem-contact-dialog__list">
      <div class="dem-contact-dialog__row">
        <dt class="dem-contact-dialog__label">Adresse</dt>
        <dd class="dem-contact-dialog__value">
          {SITE.address.street}<br />
          {SITE.address.postalCode}
          {SITE.address.city}
        </dd>
      </div>

      <div class="dem-contact-dialog__row">
        <dt class="dem-contact-dialog__label">Téléphone</dt>
        <dd class="dem-contact-dialog__value">
          <a href={`tel:${SITE.contact.phone}`} class="dem-contact-dialog__link">
            {SITE.contact.phoneDisplay}
          </a>
        </dd>
      </div>

      <div class="dem-contact-dialog__row">
        <dt class="dem-contact-dialog__label">Email</dt>
        <dd class="dem-contact-dialog__value">
          <a href={`mailto:${SITE.contact.email}`} class="dem-contact-dialog__link">
            {SITE.contact.email}
          </a>
        </dd>
      </div>
    </dl>

    <button type="button" class="dem-contact-dialog__close" aria-label="Fermer la fenêtre">
      ×
    </button>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('dem-contact-dialog') as HTMLDialogElement | null;
  const openers = document.querySelectorAll<HTMLButtonElement>(
    '[aria-controls="dem-contact-dialog"]',
  );
  const closer = document.querySelector<HTMLButtonElement>('.dem-contact-dialog__close');

  openers.forEach((btn) => {
    btn.addEventListener('click', () => dialog?.showModal());
  });

  closer?.addEventListener('click', () => dialog?.close());

  // Click sur backdrop ferme aussi (UX standard popup).
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

<style>
  /* Section CTA — petit bloc ink entre validation et bandeau rouge. */
  .dem-cta-contact {
    background-color: var(--color-black-deep);
    color: var(--color-cream);
    padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 5vw, 4rem) clamp(4rem, 7vw, 6rem);
  }
  .dem-cta-contact__inner {
    display: flex;
    justify-content: center;
  }
  .dem-cta-contact__button {
    appearance: none;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: var(--color-cream);
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--color-cream);
    font-family: var(--font-heading), sans-serif;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    will-change: transform;
    transition: opacity 0.3s ease;
  }
  .dem-cta-contact__button:hover,
  .dem-cta-contact__button:focus-visible {
    opacity: 0.85;
  }
  .dem-cta-contact__button:focus-visible {
    outline: 2px solid var(--color-cream);
    outline-offset: 6px;
  }
  .dem-cta-contact__arrow {
    width: 18px;
    height: 18px;
    object-fit: contain;
  }

  /* Dialog popup — ink card centrée, backdrop noir alpha. */
  .dem-contact-dialog {
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--color-cream);
    max-width: min(560px, 92vw);
    width: 100%;
  }
  .dem-contact-dialog::backdrop {
    background: color-mix(in oklab, var(--color-black-deep) 78%, transparent);
    backdrop-filter: blur(4px);
  }
  .dem-contact-dialog__inner {
    position: relative;
    background-color: var(--color-black-deep);
    color: var(--color-cream);
    border: 1px solid color-mix(in oklab, var(--color-cream) 25%, transparent);
    padding: clamp(2rem, 4vw, 3rem) clamp(1.75rem, 4vw, 2.75rem);
  }
  .dem-contact-dialog__head {
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }
  .dem-contact-dialog__eyebrow {
    font-family: var(--font-heading), sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-red);
    margin: 0 0 0.5rem;
  }
  .dem-contact-dialog__title {
    font-family: var(--font-heading), sans-serif;
    font-weight: 200;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    letter-spacing: -0.01em;
    line-height: 1.1;
    color: var(--color-cream);
    margin: 0;
  }
  .dem-contact-dialog__list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .dem-contact-dialog__row {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-bottom: clamp(1rem, 2vw, 1.5rem);
    border-bottom: 1px solid color-mix(in oklab, var(--color-cream) 18%, transparent);
  }
  .dem-contact-dialog__row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .dem-contact-dialog__label {
    font-family: var(--font-heading), sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-cream) 65%, transparent);
    margin: 0;
  }
  .dem-contact-dialog__value {
    font-family: var(--font-heading), sans-serif;
    font-weight: 200;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.5;
    color: var(--color-cream);
    margin: 0;
  }
  .dem-contact-dialog__link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--color-cream) 40%, transparent);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.25s ease;
  }
  .dem-contact-dialog__link:hover {
    text-decoration-color: var(--color-cream);
  }
  .dem-contact-dialog__close {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    appearance: none;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: var(--color-cream);
    font-size: 2rem;
    line-height: 1;
    padding: 0.25rem 0.5rem;
    transition: opacity 0.25s ease;
  }
  .dem-contact-dialog__close:hover,
  .dem-contact-dialog__close:focus-visible {
    opacity: 0.7;
  }
  .dem-contact-dialog__close:focus-visible {
    outline: 1px solid var(--color-cream);
    outline-offset: 2px;
  }
</style>
