---
/*
 * <TypologieFaq> — section FAQ partagée des 4 pages typologies.
 *
 * Refonte DA finale 2026-06-04 (trames « modif finales ») :
 *   - Fond BEIGE (--color-cream #EDE6D6), texte/icône NOIR (était fond ROUGE).
 *   - Marquee « découvrir les projets ◦ … » en lettres OUTLINE défilant en
 *     boucle au-dessus du titre (annotation : « DEFILEMENT A L'HORIZONTAL EN
 *     BOUCLE SANS FIN », « ARRET DE L'ANIMATION AU SURVOL », clic → /projets).
 *   - Titre « FAQ » noir massif. Plus de sous-titre « Questions fréquentes »
 *     (absent de la trame).
 *   - Accordéon `<FaqAccordion>` réutilisé ; séparateurs arrondis à droite
 *     (parti-pris angles arrondis sitewide), icône `+`→`×` (rotate 45°).
 *
 * API :
 *   - items (FaqItem[]) : Q/R transmis à FaqAccordion
 *   - sectionLabel (string, opt) : étiquette nav scroll (défaut "FAQ")
 */
import FaqAccordion, { type FaqItem } from '@/components/islands/FaqAccordion';

interface Props {
  items: ReadonlyArray<FaqItem>;
  sectionLabel?: string;
}

const { items, sectionLabel = 'FAQ' } = Astro.props;

// Motif marquee répété — défilement infini, séparateur ◦ (cercle évidé).
const MARQUEE = 'découvrir les projets ◦ ';
const marqueeUnit = MARQUEE.repeat(6);
---

<section
  id="faq"
  data-section-label={sectionLabel}
  data-theme="dark"
  class="typo-faq"
  aria-labelledby="faq-title"
>
  <a href="/projets" class="typo-faq__marquee" aria-label="Découvrir les projets">
    {
      /* Marquee en SVG : contour avec stroke-linejoin: round → aucun pic de
        tracé aux angles (le « e »/« v »/« t » ne dépassent plus). Le script
        dimensionne chaque SVG sur la largeur réelle du texte. */
    }
    <div class="typo-faq__marquee-track" aria-hidden="true" data-typo-marquee>
      <svg class="typo-faq__marquee-svg"
        ><text class="typo-faq__marquee-text" x="0" y="0">{marqueeUnit}</text></svg
      >
      <svg class="typo-faq__marquee-svg"
        ><text class="typo-faq__marquee-text" x="0" y="0">{marqueeUnit}</text></svg
      >
    </div>
  </a>

  <div class="typo-faq__inner">
    <div class="typo-faq__head">
      <h2 id="faq-title" class="typo-faq__title">FAQ</h2>
    </div>
    <FaqAccordion items={items} client:visible />
  </div>
</section>

<style is:global>
  /* ════════════════════════════════════════════════════════════════════
   * <TypologieFaq> — FAQ beige des pages typologies (refonte 2026-06-04).
   * `is:global` car l'astro-island FaqAccordion vit hors scope local.
   * ═══════════════════════════════════════════════════════════════════ */
  .typo-faq {
    width: 100%;
    background-color: var(--color-ink);
    color: var(--color-cream);
    padding: clamp(2.5rem, 6vw, 5rem) 0 clamp(3rem, 7vw, 6rem);
  }

  /* ── Marquee outline défilant ────────────────────────────────────────── */
  .typo-faq__marquee {
    display: block;
    width: 100%;
    overflow: hidden;
    text-decoration: none;
    padding: clamp(1rem, 2vw, 2rem) 0 clamp(2.5rem, 5vw, 4rem);
  }
  .typo-faq__marquee-track {
    display: flex;
    width: max-content;
    animation: typo-faq-marquee 38s linear infinite;
    will-change: transform;
  }
  /* SVG dimensionné par le script (width/height/viewBox posés depuis la bbox
     du texte). flex:none pour que les 2 moitiés gardent leur largeur. */
  .typo-faq__marquee-svg {
    display: block;
    flex: none;
    overflow: visible;
    margin-right: 0.2em;
  }
  .typo-faq__marquee-text {
    font-family: var(--font-heading), sans-serif;
    font-weight: 800;
    font-size: clamp(2.5rem, 8vw, 8rem);
    letter-spacing: -0.01em;
    /* Outline NET : on peint d'abord le contour (stroke), puis un remplissage
       couleur FOND (cream) par-dessus (paint-order: stroke fill). Résultat :
       seule la moitié EXTÉRIEURE du trait reste visible → les contre-formes du
       « e »/« t » ne sont plus rongées, et les jointures ARRONDIES suppriment
       les pics. Stroke épais (3px) car la moitié seulement est visible. */
    fill: var(--color-ink);
    stroke: var(--color-cream);
    stroke-width: 3px;
    stroke-linejoin: round;
    stroke-linecap: round;
    paint-order: stroke fill;
    transition: fill 0.4s var(--ease-out-editorial);
  }
  /* Survol : le marquee CONTINUE de défiler (pas de pause) et l'intérieur des
     lettres se remplit en NOIR (Morgan 2026-06-05). */
  .typo-faq__marquee:hover .typo-faq__marquee-text,
  .typo-faq__marquee:focus-visible .typo-faq__marquee-text {
    fill: var(--color-cream);
  }
  @keyframes typo-faq-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .typo-faq__marquee-track {
      animation: none;
    }
  }

  /* ── En-tête + layout ────────────────────────────────────────────────── */
  .typo-faq__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding: 0 clamp(1.5rem, 5vw, 4rem);
  }
  @media (min-width: 1024px) {
    .typo-faq__inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr);
      column-gap: clamp(3rem, 6vw, 5rem);
      align-items: start;
    }
    .typo-faq .faq-acc__list {
      grid-column: 2;
    }
  }
  .typo-faq__head {
    display: flex;
    flex-direction: column;
  }
  .typo-faq__title {
    font-family: var(--font-heading), sans-serif;
    font-weight: 900;
    font-size: clamp(4rem, 11vw, 11rem);
    line-height: 0.92;
    letter-spacing: -0.01em;
    color: var(--color-cream);
    margin: 0;
  }

  /* ── Surcharges accordéon pour fond NOIR (inversion DA finale 2026-06-16) :
     question/icône/texte en CRÈME, séparateurs crème, arrondi à DROITE. ──── */
  .typo-faq .faq-acc__question,
  .typo-faq .faq-acc__icon {
    color: var(--color-cream);
  }
  .typo-faq .faq-acc__answer {
    color: color-mix(in oklab, var(--color-cream) 92%, transparent);
  }
  .typo-faq .faq-acc__item {
    border-bottom: 0;
  }
  /* Séparateur = bord bas + bord droit arrondi au coin bas-droite
     (parti-pris « arrondi à droite » des trames). Gauche/haut ouverts. */
  .typo-faq .faq-acc__summary {
    border-bottom: 1px solid color-mix(in oklab, var(--color-cream) 22%, transparent);
    border-right: 1px solid color-mix(in oklab, var(--color-cream) 22%, transparent);
    border-bottom-right-radius: clamp(18px, 2.5vw, 32px);
  }
  .typo-faq .faq-acc__summary:focus-visible {
    outline: 1px solid color-mix(in oklab, var(--color-cream) 45%, transparent);
  }
</style>

<script>
  // Dimensionne chaque SVG du marquee sur la bbox réelle de son texte (le SVG
  // ne sait pas s'auto-ajuster au contenu). Recalcule après chargement des
  // fonts et au resize (la taille de police est en clamp responsive).
  function sizeTypoMarquee() {
    const svgs = document.querySelectorAll<SVGSVGElement>(
      '[data-typo-marquee] .typo-faq__marquee-svg',
    );
    svgs.forEach((svg) => {
      const text = svg.querySelector<SVGTextElement>('text');
      if (!text) return;
      const bb = text.getBBox();
      if (bb.width === 0) return;
      const padY = bb.height * 0.06;
      const x = bb.x;
      const y = bb.y - padY;
      const w = bb.width;
      const h = bb.height + padY * 2;
      svg.setAttribute('viewBox', `${x} ${y} ${w} ${h}`);
      svg.setAttribute('width', String(w));
      svg.setAttribute('height', String(h));
    });
  }

  function initTypoMarquee() {
    if (!document.querySelector('[data-typo-marquee]')) return;
    sizeTypoMarquee();
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => sizeTypoMarquee());
    }
    let t = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(t);
      t = window.setTimeout(sizeTypoMarquee, 150);
    });
  }

  initTypoMarquee();
  document.addEventListener('astro:page-load', initTypoMarquee);
</script>
