---
/*
 * Header éditorial minimaliste — logo + topbar méta + bouton Menu + CTA pill.
 *
 * Refonte 2026-04-29 (Morgan, retours bloc) :
 *  - Topbar (bandeau méta du haut) : fond cream solide, écritures bleu Klein.
 *    Plus de verre dépoli, plus de mix-blend-difference.
 *  - Logo : gris sombre (ink) sur fond cream (default), cream sur sections
 *    sombres (Klein / forest hero immersifs) via body.is-dark-section.
 *  - CTA pill « Démarrer un projet » : fond Klein + texte cream. Sur sections
 *    sombres, inversion fond cream + texte Klein pour contraste.
 *  - Menu/icônes : color ink default, cream sur dark-section.
 *  - Pas d'effet bold au hover (rendu plus calme, conforme à la demande
 *    parallèle sur le menu fullscreen).
 */

interface Props {
  darkHero?: boolean;
}
const { darkHero = false } = Astro.props;
---

<header
  class:list={[
    'site-header fixed top-0 right-0 left-0 z-40 transition-[color] duration-[450ms] ease-[var(--ease-out-editorial)]',
    darkHero && 'site-header--dark-hero',
  ]}
  data-header
  data-dark-hero={darkHero ? 'true' : 'false'}
>
  <!-- Topbar méta (desktop only) ─ fond cream solide, écritures Klein ───── -->
  <div class="site-header__topbar hidden lg:block">
    <div
      class="mx-auto flex max-w-[1400px] items-center justify-between gap-8 px-10 py-3.5 font-mono text-[11.5px] tracking-[0.26em] uppercase"
    >
      <p>Studio · Brive‑la‑Gaillarde · Aquitaine</p>
      <p class="flex items-center gap-2.5">
        <span class="status-dot inline-block h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
        Calendrier 2026 ouvert
      </p>
      <p>
        <a href="tel:+33661088444" class="transition-opacity hover:opacity-70">
          +33 6 61 08 84 44
        </a>
        <span class="mx-3 opacity-40">·</span>
        <a
          href="mailto:contact.jonathanbiodesign@gmail.com"
          class="transition-opacity hover:opacity-70"
        >
          Contact
        </a>
      </p>
    </div>
  </div>

  <!-- Main row : logo · CTA · bouton Menu ─────────────── -->
  <div
    class="site-header__main mx-auto flex max-w-[1400px] items-center justify-between gap-6 px-6 py-5 md:px-10 md:py-6"
  >
    <a
      href="/"
      class="logo-swap relative flex shrink-0 items-center"
      aria-label="Studio J Oliveira — accueil"
      data-header-logo
    >
      <span
        class="site-logo block h-9 w-[150px] md:h-10 md:w-[167px] lg:h-11 lg:w-[183px]"
        aria-hidden="true"></span>
      <span class="sr-only">Studio J Oliveira</span>
    </a>

    <div class="flex items-center gap-4 md:gap-6">
      <a
        href="/demarrer-un-projet"
        class="cta-pill group hidden items-center gap-3 rounded-full px-5 py-3 text-[13px] tracking-[0.04em] transition-all md:inline-flex"
      >
        <span class="cta-dot inline-block h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
        Démarrer un projet
        <span
          aria-hidden="true"
          class="inline-block transition-transform duration-[var(--duration-fast)] group-hover:translate-x-1"
          >→</span
        >
      </a>

      <button
        type="button"
        class="menu-trigger relative flex items-center gap-3 text-[12px] tracking-[0.24em] uppercase"
        aria-label="Ouvrir le menu principal"
        aria-expanded="false"
        aria-controls="primary-menu"
        data-menu-trigger
      >
        <span class="hidden sm:inline">Menu</span>
        <span class="menu-bars flex flex-col gap-1.5" aria-hidden="true">
          <span class="block h-px w-6 bg-current transition-transform"></span>
          <span class="block h-px w-6 bg-current transition-transform"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<style>
  /* Default (sur fond cream du site) — Header transparent, couleur ink. */
  .site-header {
    background-color: transparent;
    color: var(--color-ink);
  }

  /* Topbar méta — fond cream solide en permanence, écritures Klein.
     Plus de verre dépoli, plus de mix-blend. Toujours lisible quel que soit
     le fond de la page derrière (cream comme Klein). */
  .site-header__topbar {
    background-color: var(--color-cream);
    color: var(--color-klein);
    border-bottom: 1px solid color-mix(in oklab, var(--color-klein) 10%, transparent);
  }

  /* Logo — ink (gris sombre) par défaut, masque sur le PNG wordmark. */
  .site-logo {
    background-color: var(--color-ink);
    -webkit-mask: url('/brand/wordmark-black.png?v=3') center / contain no-repeat;
    mask: url('/brand/wordmark-black.png?v=3') center / contain no-repeat;
  }

  /* Sur sections sombres (Klein / forest immersif via data-theme=dark) :
     logo cream + menu cream. La topbar reste cream/Klein (rectangle
     posé qui contraste sur la page). */
  :global(body.is-dark-section) .site-header,
  .site-header--dark-hero:not(.is-scrolled) {
    color: var(--color-cream);
  }
  :global(body.is-dark-section) .site-logo,
  .site-header--dark-hero:not(.is-scrolled) .site-logo {
    background-color: var(--color-cream);
  }

  /* CTA pill — fond Klein, texte cream (default).
     Pas d'effet bold au hover — assombrissement subtil du fond seulement. */
  .cta-pill {
    background-color: var(--color-klein);
    color: var(--color-cream);
    border: 1px solid var(--color-klein);
    transition:
      background-color 0.3s var(--ease-out-editorial),
      border-color 0.3s var(--ease-out-editorial);
  }
  .cta-pill:hover {
    background-color: color-mix(in oklab, var(--color-klein) 85%, black);
    border-color: color-mix(in oklab, var(--color-klein) 85%, black);
  }
  .cta-pill .cta-dot {
    background-color: var(--color-cream);
    transition: transform 0.4s var(--ease-out-editorial);
  }
  .cta-pill:hover .cta-dot {
    transform: scale(1.4);
  }

  /* Sur dark-section : pill inversée — fond cream + texte Klein pour contraste
     (le fond Klein du site rendrait un pill Klein invisible). */
  :global(body.is-dark-section) .cta-pill,
  .site-header--dark-hero:not(.is-scrolled) .cta-pill {
    background-color: var(--color-cream);
    color: var(--color-klein);
    border-color: var(--color-cream);
  }
  :global(body.is-dark-section) .cta-pill:hover,
  .site-header--dark-hero:not(.is-scrolled) .cta-pill:hover {
    background-color: color-mix(in oklab, var(--color-cream) 88%, var(--color-klein));
    border-color: color-mix(in oklab, var(--color-cream) 88%, var(--color-klein));
  }
  :global(body.is-dark-section) .cta-pill .cta-dot,
  .site-header--dark-hero:not(.is-scrolled) .cta-pill .cta-dot {
    background-color: var(--color-klein);
  }

  /* Status dot topbar — Klein qui pulse. */
  .status-dot {
    background-color: var(--color-klein);
    animation: status-pulse 2.5s ease-in-out infinite;
  }
  @keyframes status-pulse {
    0%,
    100% {
      opacity: 0.5;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.3);
    }
  }

  /* Burger ↔ X — animation préservée (refonte 2026-04-24 designbyad). */
  .menu-trigger {
    cursor: pointer;
    padding: 0.4rem 0;
  }
  .menu-bars {
    position: relative;
    height: 9px;
    width: 24px;
    display: inline-block;
  }
  .menu-bars > span {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background-color: currentColor;
    transition:
      transform 0.45s cubic-bezier(0.76, 0, 0.24, 1),
      top 0.45s cubic-bezier(0.76, 0, 0.24, 1),
      bottom 0.45s cubic-bezier(0.76, 0, 0.24, 1),
      width 0.3s var(--ease-out-editorial);
    transform-origin: center;
  }
  .menu-bars > span:first-child {
    top: 0;
  }
  .menu-bars > span:last-child {
    bottom: 0;
  }
  .menu-trigger:hover .menu-bars > span:first-child {
    width: 65%;
    margin-left: auto;
  }
  .menu-trigger:hover .menu-bars > span:last-child {
    width: 85%;
  }
  .menu-trigger[aria-expanded='true'] .menu-bars > span {
    width: 100% !important;
    margin-left: 0;
  }
  .menu-trigger[aria-expanded='true'] .menu-bars > span:first-child {
    top: 4px;
    transform: rotate(45deg);
  }
  .menu-trigger[aria-expanded='true'] .menu-bars > span:last-child {
    bottom: 4px;
    transform: rotate(-45deg);
  }
  .menu-trigger[aria-expanded='true']:hover .menu-bars > span:first-child {
    transform: rotate(45deg) scale(1.1);
  }
  .menu-trigger[aria-expanded='true']:hover .menu-bars > span:last-child {
    transform: rotate(-45deg) scale(1.1);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-logo,
    .status-dot,
    .menu-trigger .menu-bars > span,
    .cta-pill {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  /**
   * Header wire — idempotent + expose --header-height en CSS custom property
   * sur <html> pour offset hero / scroll-margin-top.
   */
  let headerWired = false;
  let scrollListener: (() => void) | null = null;
  let resizeObserver: ResizeObserver | null = null;

  function wireHeaderScroll() {
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (!header) return;

    if (resizeObserver) resizeObserver.disconnect();
    resizeObserver = new ResizeObserver(() => {
      const h = header.getBoundingClientRect().height;
      document.documentElement.style.setProperty('--header-height', `${h}px`);
    });
    resizeObserver.observe(header);
    document.documentElement.style.setProperty(
      '--header-height',
      `${header.getBoundingClientRect().height}px`,
    );

    if (headerWired) return;
    headerWired = true;
    scrollListener = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 80);
    };
    scrollListener();
    window.addEventListener('scroll', scrollListener, { passive: true });
  }

  wireHeaderScroll();
  document.addEventListener('astro:page-load', wireHeaderScroll);
</script>
