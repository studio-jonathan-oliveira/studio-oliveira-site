---
/*
 * Header éditorial minimaliste — logo + topbar méta + bouton Menu + CTA pill.
 *
 * Décision audit DA/UX 2026-04-23 : suppression de la nav horizontale inline.
 * La navigation primaire vit désormais dans MenuPrimary.astro (overlay full
 * screen déclenché par le bouton Menu). Raisons :
 *  - Libellés Jonathan longs (« Aménagement végétalisé d'intérieur » = 32 car)
 *    forçaient le wrap entre 1024-1200px.
 *  - Hiérarchie à plat de 6 onglets = pas de sous-sections découvrables.
 *  - Spec PDF l.740 Jonathan : « menu déroulé latéral évolutif = LE MUST ».
 *
 * Le header reste fixed top, bascule transparent → cream au scroll de 80px.
 */

interface Props {
  darkHero?: boolean;
}
const { darkHero = false } = Astro.props;
---

<header
  class:list={[
    'site-header fixed top-0 right-0 left-0 z-40 transition-[background-color,color,border-color,backdrop-filter] duration-[450ms] ease-[var(--ease-out-editorial)]',
    darkHero && 'site-header--dark-hero',
  ]}
  data-header
  data-dark-hero={darkHero ? 'true' : 'false'}
>
  <!-- Topbar méta (desktop only) ─────────────────────── -->
  <div class="site-header__topbar hidden border-b border-current/5 lg:block">
    <div
      class="mx-auto flex max-w-[1400px] items-center justify-between gap-8 px-10 py-3.5 font-mono text-[11.5px] tracking-[0.26em] uppercase opacity-75"
    >
      <p>Studio · Brive-la-Gaillarde · Aquitaine</p>
      <p class="flex items-center gap-2.5">
        <span class="status-dot inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-laterite)]"
        ></span>
        Disponible pour projets 2026
      </p>
      <p>
        <a href="tel:+33661088444" class="transition-opacity hover:opacity-100">
          +33 6 61 08 84 44
        </a>
        <span class="mx-3 opacity-40">·</span>
        <a
          href="mailto:contact.jonathanbiodesign@gmail.com"
          class="transition-opacity hover:opacity-100"
        >
          Contact
        </a>
      </p>
    </div>
  </div>

  <!-- Main row : logo · CTA · bouton Menu ─────────────── -->
  <div
    class="site-header__main mx-auto flex max-w-[1400px] items-center justify-between gap-6 px-6 py-5 md:px-10 md:py-6"
  >
    <a
      href="/"
      class="logo-swap relative flex shrink-0 items-center"
      aria-label="Studio J Oliveira — accueil"
      data-header-logo
    >
      <img
        src="/brand/wordmark-moss.png?v=3"
        alt=""
        width="1200"
        height="288"
        class="logo-moss h-9 w-auto md:h-10 lg:h-11"
        loading="eager"
        decoding="async"
      />
      <img
        src="/brand/wordmark-cream.png?v=3"
        alt=""
        width="1200"
        height="288"
        class="logo-cream absolute inset-0 h-9 w-auto md:h-10 lg:h-11"
        loading="eager"
        decoding="async"
        aria-hidden="true"
      />
      <span class="sr-only">Studio J Oliveira</span>
    </a>

    <div class="flex items-center gap-4 md:gap-6">
      <a
        href="/contact"
        class="cta-pill group hidden items-center gap-3 rounded-full px-5 py-3 text-[13px] tracking-[0.04em] transition-all md:inline-flex"
      >
        <span
          class="cta-dot inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-laterite)]"
          aria-hidden="true"></span>
        Démarrer un projet
        <span
          aria-hidden="true"
          class="inline-block transition-transform duration-[var(--duration-fast)] group-hover:translate-x-1"
          >→</span
        >
      </a>

      <button
        type="button"
        class="menu-trigger relative flex items-center gap-3 text-[12px] tracking-[0.24em] uppercase"
        aria-label="Ouvrir le menu principal"
        aria-expanded="false"
        aria-controls="primary-menu"
        data-menu-trigger
      >
        <span class="hidden sm:inline">Menu</span>
        <span class="menu-bars flex flex-col gap-1.5" aria-hidden="true">
          <span class="block h-px w-6 bg-current transition-transform"></span>
          <span class="block h-px w-6 bg-current transition-transform"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<style>
  /* État par défaut (pages classiques, header sur fond cream) */
  .site-header {
    background-color: var(--color-cream);
    color: var(--color-forest);
  }

  /* Dark hero — transparent, logo crème, texte crème */
  .site-header--dark-hero {
    background-color: transparent;
    color: var(--color-cream);
  }
  .site-header--dark-hero .logo-moss {
    opacity: 0;
  }
  .site-header--dark-hero .logo-cream {
    opacity: 1;
  }

  /* Scrolled — cream translucide flouté, forest text */
  .site-header.is-scrolled {
    background-color: color-mix(in oklab, var(--color-cream) 92%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    color: var(--color-forest);
    border-bottom: 1px solid color-mix(in oklab, var(--color-forest) 8%, transparent);
  }
  .site-header.is-scrolled .logo-moss {
    opacity: 1;
  }
  .site-header.is-scrolled .logo-cream {
    opacity: 0;
  }

  .site-header:not(.site-header--dark-hero) .logo-moss {
    opacity: 1;
  }
  .site-header:not(.site-header--dark-hero) .logo-cream {
    opacity: 0;
  }

  .logo-swap .logo-moss,
  .logo-swap .logo-cream {
    transition: opacity 0.4s var(--ease-out-editorial);
  }

  /* CTA pill — fond plein editorial, inversion au hover */
  .cta-pill {
    background-color: var(--color-forest);
    color: var(--color-cream);
    border: 1px solid var(--color-forest);
  }
  .cta-pill:hover {
    background-color: var(--color-moss);
    border-color: var(--color-moss);
    color: var(--color-cream);
  }
  .cta-pill .cta-dot {
    transition:
      transform 0.4s var(--ease-out-editorial),
      background-color 0.3s;
  }
  .cta-pill:hover .cta-dot {
    transform: scale(1.4);
    background-color: var(--color-cream);
  }
  /* Dark hero — pill crème contour, texte forest */
  .site-header--dark-hero:not(.is-scrolled) .cta-pill {
    background-color: var(--color-cream);
    color: var(--color-forest);
    border-color: var(--color-cream);
  }
  .site-header--dark-hero:not(.is-scrolled) .cta-pill:hover {
    background-color: var(--color-laterite);
    border-color: var(--color-laterite);
    color: var(--color-cream);
  }

  /* Menu trigger — minimal burger 2 bars, bascule en X quand ouvert */
  .menu-trigger {
    cursor: pointer;
    padding: 0.4rem 0;
  }
  .menu-trigger[aria-expanded='true'] .menu-bars > span:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .menu-trigger[aria-expanded='true'] .menu-bars > span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }
  .menu-trigger:hover .menu-bars > span {
    transform: scaleX(0.85);
    transform-origin: right;
  }
  .menu-trigger[aria-expanded='true']:hover .menu-bars > span {
    transform-origin: center;
  }

  /* Status dot — pulse discret */
  .status-dot {
    animation: status-pulse 2.5s ease-in-out infinite;
  }
  @keyframes status-pulse {
    0%,
    100% {
      opacity: 0.5;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.3);
    }
  }

  /* Topbar borderless subtle tint */
  .site-header__topbar {
    border-bottom-color: color-mix(in oklab, currentColor 10%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .logo-swap .logo-moss,
    .logo-swap .logo-cream,
    .status-dot,
    .menu-trigger .menu-bars > span {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  function wireHeaderScroll() {
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (!header) return;
    const check = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 80);
    };
    check();
    window.addEventListener('scroll', check, { passive: true });
  }

  wireHeaderScroll();
  document.addEventListener('astro:page-load', wireHeaderScroll);
</script>
