---
/*
 * Header éditorial — barre du haut avec 3 zones : logo · CTA centré · Menu.
 *
 * Refonte 2026-04-30 (demande Jonathan) :
 *  - Topbar méta supprimée (tel/email/calendrier) → header simplifié.
 *  - CTA "Démarrer un projet" recentré au milieu (grid 3 cols).
 *  - Auto-hide au scroll : header caché par défaut sur darkHero (home),
 *    réapparaît dès qu'on scroll vers le haut. Sur autres pages, hide
 *    au scroll-down / show au scroll-up classique.
 *
 *   - Logo : ink (gris sombre) sur le fond cream du Header.
 *   - Menu trigger : ink.
 *   - CTA pill : latérite bg + cream texte, toujours.
 */

interface Props {
  darkHero?: boolean;
}
const { darkHero = false } = Astro.props;
---

<header
  class:list={[
    'site-header fixed top-0 right-0 left-0 z-40',
    darkHero && 'site-header--dark-hero',
    darkHero && 'is-hidden',
  ]}
  data-header
  data-theme="light"
  data-dark-hero={darkHero ? 'true' : 'false'}
>
  <!-- Main row : logo · CTA centré · bouton Menu ─────────────── -->
  <div
    class="site-header__main mx-auto grid max-w-[1400px] grid-cols-[1fr_auto_1fr] items-center gap-4 px-6 py-5 md:px-10 md:py-6"
  >
    <a
      href="/"
      class="logo-swap relative flex shrink-0 items-center justify-self-start"
      aria-label="Studio J Oliveira — accueil"
      data-header-logo
    >
      <span
        class="site-logo block h-9 w-[150px] md:h-10 md:w-[167px] lg:h-11 lg:w-[183px]"
        aria-hidden="true"></span>
      <span class="sr-only">Studio J Oliveira</span>
    </a>

    {
      /* CTA principal toujours visible (refonte 2026-05-11 — audit UI P0-2 :
        l'ancien `hidden md:inline-flex` cachait le CTA n°1 d'acquisition
        sur mobile). Sur sm-, on raccourcit le libellé en « Projet » pour
        tenir entre logo et burger sur 375px. */
    }
    <a
      href="/demarrer-un-projet"
      class="cta-pill group inline-flex items-center gap-2 justify-self-center rounded-full px-3 py-2 text-[12px] tracking-[0.04em] transition-all sm:gap-3 sm:px-5 sm:py-3 sm:text-[13px]"
      data-magnetic="0.25"
      data-cursor-skip
    >
      <span class="cta-dot inline-block h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
      <span class="hidden sm:inline">Démarrer un projet</span>
      <span class="sm:hidden">Projet</span>
      <span
        aria-hidden="true"
        class="inline-block transition-transform duration-[var(--duration-fast)] group-hover:translate-x-1"
        >→</span
      >
    </a>

    <button
      type="button"
      class="menu-trigger relative flex items-center gap-3 justify-self-end text-[12px] tracking-[0.24em] uppercase"
      aria-label="Ouvrir le menu principal"
      aria-expanded="false"
      aria-controls="primary-menu"
      data-menu-trigger
    >
      <span class="hidden sm:inline">Menu</span>
      <span class="menu-bars flex flex-col gap-1.5" aria-hidden="true">
        <span class="block h-px w-6 bg-current transition-transform"></span>
        <span class="block h-px w-6 bg-current transition-transform"></span>
      </span>
    </button>
  </div>
</header>

<style>
  /* Header — refonte DA Jonathan 2026-05-15 : fond noir profond + cream.
     Le --color-ink étant désormais aliasé sur --color-black-deep, on
     est cohérent avec le reste de la home. */
  .site-header {
    background-color: var(--color-black-deep);
    color: var(--color-cream);
    border-bottom: 1px solid color-mix(in oklab, var(--color-cream) 8%, transparent);
    transform: translateY(0);
    transition: transform 0.55s var(--ease-out-editorial);
    will-change: transform;
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  /* Logo — cream sur fond ink (mask inversé via background-color). */
  .site-logo {
    background-color: var(--color-cream);
    -webkit-mask: url('/brand/wordmark-black.png?v=3') center / contain no-repeat;
    mask: url('/brand/wordmark-black.png?v=3') center / contain no-repeat;
  }

  /* CTA pill — refonte v2 2026-05-15 (retour Morgan) : magnetic + dot
     clignotant + halo respirant pour inciter au clic. Fond rouge plein +
     texte cream Inter bold UPPERCASE. */
  .cta-pill {
    position: relative;
    background-color: var(--color-red);
    color: var(--color-cream);
    border: 1px solid var(--color-red);
    font-family: var(--font-heading), sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    transition:
      background-color 0.3s var(--ease-out-editorial),
      border-color 0.3s var(--ease-out-editorial),
      color 0.3s var(--ease-out-editorial),
      box-shadow 0.4s var(--ease-out-editorial);
    will-change: transform, box-shadow;
    /* Halo rouge respirant — pulse douce sur l'extérieur du pill pour
       attirer l'œil sans agresser. Synchronisé avec le dot. */
    animation: cta-pill-halo 2.6s ease-in-out infinite;
  }
  .cta-pill:hover {
    background-color: color-mix(in oklab, var(--color-red) 86%, var(--color-black-deep));
    border-color: color-mix(in oklab, var(--color-red) 86%, var(--color-black-deep));
    /* Le hover renforce le halo (état activé) et fige le pulse interne. */
    box-shadow: 0 0 0 6px color-mix(in oklab, var(--color-red) 32%, transparent);
    animation-play-state: paused;
  }
  @keyframes cta-pill-halo {
    0%,
    100% {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--color-red) 40%, transparent);
    }
    50% {
      box-shadow: 0 0 0 8px color-mix(in oklab, var(--color-red) 0%, transparent);
    }
  }
  /* Dot interne — clignotement signature (pulse opacity + scale). */
  .cta-pill .cta-dot {
    background-color: var(--color-cream);
    transition: transform 0.4s var(--ease-out-editorial);
    animation: cta-pill-dot 1.4s ease-in-out infinite;
  }
  @keyframes cta-pill-dot {
    0%,
    100% {
      opacity: 0.6;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.45);
    }
  }
  .cta-pill:hover .cta-dot {
    transform: scale(1.55);
    opacity: 1;
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-pill,
    .cta-pill .cta-dot {
      animation: none;
    }
  }

  /* Burger ↔ X — animation préservée (refonte 2026-04-24 designbyad). */
  .menu-trigger {
    cursor: pointer;
    padding: 0.4rem 0;
  }
  .menu-bars {
    position: relative;
    height: 9px;
    width: 24px;
    display: inline-block;
  }
  .menu-bars > span {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background-color: currentColor;
    transition:
      transform 0.45s cubic-bezier(0.76, 0, 0.24, 1),
      top 0.45s cubic-bezier(0.76, 0, 0.24, 1),
      bottom 0.45s cubic-bezier(0.76, 0, 0.24, 1),
      width 0.3s var(--ease-out-editorial);
    transform-origin: center;
  }
  .menu-bars > span:first-child {
    top: 0;
  }
  .menu-bars > span:last-child {
    bottom: 0;
  }
  .menu-trigger:hover .menu-bars > span:first-child {
    width: 65%;
    margin-left: auto;
  }
  .menu-trigger:hover .menu-bars > span:last-child {
    width: 85%;
  }
  .menu-trigger[aria-expanded='true'] .menu-bars > span {
    width: 100% !important;
    margin-left: 0;
  }
  .menu-trigger[aria-expanded='true'] .menu-bars > span:first-child {
    top: 4px;
    transform: rotate(45deg);
  }
  .menu-trigger[aria-expanded='true'] .menu-bars > span:last-child {
    bottom: 4px;
    transform: rotate(-45deg);
  }
  .menu-trigger[aria-expanded='true']:hover .menu-bars > span:first-child {
    transform: rotate(45deg) scale(1.1);
  }
  .menu-trigger[aria-expanded='true']:hover .menu-bars > span:last-child {
    transform: rotate(-45deg) scale(1.1);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-logo,
    .menu-trigger .menu-bars > span,
    .cta-pill {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  /*
   * Header auto-hide (refonte 2026-04-30 demande Jonathan) :
   *  - Sur la home (data-dark-hero=true), header caché par défaut tant
   *    qu'on est dans le hero. Réapparaît dès le premier scroll vers le haut.
   *  - Sur autres pages : visible par défaut, hide au scroll-down (au-delà
   *    de 100px), show au scroll-up. Toujours visible si scrollY < 80.
   *  - Anti-bounce : seuil minimal de 6px de delta pour éviter les flickers.
   */
  let headerWired = false;
  let resizeObserver: ResizeObserver | null = null;
  let lastScrollY = 0;
  const HIDE_DELTA_PX = 6;
  const TOP_THRESHOLD_PX = 80;
  const HIDE_THRESHOLD_PX = 100;

  function wireHeaderScroll() {
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (!header) return;

    const isDarkHero = header.dataset.darkHero === 'true';

    if (resizeObserver) resizeObserver.disconnect();
    resizeObserver = new ResizeObserver(() => {
      const h = header.getBoundingClientRect().height;
      document.documentElement.style.setProperty('--header-height', `${h}px`);
    });
    resizeObserver.observe(header);
    document.documentElement.style.setProperty(
      '--header-height',
      `${header.getBoundingClientRect().height}px`,
    );

    if (headerWired) return;
    headerWired = true;
    lastScrollY = window.scrollY;

    const onScroll = () => {
      const y = window.scrollY;
      const delta = y - lastScrollY;
      header.classList.toggle('is-scrolled', y > TOP_THRESHOLD_PX);

      if (Math.abs(delta) < HIDE_DELTA_PX) return;

      if (y < TOP_THRESHOLD_PX) {
        // Tout en haut : caché si darkHero (zone hero), visible sinon.
        header.classList.toggle('is-hidden', isDarkHero);
      } else if (delta > 0 && y > HIDE_THRESHOLD_PX) {
        // Scroll vers le bas : on cache.
        header.classList.add('is-hidden');
      } else if (delta < 0) {
        // Scroll vers le haut : on montre.
        header.classList.remove('is-hidden');
      }

      lastScrollY = y;
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  wireHeaderScroll();
  document.addEventListener('astro:page-load', wireHeaderScroll);
</script>
