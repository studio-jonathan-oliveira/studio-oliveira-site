---
/*
 * Header — refonte DA finale 2026-06-04 (trames « modif finales »).
 *
 * Structure trame (cf. coeur urbain) sur 2 rangées :
 *   1. Grand CTA pleine largeur « Démarrer un projet » = carte BEIGE à coins
 *      arrondis, libellé noir centré. Survol → fond VIOLET. Clic → /demarrer.
 *      (Annotation trame « SURVOL + CLIC TOP BARRE ».)
 *   2. Juste dessous : logo `oliveira` à gauche + « MENU » + burger à droite.
 *
 * Fond beige, texte/logo noir. Auto-hide au scroll conservé (script bas).
 * Le bouton `data-menu-trigger` est préservé tel quel pour le menu overlay.
 */

interface Props {
  darkHero?: boolean;
}
const { darkHero = false } = Astro.props;
---

<header
  class:list={[
    'site-header fixed top-0 right-0 left-0 z-40',
    darkHero && 'site-header--dark-hero',
    darkHero && 'is-hidden',
  ]}
  data-header
  data-theme="light"
  data-dark-hero={darkHero ? 'true' : 'false'}
>
  {/* Rangée 1 — gros CTA « Démarrer un projet » pleine largeur */}
  <a
    href="/demarrer-un-projet"
    class="site-header__cta"
    data-cursor-skip
    aria-label="Démarrer un projet"
  >
    <span class="site-header__cta-label">Démarrer un projet</span>
  </a>

  {/* Rangée 2 — logo flush-left · MENU flush-right */}
  <div class="site-header__bar">
    <a
      href="/"
      class="logo-swap relative flex shrink-0 items-center"
      aria-label="Studio J Oliveira — accueil"
      data-header-logo
    >
      <span class="site-logo block" aria-hidden="true"></span>
      <span class="sr-only">Studio J Oliveira</span>
    </a>

    <button
      type="button"
      class="menu-trigger relative flex items-center gap-3"
      aria-label="Ouvrir le menu principal"
      aria-expanded="false"
      aria-controls="primary-menu"
      data-menu-trigger
    >
      <span class="menu-trigger__label">Menu</span>
      <span class="menu-bars flex flex-col gap-1.5" aria-hidden="true">
        <span class="block h-px w-6 bg-current transition-transform"></span>
        <span class="block h-px w-6 bg-current transition-transform"></span>
      </span>
    </button>
  </div>
</header>

<style>
  /* Header beige sitewide (DA finale). */
  /* Conteneur TRANSPARENT (trame) : la topbar beige arrondie ne couvre QUE le
     CTA « Démarrer un projet » ; la rangée logo + MENU passe juste dessous sur
     fond transparent. */
  .site-header {
    color: var(--color-ink);
    background-color: transparent;
    transform: translateY(0);
    transition: transform 0.55s var(--ease-out-editorial);
    will-change: transform;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(0.5rem, 1vw, 1rem);
  }
  .site-header.is-hidden {
    transform: translateY(calc(-100% - 1.5rem));
  }

  /* Rangée 1 — gros CTA pleine largeur (bord à bord), libellé centré.
     Repos : beige. Survol → NOIR (libellé cream). Clic/actif → VIOLET.
     Plus haute / plus grosse (retour Morgan 2026-06-04). */
  /* Carte beige arrondie + liseré périphérique (trame) : la topbar S'ARRÊTE
     ici, elle ne contient QUE le CTA. Inset via marge (top + côtés). */
  .site-header__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: clamp(0.5rem, 1.1vw, 0.9rem) clamp(0.5rem, 1.1vw, 0.9rem) 0;
    padding: clamp(1.3rem, 2.6vw, 2.4rem);
    border: 1px solid color-mix(in oklab, var(--color-ink) 16%, transparent);
    border-radius: clamp(16px, 1.8vw, 26px);
    text-decoration: none;
    color: var(--color-ink);
    background-color: var(--color-cream);
    transition:
      background-color 0.35s var(--ease-out-editorial),
      color 0.35s var(--ease-out-editorial);
  }
  .site-header__cta-label {
    font-family: var(--font-heading), sans-serif;
    font-weight: 700;
    font-size: clamp(1.1rem, 1.7vw, 1.6rem);
    letter-spacing: 0;
    color: inherit;
  }
  @media (hover: hover) {
    .site-header__cta:hover {
      background-color: var(--color-ink);
      color: var(--color-cream);
    }
  }
  .site-header__cta:focus-visible {
    background-color: var(--color-ink);
    color: var(--color-cream);
  }
  /* Survol ET clic : NOIR (plus de mauve au clic — Morgan 2026-06-05). */
  .site-header__cta:active {
    background-color: var(--color-ink);
    color: var(--color-cream);
  }

  /* Rangée 2 — logo gauche · MENU droite (avec marge latérale propre) */
  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0 clamp(1rem, 3vw, 2.5rem);
  }
  .site-logo {
    height: clamp(28px, 3vw, 40px);
    width: clamp(130px, 13vw, 175px);
    background-color: var(--color-ink);
    -webkit-mask: url('/brand/wordmark-black.png?v=3') left center / contain no-repeat;
    mask: url('/brand/wordmark-black.png?v=3') left center / contain no-repeat;
    transition: background-color 0.35s var(--ease-out-editorial);
  }

  /* Topbar par-dessus le hero sombre de la home (scroll-up dans la zone hero) :
     le logo + MENU passeraient en ink (noir) sur la photo sombre → invisibles.
     On les force en crème tant que la topbar surplombe le hero (toggle JS
     `is-over-hero`). Morgan 2026-06-05. */
  .site-header.is-over-hero {
    color: var(--color-cream);
  }
  .site-header.is-over-hero .site-logo {
    background-color: var(--color-cream);
  }
  .site-header.is-over-hero .menu-trigger {
    color: var(--color-cream);
  }

  /* Burger ↔ X — animation préservée (designbyad). */
  .menu-trigger {
    cursor: pointer;
    padding: 0.4rem 0;
    color: var(--color-ink);
  }
  /* « Menu » plus visible (Morgan 2026-06-05) : grossi, gras, casse normale
     (M maj + reste minuscule), plus de tracking eyebrow ni uppercase. */
  .menu-trigger__label {
    font-family: var(--font-heading), sans-serif;
    font-size: clamp(15px, 1.25vw, 19px);
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
  }
  .menu-bars {
    position: relative;
    height: 9px;
    width: 24px;
    display: inline-block;
  }
  .menu-bars > span {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background-color: currentColor;
    transition:
      transform 0.45s cubic-bezier(0.76, 0, 0.24, 1),
      top 0.45s cubic-bezier(0.76, 0, 0.24, 1),
      bottom 0.45s cubic-bezier(0.76, 0, 0.24, 1),
      width 0.3s var(--ease-out-editorial);
    transform-origin: center;
  }
  .menu-bars > span:first-child {
    top: 0;
  }
  .menu-bars > span:last-child {
    bottom: 0;
  }
  .menu-trigger:hover .menu-bars > span:first-child {
    width: 65%;
    margin-left: auto;
  }
  .menu-trigger:hover .menu-bars > span:last-child {
    width: 85%;
  }
  .menu-trigger[aria-expanded='true'] .menu-bars > span {
    width: 100% !important;
    margin-left: 0;
  }
  .menu-trigger[aria-expanded='true'] .menu-bars > span:first-child {
    top: 4px;
    transform: rotate(45deg);
  }
  .menu-trigger[aria-expanded='true'] .menu-bars > span:last-child {
    bottom: 4px;
    transform: rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-logo,
    .menu-trigger .menu-bars > span {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  /*
   * Header auto-hide (conservé) :
   *  - Home (data-dark-hero=true) : caché tant qu'on est dans le hero,
   *    réapparaît au scroll vers le haut.
   *  - Autres pages : visible, hide au scroll-down, show au scroll-up.
   */
  let headerWired = false;
  let resizeObserver: ResizeObserver | null = null;
  let lastScrollY = 0;
  const HIDE_DELTA_PX = 6;
  const TOP_THRESHOLD_PX = 80;
  const HIDE_THRESHOLD_PX = 100;

  function wireHeaderScroll() {
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (!header) return;

    const isDarkHero = header.dataset.darkHero === 'true';

    if (resizeObserver) resizeObserver.disconnect();
    resizeObserver = new ResizeObserver(() => {
      const h = header.getBoundingClientRect().height;
      document.documentElement.style.setProperty('--header-height', `${h}px`);
    });
    resizeObserver.observe(header);
    document.documentElement.style.setProperty(
      '--header-height',
      `${header.getBoundingClientRect().height}px`,
    );

    if (headerWired) return;
    headerWired = true;
    lastScrollY = window.scrollY;

    const onScroll = () => {
      const y = window.scrollY;
      const delta = y - lastScrollY;
      header.classList.toggle('is-scrolled', y > TOP_THRESHOLD_PX);

      // Home : la topbar surplombe le hero sticky (100vh) tant qu'on n'a pas
      // scrollé au-delà ; on bascule logo + MENU en crème dans cette zone.
      if (isDarkHero) {
        header.classList.toggle('is-over-hero', y < window.innerHeight - header.offsetHeight);
      }

      if (Math.abs(delta) < HIDE_DELTA_PX) return;

      if (y < TOP_THRESHOLD_PX) {
        header.classList.toggle('is-hidden', isDarkHero);
      } else if (delta > 0 && y > HIDE_THRESHOLD_PX) {
        header.classList.add('is-hidden');
      } else if (delta < 0) {
        header.classList.remove('is-hidden');
      }

      lastScrollY = y;
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  wireHeaderScroll();
  document.addEventListener('astro:page-load', wireHeaderScroll);
</script>
