---
/*
 * <TypologieHero> — hero partagé des 4 pages /architecture-paysagere/[typologie].
 *
 * Refonte DA finale 2026-06-04 (trames « modif finales » Jonathan) :
 *   - PLUS DE PHOTO. Fond BEIGE uni (--color-cream = #EDE6D6), texte NOIR.
 *   - H1 typographique ÉNORME en bas-gauche, sur 2 lignes, graisse Black,
 *     casse mixte (« Coeur » / « urbain » : capitale initiale ligne 1
 *     seulement). Annotation trame : « LE TITRE RESTE FIXE, PAS D'ANIMATION ».
 *   - Specs (4 lignes label/valeur) sous le H1, fond beige, texte noir,
 *     séparateur fin sous chaque rangée.
 *
 * Les 4 LABELS sont FIGÉS (taxonomie commune). Seules les valeurs changent.
 * Correctif trame : label 3 = « Type de jardin / propriété » (était
 * « Contexte environnemental »).
 *
 * API :
 *   - h1Lines ([string, string]) : 2 lignes du H1 (ex: ['Coeur', 'urbain'])
 *   - valeurs ([string, string, string, string]) : 4 valeurs droite
 *   - sectionLabel (string, opt) : étiquette `data-section-label`
 *
 * NB : la prop `photo`/`alt` historique est supprimée (plus de photo hero).
 */
interface Props {
  h1Lines: readonly [string, string];
  valeurs: readonly [string, string, string, string];
  sectionLabel?: string;
  /* Props historiques tolérées pour rétro-compat le temps de porter les 3
     autres typologies à la DA finale (hero sans photo). Ignorées. */
  photo?: ImageMetadata;
  alt?: string;
  photoPosition?: string;
}

const { h1Lines, valeurs, sectionLabel } = Astro.props;

// Taxonomie figée du studio — ne pas paramétrer. Label 3 corrigé (trame).
const LABELS = [
  'Secteur géographique',
  'Moyenne surface jardin',
  'Type de jardin / propriété',
  'Complexité spatiale et environnementale',
] as const;
---

<section
  id="hero"
  data-section-label={sectionLabel ?? h1Lines.join(' ')}
  data-theme="light"
  class="typo-hero"
  aria-labelledby="hero-title"
>
  <h1 id="hero-title" class="typo-hero__title">
    <span class="typo-hero__title-line">{h1Lines[0]}</span>
    <span class="typo-hero__title-line">{h1Lines[1]}</span>
  </h1>
</section>

<section data-theme="light" class="typo-hero-specs" aria-label="Caractéristiques typologie">
  <dl class="typo-hero-specs__list">
    {
      LABELS.map((label, i) => (
        <div class="typo-hero-specs__row">
          <dt class="typo-hero-specs__label">{label}</dt>
          <dd class="typo-hero-specs__value">{valeurs[i]}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  /* Hero typographique beige — le H1 occupe ~1 écran (cf. traits rouges
     gabarit 1920×1080 sur la trame), posé bas-gauche, fixe (pas d'anim). */
  .typo-hero {
    position: relative;
    width: 100%;
    min-height: 100svh;
    background-color: var(--color-cream);
    color: var(--color-ink);
    display: flex;
    align-items: flex-end;
    box-sizing: border-box;
    padding: clamp(2rem, 6vh, 5rem) clamp(1.5rem, 4vw, 4rem) clamp(3rem, 8vh, 6rem);
  }
  .typo-hero__title {
    margin: 0;
    display: flex;
    flex-direction: column;
    color: var(--color-ink);
  }
  .typo-hero__title-line {
    display: block;
    font-family: var(--font-heading), sans-serif;
    font-weight: 900;
    font-size: clamp(3rem, 13vw, 14rem);
    /* line-height 0.9 → 0.96 : évite que le descendant du « g » (Frange) heurte
       la ligne du dessous (Morgan 2026-06-05). */
    line-height: 0.96;
    letter-spacing: -0.02em;
    /* DA finale = casse normale (annule l'uppercase global h1-h4). */
    text-transform: none;
  }

  /* Specs — sous le hero, fond beige, 4 lignes label↔valeur, séparateur
     fin sous chaque rangée. */
  /* Section full-bleed : pas de padding horizontal → le trait de chaque
     ligne touche le BORD GAUCHE de l'écran (bord à bord). */
  .typo-hero-specs {
    width: 100%;
    background-color: var(--color-cream);
    color: var(--color-ink);
    padding: clamp(2rem, 5vh, 4rem) 0 clamp(3rem, 7vh, 5rem);
    box-sizing: border-box;
  }
  .typo-hero-specs__list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  /* Chaque rangée = trait bas pleine largeur (bord gauche écran) qui FINIT
     EN COURBE VERS LE HAUT à droite (border-right + radius bas-droite),
     cf. trame Jonathan. Le texte est repoussé du bord par le padding inline. */
  .typo-hero-specs__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: clamp(2rem, 6vw, 6rem);
    width: 100%;
    /* Police + interlignes agrandis (Morgan 2026-06-05 : même rapport
       hauteur/largeur que les trames). Épaisseur liseret + courbure via tokens. */
    padding: clamp(1.2rem, 2.2vw, 1.9rem) clamp(1.5rem, 4vw, 4rem);
    border-bottom: var(--stroke-liseret) solid
      color-mix(in oklab, var(--color-ink) 22%, transparent);
    border-right: var(--stroke-liseret) solid color-mix(in oklab, var(--color-ink) 22%, transparent);
    border-bottom-right-radius: var(--radius-liseret);
  }
  .typo-hero-specs__label,
  .typo-hero-specs__value {
    font-family: var(--font-body), sans-serif;
    font-weight: 400;
    font-size: clamp(1.05rem, 1.5vw, 1.65rem);
    line-height: 1.3;
    letter-spacing: 0.005em;
    color: var(--color-ink);
    margin: 0;
    flex: 0 1 auto;
  }
  .typo-hero-specs__label {
    text-align: left;
    color: color-mix(in oklab, var(--color-ink) 85%, transparent);
  }
  .typo-hero-specs__value {
    text-align: right;
  }
  @media (max-width: 767px) {
    .typo-hero-specs__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.15rem;
    }
    .typo-hero-specs__value {
      text-align: left;
    }
  }
</style>
