---
/*
 * <TypologieHero> — hero partagé des 4 pages /architecture-paysagere/[typologie].
 *
 * Pattern validé Morgan 2026-05-19 v3 (synthèse trame originale +
 * retours successifs) :
 *   - Photo plein-bleed 100svh + voile gradient DOUBLE (haut pour H1,
 *     bas pour specs) avec milieu transparent
 *   - H1 split 2 lignes posé HAUT-GAUCHE (ExtraLight 200 UPPERCASE)
 *   - 4 specs en BAS du hero, séparées du reste de la photo par un trait
 *     blanc horizontal pleine largeur (border-top cream 35% alpha)
 *   - Chaque ligne specs en flex `space-between` (label gauche, valeur
 *     collée au bord droit, photo visible entre) — PAS un grid 2-colonnes
 *     resserré (trame Jonathan : les valeurs sont aussi loin que possible
 *     à droite, pas centrées)
 *   - Mobile <768px : passage colonne (label/valeur empilés)
 *
 * Les 4 LABELS sont FIGÉS (taxonomie commune aux 4 typologies). Seules les
 * valeurs droite changent par typologie.
 *
 * API minimale :
 *   - photo (ImageMetadata) : image hero
 *   - alt (string) : alt descriptif SEO
 *   - h1Lines ([string, string]) : 2 lignes du H1 split (ex: ['MICRO', 'URBAIN'])
 *   - valeurs ([string, string, string, string]) : 4 valeurs droite, dans l'ordre
 *     des labels figés (secteur / surface / contexte / complexité)
 *   - sectionLabel (string, optionnel) : étiquette `data-section-label`
 */
import { Image } from 'astro:assets';

interface Props {
  photo: ImageMetadata;
  alt: string;
  h1Lines: readonly [string, string];
  valeurs: readonly [string, string, string, string];
  sectionLabel?: string;
}

const { photo, alt, h1Lines, valeurs, sectionLabel } = Astro.props;

// Les 4 labels sont la taxonomie figée du studio — ne pas paramétrer.
const LABELS = [
  'Secteur géographique',
  'Moyenne surface jardin',
  'Contexte environnemental',
  'Complexité spatiale et environnementale',
] as const;
---

<section
  id="hero"
  data-section-label={sectionLabel ?? h1Lines.join(' ')}
  data-theme="dark"
  class="typo-hero relative overflow-hidden bg-[var(--color-black-deep)] text-[var(--color-cream)]"
  aria-labelledby="hero-title"
>
  <div class="typo-hero__media">
    <Image
      src={photo}
      alt={alt}
      widths={[960, 1440, 1920, 2560]}
      sizes="100vw"
      quality={92}
      format="webp"
      loading="eager"
      class="typo-hero__img"
    />
    <div class="typo-hero__veil" aria-hidden="true"></div>
  </div>

  <div class="typo-hero__overlay">
    <div class="typo-hero__top">
      <h1 id="hero-title" class="typo-hero__title">
        <span class="typo-hero__title-line">{h1Lines[0]}</span>
        <span class="typo-hero__title-line">{h1Lines[1]}</span>
      </h1>
    </div>

    <div class="typo-hero__bottom">
      <dl class="typo-hero__specs" aria-label="Caractéristiques typologie">
        {
          LABELS.map((label, i) => (
            <div class="typo-hero__spec-row">
              <dt class="typo-hero__spec-label">{label}</dt>
              <dd class="typo-hero__spec-value">{valeurs[i]}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .typo-hero {
    position: relative;
    width: 100%;
    min-height: 100svh;
    isolation: isolate;
  }
  .typo-hero__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .typo-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  /* Voile gradient DOUBLE — assombrit HAUT (zone H1) + BAS (zone specs),
     transparent au milieu. Garantit la lisibilité du H1 en haut ET des
     specs en bas du hero sans rogner la zone visuelle centrale. */
  .typo-hero__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--color-black-deep) 72%, transparent) 0%,
      color-mix(in oklab, var(--color-black-deep) 30%, transparent) 22%,
      transparent 45%,
      transparent 58%,
      color-mix(in oklab, var(--color-black-deep) 35%, transparent) 80%,
      color-mix(in oklab, var(--color-black-deep) 78%, transparent) 100%
    );
    pointer-events: none;
  }
  /* Overlay = bloc HAUT (H1) + bloc BAS (specs) avec espace au milieu
     pour laisser respirer la photo. `justify-content: space-between`
     pousse les 2 blocs aux extrémités du hero (100svh). */
  .typo-hero__overlay {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(5.5rem, 12vh, 8rem) clamp(1.5rem, 5vw, 4rem) clamp(2rem, 5vw, 3.5rem);
  }
  .typo-hero__top,
  .typo-hero__bottom {
    width: 100%;
  }
  .typo-hero__title {
    font-family: var(--font-heading), sans-serif;
    font-weight: 200;
    font-size: clamp(2.6rem, 9vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    color: var(--color-cream);
    margin: 0;
    max-width: none;
  }
  .typo-hero__title-line {
    display: block;
  }
  /* Specs en bas du hero — trait blanc horizontal pleine largeur au-dessus
     (border-top cream 35% alpha, conformément à la trame Jonathan). Chaque
     ligne s'étire pleine largeur avec label collé à gauche / valeur collée
     à droite (flex space-between) pour reproduire la respiration du design
     trame (les valeurs vont jusqu'au bord droit, pas centrées). */
  .typo-hero__specs {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(0.55rem, 1.1vw, 1rem);
    padding-top: clamp(1.25rem, 2.5vw, 1.75rem);
    border-top: 1px solid color-mix(in oklab, var(--color-cream) 40%, transparent);
  }
  .typo-hero__spec-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: clamp(2rem, 6vw, 6rem);
    width: 100%;
  }
  .typo-hero__spec-label {
    font-family: var(--font-body), sans-serif;
    font-weight: 300;
    font-size: clamp(0.82rem, 1vw, 1rem);
    line-height: 1.35;
    color: var(--color-cream);
    margin: 0;
    text-align: left;
    flex: 0 1 auto;
  }
  .typo-hero__spec-value {
    font-family: var(--font-body), sans-serif;
    font-weight: 400;
    font-size: clamp(0.82rem, 1vw, 1rem);
    line-height: 1.35;
    color: var(--color-cream);
    text-align: right;
    margin: 0;
    flex: 0 1 auto;
  }
  @media (max-width: 767px) {
    .typo-hero__spec-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.15rem;
    }
    .typo-hero__spec-value {
      text-align: left;
    }
  }
</style>
