---
/*
 * Lightbox — animation sitewide « flou au survol + clic agrandissement »
 * (trames « modif finales » : annotations « FLOU AU SURVOL + CLIC
 * AGRANDISSEMENT » / « AGRANDISSEMENT DE L'IMAGE »).
 *
 * Usage dans une page : entourer chaque visuel zoomable d'un bouton
 *   <button class="zoom-card" data-zoom-src={img.src} data-zoom-alt="…">
 *     <Image … class="zoom-card__img" />
 *     <span class="zoom-card__pill">Agrandir</span>
 *   </button>
 * → survol : image floutée + pastille « Agrandir » ; clic : overlay plein
 *   écran avec l'image agrandie (coins arrondis) + bouton ×.
 *
 * MODE « Approche projet » (trame accordeon-etude-et-conception, annotation
 * « AGRANDISSEMENT DE L'IMAGE » + « TEXTE + CADRE AIMANTÉ AU CURSEUR ») :
 * si la carte porte data-zoom-approche="…", la lightbox superpose une carte
 * beige « Approche projet » (titre noir bold + corps justifié) AIMANTÉE au
 * curseur (léger parallax magnétique). Les paragraphes du corps sont séparés
 * par « \n\n » dans l'attribut. Sans cet attribut → image seule (réalisations,
 * galerie studio, autres galeries sitewide).
 *
 * Ce composant rend l'overlay (une fois) + le CSS global + le script de
 * délégation. À inclure une seule fois (BaseLayout).
 */
---

<div class="lightbox" id="lightbox" aria-hidden="true" data-theme="dark" data-lightbox>
  <button
    class="lightbox__close"
    type="button"
    aria-label="Fermer l'agrandissement"
    data-lightbox-close
  >
    <span aria-hidden="true">×</span>
  </button>
  <figure class="lightbox__figure" data-lightbox-figure>
    <img class="lightbox__img" id="lightbox-img" alt="" data-lightbox-img />
    {/* Carte « Approche projet » — affichée seulement en mode conception. */}
    <div class="lightbox__approche" data-lightbox-approche hidden aria-hidden="true">
      <p class="lightbox__approche-title">Approche projet</p>
      <div class="lightbox__approche-body" data-lightbox-approche-body></div>
    </div>
  </figure>
</div>

<style is:global>
  /* ── Carte zoomable : flou au survol + pastille « Agrandir » ──────────── */
  .zoom-card {
    appearance: none;
    border: 0;
    margin: 0;
    padding: 0;
    background: transparent;
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-image);
    cursor: pointer;
  }
  .zoom-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: filter 0.4s var(--ease-out-editorial, ease);
  }
  .zoom-card__pill {
    position: absolute;
    top: clamp(0.6rem, 1.2vw, 1rem);
    right: clamp(0.6rem, 1.2vw, 1rem);
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    background-color: var(--color-cream);
    color: var(--color-ink);
    border-radius: 9999px;
    font-family: var(--font-heading), sans-serif;
    font-weight: 700;
    font-size: clamp(0.8rem, 1vw, 0.95rem);
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.35s var(--ease-out-editorial, ease),
      transform 0.35s var(--ease-out-editorial, ease);
    pointer-events: none;
  }
  @media (hover: hover) {
    .zoom-card:hover .zoom-card__img,
    .zoom-card:focus-visible .zoom-card__img {
      /* Flou renforcé, sans assombrissement ni zoom (Morgan 2026-06-05). */
      filter: blur(18px);
    }
    .zoom-card:hover .zoom-card__pill,
    .zoom-card:focus-visible .zoom-card__pill {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Overlay lightbox ─────────────────────────────────────────────────── */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 5vw, 5rem);
    background-color: color-mix(in oklab, var(--color-ink) 88%, transparent);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.4s var(--ease-out-editorial, ease),
      visibility 0.4s;
  }
  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
  }
  /* Fermeture (FLIP inverse) : on garde l'overlay visible et l'image opaque
     pendant qu'elle rétrécit vers sa vignette ; seul le FOND sombre se dissipe
     (background transparent), + la carte approche et le × disparaissent. */
  .lightbox.is-closing {
    background-color: transparent;
    transition: background-color 0.6s var(--ease-out-editorial, ease);
  }
  .lightbox.is-closing .lightbox__approche,
  .lightbox.is-closing .lightbox__close {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  /* Figure = conteneur relatif pour aimanter la carte « Approche projet »
     sur l'image. En mode image seule, se comporte comme l'ancien <img>. */
  .lightbox__figure {
    position: relative;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: min(92vw, 1400px);
    max-height: 86vh;
  }
  .lightbox__img {
    max-width: 100%;
    max-height: 86vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: clamp(14px, 1.6vw, 24px);
    /* L'ouverture est animée en FLIP (JS) : l'image part de la position/échelle
       de la carte cliquée et grandit jusqu'au plein écran. transform-origin
       haut-gauche pour que le calcul invert/play soit exact. */
    transform-origin: top left;
    will-change: transform;
    backface-visibility: hidden;
  }

  /* ── Carte « Approche projet » (mode conception) ─────────────────────── */
  /* Fond beige, texte noir. Elle SUIT LE CURSEUR (annotation trame « TEXTE +
     CADRE AIMANTÉ AU CURSEUR »), comme le cursor-tooltip des cartes typologies
     sur la home : position fixed pilotée par --lb-x / --lb-y (lerp en JS).
     pointer-events none → le clic sur le fond ferme toujours la lightbox. */
  .lightbox__approche {
    position: fixed;
    left: 0;
    top: 0;
    width: min(38ch, 80vw);
    box-sizing: border-box;
    padding: clamp(1rem, 1.6vw, 1.6rem) clamp(1.1rem, 1.8vw, 1.8rem);
    background-color: var(--color-cream);
    color: var(--color-ink);
    border-radius: clamp(14px, 1.2vw, 20px);
    box-shadow: 0 18px 50px color-mix(in oklab, var(--color-ink) 45%, transparent);
    pointer-events: none;
    z-index: 210;
    opacity: 0;
    transform: translate3d(var(--lb-x, 0px), var(--lb-y, 0px), 0);
    /* Seule l'opacité est animée — la position est pilotée image par image
       (rAF), pas par une transition CSS qui lutterait avec le lerp. */
    transition: opacity 0.45s var(--ease-out-editorial, ease);
    will-change: transform;
  }
  .lightbox.is-open .lightbox__approche {
    opacity: 1;
  }
  .lightbox__approche-title {
    margin: 0 0 0.7em;
    font-family: var(--font-heading), sans-serif;
    font-weight: 700;
    font-size: clamp(1rem, 1.3vw, 1.4rem);
    letter-spacing: 0.01em;
    word-spacing: 0.12em;
    line-height: 1.1;
  }
  .lightbox__approche-body {
    font-family: var(--font-body), sans-serif;
    font-weight: 300;
    font-size: clamp(0.78rem, 0.92vw, 0.95rem);
    line-height: 1.6;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    white-space: pre-line; /* « \n\n » → saut de paragraphe */
    color: color-mix(in oklab, var(--color-ink) 92%, transparent);
  }

  /* Sous le seuil tablette : la carte passe en bas, pleine largeur, statique
     (l'aimantation et la superposition n'ont pas de sens sur petit écran). */
  @media (max-width: 767px) {
    .lightbox__figure {
      flex-direction: column;
      max-height: none;
    }
    .lightbox__approche {
      position: static;
      width: 100%;
      transform: none;
      margin-top: 0.9rem;
      opacity: 1;
    }
    .lightbox__img {
      max-height: 62vh;
    }
  }

  .lightbox__close {
    position: absolute;
    top: clamp(1rem, 3vw, 2.5rem);
    right: clamp(1rem, 3vw, 2.5rem);
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--color-cream);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    z-index: 2;
  }
  @media (prefers-reduced-motion: reduce) {
    .zoom-card__img,
    .zoom-card__pill,
    .lightbox,
    .lightbox__img,
    .lightbox__approche {
      transition: none;
    }
  }
</style>

<script>
  function initLightbox() {
    const overlay = document.querySelector<HTMLElement>('[data-lightbox]');
    const img = document.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const figure = document.querySelector<HTMLElement>('[data-lightbox-figure]');
    const approche = document.querySelector<HTMLElement>('[data-lightbox-approche]');
    const approcheBody = document.querySelector<HTMLElement>('[data-lightbox-approche-body]');
    if (!overlay || !img || !figure || !approche || !approcheBody) return;

    const fine = window.matchMedia('(pointer: fine)').matches;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Carte d'origine du clic — mémorisée pour rejouer le FLIP À L'ENVERS à la
    // fermeture (l'image rétrécit vers sa vignette dans la galerie).
    let originCard: HTMLElement | null = null;
    let closing = false;

    // ── Carte « Approche projet » qui SUIT LE CURSEUR (annotation trame
    // « CADRE AIMANTÉ AU CURSEUR »), comme le cursor-tooltip des typologies
    // home. Position fixed pilotée par --lb-x / --lb-y (lerp en rAF), placée
    // en haut-droite du pointeur et clampée dans le viewport. ───────────────
    let tx = 0,
      ty = 0,
      cx = 0,
      cy = 0,
      rafId = 0,
      following = false,
      snap = false;
    const OFFX = 26;
    const OFFY = 22;
    const M = 14;

    const followLoop = () => {
      cx += (tx - cx) * 0.18;
      cy += (ty - cy) * 0.18;
      approche.style.setProperty('--lb-x', `${cx.toFixed(2)}px`);
      approche.style.setProperty('--lb-y', `${cy.toFixed(2)}px`);
      if (following) rafId = requestAnimationFrame(followLoop);
    };
    const onFollowMove = (e: PointerEvent) => {
      const w = approche.offsetWidth;
      const h = approche.offsetHeight;
      let x = e.clientX + OFFX;
      let y = e.clientY - h - OFFY; // au-dessus-droite du curseur
      if (x + w > window.innerWidth - M) x = e.clientX - w - OFFX;
      if (y < M) y = e.clientY + OFFY;
      x = Math.max(M, Math.min(x, window.innerWidth - w - M));
      y = Math.max(M, Math.min(y, window.innerHeight - h - M));
      tx = x;
      ty = y;
      if (snap) {
        cx = tx;
        cy = ty;
        snap = false;
      }
    };
    const startFollow = () => {
      if (following || !fine) return;
      following = true;
      snap = true;
      window.addEventListener('pointermove', onFollowMove);
      rafId = requestAnimationFrame(followLoop);
    };
    const stopFollow = () => {
      following = false;
      cancelAnimationFrame(rafId);
      window.removeEventListener('pointermove', onFollowMove);
    };

    // ── FLIP : l'image part de la position/échelle de la carte cliquée et
    // grandit jusqu'au plein écran (ouverture fluide, pas brute). ───────────
    const playFlip = (cardRect: DOMRect) => {
      if (reduce) return;
      const last = img.getBoundingClientRect();
      if (!last.width || !last.height) return;
      const dx = cardRect.left - last.left;
      const dy = cardRect.top - last.top;
      const sx = cardRect.width / last.width;
      const sy = cardRect.height / last.height;
      img.style.transition = 'none';
      img.style.transform = `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})`;
      void img.offsetWidth; // reflow
      // Ouverture ralentie (Morgan 2026-06-08 : « plus lent l'animation »).
      img.style.transition = 'transform 0.8s var(--ease-out-editorial, ease)';
      img.style.transform = 'translate(0, 0) scale(1)';
    };

    const open = (
      src: string,
      alt: string,
      approcheText: string | undefined,
      cardRect: DOMRect,
    ) => {
      img.alt = alt;
      const run = () => {
        overlay.classList.add('is-open');
        overlay.setAttribute('aria-hidden', 'false');
        // Verrou du scroll SANS décalage : on compense la largeur de la
        // scrollbar par un padding-right équivalent (sinon toute la page saute
        // quand la scrollbar disparaît/réapparaît — saccade signalée Morgan).
        const sw = window.innerWidth - document.documentElement.clientWidth;
        document.documentElement.style.overflow = 'hidden';
        if (sw > 0) document.documentElement.style.paddingRight = `${sw}px`;
        if (approcheText) {
          approcheBody.textContent = approcheText;
          approche.hidden = false;
          approche.setAttribute('aria-hidden', 'false');
          startFollow();
        } else {
          approche.hidden = true;
          approche.setAttribute('aria-hidden', 'true');
          stopFollow();
        }
        // FLIP après application du layout (image à sa taille finale).
        requestAnimationFrame(() => playFlip(cardRect));
      };
      // L'image doit être chargée pour mesurer sa taille finale (FLIP).
      if (img.getAttribute('src') === src && img.complete) {
        run();
      } else {
        img.onload = () => {
          img.onload = null;
          run();
        };
        img.src = src;
        if (img.complete) {
          img.onload = null;
          run();
        }
      }
    };
    const hardClose = () => {
      // Masquage INSTANTANÉ de l'overlay (transition coupée) : l'image vient de
      // rejoindre sa vignette, on évite que le reset de transform / le retour du
      // fond sombre soient visibles (= la saccade de fin signalée par Morgan).
      overlay.style.transition = 'none';
      overlay.classList.remove('is-open', 'is-closing');
      void overlay.offsetWidth; // applique le masquage avant de réactiver la transition
      overlay.style.transition = '';
      overlay.setAttribute('aria-hidden', 'true');
      document.documentElement.style.overflow = '';
      document.documentElement.style.paddingRight = '';
      stopFollow();
      img.style.transition = '';
      img.style.transform = '';
      originCard = null;
      closing = false;
    };
    // Fermeture : FLIP À L'ENVERS — l'image rétrécit vers sa vignette d'origine
    // (Morgan 2026-06-08 : « qu'on voie l'image réduire pour se repositionner
    // dans la galerie »). Le fond se dissipe pendant que l'image rejoint sa carte.
    const close = () => {
      if (closing) return;
      const last = img.getBoundingClientRect();
      const target = originCard?.getBoundingClientRect();
      if (reduce || !target || !last.width || !target.width) {
        hardClose();
        return;
      }
      closing = true;
      overlay.classList.add('is-closing');
      stopFollow();
      const dx = target.left - last.left;
      const dy = target.top - last.top;
      const sx = target.width / last.width;
      const sy = target.height / last.height;
      img.style.transition = 'transform 0.8s var(--ease-out-editorial, ease)';
      img.style.transform = `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})`;
      let done = false;
      const finish = () => {
        if (done) return;
        done = true;
        img.removeEventListener('transitionend', finish);
        hardClose();
      };
      img.addEventListener('transitionend', finish);
      window.setTimeout(finish, 950); // filet de sécurité si transitionend manque
    };

    // Délégation : clic sur toute carte [data-zoom-src].
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const card = target?.closest?.('[data-zoom-src]') as HTMLElement | null;
      if (card) {
        e.preventDefault();
        const src = card.dataset.zoomSrc;
        if (src) {
          originCard = card;
          open(
            src,
            card.dataset.zoomAlt || '',
            card.dataset.zoomApproche,
            card.getBoundingClientRect(),
          );
        }
        return;
      }
      // Le clic sur la carte « Approche projet » (pointer-events: none) tombe
      // sur l'overlay → ferme, comme tout clic hors image/×.
      if (target?.closest?.('[data-lightbox-close]') || target === overlay) {
        close();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay.classList.contains('is-open')) close();
    });
  }

  initLightbox();
  document.addEventListener('astro:page-load', initLightbox);
</script>
