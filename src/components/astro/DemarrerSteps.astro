---
/*
 * <DemarrerSteps> — bloc unique englobant les 2 étapes "L'APPEL DE …"
 * (qualification + validation).
 *
 * Pattern (trame Jonathan 2026-05-22, fix Morgan 2026-05-22 soir) :
 *   - UNE seule photo aside, à gauche, en long sur toute la hauteur
 *     verticale des 2 étapes combinées (sticky desktop, ratio mobile)
 *   - 2 étapes empilées à droite (eyebrow + titre oversized + accordéons)
 *   - Fond ink, texte cream, accordéons single-open via FaqAccordion
 *
 * Refactor de l'ancienne `<DemarrerStep>` qui dupliquait la photo entre
 * qualif et valid → effet 2 photos visibles, contraire à la trame qui
 * montre UNE photo unique full-height.
 */
import { Image } from 'astro:assets';
import FaqAccordion, { type FaqItem } from '@/components/islands/FaqAccordion';
import asideImg from '@/assets/demarrer-un-projet/02-aside.jpg';

export interface Step {
  id: string;
  eyebrow: string;
  title: string;
  sectionLabel: string;
  accordions: ReadonlyArray<FaqItem>;
}

interface Props {
  steps: readonly [Step, Step];
}

const { steps } = Astro.props;
---

<section data-theme="dark" class="dem-steps" aria-label="Parcours en 2 temps">
  <div class="dem-steps__inner">
    <aside class="dem-steps__aside" aria-hidden="true">
      {/* Photo décorative pure (l'aside parent est aria-hidden). */}
      <Image
        src={asideImg}
        alt=""
        widths={[640, 960, 1400, 1800]}
        sizes="(min-width: 1024px) 38vw, 100vw"
        quality={88}
        format="webp"
        loading="lazy"
        class="dem-steps__aside-img"
      />
    </aside>

    <div class="dem-steps__column">
      {
        steps.map((step) => (
          <article
            id={step.id}
            data-section-label={step.sectionLabel}
            class="dem-steps__step"
            aria-labelledby={`${step.id}-title`}
          >
            <header class="dem-steps__head">
              <p class="dem-steps__eyebrow">{step.eyebrow}</p>
              <h2 id={`${step.id}-title`} class="dem-steps__title">
                {step.title}
              </h2>
            </header>
            <div class="dem-steps__faq">
              <FaqAccordion items={step.accordions} client:visible />
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  /* ════════════════════════════════════════════════════════════════════
   * <DemarrerSteps> — UNE photo aside + 2 étapes empilées droite.
   * is:global pour pouvoir cibler `.faq-acc__*` injecté par l'island
   * FaqAccordion (hors scope local Astro).
   * ═══════════════════════════════════════════════════════════════════ */
  .dem-steps {
    background-color: var(--color-black-deep);
    color: var(--color-cream);
    width: 100%;
    overflow: hidden;
  }
  .dem-steps__inner {
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 1024px) {
    .dem-steps__inner {
      /* Ratio ~28% aside / 72% accordéons (retour Morgan : un peu
         moins d'1/3 pour la photo, 2/3 pour les accordéons). L'image
         object-fit: cover recadre naturellement plus serré sur la
         partie centrale (focus tulipes). */
      grid-template-columns: minmax(0, 0.28fr) minmax(0, 0.72fr);
      column-gap: clamp(2rem, 4vw, 4rem);
      /* Stretch : l'aside s'étend sur la hauteur des 2 étapes combinées
         (effet « photo en long » de la trame). Le zoom à l'ouverture
         d'accordéon est neutralisé en sticky-isant l'IMAGE elle-même
         (pas l'aside) avec une hauteur fixe 100svh. Voir below. */
      align-items: stretch;
    }
  }

  /* Photo aside — l'aside container fait toute la hauteur des 2 étapes
     (stretch), mais l'image dedans est sticky 100svh fixe : elle reste
     visible et NE ZOOMS PAS quand un accordéon s'ouvre/ferme, et suit
     visuellement tout le scroll des accordéons. */
  .dem-steps__aside {
    width: 100%;
    line-height: 0;
  }
  @media (max-width: 1023px) {
    .dem-steps__aside {
      aspect-ratio: 4 / 3;
      overflow: hidden;
    }
  }
  @media (min-width: 1024px) {
    .dem-steps__aside {
      align-self: stretch;
      position: relative;
    }
  }
  .dem-steps__aside-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  @media (min-width: 1024px) {
    /* Desktop : l'image s'étend sur toute la hauteur du parent stretch
       (= 2 étapes accordéons + padding-bottom généreux), donc descend
       jusqu'à la fin de la zone noire. Le zoom à l'ouverture d'accordéon
       est subtil car le delta de hauteur (~200px) est faible vs la
       hauteur totale (~150vh+) — object-fit:cover recadre très peu. */
    .dem-steps__aside-img {
      height: 100%;
      min-height: 100svh;
    }
  }

  /* Colonne droite — empile les 2 étapes verticalement.
     `min-height` plutôt que `padding-bottom` : la hauteur minimale absorbe
     l'expansion des accordéons sans pousser le parent vers le bas. Tant
     que les accordéons restent dans cette réserve d'espace → la colonne
     (et donc l'aside stretch + image) ne bougent PAS quand on déplie un
     accordéon. Si ça dépasse, la colonne grandit juste de ce qu'il faut. */
  .dem-steps__column {
    display: flex;
    flex-direction: column;
    padding: clamp(3rem, 7vw, 6rem) clamp(1.5rem, 5vw, 4rem);
    gap: clamp(4rem, 8vw, 7rem);
    min-height: 120vh;
  }
  @media (min-width: 1024px) {
    .dem-steps__column {
      padding-left: 0;
      padding-right: clamp(2rem, 5vw, 5rem);
      /* Réserve d'espace généreuse desktop : assez pour absorber 2 accordéons
         déployés (~80vh contenu max) + marge sans déclencher de zoom. */
      min-height: 170vh;
    }
  }

  .dem-steps__step {
    display: flex;
    flex-direction: column;
    gap: clamp(1.75rem, 3.5vw, 3rem);
  }

  .dem-steps__head {
    display: flex;
    flex-direction: column;
    gap: clamp(0.4rem, 0.8vw, 0.8rem);
  }
  .dem-steps__eyebrow {
    font-family: var(--font-heading), sans-serif;
    font-weight: 700;
    font-size: clamp(1rem, 1.4vw, 1.45rem);
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-cream);
    margin: 0;
  }
  /* Titre oversized : calibré pour rentrer dans la grille 0.58fr SANS
     coupure. Avant : clamp 9rem trop large pour "QUALIFICATION" (13c).
     Maintenant : letter-spacing serré + clamp réduit, autorise scale
     proportionnel viewport sans déborder. */
  .dem-steps__title {
    font-family: var(--font-heading), sans-serif;
    font-weight: 200;
    font-size: clamp(2.25rem, 6.2vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--color-cream);
    margin: 0;
    /* Sécurité : si jamais on rallonge un titre, on serre plutôt qu'on coupe */
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .dem-steps__faq {
    width: 100%;
  }
</style>
