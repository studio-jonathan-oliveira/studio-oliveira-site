---
/*
 * <DemarrerSteps> — section étapes de /demarrer-un-projet.
 *
 * DA finale 2026-06-04 (trame « demarrer un projet ») : grande PHOTO sombre en
 * fond plein, avec en OVERLAY deux groupes d'étapes. Chaque groupe = un CHIFFRE
 * géant violet (1, 2) à gauche + la liste d'accordéons à droite (titres violet,
 * icône +/×, réponses crème). Un voile sombre garantit la lisibilité.
 */
import { Image } from 'astro:assets';
import FaqAccordion, { type FaqItem } from '@/components/islands/FaqAccordion';
import bgImg from '@/assets/demarrer-un-projet/02-aside.jpg';

export interface Step {
  id: string;
  eyebrow: string;
  title: string;
  sectionLabel: string;
  accordions: ReadonlyArray<FaqItem>;
}

interface Props {
  steps: readonly [Step, Step];
}

const { steps } = Astro.props;
---

<section data-theme="dark" class="dem-steps" aria-label="Parcours en 2 temps">
  <div class="dem-steps__bg" aria-hidden="true">
    <Image
      src={bgImg}
      alt=""
      widths={[960, 1400, 1920]}
      sizes="100vw"
      quality={86}
      format="webp"
      loading="lazy"
      class="dem-steps__bg-img"
    />
    <span class="dem-steps__veil"></span>
  </div>

  <div class="dem-steps__groups">
    {
      steps.map((step, i) => (
        <article
          id={step.id}
          data-section-label={step.sectionLabel}
          class="dem-steps__group"
          aria-label={step.title}
        >
          <span class="dem-steps__num" aria-hidden="true">
            {i + 1}
          </span>
          <div class="dem-steps__faq">
            <FaqAccordion items={step.accordions} client:visible />
          </div>
        </article>
      ))
    }
  </div>
</section>

<style is:global>
  /* ════════════════════════════════════════════════════════════════════
   * <DemarrerSteps> — photo plein cadre + chiffres 1/2 violet + accordéons.
   * is:global pour cibler `.faq-acc__*` injecté par l'island FaqAccordion.
   * ═══════════════════════════════════════════════════════════════════ */
  .dem-steps {
    position: relative;
    width: 100%;
    isolation: isolate;
    overflow: hidden;
    background-color: var(--color-black-deep);
    color: var(--color-cream);
  }
  .dem-steps__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .dem-steps__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition:
      filter 0.6s var(--ease-out-editorial),
      transform 0.6s var(--ease-out-editorial);
  }
  /* Image VISIBLE par défaut (Morgan 2026-06-08 : « on doit pouvoir la voir »).
     Le FLOU ne s'applique QUE quand un accordéon est ouvert — même flou que le
     survol des typos (blur 18px pur, sans assombrissement ni zoom). */
  .dem-steps__bg.is-blurred .dem-steps__bg-img {
    filter: blur(18px);
  }
  /* Voile RETIRÉ par défaut (plus d'opacification permanente). */
  .dem-steps__veil {
    position: absolute;
    inset: 0;
    background: transparent;
  }

  /* Image immersive étalée sur ~3 écrans (Morgan 2026-06-08) : le « 1 » + ses
     accordéons en haut, puis un GRAND ESPACE d'environ un écran (gap), puis le
     « 2 ». La photo (bg position:absolute inset:0) remplit toute la hauteur du
     bloc → impression d'image étalée sur la hauteur. */
  .dem-steps__groups {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    /* ~1 écran de vide entre le groupe 1 et le groupe 2. */
    gap: 96svh;
    /* Marge DROITE à 0 → les accordéons (et leur liseret) atteignent le bord
       droit de l'écran (Morgan 2026-06-08). Marge gauche conservée. */
    padding: 18svh 0 60svh clamp(1.5rem, 5vw, 4rem);
  }

  .dem-steps__group {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: start;
  }
  @media (min-width: 768px) {
    .dem-steps__group {
      grid-template-columns: minmax(0, 0.4fr) minmax(0, 0.6fr);
      column-gap: clamp(2rem, 5vw, 5rem);
    }
  }
  /* Chiffre géant beige (inversion DA finale 2026-06-16 : violet éradiqué). */
  .dem-steps__num {
    font-family: var(--font-heading), sans-serif;
    font-weight: 200;
    font-size: clamp(7rem, 22vw, 22rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: var(--color-cream);
  }
  .dem-steps__faq {
    width: 100%;
  }

  /* Accordéon sur photo sombre : titres + icône CRÈME, réponses crème,
     séparateurs arrondis à droite. */
  .dem-steps .faq-acc__question,
  .dem-steps .faq-acc__icon {
    color: var(--color-cream);
  }
  /* Lisibilité sur la photo floutée CLAIRE (retour Jonathan 2026-06-16 :
     « les textes ne se voient pas quand l'image est claire, test du gras ») :
     titres des menus en GRAS + légère ombre portée pour décoller du fond. */
  .dem-steps .faq-acc__question {
    font-weight: 700;
    text-shadow: 0 1px 14px color-mix(in oklab, var(--color-ink) 60%, transparent);
  }
  .dem-steps .faq-acc__answer {
    color: color-mix(in oklab, var(--color-cream) 88%, transparent);
  }
  .dem-steps .faq-acc__item {
    border-bottom: 0;
  }
  /* Liseret (Morgan 2026-06-08 : « ils doivent aller jusqu'au bord à droite et
     moins remonter »). Le border-right de base longeait toute la hauteur du
     summary (~100px) → trop de remontée. On le redessine en ::after de HAUTEUR
     FIXE petite : ligne basse pleine largeur jusqu'au bord droit + courbe douce
     qui ne remonte que de ~16px. Couleur violette. */
  .dem-steps .faq-acc__summary {
    position: relative;
    border: 0;
  }
  .dem-steps .faq-acc__summary::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    /* Hauteur = radius → quart de cercle complet, MÊME courbe que les specs typo
       (token --radius-liseret) tout en remontant beaucoup moins que l'ancien
       border-right pleine hauteur (Morgan 2026-06-08). */
    height: var(--radius-liseret);
    border-bottom: var(--stroke-liseret) solid
      color-mix(in oklab, var(--color-cream) 45%, transparent);
    border-right: var(--stroke-liseret) solid
      color-mix(in oklab, var(--color-cream) 45%, transparent);
    border-bottom-right-radius: var(--radius-liseret);
    pointer-events: none;
  }
  .dem-steps .faq-acc__summary:focus-visible {
    outline-color: color-mix(in oklab, var(--color-cream) 60%, transparent);
  }
</style>

<script>
  // Flou de la photo de fond quand un accordéon de la section est ouvert
  // (trame). On observe l'attribut aria-expanded (posé par l'island React).
  function initDemStepsBlur() {
    const section = document.querySelector<HTMLElement>('.dem-steps');
    const bg = section?.querySelector<HTMLElement>('.dem-steps__bg');
    if (!section || !bg) return;
    const sync = () => {
      const open = section.querySelector('.faq-acc__summary[aria-expanded="true"]');
      bg.classList.toggle('is-blurred', !!open);
    };
    const obs = new MutationObserver(sync);
    obs.observe(section, {
      subtree: true,
      attributes: true,
      attributeFilter: ['aria-expanded'],
    });
    sync();
  }

  initDemStepsBlur();
  document.addEventListener('astro:page-load', initDemStepsBlur);
</script>
