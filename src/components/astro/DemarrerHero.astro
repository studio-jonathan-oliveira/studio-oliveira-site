---
/*
 * <DemarrerHero> — hero de /demarrer-un-projet.
 *
 * DA finale 2026-06-04 (trame « demarrer un projet ») : carte VIOLET #e0afff,
 * H1 oversized NOIR « Démarrer votre projet » (typographique, haut-gauche),
 * puis sous-titre « Comment ça marche ? » plus bas (introduit la section
 * étapes). Pas de photo, pas de paragraphes d'intro (absents de la trame).
 */
---

<section
  id="hero"
  data-section-label="Démarrer"
  data-theme="light"
  class="dem-hero"
  aria-labelledby="dem-hero-title"
>
  <div class="dem-hero__inner">
    <h1 id="dem-hero-title" class="dem-hero__title">
      <span class="dem-hero__title-line">Démarrer</span>
      <span class="dem-hero__title-line">votre projet</span>
    </h1>
    <p class="dem-hero__subtitle">Comment ça marche ?</p>
  </div>
</section>

<style>
  /* Hero violet, H1 noir typographique + sous-titre « Comment ça marche ? ». */
  .dem-hero {
    position: relative;
    width: 100%;
    min-height: 100svh;
    background-color: var(--color-violet);
    color: var(--color-ink);
    box-sizing: border-box;
    padding: clamp(7rem, 16vh, 12rem) clamp(1.5rem, 4vw, 4rem) clamp(3rem, 8vh, 6rem);
    overflow: hidden;
  }
  .dem-hero__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: calc(100svh - clamp(10rem, 24vh, 18rem));
  }
  .dem-hero__title {
    margin: 0;
    display: flex;
    flex-direction: column;
    color: var(--color-ink);
  }
  .dem-hero__title-line {
    display: block;
    font-family: var(--font-heading), sans-serif;
    font-weight: 900;
    font-size: clamp(3rem, 11vw, 11rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: none;
  }
  /* Sous-titre « Comment ça marche ? » — plus petit, poussé vers le bas. */
  /* « Comment ça marche ? » agrandi (Morgan 2026-06-05). */
  .dem-hero__subtitle {
    margin: clamp(3rem, 10vh, 9rem) 0 0;
    font-family: var(--font-heading), sans-serif;
    font-weight: 300;
    font-size: clamp(2rem, 5vw, 5rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
</style>
