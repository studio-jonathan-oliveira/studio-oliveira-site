---
/*
 * Footer — refonte DA finale 2026-06-04 (trames « modif finales »).
 *   - Carte BEIGE (#EDE6D6) à coins HAUTS arrondis, texte/logo NOIR.
 *     (Décision Morgan : footer beige/noir partout SAUF /demarrer-un-projet.)
 *   - Logo en tuile carrée NOIRE arrondie (wordmark cream à l'intérieur).
 *   - Colonne gauche : Siège social Studio (NAP) + Territoires « National ».
 *   - Colonne droite : nav Home / Studio / Projets / Démarrer un projet +
 *     bloc « Etudes par typologies de jardin » (4 typologies, active en gras).
 *
 * NAP (Name / Address / Phone) conservé — critique SEO local / Google Business.
 * Les liens /zones et services détaillés ne sont plus dans le footer (trame) ;
 * ils restent accessibles via le menu principal.
 */
const currentPath = Astro.url.pathname;
// Footer NOIR (data-theme="dark") sur la home, /studio ET /demarrer-un-projet
// (trame). Le style sombre est porté par .site-footer[data-theme='dark'] plus
// bas, et le data-theme fait aussi basculer le curseur custom en crème au survol.
const darkFooterPaths = ['/', '/studio', '/demarrer-un-projet'];
const footerTheme = darkFooterPaths.includes(currentPath) ? 'dark' : 'light';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/studio', label: 'Studio' },
  { href: '/projets', label: 'Projets' },
  { href: '/demarrer-un-projet', label: 'Démarrer un projet' },
];

const typologies = [
  { href: '/architecture-paysagere/micro-urbain', label: 'Micro urbain' },
  { href: '/architecture-paysagere/coeur-urbain', label: 'Coeur urbain' },
  { href: '/architecture-paysagere/frange-urbaine', label: 'Frange urbaine' },
  { href: '/architecture-paysagere/domaine-caractere', label: 'Domaine & Caractère' },
];
---

<footer class="site-footer" aria-label="Pied de page" data-theme={footerTheme}>
  <div class="site-footer__inner">
    <header class="site-footer__top">
      <a href="/" class="site-footer__logo" aria-label="Studio J Oliveira — accueil">
        <span class="site-footer__logo-mark" aria-hidden="true"></span>
      </a>
    </header>

    <div class="site-footer__grid">
      <div class="site-footer__col site-footer__col--left">
        <section aria-labelledby="footer-siege">
          <h2 id="footer-siege" class="site-footer__heading">Siège social Studio</h2>
          <address class="site-footer__address">
            <span>41 Rue Général Souham</span>
            <span>19100 BRIVE</span>
            <a href="tel:+33661088444" class="site-footer__link">06 61 08 84 44</a>
            <a href="mailto:contact.jonathanbiodesign@gmail.com" class="site-footer__link">
              contact.jonathanbiodesign@gmail.com
            </a>
          </address>
        </section>

        <section aria-labelledby="footer-territoires" class="site-footer__block">
          <h2 id="footer-territoires" class="site-footer__heading">Territoires d'intervention</h2>
          <p class="site-footer__national">National</p>
        </section>

        <p class="site-footer__legal">Droits réservés, mentions légales, etc.</p>
      </div>

      <div class="site-footer__col site-footer__col--right">
        <nav class="site-footer__nav" aria-label="Navigation pied de page">
          {
            nav.map((n) => (
              <a
                href={n.href}
                class="site-footer__navlink"
                aria-current={currentPath === n.href ? 'page' : undefined}
              >
                {n.label}
              </a>
            ))
          }
        </nav>

        <section aria-labelledby="footer-typologies" class="site-footer__typo">
          <h2 id="footer-typologies" class="site-footer__typo-title">
            Etudes par typologies de jardin
          </h2>
          <ul class="site-footer__typo-list">
            {
              typologies.map((t) => (
                <li>
                  <a
                    href={t.href}
                    class={
                      'site-footer__typo-link' +
                      (currentPath === t.href ? ' site-footer__typo-link--active' : '')
                    }
                    aria-current={currentPath === t.href ? 'page' : undefined}
                  >
                    {t.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Variante NOIRE (home + studio) — pilotée par data-theme="dark". Fond ink,
     texte crème, tuile logo beige (logo noir). */
  .site-footer[data-theme='dark'] {
    background-color: var(--color-ink);
    color: var(--color-cream);
  }
  .site-footer[data-theme='dark'] .site-footer__heading,
  .site-footer[data-theme='dark'] .site-footer__navlink,
  .site-footer[data-theme='dark'] .site-footer__typo-title,
  .site-footer[data-theme='dark'] .site-footer__typo-link--active {
    color: var(--color-cream);
  }
  .site-footer[data-theme='dark'] .site-footer__address,
  .site-footer[data-theme='dark'] .site-footer__national,
  .site-footer[data-theme='dark'] .site-footer__typo-link {
    color: color-mix(in oklab, var(--color-cream) 82%, transparent);
  }
  .site-footer[data-theme='dark'] .site-footer__legal {
    color: color-mix(in oklab, var(--color-cream) 55%, transparent);
  }
  .site-footer[data-theme='dark'] .site-footer__logo {
    background-color: var(--color-cream);
  }
  .site-footer[data-theme='dark'] .site-footer__logo-mark {
    background-color: var(--color-ink);
  }

  /* Carte beige à coins hauts arrondis, texte noir (pages claires). */
  .site-footer {
    background-color: var(--color-cream);
    color: var(--color-ink);
    border-top-left-radius: clamp(24px, 4vw, 56px);
    border-top-right-radius: clamp(24px, 4vw, 56px);
    margin-top: 0;
    overflow: hidden;
  }
  .site-footer__inner {
    max-width: 1500px;
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem) clamp(2rem, 4vw, 3rem);
  }

  .site-footer__top {
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }
  /* Logo = tuile carrée NOIRE arrondie, wordmark cream à l'intérieur. */
  .site-footer__logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(96px, 9vw, 128px);
    height: clamp(96px, 9vw, 128px);
    background-color: var(--color-ink);
    border-radius: clamp(18px, 2vw, 28px);
    line-height: 0;
  }
  .site-footer__logo-mark {
    display: block;
    width: 68%;
    height: 38%;
    background-color: var(--color-cream);
    -webkit-mask: url('/brand/wordmark-black.png?v=3') center / contain no-repeat;
    mask: url('/brand/wordmark-black.png?v=3') center / contain no-repeat;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
  }
  @media (min-width: 768px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: clamp(2rem, 6vw, 5rem);
    }
  }
  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: clamp(1.75rem, 3.5vw, 2.75rem);
  }
  @media (min-width: 768px) {
    .site-footer__col--right {
      text-align: right;
      align-items: flex-end;
    }
  }

  .site-footer__heading {
    font-family: var(--font-heading), sans-serif;
    font-size: clamp(1.05rem, 1.3vw, 1.3rem);
    font-weight: 700;
    text-transform: none;
    letter-spacing: 0;
    margin: 0 0 0.85rem 0;
    color: var(--color-ink);
  }
  .site-footer__address {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-family: var(--font-body), sans-serif;
    font-weight: 400;
    font-size: clamp(0.95rem, 1.1vw, 1.1rem);
    line-height: 1.5;
    color: color-mix(in oklab, var(--color-ink) 88%, transparent);
    font-style: normal;
  }
  .site-footer__national {
    font-family: var(--font-body), sans-serif;
    font-weight: 400;
    font-size: clamp(0.95rem, 1.1vw, 1.1rem);
    margin: 0;
    color: color-mix(in oklab, var(--color-ink) 88%, transparent);
  }
  .site-footer__legal {
    margin: 0;
    font-family: var(--font-body), sans-serif;
    font-size: clamp(0.7rem, 0.85vw, 0.8rem);
    color: color-mix(in oklab, var(--color-ink) 55%, transparent);
  }

  .site-footer__link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.3s ease,
      opacity 0.3s ease;
  }
  .site-footer__link:hover,
  .site-footer__link:focus-visible {
    border-bottom-color: currentColor;
    opacity: 0.85;
  }

  /* Nav droite — grande, fine, casse normale. */
  .site-footer__nav {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .site-footer__navlink {
    font-family: var(--font-heading), sans-serif;
    font-weight: 300;
    font-size: clamp(1.5rem, 2.6vw, 2.4rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    text-decoration: none;
    transition: opacity 0.3s ease;
  }
  .site-footer__navlink:hover,
  .site-footer__navlink:focus-visible {
    opacity: 0.6;
  }

  .site-footer__typo-title {
    font-family: var(--font-heading), sans-serif;
    font-weight: 300;
    font-size: clamp(1.5rem, 2.6vw, 2.4rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: clamp(1.25rem, 2.5vw, 2rem) 0 0.85rem;
    color: var(--color-ink);
    text-transform: none;
  }
  .site-footer__typo-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    justify-content: flex-start;
  }
  @media (min-width: 768px) {
    .site-footer__typo-list {
      justify-content: flex-end;
    }
  }
  .site-footer__typo-link {
    font-family: var(--font-body), sans-serif;
    font-weight: 400;
    font-size: clamp(0.85rem, 1vw, 1rem);
    color: color-mix(in oklab, var(--color-ink) 80%, transparent);
    text-decoration: none;
    transition: opacity 0.3s ease;
  }
  .site-footer__typo-link:hover,
  .site-footer__typo-link:focus-visible {
    opacity: 0.6;
  }
  .site-footer__typo-link--active {
    font-weight: 700;
    color: var(--color-ink);
  }
</style>
