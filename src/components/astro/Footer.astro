---
/*
 * Footer — section finale unifiée (refonte 2026-04-30, demande Jonathan,
 * capture screen-contact.png).
 *
 * Architecture :
 *   - Fond latérite plein, écritures cream.
 *   - Logo Oliveira en haut-gauche, dot pulsant central décoratif.
 *   - Grille 2 colonnes (gauche : NAP studio + Territoires d'intervention,
 *     droite : Services + Studio).
 *   - Filet cream fin séparateur, mentions légales en bas.
 *
 * NAP (Name / Address / Phone) reste cohérent SEO local — critique pour
 * Google Business Profile.
 */

const currentYear = new Date().getFullYear();
const currentPath = Astro.url.pathname;

const services = [
  { href: '/architecture-paysagere', label: 'Architecture paysagère' },
  { href: '/amenagement-vegetal-interieur', label: "Architecture végétal d'intérieur" },
  { href: '/lcd-atypiques', label: 'LCD atypiques' },
  { href: '/pros', label: 'PRO' },
  { href: '/projets', label: 'Projets' },
];

const studio = [
  { href: '/studio', label: 'Le studio' },
  { href: '/journal', label: 'Journal' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="site-footer" aria-label="Pied de page" data-theme="dark">
  <div class="site-footer__inner">
    <header class="site-footer__top">
      <a href="/" class="site-footer__logo" aria-label="Studio J Oliveira — accueil">
        <span class="site-footer__logo-mark" aria-hidden="true"></span>
      </a>
      <span class="site-footer__dot" aria-hidden="true"></span>
    </header>

    <div class="site-footer__grid">
      <div class="site-footer__col">
        <section aria-labelledby="footer-siege">
          <h2 id="footer-siege" class="site-footer__heading">Siège social Studio</h2>
          <address class="site-footer__address">
            <span>41 Rue Général Souham</span>
            <span>19100 BRIVE</span>
            <a href="tel:+33661088444" class="site-footer__link">06 61 08 84 44</a>
            <a href="mailto:contact.jonathanbiodesign@gmail.com" class="site-footer__link">
              contact.jonathanbiodesign@gmail.com
            </a>
          </address>
        </section>

        <section aria-labelledby="footer-territoires" class="site-footer__block">
          <h2 id="footer-territoires" class="site-footer__heading">Territoires d'intervention</h2>
          {
            /* Liens vers les pages /zones/* — refonte 2026-05-11 (audit SEO P0 :
              les pages locales étaient orphelines, jamais crawlées). Le footer
              global les link désormais sitewide, ce qui les sort de l'orphelinat
              et active le pilier SEO local Brive/Bordeaux/Limoges. */
          }
          <ul class="site-footer__list">
            <li>
              <a href="/zones/brive-la-gaillarde" class="site-footer__link">Brive et alentours</a>
            </li>
            <li><a href="/zones/bordeaux" class="site-footer__link">Bordeaux et Gironde</a></li>
            <li><a href="/zones/limoges" class="site-footer__link">Limoges et Haute-Vienne</a></li>
            <li>
              <a href="/zones/toulouse" class="site-footer__link">Toulouse et métropole</a>
            </li>
            <li><a href="/zones" class="site-footer__link">Toutes les zones →</a></li>
          </ul>
        </section>
      </div>

      <div class="site-footer__col site-footer__col--right">
        <section aria-labelledby="footer-services">
          <h2 id="footer-services" class="site-footer__heading">Services</h2>
          <ul class="site-footer__list">
            {
              services.map((s) => (
                <li>
                  <a
                    href={s.href}
                    class="site-footer__link"
                    aria-current={currentPath === s.href ? 'page' : undefined}
                  >
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section aria-labelledby="footer-studio" class="site-footer__block">
          <h2 id="footer-studio" class="site-footer__heading">Studio</h2>
          <ul class="site-footer__list">
            {
              studio.map((s) => (
                <li>
                  <a
                    href={s.href}
                    class="site-footer__link"
                    aria-current={currentPath === s.href ? 'page' : undefined}
                  >
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </div>

    <div class="site-footer__legal">
      <p>
        © {currentYear} Studio J Oliveira — Tous droits réservés.
        <a href="/mentions-legales" class="site-footer__link">Mentions légales</a>
        <a href="/confidentialite" class="site-footer__link">Confidentialité</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-laterite);
    color: var(--color-cream);
    margin-top: 0;
  }
  .site-footer__inner {
    max-width: 1500px;
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem) clamp(1.5rem, 3vw, 2rem);
  }

  .site-footer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }
  .site-footer__logo {
    display: inline-block;
    line-height: 0;
  }
  /* Logo agrandi 2026-05-02 (Morgan) : 140×36 → 220×56. */
  .site-footer__logo-mark {
    display: block;
    width: clamp(180px, 18vw, 240px);
    height: clamp(46px, 4.6vw, 60px);
    background-color: var(--color-cream);
    -webkit-mask: url('/brand/wordmark-black.png?v=3') left center / contain no-repeat;
    mask: url('/brand/wordmark-black.png?v=3') left center / contain no-repeat;
  }
  .site-footer__dot {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--color-cream);
    opacity: 0.85;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 768px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: clamp(2rem, 6vw, 5rem);
    }
  }
  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .site-footer__col--right {
    text-align: left;
  }
  @media (min-width: 768px) {
    .site-footer__col--right {
      text-align: right;
      align-items: flex-end;
    }
  }
  .site-footer__block {
    margin-top: 0;
  }

  /* Tailles augmentées 2026-05-02 v2 (Morgan, capture footer-screenshot) :
     headings 1.25rem → 1.5rem, body 1.15rem → 1.4rem. Plus monumentaux. */
  .site-footer__heading {
    font-family: var(--font-heading), sans-serif;
    font-size: clamp(1.3rem, 1.7vw, 1.7rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 1.1rem 0;
    color: var(--color-cream);
  }

  .site-footer__address,
  .site-footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-family: var(--font-body), sans-serif;
    font-size: clamp(1.2rem, 1.5vw, 1.5rem);
    line-height: 1.5;
    color: color-mix(in oklab, var(--color-cream) 92%, transparent);
    font-style: normal;
  }
  .site-footer__list strong {
    font-weight: 700;
    color: var(--color-cream);
  }

  .site-footer__link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.3s ease,
      opacity 0.3s ease;
  }
  .site-footer__link:hover,
  .site-footer__link:focus-visible {
    border-bottom-color: currentColor;
    opacity: 0.85;
  }

  .site-footer__legal {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in oklab, var(--color-cream) 22%, transparent);
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: color-mix(in oklab, var(--color-cream) 70%, transparent);
  }
  .site-footer__legal p {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }
  .site-footer__legal .site-footer__link {
    border-bottom: 1px solid color-mix(in oklab, var(--color-cream) 30%, transparent);
  }
</style>
