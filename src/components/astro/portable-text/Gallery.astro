---
/*
 * Gallery — galerie inline de 2-3 images (bloc `figureGallery`).
 * Grille responsive : empilée en mobile, en colonnes dès `sm`.
 */
import type { PtFigureGallery } from '@/lib/portable-text';
import type { SanityImageSource } from '@sanity/image-url';
import { urlFor } from '@/lib/sanity';

interface Props {
  node: PtFigureGallery;
}

const { node } = Astro.props;
const images = (node.images ?? []).filter((img) => Boolean(img.asset));
---

{
  images.length > 0 && (
    <figure class="pt-gallery" style={`--pt-gallery-cols:${images.length}`}>
      <div class="pt-gallery__grid">
        {images.map((img) => (
          <img
            src={urlFor(img as SanityImageSource)
              .width(1200)
              .auto('format')
              .url()}
            alt={img.alt ?? ''}
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
      {images.some((img) => img.caption) && (
        <figcaption>{images.find((img) => img.caption)?.caption}</figcaption>
      )}
    </figure>
  )
}

<style>
  .pt-gallery__grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .pt-gallery__grid {
      grid-template-columns: repeat(var(--pt-gallery-cols, 2), 1fr);
    }
  }
  .pt-gallery__grid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
