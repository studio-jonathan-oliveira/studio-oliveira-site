---
import '@/styles/global.css';
// ClientRouter désactivé 2026-04-24 : causait un écran noir au clic sur les
// liens internes (view transitions sans animations définies = flash black).
// Navigation classique (full reload) utilisée — moins smooth mais fiable.
// À réactiver Phase 6 avec des view transitions proprement définies.
import Header from '@/components/astro/Header.astro';
import MenuPrimary from '@/components/astro/MenuPrimary.astro';
import Footer from '@/components/astro/Footer.astro';
import Grain from '@/components/astro/Grain.astro';
import SmoothScroll from '@/components/astro/SmoothScroll.astro';
import CustomCursor from '@/components/astro/CustomCursor.astro';
import ScrollNav from '@/components/astro/ScrollNav.astro';

interface Props {
  title: string;
  description?: string | undefined;
  canonical?: string | undefined;
  ogImage?: string | undefined;
  ogType?: 'website' | 'article' | 'profile' | undefined;
  noindex?: boolean | undefined;
  lang?: string | undefined;
  /** Première section sombre (hero immersif) : header démarre transparent + logo crème. */
  darkHero?: boolean | undefined;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.jpg',
  ogType = 'website',
  noindex = false,
  lang = 'fr',
  darkHero = false,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://www.jonathanoliveira.fr';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
// OG image : utilise PUBLIC_SITE_URL en priorité (prod), puis VERCEL_URL
// (set automatiquement par Vercel en preview/dev deploys) pour exposer une
// URL réellement atteignable par les crawlers sociaux (opengraph.xyz,
// LinkedIn, etc.). Sinon retombe sur siteUrl. Canonical reste sur siteUrl
// même en preview pour pointer Google vers la prod.
const vercelUrl = import.meta.env.VERCEL_URL;
const ogImageBase =
  import.meta.env.PUBLIC_SITE_URL ?? (vercelUrl ? `https://${vercelUrl}` : siteUrl);
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, ogImageBase).toString();
const siteName = 'Studio J Oliveira';
// Dedup intelligente : ne pas ajouter « — Studio J Oliveira » si le title
// le contient déjà (cas d'un title rédigé full custom comme la home).
const titleContainsSiteName = title.toLowerCase().includes(siteName.toLowerCase());
const fullTitle = titleContainsSiteName ? title : `${title} — ${siteName}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}

    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    {
      /* Preload fonts critiques (2026-05-12) — Jost latin + Geist Mono latin
        servis depuis /public/fonts (cf. global.css @font-face).
        - Jost = font-heading + font-body, utilisé sur H1 hero (LCP)
        - Geist Mono = eyebrows partout, démarre le rendu visible
        crossorigin obligatoire pour le preload de fonts woff2. */
    }
    <link
      rel="preload"
      href="/fonts/jost-variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/geist-mono-variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      /* latin-ext + italic non preloadés (chargés à la demande par le
        navigateur via unicode-range / italic style). Économie ~50 KB sur le
        critical path tout en gardant les caractères français accentués
        (déjà dans latin-wght-normal). */
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="fr_FR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#F5F1EA" />

    {/* <ClientRouter /> désactivé 2026-04-24 — bug écran noir au clic lien */}

    <slot name="head" />
  </head>

  <body class="text-[length:var(--text-base)] font-[var(--font-body)]">
    <div class="site-preloader" id="site-preloader" aria-hidden="true"></div>

    {
      /* Curtain page transition retiré 2026-04-24 : bloquait la navigation
        (écran noir infini au click, bug Morgan). Transition native Astro
        ClientRouter utilisée à la place. */
    }

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-[var(--color-forest)] focus:px-4 focus:py-2 focus:text-[var(--color-cream)]"
    >
      Aller au contenu principal
    </a>

    <Header darkHero={darkHero} />
    <MenuPrimary />

    {/* Slot intro rendu hors de <main> pour ne pas être masqué par .intro-hidden. */}
    <slot name="intro" />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <Grain />

    <CustomCursor />
    <ScrollNav />

    <SmoothScroll />

    <script>
      // Polish Motion transversal — reveals, stagger, magnetic, parallax, hero sequence.
      import '@/scripts/motion-enhance';
      // Theme observer : source unique de vérité pour html[data-theme] + body.is-dark-section.
      import '@/scripts/theme-observer';

      // Micro-preloader : retire l'overlay 80ms après first paint. Cache les
      // éventuels reflows/FOUC tout en restant bref (pas de coût LCP significatif).
      function dismissPreloader() {
        const el = document.getElementById('site-preloader');
        if (!el) return;
        window.setTimeout(() => el.classList.add('is-done'), 80);
        // Purge du DOM après transition
        window.setTimeout(() => el.remove(), 900);
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', dismissPreloader, { once: true });
      } else {
        dismissPreloader();
      }

      // Curtain de transition retiré 2026-04-24 (bug écran noir infini).
      // La transition native Astro ClientRouter (fade rapide) suffit.
    </script>
  </body>
</html>
