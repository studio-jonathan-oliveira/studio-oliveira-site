---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/astro/Header.astro';
import MenuPrimary from '@/components/astro/MenuPrimary.astro';
import Footer from '@/components/astro/Footer.astro';
import Grain from '@/components/astro/Grain.astro';
import SmoothScroll from '@/components/astro/SmoothScroll.astro';
import CustomCursor from '@/components/astro/CustomCursor.astro';
import ScrollNav from '@/components/astro/ScrollNav.astro';

interface Props {
  title: string;
  description?: string | undefined;
  canonical?: string | undefined;
  ogImage?: string | undefined;
  ogType?: 'website' | 'article' | 'profile' | undefined;
  noindex?: boolean | undefined;
  lang?: string | undefined;
  /** Première section sombre (hero immersif) : header démarre transparent + logo crème. */
  darkHero?: boolean | undefined;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.jpg',
  ogType = 'website',
  noindex = false,
  lang = 'fr',
  darkHero = false,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://www.jonathanoliveira.fr';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();
const siteName = 'Studio J Oliveira';
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}

    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    {
      /* TODO Phase 6 — preload fonts via Astro Fonts API (experimental.fonts) pour éliminer CLS et LCP shift. Actuellement, fontsource importe via @import, le navigateur télécharge à la volée avec font-display: swap. */
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="fr_FR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#F5F1EA" />

    <ClientRouter />

    <slot name="head" />
  </head>

  <body class="text-[length:var(--text-base)] font-[var(--font-body)]">
    <div class="site-preloader" id="site-preloader" aria-hidden="true"></div>

    <!-- Curtain de transition de page : rideau forest qui monte au départ,
         descend à l'arrivée. Animé via Motion sur events astro:before-preparation
         et astro:after-swap. Signature designbyad.com.au (Barba.js là-bas,
         Astro ClientRouter + Motion chez nous — même rendu sans la dette JS). -->
    <div class="page-curtain" id="page-curtain" aria-hidden="true"></div>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-[var(--color-forest)] focus:px-4 focus:py-2 focus:text-[var(--color-cream)]"
    >
      Aller au contenu principal
    </a>

    <Header darkHero={darkHero} />
    <MenuPrimary />

    {/* Slot intro rendu hors de <main> pour ne pas être masqué par .intro-hidden. */}
    <slot name="intro" />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <Grain />

    <CustomCursor />
    <ScrollNav />

    <SmoothScroll />

    <script>
      // Polish Motion transversal — reveals, stagger, magnetic, parallax, hero sequence.
      import '@/scripts/motion-enhance';
      // Theme observer : source unique de vérité pour html[data-theme] + body.is-dark-section.
      import '@/scripts/theme-observer';

      // Micro-preloader : retire l'overlay 80ms après first paint. Cache les
      // éventuels reflows/FOUC tout en restant bref (pas de coût LCP significatif).
      function dismissPreloader() {
        const el = document.getElementById('site-preloader');
        if (!el) return;
        window.setTimeout(() => el.classList.add('is-done'), 80);
        // Purge du DOM après transition
        window.setTimeout(() => el.remove(), 900);
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', dismissPreloader, { once: true });
      } else {
        dismissPreloader();
      }

      // Page curtain — transition entre pages via Astro ClientRouter events.
      // Le curtain commence caché (scaleY 0, origin bottom). Au départ : monte
      // (origin bottom → scaleY 1). Au swap : la nouvelle page est chargée
      // dessous, on bascule l'origin en top et on descend (scaleY 1 → 0).
      const curtain = document.getElementById('page-curtain');
      if (curtain && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        curtain.style.transformOrigin = 'bottom';
        curtain.style.transform = 'scaleY(0)';

        document.addEventListener('astro:before-preparation', (e) => {
          const event = e as unknown as { loader: () => Promise<void> };
          const original = event.loader;
          // Retarde le chargement pour laisser le curtain monter (0.45s)
          event.loader = async () => {
            curtain.style.transformOrigin = 'bottom';
            curtain.style.transform = 'scaleY(1)';
            curtain.style.transition = 'transform 0.45s cubic-bezier(0.7, 0, 0.3, 1)';
            await new Promise((r) => window.setTimeout(r, 450));
            await original();
          };
        });

        document.addEventListener('astro:after-swap', () => {
          // Nouvelle page swappée : on bascule l'origin et on descend
          curtain.style.transition = 'none';
          curtain.style.transformOrigin = 'top';
          // Force reflow pour appliquer le changement d'origin
          curtain.getBoundingClientRect();
          curtain.style.transition = 'transform 0.55s cubic-bezier(0.16, 1, 0.3, 1)';
          curtain.style.transform = 'scaleY(0)';
          window.setTimeout(() => {
            // Reset pour la prochaine navigation
            curtain.style.transition = 'none';
            curtain.style.transformOrigin = 'bottom';
          }, 600);
        });
      }
    </script>
  </body>
</html>
