---
/*
 * /pros — Page dédiée aux clients professionnels.
 * Source PDF Jonathan : lignes 784-804.
 *
 * Style distinctif selon le PDF :
 * - Clarté, rapidité, pas de blabla inutile (l. 785-786)
 * - Images ou vidéos projets réalisés avec infos claires (l. 788-790)
 * - Texte plus-value pro — validation investissement par séduction du design (l. 792-794)
 * - Garanties + prix réalisation (si nécessaire, à définir plus tard l. 796-798)
 * - Galerie/carrousel projets (l. 800)
 * - ⚡ CTA SUIVEUR SOURIS visible tout le long du scroll (l. 801-804 + mp4 référence)
 *   → Phase B, à implémenter via Motion + event pointermove
 *
 * Verticales pros (selon PDF l. 536, 732) :
 *   - Hôtellerie
 *   - Restauration
 *   - Bureaux
 *   - Commerces
 *
 * ⚠️ Page en squelette — contenu définitif à rédiger (Claude ébauche + Jonathan valide).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/astro/Section.astro';
import SectionHeader from '@/components/astro/SectionHeader.astro';
import CtaLink from '@/components/astro/CtaLink.astro';
import { jsonLdGraph, organization, localBusiness, breadcrumbs, service } from '@/lib/schema-org';

const verticales = [
  { slug: 'hotellerie', nom: 'Hôtellerie', accroche: '[À FOURNIR]' },
  { slug: 'restauration', nom: 'Restauration', accroche: '[À FOURNIR]' },
  { slug: 'bureaux', nom: 'Bureaux', accroche: '[À FOURNIR]' },
  { slug: 'commerces', nom: 'Commerces', accroche: '[À FOURNIR]' },
];

const schema = jsonLdGraph([
  organization(),
  localBusiness(),
  service({
    name: 'Design biophilique pour professionnels',
    slug: 'pros',
    path: '/pros',
    description:
      'Aménagements végétalisés pour hôtellerie, restauration, bureaux et commerces. Design biophilique premium, plantes naturelles et artificielles, conception et réalisation.',
  }),
  breadcrumbs([
    { name: 'Accueil', item: '/' },
    { name: 'Pros', item: '/pros' },
  ]),
]);
---

<BaseLayout
  title="Design biophilique pour professionnels — Studio J Oliveira"
  description="Studio de design biophilique à Brive. Aménagements végétalisés pour hôtellerie, restauration, bureaux et commerces. Décors immersifs, plantes naturelles et artificielles."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  {
    /* ScrollCursorCta retiré 2026-04-28 (feedback Morgan : intrusif, clic dans
     le vide envoie sur contact). À ré-évaluer plus tard avec Jonathan ; le
     PDF l.801-804 le demandait mais l'expérience réelle ne convainc pas. */
  }

  <Section variant="cream" id="hero" sectionLabel="Pros" class="pt-40 md:pt-48">
    <div class="max-w-3xl" data-reveal="up">
      <p class="font-mono text-xs tracking-[0.22em] text-[var(--color-forest)]/55 uppercase">
        <span class="text-[var(--color-forest)]/40">PRO</span>
        &nbsp;·&nbsp; Hôtellerie · Restauration · Bureaux · Commerces
      </p>
      <h1
        data-mask-reveal
        data-mask-stagger="0.14"
        class="mt-6 font-[family-name:var(--font-heading)] leading-[1.02] tracking-tight text-[var(--color-forest)]"
      >
        <span data-mask-line class="block pb-[0.05em] text-[length:var(--text-4xl)] italic"
          >Design biophilique pour</span
        >
        <span
          data-mask-line
          class="block pb-[0.18em] text-[length:var(--text-5xl)] md:text-[length:var(--text-hero)]"
          style="font-weight: 500; letter-spacing: -0.012em; line-height: 0.96;"
          >PROFESSIONNELS.</span
        >
      </h1>
      <p
        class="mt-10 max-w-2xl text-[length:var(--text-lg)] leading-relaxed text-[var(--color-forest)]/80"
      >
        [À FOURNIR — pitch pro 60-80 mots. Plus-value business : validation de l'investissement par
        la séduction du design, durabilité, conformité normes. Pas de blabla.]
      </p>
    </div>
  </Section>

  {/* ───── BANDE KEYWORDS (4 verticales pros) ───── */}
  <section class="bg-[var(--color-cream)] px-6 pb-20 md:px-10 md:pb-28" aria-hidden="true">
    <p
      class="page-keywords-band page-keywords-band--light"
      data-reveal="up"
      data-justify-scroll
      data-justify-amp="20"
      data-justify-seed="29"
    >
      Hôtellerie <span aria-hidden="true">·</span>
      Restauration <span aria-hidden="true">·</span>
      Bureaux <span aria-hidden="true">·</span>
      Commerces
    </p>
  </section>

  <!-- VERTICALES — 4 segments -->
  <Section variant="cream" topDivider aria-labelledby="verticales-title">
    <SectionHeader
      eyebrow="Nos segments"
      title="Quatre univers, une même exigence."
      intro="[À FOURNIR — 2-3 lignes pour introduire les 4 verticales.]"
      id="verticales-title"
    >
      <Fragment slot="title" set:html="Quatre univers, une même exigence." />
    </SectionHeader>

    <ul
      data-pros-cards
      class="mt-16 grid grid-cols-1 gap-px bg-[var(--color-forest)]/10 md:grid-cols-2"
    >
      {
        verticales.map((v) => (
          <li class="bg-[var(--color-cream)]">
            <a
              href={`/amenagement-vegetal-interieur/${v.slug}`}
              class="group flex h-full flex-col justify-between p-10 transition-colors hover:bg-[var(--color-forest)]/5 md:p-14"
            >
              <div>
                <p class="font-mono text-[11px] tracking-[0.22em] text-[var(--color-forest)]/55 uppercase">
                  Verticale · {v.nom}
                </p>
                <h3 class="mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-3xl)] leading-tight text-[var(--color-forest)]">
                  {v.nom}
                </h3>
                <p class="mt-4 text-sm text-[var(--color-forest)]/70">{v.accroche}</p>
              </div>
              <span class="mt-10 inline-flex items-center gap-2 text-sm text-[var(--color-forest)] transition-transform group-hover:translate-x-1">
                Découvrir
                <span aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- GARANTIES — placeholder structure -->
  <Section variant="cream" topDivider>
    <SectionHeader
      eyebrow="Garanties"
      title="[À FOURNIR — titre section garanties]"
      intro="[À FOURNIR — intro 2 lignes sur les garanties que Jonathan propose aux pros.]"
    />
    <ul data-pros-cards class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
      {
        [1, 2, 3].map((n) => (
          <li class="border-t border-[var(--color-forest)]/10 pt-6">
            <p class="font-mono text-[10px] tracking-[0.28em] text-[var(--color-forest)]/55 uppercase">
              Garantie {n}
            </p>
            <h3 class="mt-4 font-[family-name:var(--font-heading)] text-[length:var(--text-2xl)] leading-tight text-[var(--color-forest)]">
              [À FOURNIR]
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-[var(--color-forest)]/70">[À FOURNIR]</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- GALERIE PROJETS PROS — à alimenter quand inventaire Jonathan reçu -->
  <Section variant="cream" topDivider>
    <SectionHeader eyebrow="Portefeuille pros" title="[À FOURNIR — projets pros publiables]" />
    <p class="mt-8 max-w-2xl text-sm text-[var(--color-forest)]/60">
      [À FOURNIR — galerie photo ou carrousel projets pros. Selon PDF ligne 800, peut être galerie
      statique ou carrousel. Morgan conseille galerie scroll-snap horizontal plutôt que carrousel
      auto (anti-pattern PDF l. 688).]
    </p>
  </Section>

  <!-- CTA FINAL -->
  <div>
    <Section variant="forest" topDivider id="contact-cta" sectionLabel="Contact">
      <div class="mx-auto max-w-4xl text-center" data-reveal="slow">
        <p class="font-mono text-xs tracking-[0.28em] text-[var(--color-cream)]/55 uppercase">
          Engager la conversation
        </p>
        <h2
          data-mask-reveal
          data-mask-stagger="0.14"
          class="mt-8 font-[family-name:var(--font-heading)] text-[length:var(--text-4xl)] leading-[1.05] text-[var(--color-cream)]"
        >
          <span data-mask-line class="block pb-[0.05em]">Un projet pro ?</span>
          <span data-mask-line class="block pb-[0.12em]"
            ><em class="text-[var(--color-cream)]/55 italic">Parlons-en.</em></span
          >
        </h2>
        <p
          class="mx-auto mt-10 max-w-xl text-[length:var(--text-base)] leading-relaxed text-[var(--color-cream)]/70"
        >
          Appel découverte 15-25 minutes. On qualifie le projet, on pose les attentes, on repart
          avec une lecture claire de la suite.
        </p>
        <div class="mt-12 flex flex-col items-center justify-center gap-6 md:flex-row md:gap-10">
          <CtaLink href="/contact" label="Démarrer un projet" tone="dark" size="lg" magnetic={0} />
          <a
            href="tel:+33661088444"
            class="text-sm text-[var(--color-cream)] underline underline-offset-4 hover:text-[var(--color-cream)]"
          >
            06 61 08 84 44
          </a>
        </div>
      </div>
    </Section>
  </div>

  <style>
    /* Reveal CSS pure pour les cards verticales/garanties (alternative à
       data-reveal-stagger qui bug sur grids — page-conventions.md §13.4). */
    [data-pros-cards] > li {
      opacity: 0;
      transform: translateY(40px);
      transition:
        opacity 1s var(--ease-out-editorial),
        transform 1s var(--ease-out-editorial);
    }
    [data-pros-cards].is-revealed > li {
      opacity: 1;
      transform: translateY(0);
    }
    [data-pros-cards].is-revealed > li:nth-child(1) {
      transition-delay: 0s;
    }
    [data-pros-cards].is-revealed > li:nth-child(2) {
      transition-delay: 0.12s;
    }
    [data-pros-cards].is-revealed > li:nth-child(3) {
      transition-delay: 0.24s;
    }
    [data-pros-cards].is-revealed > li:nth-child(4) {
      transition-delay: 0.36s;
    }
  </style>

  <script>
    function initProsCardsObserver() {
      const grids = document.querySelectorAll<HTMLElement>('[data-pros-cards]');
      grids.forEach((grid) => {
        if (grid.dataset.observerWired === 'true') return;
        grid.dataset.observerWired = 'true';
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                grid.classList.add('is-revealed');
                observer.disconnect();
                break;
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        observer.observe(grid);
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProsCardsObserver, { once: true });
    } else {
      initProsCardsObserver();
    }
    document.addEventListener('astro:page-load', initProsCardsObserver);
  </script>
</BaseLayout>
