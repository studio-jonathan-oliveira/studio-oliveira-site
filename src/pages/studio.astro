---
/*
 * /studio — page Jonathan Oliveira, portrait + parcours + méthode.
 * Refonte 2026-04-23 : hero split avec portrait Jonathan + section démarche
 * texturée + méthode forest sombre immersif (feedback Morgan : « plus sexy,
 * texture, couleur, photos de Jonathan »).
 * Photos du dossier client : _brief/client-assets/logo-identite/DSC079*, DSC08003.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/astro/Section.astro';
import { Image } from 'astro:assets';
import { SITE } from '@/lib/site-config';
import { jsonLdGraph, breadcrumbs, localBusiness, organization, person } from '@/lib/schema-org';

import portrait01 from '@/assets/jonathan/portrait-01.webp';
import portrait02 from '@/assets/jonathan/portrait-02.webp';
import textureVegetale from '@/assets/home/hero-biophilie.jpg';

const schema = jsonLdGraph([
  organization(),
  person(),
  localBusiness(),
  breadcrumbs([
    { name: 'Accueil', item: '/' },
    { name: 'Studio', item: '/studio' },
  ]),
]);

// Parcours factuel sourcé PDF PROCESS ETUDES STUDIO 2026
const parcours = [
  { annee: 'BAC ES', detail: 'Diplômé avec mention' },
  { annee: 'Bac Pro Travaux paysagers', detail: '1 an, mention' },
  { annee: 'BTSA Aménagement paysagers', detail: '2 ans, mention' },
  { annee: 'Licence Pro Conception et aménagement paysagers', detail: '1 an, mention' },
  {
    annee: 'Chef de projet / Dessinateur-projeteur',
    detail: '4,5 ans — entreprise d’aménagements paysagers, Limoges',
  },
  {
    annee: `Création du Studio J Oliveira — ${SITE.foundedYear}`,
    detail: 'Studio de design biophilique indépendant, Brive-la-Gaillarde',
  },
];

const piliers = [
  {
    titre: 'Le bâti',
    description: 'L’architecture du lieu, ses matériaux, son dialogue avec le territoire.',
  },
  {
    titre: 'L’environnement',
    description: 'Le climat, le sol, les essences adaptées, la biodiversité existante.',
  },
  {
    titre: 'L’humain',
    description: 'Le mode de vie, les usages réels, le rapport sensible au jardin.',
  },
];

const etapesMethode = [
  {
    num: '01',
    label: 'Appel de qualification',
    duree: '15 — 25 min',
    detail:
      'Localisation, typologie, surface, budget global, maturité du projet. Je filtre les projets non alignés et je prépare le rendez-vous.',
  },
  {
    num: '02',
    label: 'Rendez-vous studio',
    duree: '1 h 45 — 2 h',
    detail:
      "Récit du client, co-construction visuelle à partir d'images de référence, lecture experte du site, définition de l'étude adaptée à la typologie.",
  },
  {
    num: '03',
    label: 'Validation à distance',
    duree: '15 min',
    detail:
      "Un dernier échange 72 h à 1 semaine après le rendez-vous — lever la dernière hésitation, signer l'étude.",
  },
];
---

<BaseLayout
  title="Jonathan Oliveira — Designer biophilique à Brive-la-Gaillarde"
  description="Jonathan Oliveira, designer paysagiste indépendant fondateur du Studio de design biophilique à Brive-la-Gaillarde. Démarche scientifique et sensible, formation en architecture d'intérieur et ingénierie paysagère."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={schema} />
  </Fragment>

  {/* ───── HERO SPLIT : portrait Jonathan + texte éditorial ───── */}
  <section
    id="hero"
    data-section-label="Studio"
    class="studio-hero relative bg-[var(--color-cream)]"
  >
    <div class="mx-auto grid max-w-[1500px] grid-cols-1 gap-0 pt-32 md:pt-40 lg:grid-cols-12">
      <div
        class="px-6 pt-8 pb-16 md:px-12 md:pt-16 md:pb-24 lg:col-span-7 lg:col-start-1"
        data-reveal="up"
      >
        <p class="font-mono text-xs tracking-[0.26em] text-[var(--color-laterite)] uppercase">
          <span class="studio-dot" aria-hidden="true"></span>
          Le studio · Depuis {SITE.foundedYear}
        </p>
        <h1
          data-mask-reveal
          data-mask-stagger="0.14"
          class="mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-5xl)] leading-[1.02] md:text-[length:var(--text-hero)]"
        >
          <span data-mask-line class="block pb-[0.05em]">Jonathan</span>
          <span data-mask-line class="block pb-[0.05em] text-[var(--color-cream)]">Oliveira —</span>
          <span data-mask-line class="block pb-[0.12em] text-[var(--color-laterite)] italic">
            Designer biophilique.
          </span>
        </h1>
        <p
          class="mt-10 max-w-xl text-[length:var(--text-lg)] leading-relaxed text-[var(--color-cream)]/80"
        >
          Le Studio J Oliveira est un studio de design spatial spécialisé dans l'aménagement
          environnemental immersif et expérientiel —
          <a
            href="/architecture-paysagere"
            class="border-b border-[var(--color-moss)]/40 hover:border-[var(--color-laterite)] hover:text-[var(--color-laterite)]"
            >architecture paysagère</a
          > et <a
            href="/amenagement-vegetal-interieur"
            class="border-b border-[var(--color-moss)]/40 hover:border-[var(--color-laterite)] hover:text-[var(--color-laterite)]"
            >aménagement végétalisé d'intérieur</a
          >. J'étudie et conçois des espaces à vivre, en dialogue avec le bâti, l'environnement et
          l'humain.
        </p>
      </div>

      <div class="relative lg:col-span-5 lg:col-start-8" data-reveal="up" data-reveal-delay="0.2">
        <div class="studio-portrait relative overflow-hidden">
          <Image
            src={portrait01}
            alt="Jonathan Oliveira, fondateur du Studio"
            widths={[480, 720, 960, 1200]}
            sizes="(min-width: 1024px) 40vw, 100vw"
            quality={84}
            format="webp"
            class="h-full w-full object-cover"
            loading="eager"
          />
          <span class="studio-portrait-caption" aria-hidden="true">
            <em class="italic">Jonathan Oliveira</em>
            <span>Fondateur</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  {/* ───── 01 · DÉMARCHE — avec texture végétale en fond + piliers ───── */}
  <section
    class="studio-demarche relative isolate overflow-hidden bg-[var(--color-forest)] text-[var(--color-cream)]"
    data-theme="dark"
    aria-labelledby="demarche-title"
  >
    <div class="absolute inset-0 -z-10">
      <Image
        src={textureVegetale}
        alt=""
        widths={[960, 1440, 1920]}
        sizes="100vw"
        quality={60}
        format="webp"
        class="h-full w-full object-cover object-center"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-[var(--color-forest)]/92" aria-hidden="true"></div>
      <div class="studio-demarche-halo" aria-hidden="true"></div>
    </div>

    <div class="mx-auto max-w-7xl px-6 py-24 md:px-10 md:py-36">
      <div class="grid gap-12 md:grid-cols-[1fr_1.5fr] md:gap-20">
        <div data-reveal="up">
          <p class="font-mono text-xs tracking-[0.26em] text-[var(--color-laterite)] uppercase">
            <span class="text-[var(--color-cream)]/40">01</span> &nbsp;·&nbsp; Démarche
          </p>
          <h2
            id="demarche-title"
            class="mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-4xl)] leading-[1.02] md:text-[length:var(--text-5xl)]"
          >
            Trois piliers,<br />
            un même <em class="text-[var(--color-laterite)] italic">écosystème</em>.
          </h2>
        </div>

        <div
          class="space-y-6 text-[length:var(--text-base)] leading-relaxed text-[var(--color-cream)]/85"
          data-reveal="up"
          data-reveal-delay="0.15"
        >
          <p>
            La conception biophilique est un art de conception architecturale directement inspiré
            des environnements naturels et de leurs effets sur l'humain. Une démarche
            <em class="text-[var(--color-moss)] italic">scientifique</em> couplée à la technicité architecturale
            — étudier la nature à l'état primitif, comprendre ses interactions, puis reproduire ses bienfaits
            dans les espaces que nous habitons.
          </p>
          <p>
            Trois écosystèmes cohabitent dans chaque projet : le bâti, l'environnement, l'humain.
            C'est cet <em class="text-[var(--color-laterite)] italic">équilibre</em> que je cherche —
            une conception juste, logique avec les besoins du client, en considération de l'environnement
            dans lequel elle s'implante.
          </p>
        </div>
      </div>

      <ul
        class="mt-16 grid grid-cols-1 gap-px bg-[var(--color-cream)]/10 sm:grid-cols-3"
        data-reveal-stagger="0.12"
        data-reveal="up"
      >
        {
          piliers.map((p, i) => (
            <li class="bg-[var(--color-forest)]/80 p-8 backdrop-blur-sm md:p-10">
              <p class="font-mono text-[10px] tracking-[0.26em] text-[var(--color-laterite)] uppercase">
                Pilier {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="mt-5 font-[family-name:var(--font-heading)] text-[length:var(--text-2xl)] leading-tight">
                <em class="italic">{p.titre}</em>
              </h3>
              <p class="mt-4 text-sm leading-relaxed text-[var(--color-cream)]/75">
                {p.description}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ───── 02 · PARCOURS : timeline gauche + portrait + quote aside droite ───── */}
  <Section variant="forest" aria-labelledby="parcours-title">
    <div class="grid gap-12 md:grid-cols-[1.3fr_1fr] md:gap-16">
      <div data-reveal="up">
        <p class="font-mono text-xs tracking-[0.26em] text-[var(--color-moss)] uppercase">
          <span class="text-[var(--color-cream)]/40">02</span> &nbsp;·&nbsp; Parcours
        </p>
        <h2
          id="parcours-title"
          class="mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-4xl)] leading-[1.02] md:text-[length:var(--text-5xl)]"
        >
          <em class="italic">Formation</em><br />
          et trajectoire.
        </h2>

        <ol class="mt-12 space-y-0" data-reveal-stagger="0.1" data-reveal="up">
          {
            parcours.map((p, i) => (
              <li class="studio-parcours-item group grid grid-cols-[auto_1fr] gap-6 py-6 md:gap-10 md:py-7">
                <p class="font-mono text-[10px] tracking-[0.26em] text-[var(--color-laterite)] uppercase">
                  {String(i + 1).padStart(2, '0')}
                </p>
                <div>
                  <p class="font-[family-name:var(--font-heading)] text-[length:var(--text-xl)] leading-tight text-[var(--color-cream)]">
                    <em class="italic">{p.annee}</em>
                  </p>
                  <p class="mt-2 text-sm leading-relaxed text-[var(--color-cream)]/70">
                    {p.detail}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <aside
        class="studio-parcours-aside flex flex-col gap-8"
        data-reveal="up"
        data-reveal-delay="0.2"
      >
        <div class="studio-parcours-portrait overflow-hidden">
          <Image
            src={portrait02}
            alt="Jonathan Oliveira, portrait éditorial"
            widths={[480, 720, 960]}
            sizes="(min-width: 768px) 42vw, 92vw"
            quality={82}
            format="webp"
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </div>
        <blockquote class="studio-parcours-quote border-l border-[var(--color-laterite)]/40 pl-6">
          <p
            class="font-[family-name:var(--font-heading)] text-[length:var(--text-xl)] leading-[1.25] text-[var(--color-cream)]/85 italic md:text-[length:var(--text-2xl)]"
          >
            Dix ans de paysagisme avant de fonder le studio — pour comprendre d'abord le métier par
            l'intérieur, avant d'en proposer une <em class="text-[var(--color-laterite)] not-italic"
              >autre lecture</em
            >.
          </p>
          <footer
            class="mt-5 font-mono text-[10px] tracking-[0.26em] text-[var(--color-moss)] uppercase"
          >
            — Résumé du parcours
          </footer>
        </blockquote>
      </aside>
    </div>
  </Section>

  {/* ───── 03 · MÉTHODE forest immersif avec blockquote géant ───── */}
  <section
    class="studio-methode relative bg-[var(--color-forest)] text-[var(--color-cream)]"
    data-theme="dark"
    aria-labelledby="methode-title"
  >
    <div class="mx-auto max-w-7xl px-6 py-20 md:px-10 md:py-28">
      <div class="mb-12 md:mb-16" data-reveal="up">
        <p class="font-mono text-xs tracking-[0.26em] text-[var(--color-laterite)] uppercase">
          <span class="text-[var(--color-cream)]/40">03</span> &nbsp;·&nbsp; Méthode
        </p>
        <h2
          id="methode-title"
          class="mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-4xl)] leading-[1.02] md:text-[length:var(--text-5xl)]"
        >
          Je ne vends pas<br />
          une <em class="text-[var(--color-laterite)] italic">étude</em>.
        </h2>
      </div>

      <blockquote
        class="studio-quote mx-auto max-w-4xl font-[family-name:var(--font-heading)] text-[length:var(--text-3xl)] leading-[1.18] italic md:text-[length:var(--text-4xl)]"
        data-reveal="up"
      >
        Je vends une <em class="text-[var(--color-laterite)] not-italic">vision</em>, une
        <em class="text-[var(--color-moss)] not-italic">méthode</em>, une
        <em class="text-[var(--color-moss)] not-italic">expérience</em>, une
        <em class="text-[var(--color-laterite)] not-italic">sécurité de résultat</em>. Le client ne
        doit jamais avoir l'impression d'être vendu, mais plutôt : choisir, co-construire, s'élever
        vers un projet plus juste et plus qualitatif.
      </blockquote>

      <p
        class="mx-auto mt-12 max-w-2xl text-[length:var(--text-base)] leading-relaxed text-[var(--color-cream)]/75"
        data-reveal="up"
        data-reveal-delay="0.2"
      >
        Le parcours est simple et volontairement lent — trois temps, pour créer la relation,
        comprendre le lieu, et positionner la valeur avant de chiffrer.
      </p>

      <ol class="mt-16 space-y-0 md:mt-20" data-reveal-stagger="0.12" data-reveal="up">
        {
          etapesMethode.map((etape) => (
            <li class="studio-methode-item grid grid-cols-[auto_1fr] items-baseline gap-6 border-t border-[var(--color-cream)]/12 py-8 md:gap-16 md:py-10">
              <p class="font-mono text-[10px] tracking-[0.26em] text-[var(--color-laterite)] uppercase">
                {etape.num}
              </p>
              <div>
                <div class="flex flex-wrap items-baseline gap-4">
                  <h3 class="font-[family-name:var(--font-heading)] text-[length:var(--text-2xl)] leading-tight md:text-[length:var(--text-3xl)]">
                    <em class="italic">{etape.label}</em>
                  </h3>
                  <span class="font-mono text-[11px] tracking-[0.22em] text-[var(--color-moss)] uppercase">
                    {etape.duree}
                  </span>
                </div>
                <p class="mt-4 max-w-xl text-sm leading-relaxed text-[var(--color-cream)]/75">
                  {etape.detail}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ───── CTA final cream ───── */}
  <Section variant="forest" topDivider>
    <div class="text-center" data-reveal="slow">
      <p class="font-mono text-xs tracking-[0.26em] text-[var(--color-moss)] uppercase">
        Étape suivante
      </p>
      <h2
        class="mt-8 font-[family-name:var(--font-heading)] text-[length:var(--text-5xl)] leading-[1.02] text-[var(--color-cream)]"
      >
        Engager la <em class="text-[var(--color-laterite)] italic">conversation</em>.
      </h2>
      <p
        class="mx-auto mt-10 max-w-xl text-[length:var(--text-base)] leading-relaxed text-[var(--color-cream)]/70"
      >
        Premier échange téléphonique de 15 à 25 minutes pour qualifier le projet.
      </p>
      <div class="mt-12 flex flex-col items-center justify-center gap-6 md:flex-row md:gap-10">
        <a
          href="/contact"
          data-magnetic="0.3"
          class="inline-flex items-center gap-3 rounded-full border border-[var(--color-cream)] px-7 py-3.5 text-sm tracking-wide text-[var(--color-cream)] transition-colors hover:bg-[var(--color-forest)] hover:text-[var(--color-cream)]"
        >
          Prendre contact
          <span aria-hidden="true">→</span>
        </a>
        <a
          href={`tel:${SITE.contact.phone}`}
          class="text-sm text-[var(--color-cream)] underline underline-offset-4 hover:text-[var(--color-laterite)]"
        >
          {SITE.contact.phoneDisplay}
        </a>
      </div>
    </div>
  </Section>

  <style>
    /* Dot pulsant (signature) */
    .studio-dot {
      display: inline-block;
      width: 7px;
      height: 7px;
      margin-right: 0.4rem;
      border-radius: 50%;
      background-color: var(--color-laterite);
      vertical-align: middle;
      animation: studio-pulse 2.6s ease-in-out infinite;
    }
    @keyframes studio-pulse {
      0%,
      100% {
        opacity: 0.55;
        transform: scale(1);
      }
      50% {
        opacity: 1;
        transform: scale(1.3);
      }
    }

    /* Portrait Jonathan */
    .studio-portrait {
      aspect-ratio: 4 / 5;
      background-color: var(--color-forest);
      position: relative;
    }
    @media (min-width: 1024px) {
      .studio-portrait {
        aspect-ratio: 4 / 6;
      }
    }
    .studio-portrait-caption {
      position: absolute;
      bottom: 1.5rem;
      left: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      font-family: var(--font-mono), ui-monospace, monospace;
      font-size: 10px;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--color-cream);
      padding: 0.5rem 0.75rem;
      background-color: color-mix(in oklab, var(--color-forest) 85%, transparent);
      backdrop-filter: blur(4px);
    }
    .studio-portrait-caption em {
      font-family: var(--font-heading), serif;
      font-size: 14px;
      letter-spacing: 0;
      text-transform: none;
      color: var(--color-cream);
      font-variation-settings:
        'opsz' 144,
        'SOFT' 70;
    }

    /* Halo latérite dans la section Démarche forest */
    .studio-demarche-halo {
      position: absolute;
      top: -25%;
      right: -20%;
      width: 70%;
      height: 70%;
      background: radial-gradient(
        circle at center,
        color-mix(in oklab, var(--color-laterite) 32%, transparent) 0%,
        transparent 65%
      );
      pointer-events: none;
      opacity: 0.85;
    }

    /* Parcours timeline hover */
    .studio-parcours-item {
      border-bottom: 1px solid color-mix(in oklab, var(--color-forest) 12%, transparent);
      transition:
        background-color 0.3s ease,
        padding-left 0.4s var(--ease-out-editorial);
    }
    .studio-parcours-item:first-child {
      border-top: 1px solid color-mix(in oklab, var(--color-forest) 12%, transparent);
    }
    .studio-parcours-item:hover {
      background-color: color-mix(in oklab, var(--color-laterite) 4%, transparent);
      padding-left: 0.5rem;
    }

    /* Blockquote de méthode */
    .studio-quote {
      position: relative;
      padding-left: 2rem;
    }
    .studio-quote::before {
      content: '“';
      position: absolute;
      left: -0.5rem;
      top: -0.6em;
      font-family: var(--font-heading), serif;
      font-size: 6rem;
      line-height: 1;
      color: var(--color-laterite);
      opacity: 0.5;
      font-style: italic;
    }

    /* Étapes méthode hover */
    .studio-methode-item {
      transition: padding-left 0.4s var(--ease-out-editorial);
    }
    .studio-methode-item:hover {
      padding-left: 0.5rem;
    }
  </style>
</BaseLayout>
