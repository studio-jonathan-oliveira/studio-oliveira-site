---
/*
 * /studio — refonte DA Jonathan 2026-05-15 (trame "page studio.png").
 *
 * Architecture verticale issue de la trame :
 *   1. Hero Bienvenue (noir profond) — titre Bold UPPERCASE + 5 paragraphes
 *      Jonathan verbatim + photo végétale (col droite).
 *   2. Manifeste (rouge plein-bleed) — phrase Bold UPPERCASE justify.
 *   3. Architectures (rouge) — 4 lignes accordéon (Title Case Jonathan).
 *      Commit 1 : scaffold statique. Commit 2 : interactivité React island.
 *   4. Parcours et Expérience (noir) — H2 + portrait Jonathan + frise
 *      des 6 entrées de formation/expérience (sourcées PDF process).
 *   5. Footer global 2 cols (sera porté en 3 cols variant au commit 3).
 *
 * Contenu Jonathan : VERBATIM extrait de la trame (OCR multi-agents).
 * Aucun texte inventé. Frise parcours : 6 entrées du studio.astro précédent
 * (sourcées PDF PROCESS ETUDES STUDIO 2026, validation Morgan 2026-05-15).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { SITE } from '@/lib/site-config';
import { jsonLdGraph, breadcrumbs, localBusiness, organization, person } from '@/lib/schema-org';
import ArchitecturesAccordion from '@/components/islands/ArchitecturesAccordion';

// Photos studio fournies par Jonathan 2026-05-15 (retours v3). Sources
// brutes dans _assets/studio/, compressées via scripts/optimize-studio-source.ts.
import heroPhoto from '@/assets/studio/01-hero.jpg';
import parcoursPhoto from '@/assets/studio/02-parcours.jpg';

const schema = jsonLdGraph([
  organization(),
  person(),
  localBusiness(),
  breadcrumbs([
    { name: 'Accueil', item: '/' },
    { name: 'Studio', item: '/studio' },
  ]),
]);

// Bienvenue — 5 paragraphes Jonathan VERBATIM trame (OCR consolidé).
const bienvenue = [
  "Le studio J Oliveira a été créé en fin 2021 à la suite de 4 ans d'expérience en tant que chef de projet et dessinateur projeteur dans une entreprise d'aménagements paysagers à Limoges.",
  "Fort d'une expérience de plus de 9 ans dans l'architecture paysagère et diplômé d'une Licence Pro conception paysagère, j'ai construit mon design autour de mon admiration pour les paysages naturels et immersifs ainsi que de la pluralité des architectures qui animent nos espaces de vie.",
  "Le design est un art qui lie fonctionnalité, ergonomie et esthétique. C'est dans cette dimension que le studio conçoit ses projets.",
  "Le végétal, quant à lui, représente le liant de l'unité de l'ensemble des composantes spatiales pour créer cet environnement agréable et durable.",
  "Ce qu'il faut bien comprendre, c'est que je ne vends pas qu'une étude. Je vends par une méthode précise, une réflexion et une structuration globale qui sécurise un résultat final pour garantir une expérience d'usage durable.",
];

// 4 architectures Jonathan — libellés Title Case (respect strict trame) +
// descriptifs VERBATIM. Affichage commit 1 = scaffold fermé statique.
const architectures = [
  {
    titre: 'Architecture Bati',
    description:
      "L'architecture bati regroupe la dénomination de l'habitat, le lieu où les gens vivent, mangent et dorment naturellement. Cette structure essentielle orchestre la propriété comme un axe central de toutes les circulations et définie le tempo esthétique de toutes les architectures qui gravitent autour.",
  },
  {
    titre: "Architecture d'intérieur",
    description:
      "Cette architecture qui anime nos quotidiens intérieurs tant dans le monde du pro que du perso est surement celle qui impacte le plus notre perception et interpretation de l'espace. Elle est le guide de votre personnalité et influence toutes les autres architectures connectées.",
  },
  {
    titre: 'Architecture Paysagère',
    description:
      "A tort déconsidérée comme une architecture à part entière, elle se positionne bel et bien comme une structure de la vie à l'extérieur de l'environnement bati et connecté à l'entité de l'habitat. L'architecture paysagère accueille, reçoit, guide et prolonge toutes les expériences de vie de l'extérieur vers l'intérieur et de l'intérieur vers l'extérieur.",
  },
  {
    titre: 'Architecture Biophilique',
    description:
      "C'est l'architecture la plus vivante de toutes car elle connecte toutes les architectures en une seule architecture avec comme seul objectif : reproduire le contexte environnemental naturel pour apporter les bénéfices aux usagers des espaces non naturels. Elle prend, dans sa conception, les aspects naturels et les combine aux environnements humains pour rendre une synthèse expérientielle de l'habitat. C'est cette architecture que le Studio J Oliveira vous propose à travers son design.",
  },
];

// Parcours — 6 entrées sourcées PDF PROCESS ETUDES STUDIO 2026.
// Validation Morgan 2026-05-15 v3 : ordre INVERSÉ — du plus récent (création
// studio) au plus ancien (BAC).
const parcours = [
  {
    annee: `Création du Studio J Oliveira — ${SITE.foundedYear}`,
    detail: 'Studio de design biophilique indépendant, Brive-la-Gaillarde',
  },
  {
    annee: 'Chef de projet / Dessinateur-projeteur',
    detail: "4,5 ans — entreprise d'aménagements paysagers, Limoges",
  },
  { annee: 'Licence Pro Conception et aménagement paysagers', detail: '1 an, mention' },
  { annee: 'BTSA Aménagement paysagers', detail: '2 ans, mention' },
  { annee: 'Bac Pro Travaux paysagers', detail: '1 an, mention' },
  { annee: 'BAC ES', detail: 'Diplômé avec mention' },
];
---

<BaseLayout
  title="Studio J Oliveira — designer d'origine ibérique, architecture & scénographie végétale"
  description="Bienvenue dans le Studio J Oliveira, studio d'origine ibérique axé sur le design, l'architecture et la scénographie végétale en France. Brive, Bordeaux, Limoges."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={schema} />
  </Fragment>

  {/* ═════════ 1 · HERO BIENVENUE (noir profond) ═════════════════════════ */}
  <section
    id="bienvenue"
    data-section-label="Studio"
    data-theme="dark"
    class="studio-bienvenue full-bleed-bg relative overflow-hidden bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="bienvenue-title"
  >
    <div class="studio-bienvenue__inner">
      <div class="studio-bienvenue__text" data-reveal="up">
        {
          /* Titre VERBATIM trame Jonathan — Bold UPPERCASE, mots-clés
           « DESIGN », « ARCHITECTURE », « SCENOGRAPHIE VEGETALE » +
           appartenance « ORIGINE IBERIQUE » + ancrage « FRANCE ». */
        }
        <h1 id="bienvenue-title" class="studio-bienvenue__title">
          BIENVENUE DANS LE STUDIO J OLIVEIRA, STUDIO D'ORIGINE IBERIQUE AXE SUR LE DESIGN,
          L'ARCHITECTURE ET LA SCENOGRAPHIE VEGETALE EN FRANCE.
        </h1>

        <div class="studio-bienvenue__body">
          {bienvenue.map((para) => <p>{para}</p>)}
        </div>
      </div>

      <div class="studio-bienvenue__visual" data-reveal="slow">
        <Image
          src={heroPhoto}
          alt="Studio J Oliveira — projet biophilique signature"
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1024px) 42vw, 100vw"
          quality={82}
          format="webp"
          class="studio-bienvenue__img"
          loading="eager"
        />
      </div>
    </div>
  </section>

  {/* ═════════ 2 · MANIFESTE (rouge plein-bleed) ═════════════════════════ */}
  <section
    id="manifeste"
    data-section-label="Manifeste"
    data-theme="red"
    class="studio-manifeste full-bleed-bg relative overflow-hidden bg-[var(--color-red)] text-[var(--color-cream)]"
    aria-label="Manifeste du Studio J Oliveira"
  >
    <div class="studio-manifeste__inner">
      {
        /* Phrase manifeste VERBATIM trame. Bold UPPERCASE. Animation
         words-fade : chaque mot fade-in au scroll (pattern home). */
      }
      <blockquote
        class="studio-manifeste__quote"
        data-words-fade
        data-words-fade-stagger="0.02"
        data-words-fade-window="0,0.45"
      >
        CHAQUE ESPACE SE COMPOSE D'UN EXISTANT ET D'UN DEVENIR. COMPRENDRE L'EXISTANT POUR
        CONSTRUIRE LE DEVENIR NECESSITE UNE REFLEXION STRUCTUREE ET SENSIBLE EN CONSIDERANT TOUTES
        LES ARCHITECTURES CONNECTEES.
      </blockquote>
    </div>
  </section>

  {
    /* ═════════ 3 · ARCHITECTURES — accordéon 4 lignes (rouge) ═══════════
     Island React single-open. Hydratation client:visible (section bas de
     page, hors LCP). Animation height via grid-template-rows 0fr↔1fr. */
  }
  <section
    id="architectures"
    data-section-label="Architectures"
    data-theme="red"
    class="studio-architectures full-bleed-bg relative bg-[var(--color-red)] text-[var(--color-cream)]"
    aria-labelledby="architectures-title"
  >
    <h2 id="architectures-title" class="sr-only">Les quatre architectures connectées</h2>
    <ArchitecturesAccordion items={architectures} client:visible />
  </section>

  {/* ═════════ 4 · PARCOURS ET EXPERIENCE (noir profond) ════════════════ */}
  <section
    id="parcours"
    data-section-label="Parcours"
    data-theme="dark"
    class="studio-parcours full-bleed-bg relative bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="parcours-title"
  >
    <div class="studio-parcours__inner">
      {
        /* Justify-multi designbyad (retour Morgan v3 2026-05-15) :
         3 mots étalés sur la largeur via text-align: justify CSS natif,
         calage scroll-driven via setupJustifyMulti (pattern home). */
      }
      <h2
        id="parcours-title"
        class="studio-parcours__title"
        data-justify-multi
        data-justify-amp="60"
        data-justify-line-step="0.15"
        data-justify-line-window="0.55"
      >
        <span
          class="studio-parcours__title-line"
          data-justify-line
          data-justify-direction="from-right">PARCOURS ET EXPERIENCE</span
        >
      </h2>

      <div class="studio-parcours__grid">
        <div class="studio-parcours__photo" data-reveal="up">
          <Image
            src={parcoursPhoto}
            alt="Jonathan Oliveira au travail dans son studio de design"
            widths={[480, 720, 960, 1200]}
            sizes="(min-width: 1024px) 38vw, 100vw"
            quality={82}
            format="webp"
            class="studio-parcours__img"
            loading="lazy"
          />
        </div>

        {
          /* Pas de data-reveal-stagger sur l'OL (retour Morgan v2 :
           timeline invisible). Les LI s'affichent en flux normal. */
        }
        <ol class="studio-parcours__timeline">
          {
            parcours.map((p) => (
              <li class="studio-parcours__row">
                <p class="studio-parcours__row-annee">{p.annee}</p>
                <p class="studio-parcours__row-detail">{p.detail}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <style is:global>
    /* ═══════════════════════════════════════════════════════════════════════
   * /studio — refonte DA Jonathan 2026-05-15.
   * Tokens hérités du design system home (noir profond + rouge + cream).
   * ═══════════════════════════════════════════════════════════════════ */

    /* ─── 1 · Hero Bienvenue ─────────────────────────────────────────── */
    .studio-bienvenue {
      padding: clamp(7rem, 14vh, 10rem) 0 clamp(4rem, 8vw, 7rem);
    }
    .studio-bienvenue__inner {
      max-width: 1500px;
      margin: 0 auto;
      padding: 0 clamp(1.5rem, 5vw, 4rem);
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(2.5rem, 5vw, 4rem);
    }
    @media (min-width: 1024px) {
      .studio-bienvenue__inner {
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
        gap: clamp(3rem, 6vw, 5rem);
        align-items: start;
      }
    }
    /* Titre Bold UPPERCASE (règle stricte Jonathan). Casse signature
     visuelle, mis en valeur par contre-respiration du body en dessous. */
    .studio-bienvenue__title {
      font-family: var(--font-heading), sans-serif;
      font-weight: 700;
      font-size: clamp(1.3rem, 2.6vw, 2.3rem);
      line-height: 1.25;
      letter-spacing: -0.005em;
      text-transform: uppercase;
      color: var(--color-cream);
      margin: 0 0 clamp(2rem, 4vw, 3.5rem) 0;
      max-width: 60ch;
    }
    .studio-bienvenue__body {
      display: flex;
      flex-direction: column;
      gap: clamp(1rem, 1.6vw, 1.5rem);
      max-width: 56ch;
    }
    .studio-bienvenue__body p {
      font-family: var(--font-body), sans-serif;
      font-weight: 200;
      font-size: clamp(1rem, 1.15vw, 1.15rem);
      line-height: 1.65;
      color: color-mix(in oklab, var(--color-cream) 92%, transparent);
      /* Aligné gauche (retour Morgan v2 2026-05-15) — la trame Jonathan
         montre les paragraphes en flag-left, pas en justify. */
      text-align: left;
      margin: 0;
    }
    /* Visuel droite : portrait/jardin pleine hauteur de la grille en
     desktop, plus contenu en mobile. */
    .studio-bienvenue__visual {
      position: relative;
      overflow: hidden;
      aspect-ratio: 4 / 5;
      background-color: var(--color-ink);
    }
    @media (min-width: 1024px) {
      .studio-bienvenue__visual {
        aspect-ratio: auto;
        align-self: stretch;
        min-height: 540px;
      }
    }
    .studio-bienvenue__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    /* ─── 2 · Manifeste rouge ──────────────────────────────────────────── */
    .studio-manifeste {
      padding: clamp(5rem, 10vw, 9rem) 0 clamp(5rem, 10vw, 9rem);
    }
    .studio-manifeste__inner {
      max-width: 1500px;
      margin: 0 auto;
      padding: 0 clamp(1.5rem, 5vw, 4rem);
    }
    /* Phrase manifeste Bold UPPERCASE — règle stricte Jonathan + cohérence
     home (.manifeste-bold). Justifié, mots cliquablement aérés via
     word-spacing 10px global déjà actif via body. */
    .studio-manifeste__quote {
      font-family: var(--font-heading), sans-serif;
      font-weight: 700;
      font-size: clamp(1.5rem, 3.2vw, 3rem);
      line-height: 1.25;
      letter-spacing: -0.005em;
      text-transform: uppercase;
      text-align: justify;
      color: var(--color-cream);
      margin: 0;
      max-width: 100%;
      hyphens: none;
    }
    /* Mots animés words-fade — chaque <span class="word"> inline-block. */
    .studio-manifeste__quote .word {
      display: inline-block;
      opacity: 0;
      transform: translateY(10px);
      will-change: opacity, transform;
    }

    /* ─── 3 · Architectures (scaffold accordéon) ───────────────────────── */
    .studio-architectures {
      padding: clamp(1rem, 2vw, 2rem) 0 clamp(3rem, 6vw, 5rem);
    }
    .studio-architectures__list {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: 1px solid color-mix(in oklab, var(--color-cream) 28%, transparent);
    }
    .studio-architectures__item {
      border-bottom: 1px solid color-mix(in oklab, var(--color-cream) 28%, transparent);
    }
    /* Bouton header de chaque ligne — full-width, reset bordures par
       défaut du <button>, transition fond au hover. */
    .studio-architectures__summary {
      appearance: none;
      background: transparent;
      border: 0;
      width: 100%;
      cursor: pointer;
      color: inherit;
      font: inherit;
      text-align: left;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      padding: clamp(1.75rem, 3.5vw, 2.5rem) clamp(1.5rem, 5vw, 4rem);
      transition: background-color 0.3s ease;
    }
    .studio-architectures__summary:hover,
    .studio-architectures__summary:focus-visible {
      background-color: color-mix(in oklab, var(--color-ink) 10%, transparent);
      outline: none;
    }
    /* Title Case Jonathan respecté (rupture vs règle home UPPERCASE).
     Inter Medium pour lisibilité maximale sur fond rouge. */
    .studio-architectures__title {
      font-family: var(--font-heading), sans-serif;
      font-weight: 500;
      font-size: clamp(1.5rem, 3vw, 2.6rem);
      line-height: 1.15;
      letter-spacing: -0.005em;
      color: var(--color-cream);
    }
    .studio-architectures__icon {
      flex-shrink: 0;
      font-family: var(--font-heading), sans-serif;
      font-weight: 200;
      font-size: clamp(1.8rem, 3.2vw, 2.6rem);
      line-height: 1;
      color: var(--color-cream);
      transition: transform 0.35s var(--ease-out-editorial);
    }
    .studio-architectures__icon--open {
      transform: rotate(45deg);
    }
    /* Animation curtain clip-path (retour Morgan v3 2026-05-15 :
       « comme le menu burger »). Pattern identique à MenuPrimary :
       clip-path inset(0 0 100% 0) → inset(0 0 0 0), cubic-bezier
       (0.7, 0, 0.3, 1), 0.7s. Combiné avec max-height pour le layout. */
    .studio-architectures__collapse {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.7s cubic-bezier(0.7, 0, 0.3, 1);
    }
    .studio-architectures__collapse--open {
      max-height: 60rem;
    }
    .studio-architectures__collapse > .studio-architectures__panel {
      clip-path: inset(0 0 100% 0);
      transition: clip-path 0.75s cubic-bezier(0.7, 0, 0.3, 1);
    }
    .studio-architectures__collapse--open > .studio-architectures__panel {
      clip-path: inset(0 0 0 0);
    }
    /* Largeur totale page (retour Morgan v3 2026-05-15 : « doit être
       affiché sur la largeur totale »). max-width retiré, padding
       identique au summary. */
    .studio-architectures__panel {
      padding: 0 clamp(1.5rem, 5vw, 4rem) clamp(2rem, 4vw, 3rem);
    }
    .studio-architectures__panel p {
      font-family: var(--font-body), sans-serif;
      font-weight: 200;
      font-size: clamp(1rem, 1.15vw, 1.2rem);
      line-height: 1.65;
      color: color-mix(in oklab, var(--color-cream) 95%, transparent);
      text-align: left;
      margin: 0;
      max-width: none;
    }

    /* ─── 4 · Parcours et expérience ──────────────────────────────────── */
    .studio-parcours {
      padding: clamp(5rem, 10vw, 9rem) 0 clamp(5rem, 10vw, 9rem);
    }
    .studio-parcours__inner {
      max-width: 1500px;
      margin: 0 auto;
      padding: 0 clamp(1.5rem, 5vw, 4rem);
    }
    /* Titre justify-multi designbyad (retour Morgan v3 2026-05-15) —
       3 mots Bold UPPERCASE étalés sur toute la largeur via
       text-align: justify CSS natif, calage scroll piloté par
       setupJustifyMulti (motion-enhance.ts). */
    .studio-parcours__title {
      margin: 0 0 clamp(3rem, 6vw, 5rem) 0;
    }
    .studio-parcours__title-line {
      display: block;
      font-family: var(--font-heading), sans-serif;
      font-weight: 700;
      font-size: clamp(1.6rem, 5.5vw, 5rem);
      line-height: 1.1;
      letter-spacing: -0.01em;
      text-transform: uppercase;
      text-align: justify;
      text-align-last: justify;
      color: var(--color-cream);
      margin: 0;
      hyphens: none;
      white-space: nowrap;
      overflow: hidden;
    }
    @media (max-width: 767px) {
      .studio-parcours__title-line {
        white-space: normal;
        text-align: left;
        text-align-last: left;
      }
    }
    .studio-parcours__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(2.5rem, 5vw, 4rem);
    }
    @media (min-width: 1024px) {
      .studio-parcours__grid {
        grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
        gap: clamp(3rem, 6vw, 5rem);
        align-items: start;
      }
    }
    .studio-parcours__photo {
      position: relative;
      overflow: hidden;
      aspect-ratio: 3 / 4;
      background-color: var(--color-ink);
    }
    .studio-parcours__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }
    .studio-parcours__timeline {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: 1px solid color-mix(in oklab, var(--color-cream) 22%, transparent);
    }
    .studio-parcours__row {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.4rem;
      padding: clamp(1.25rem, 2.5vw, 1.75rem) 0;
      border-bottom: 1px solid color-mix(in oklab, var(--color-cream) 22%, transparent);
    }
    @media (min-width: 768px) {
      .studio-parcours__row {
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
        gap: clamp(1rem, 2vw, 2rem);
        align-items: baseline;
      }
    }
    .studio-parcours__row-annee {
      font-family: var(--font-heading), sans-serif;
      font-weight: 700;
      font-size: clamp(1rem, 1.2vw, 1.2rem);
      line-height: 1.3;
      letter-spacing: 0;
      text-transform: uppercase;
      color: var(--color-cream);
      margin: 0;
    }
    .studio-parcours__row-detail {
      font-family: var(--font-body), sans-serif;
      font-weight: 200;
      font-size: clamp(0.95rem, 1.1vw, 1.1rem);
      line-height: 1.55;
      color: color-mix(in oklab, var(--color-cream) 80%, transparent);
      margin: 0;
    }

    /* full-bleed-bg : sécurité au cas où le layout pose des marges latérales
     non désirées sur les sections (cohérence avec home). */
    .studio-bienvenue,
    .studio-manifeste,
    .studio-architectures,
    .studio-parcours {
      width: 100%;
    }
  </style>
</BaseLayout>
