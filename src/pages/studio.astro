---
/*
 * /studio — refonte DA Jonathan 2026-05-15 (trame "page studio.png").
 *
 * Architecture verticale issue de la trame :
 *   1. Hero Bienvenue (noir profond) — titre Bold UPPERCASE + 5 paragraphes
 *      Jonathan verbatim + photo végétale (col droite).
 *   2. Manifeste (rouge plein-bleed) — phrase Bold UPPERCASE justify.
 *   3. Architectures (rouge) — 4 lignes accordéon (Title Case Jonathan).
 *      Commit 1 : scaffold statique. Commit 2 : interactivité React island.
 *   4. Parcours et Expérience (noir) — H2 + portrait Jonathan + frise
 *      des 6 entrées de formation/expérience (sourcées PDF process).
 *   5. Footer global 2 cols (sera porté en 3 cols variant au commit 3).
 *
 * Contenu Jonathan : VERBATIM extrait de la trame (OCR multi-agents).
 * Aucun texte inventé. Frise parcours : 6 entrées du studio.astro précédent
 * (sourcées PDF PROCESS ETUDES STUDIO 2026, validation Morgan 2026-05-15).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { jsonLdGraph, breadcrumbs, localBusiness, organization, person } from '@/lib/schema-org';
import ArchitecturesAccordion from '@/components/islands/ArchitecturesAccordion';

// Photos studio fournies par Jonathan 2026-05-15 (retours v3). Sources
// brutes dans _assets/studio/, compressées via scripts/optimize-studio-source.ts.
import heroPhoto from '@/assets/studio/01-hero.jpg';
import parcoursPhoto from '@/assets/studio/02-parcours.jpg';

const schema = jsonLdGraph([
  organization(),
  person(),
  localBusiness(),
  breadcrumbs([
    { name: 'Accueil', item: '/' },
    { name: 'Studio', item: '/studio' },
  ]),
]);

// Bienvenue — 5 paragraphes Jonathan VERBATIM trame (OCR consolidé).
// v5 2026-05-15 : « Studio » majuscule + point après le « J » sur P1.
const bienvenue = [
  "Le studio J. Oliveira a été crée en fin 2021 à la suite de 4 ans d'expérience en tant que chef de projet et dessinateur projeteur dans une entreprise d'aménagements paysagers à Limoges.",
  "Fort d'une expérience de plus de 10 ans dans l'architecture paysagère et diplômé d'une Licence Pro conception paysagère, j'ai construit mon design autour de mon admiration pour les paysages naturels et immersifs ainsi que de la pluralité des architectures qui animent nos espaces de vie.",
  "Le design est un art qui lie fonctionnalité, ergonomie et esthétique. C'est dans cette dimension que le studio conçoit ses projets.",
  "Le végétal, quant à lui, représente le liant de l'ensemble des composantes spatiales pour créer cet environnement agréable et durable.",
  "Je construit, par une méthode précise, une réflexion et une structuration globale qui sécurise un résultat final pour garantir une expérience d'usage durable.",
];

// 4 architectures Jonathan — libellés Title Case (respect strict trame) +
// descriptifs VERBATIM. Affichage commit 1 = scaffold fermé statique.
const architectures = [
  {
    titre: 'Architecture Bati',
    description:
      "L'architecture bâtie regroupe la dénomination de l'habitat, le lieu où les gens vivent, mangent et dorment naturellement. Cette structure essentielle orchestre la propriété comme un axe central de toutes les circulations et définie le tempo esthétique de toutes les architectures qui gravitent autour.",
  },
  {
    titre: "Architecture d'Intérieur",
    description:
      "Cette architecture qui anime nos quotidiens intérieurs tant dans le monde du pro que du perso est surement celle qui impacte le plus notre perception et interpretation de l'espace. Elle est le guide de votre personnalité et influence toutes les autres architectures connectées.",
  },
  {
    titre: 'Architecture Paysagère',
    description:
      "A tort déconsidérée comme une architecture à part entière, elle se positionne bel et bien comme une structure de la vie à l'extérieur de l'environnement bati et connectée à l'entité de l'habitat. L'architecture paysagère accueille, reçoit, guide et prolonge toutes les expériences de vie de l'extérieur vers l'intérieur et de l'intérieur vers l'extérieur.",
  },
  {
    titre: 'Architecture Biophilique',
    description:
      "C'est l'architecture la plus vivante de toutes car elle connecte toutes les architectures en une seule avec comme seul objectif : reproduire le contexte environnemental naturel pour apporter les bénéfices aux usagers des espaces non naturels. Elle prend, dans sa conception, les aspects naturels et les combine aux environnements humains pour rendre une synthèse expérientielle de l'habitat. C'est cette architecture que le Studio J. Oliveira vous propose à travers son design.",
  },
];

// Parcours — 6 entrées sourcées PDF PROCESS ETUDES STUDIO 2026.
// Validation Morgan 2026-05-15 v3 : ordre INVERSÉ — du plus récent (création
// studio) au plus ancien (BAC).
const parcours = [
  {
    annee: 'Création du studio — 2021',
    detail: 'Studio de conception paysagère en indépendant',
  },
  {
    annee: 'Chef de projet / Dessinateur projeteur',
    detail: "4.5 ans / Entreprise d'aménagements paysagers, Limoges",
  },
  {
    annee: 'Licence Pro / Conception paysagère',
    detail: '1 an / Diplômé avec mention',
  },
  { annee: 'BTSA / Aménagements paysagers', detail: '2 ans / Diplômé avec mention' },
  { annee: 'BAC PRO / Travaux paysagers', detail: '1 an / Diplômé avec mention' },
];
---

<BaseLayout
  title="Studio J Oliveira — designer d'origine ibérique, architecture & scénographie végétale"
  description="Bienvenue dans le Studio J Oliveira, studio d'origine ibérique axé sur le design, l'architecture et la scénographie végétale en France. Brive, Bordeaux, Limoges."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={schema} />
  </Fragment>

  {/* ═════════ 1 · HERO « Bienvenue » (beige) ════════════════════════════ */}
  <section
    id="bienvenue"
    data-section-label="Studio"
    data-theme="light"
    class="studio-hero full-bleed-bg relative bg-[var(--color-cream)] text-[var(--color-ink)]"
    aria-labelledby="bienvenue-title"
  >
    <h1 id="bienvenue-title" class="sr-only">
      Bienvenue dans le Studio J Oliveira, studio d'origine ibérique axé sur le design,
      l'architecture et la scénographie végétale en France — Brive, Bordeaux, Limoges.
    </h1>
    <p class="studio-hero__word" aria-hidden="true">Bienvenue</p>
  </section>

  {/* ═════════ 2 · INTRO texte + photo (beige) ═══════════════════════════ */}
  <section
    id="intro"
    data-section-label="Le studio"
    data-theme="light"
    class="studio-intro full-bleed-bg relative bg-[var(--color-cream)] text-[var(--color-ink)]"
    aria-label="Présentation du studio"
  >
    <div class="studio-bienvenue__inner">
      <div class="studio-bienvenue__text">
        {
          /* Apparition wavy/vague mot par mot au scroll (trame « ANIMATION DU
            TEXTE STUDIO… »), même mécanique que les accordéons. */
        }
        <div
          class="studio-bienvenue__body"
          data-words-fade
          data-words-fade-stagger="0.004"
          data-words-fade-window="0.05,0.5"
        >
          {bienvenue.map((para) => <p>{para}</p>)}
        </div>
      </div>

      <div class="studio-bienvenue__visual" data-reveal="slow">
        <Image
          src={heroPhoto}
          alt="Studio J Oliveira — projet biophilique signature"
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1024px) 42vw, 100vw"
          quality={82}
          format="webp"
          class="studio-bienvenue__img"
          loading="eager"
        />
      </div>
    </div>
  </section>

  {/* ═════════ 2 · MANIFESTE (rouge plein-bleed) ═════════════════════════ */}
  <section
    id="manifeste"
    data-section-label="Manifeste"
    data-theme="light"
    class="studio-manifeste full-bleed-bg relative bg-[var(--color-cream)] text-[var(--color-ink)]"
    aria-label="Manifeste du Studio J Oliveira"
  >
    <div class="studio-manifeste__inner">
      {/* Phrase manifeste VERBATIM trame, Bold casse normale. */}
      <blockquote
        class="studio-manifeste__quote"
        data-words-fade
        data-words-fade-stagger="0.02"
        data-words-fade-window="0,0.45"
      >
        Composer avec toutes les architectures pour créer un ensemble uni.
      </blockquote>
    </div>
  </section>

  {
    /* ═════════ 3 · ARCHITECTURES — accordéon 4 lignes (rouge) ═══════════
     Island React single-open. Hydratation client:visible (section bas de
     page, hors LCP). Animation height via grid-template-rows 0fr↔1fr. */
  }
  <section
    id="architectures"
    data-section-label="Architectures"
    data-theme="light"
    class="studio-architectures full-bleed-bg relative bg-[var(--color-cream)] text-[var(--color-ink)]"
    aria-labelledby="architectures-title"
  >
    <h2 id="architectures-title" class="sr-only">Les quatre architectures connectées</h2>
    <ArchitecturesAccordion items={architectures} client:visible />
  </section>

  {/* ═════════ 4 · PARCOURS ET EXPERIENCE (noir profond) ════════════════ */}
  <section
    id="parcours"
    data-section-label="Parcours"
    data-theme="light"
    class="studio-parcours full-bleed-bg relative bg-[var(--color-cream)] text-[var(--color-ink)]"
    aria-labelledby="parcours-title"
  >
    {
      /* Titre justify-multi sur largeur TOTALE viewport (retour Morgan v4
       2026-05-15). Sorti du conteneur inner pour s'étendre bord-à-bord
       sans contrainte de padding lateral. */
    }
    <h2 id="parcours-title" class="studio-parcours__title">
      <span class="studio-parcours__title-line">Parcours et Expérience</span>
    </h2>

    <div class="studio-parcours__inner">
      <div class="studio-parcours__grid">
        <div class="studio-parcours__photo" data-reveal="up">
          <Image
            src={parcoursPhoto}
            alt="Jonathan Oliveira au travail dans son studio de design"
            widths={[480, 720, 960, 1200]}
            sizes="(min-width: 1024px) 38vw, 100vw"
            quality={82}
            format="webp"
            class="studio-parcours__img"
            loading="lazy"
          />
        </div>

        {
          /* Chaque ligne porte data-parcours-row → inView trigger
           individuel + cascade word-by-word interne (script en bas de
           page). Reveal style « CHAQUE ESPACE » mais déclenché ligne
           par ligne au scroll. */
        }
        <ol class="studio-parcours__timeline">
          {
            parcours.map((p) => (
              <li class="studio-parcours__row" data-parcours-row>
                <p class="studio-parcours__row-annee">{p.annee}</p>
                <p class="studio-parcours__row-detail">{p.detail}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <style is:global>
    /* ═══════════════════════════════════════════════════════════════════════
   * /studio — refonte DA Jonathan 2026-05-15.
   * Tokens hérités du design system home (noir profond + rouge + cream).
   * ═══════════════════════════════════════════════════════════════════ */

    /* ─── 1 · Hero Bienvenue ─────────────────────────────────────────── */
    .studio-bienvenue {
      padding: clamp(7rem, 14vh, 10rem) 0 clamp(4rem, 8vw, 7rem);
    }
    .studio-bienvenue__inner {
      width: 100%;
      padding: 0 clamp(1.5rem, 5vw, 4rem);
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(2.5rem, 5vw, 4rem);
      box-sizing: border-box;
    }
    @media (min-width: 1024px) {
      .studio-bienvenue__inner {
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
        gap: clamp(3rem, 6vw, 5rem);
        align-items: start;
      }
    }
    /* Titre H1 — bloc Bold UPPERCASE simple aligné gauche (retour Morgan
       v6 2026-05-15 : pas d'animation). */
    .studio-bienvenue__title {
      font-family: var(--font-heading), sans-serif;
      font-weight: 700;
      font-size: clamp(1.3rem, 2.6vw, 2.3rem);
      line-height: 1.25;
      letter-spacing: -0.005em;
      text-transform: uppercase;
      text-align: left;
      color: var(--color-cream);
      margin: 0 0 clamp(2rem, 4vw, 3.5rem) 0;
      max-width: none;
    }
    .studio-bienvenue__body {
      display: flex;
      flex-direction: column;
      gap: clamp(1rem, 1.6vw, 1.5rem);
      max-width: none;
    }
    .studio-bienvenue__body p {
      font-family: var(--font-body), sans-serif;
      font-weight: 200;
      font-size: clamp(1rem, 1.15vw, 1.15rem);
      line-height: 1.65;
      color: color-mix(in oklab, var(--color-cream) 92%, transparent);
      /* Aligné gauche (retour Morgan v2 2026-05-15) — la trame Jonathan
         montre les paragraphes en flag-left, pas en justify. */
      text-align: left;
      margin: 0;
    }
    /* Words-fade pattern (retour Morgan v5 2026-05-15) — identique au
       manifeste home. setupWordsFade pose un span.word par mot et
       interpole opacity + translateY au scroll dans la window définie. */
    .studio-bienvenue__body p .word {
      display: inline-block;
      opacity: 0;
      transform: translateY(10px);
      will-change: opacity, transform;
    }
    /* Visuel droite : portrait/jardin pleine hauteur de la grille en
     desktop, plus contenu en mobile. */
    .studio-bienvenue__visual {
      position: relative;
      overflow: hidden;
      aspect-ratio: 4 / 5;
      background-color: var(--color-ink);
    }
    @media (min-width: 1024px) {
      .studio-bienvenue__visual {
        aspect-ratio: auto;
        align-self: stretch;
        min-height: 540px;
      }
    }
    .studio-bienvenue__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    /* ─── 2 · Manifeste rouge ──────────────────────────────────────────── */
    .studio-manifeste {
      padding: clamp(5rem, 10vw, 9rem) 0 clamp(5rem, 10vw, 9rem);
    }
    .studio-manifeste__inner {
      width: 100%;
      padding: 0 clamp(1.5rem, 5vw, 4rem);
      box-sizing: border-box;
    }
    /* Phrase manifeste Bold UPPERCASE — règle stricte Jonathan + cohérence
     home (.manifeste-bold). Justifié, mots cliquablement aérés via
     word-spacing 10px global déjà actif via body. */
    .studio-manifeste__quote {
      font-family: var(--font-heading), sans-serif;
      font-weight: 700;
      font-size: clamp(1.5rem, 3.2vw, 3rem);
      line-height: 1.25;
      letter-spacing: -0.005em;
      text-transform: uppercase;
      text-align: justify;
      color: var(--color-cream);
      margin: 0;
      max-width: 100%;
      hyphens: none;
    }
    /* Mots animés words-fade — chaque <span class="word"> inline-block. */
    .studio-manifeste__quote .word {
      display: inline-block;
      opacity: 0;
      transform: translateY(10px);
      will-change: opacity, transform;
    }

    /* ─── 3 · Architectures (scaffold accordéon) ───────────────────────── */
    .studio-architectures {
      padding: clamp(1rem, 2vw, 2rem) 0 clamp(3rem, 6vw, 5rem);
    }
    .studio-architectures__list {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: 1px solid color-mix(in oklab, var(--color-cream) 28%, transparent);
    }
    .studio-architectures__item {
      border-bottom: 1px solid color-mix(in oklab, var(--color-cream) 28%, transparent);
    }
    /* Bouton header de chaque ligne — full-width, reset bordures par
       défaut du <button>, transition fond au hover. */
    .studio-architectures__summary {
      appearance: none;
      background: transparent;
      border: 0;
      width: 100%;
      cursor: pointer;
      color: inherit;
      font: inherit;
      text-align: left;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      padding: clamp(1.75rem, 3.5vw, 2.5rem) clamp(1.5rem, 5vw, 4rem);
      transition: background-color 0.3s ease;
    }
    .studio-architectures__summary:focus-visible {
      outline: 1px solid color-mix(in oklab, var(--color-cream) 40%, transparent);
      outline-offset: -1px;
    }
    /* Title Case Jonathan respecté (rupture vs règle home UPPERCASE).
       v7 retour Morgan : passe en Inter ExtraLight 200. */
    .studio-architectures__title {
      font-family: var(--font-heading), sans-serif;
      font-weight: 200;
      font-size: clamp(1.5rem, 3vw, 2.6rem);
      line-height: 1.15;
      letter-spacing: -0.005em;
      color: var(--color-cream);
    }
    .studio-architectures__icon {
      flex-shrink: 0;
      font-family: var(--font-heading), sans-serif;
      font-weight: 200;
      font-size: clamp(1.8rem, 3.2vw, 2.6rem);
      line-height: 1;
      color: var(--color-cream);
      transition: transform 0.35s var(--ease-out-editorial);
    }
    .studio-architectures__icon--open {
      transform: rotate(45deg);
    }
    /* Layout collapse — height JS-measured (v8 2026-05-15).
       Retour Morgan « encore plus fluide » : on anime height (mesurée
       au scrollHeight par React) au lieu de max-height fixe. La
       transition couvre 100% du mouvement visible, plus de temps mort.
       Close 0.28s ease-in-out, open 0.32s spring-out tendu. */
    .studio-architectures__collapse {
      height: 0;
      overflow: hidden;
      transition: height 0.26s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .studio-architectures__collapse--open {
      transition: height 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    }
    /* Largeur totale page (retour Morgan v3) — pas de max-width. */
    .studio-architectures__panel {
      padding: 0 clamp(1.5rem, 5vw, 4rem) clamp(2rem, 4vw, 3rem);
    }
    /* Texte : conteneur paragraphe — word-spacing souple, ligne lisible. */
    .studio-architectures__text {
      font-family: var(--font-body), sans-serif;
      font-weight: 200;
      font-size: clamp(1rem, 1.15vw, 1.2rem);
      line-height: 1.65;
      color: color-mix(in oklab, var(--color-cream) 95%, transparent);
      text-align: left;
      margin: 0;
      max-width: none;
    }
    /* État repos d'un mot — fermeture instantanée pour switch snappy. */
    .studio-architectures__word {
      display: inline-block;
      opacity: 0;
      transform: translateY(10px);
      will-change: opacity, transform;
      transition:
        opacity 0.08s ease,
        transform 0.08s ease;
    }
    /* Wave reveal — stagger 7ms, duration 0.38s, delay initial 50ms.
       v6 retour Morgan : « plus rapide ». La cascade reste fluide mais
       le panneau atteint la lisibilité en ~0.45-0.6s selon longueur. */
    .studio-architectures__collapse--open .studio-architectures__word {
      opacity: 1;
      transform: translateY(0);
      transition:
        opacity 0.38s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.42s cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: calc(var(--i, 0) * 7ms + 50ms);
    }
    /* Reduced motion — désactive la vague. */
    @media (prefers-reduced-motion: reduce) {
      .studio-architectures__word,
      .studio-architectures__collapse--open .studio-architectures__word {
        transition: opacity 0.15s linear !important;
        transition-delay: 0s !important;
        transform: none;
      }
    }
    .studio-architectures__panel p {
      font-family: var(--font-body), sans-serif;
      font-weight: 200;
      font-size: clamp(1rem, 1.15vw, 1.2rem);
      line-height: 1.65;
      color: color-mix(in oklab, var(--color-cream) 95%, transparent);
      text-align: left;
      margin: 0;
      max-width: none;
    }

    /* ─── 4 · Parcours et expérience ──────────────────────────────────── */
    .studio-parcours {
      padding: clamp(5rem, 10vw, 9rem) 0 clamp(5rem, 10vw, 9rem);
    }
    .studio-parcours__inner {
      width: 100%;
      padding: 0 clamp(1.5rem, 5vw, 4rem);
      box-sizing: border-box;
    }
    /* Titre justify-multi designbyad (retour Morgan v4 2026-05-15) —
       3 mots Bold UPPERCASE étalés sur la LARGEUR TOTALE viewport.
       Sorti du wrapper inner, garde son propre padding latéral léger. */
    .studio-parcours__title {
      width: 100%;
      padding: 0 clamp(1.5rem, 5vw, 4rem);
      margin: 0 0 clamp(3rem, 6vw, 5rem) 0;
      box-sizing: border-box;
    }
    .studio-parcours__title-line {
      display: block;
      width: 100%;
      font-family: var(--font-heading), sans-serif;
      font-weight: 700;
      font-size: clamp(1.6rem, 7vw, 6.5rem);
      line-height: 1.1;
      letter-spacing: -0.01em;
      text-transform: uppercase;
      text-align: justify;
      text-align-last: justify;
      color: var(--color-cream);
      margin: 0;
      hyphens: none;
      white-space: nowrap;
      overflow: hidden;
    }
    @media (max-width: 767px) {
      .studio-parcours__title-line {
        white-space: normal;
        text-align: left;
        text-align-last: left;
      }
    }
    .studio-parcours__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(2.5rem, 5vw, 4rem);
    }
    @media (min-width: 1024px) {
      .studio-parcours__grid {
        grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
        gap: clamp(3rem, 6vw, 5rem);
        align-items: start;
      }
    }
    .studio-parcours__photo {
      position: relative;
      overflow: hidden;
      aspect-ratio: 3 / 4;
      background-color: var(--color-ink);
    }
    .studio-parcours__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }
    .studio-parcours__timeline {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: 1px solid color-mix(in oklab, var(--color-cream) 22%, transparent);
    }
    .studio-parcours__row {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.4rem;
      padding: clamp(1.25rem, 2.5vw, 1.75rem) 0;
      border-bottom: 1px solid color-mix(in oklab, var(--color-cream) 22%, transparent);
    }
    @media (min-width: 768px) {
      .studio-parcours__row {
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
        gap: clamp(1rem, 2vw, 2rem);
        align-items: baseline;
      }
    }
    .studio-parcours__row-annee {
      font-family: var(--font-heading), sans-serif;
      font-weight: 700;
      font-size: clamp(1rem, 1.2vw, 1.2rem);
      line-height: 1.3;
      letter-spacing: 0;
      text-transform: uppercase;
      color: var(--color-cream);
      margin: 0;
    }
    .studio-parcours__row-detail {
      font-family: var(--font-body), sans-serif;
      font-weight: 200;
      font-size: clamp(0.95rem, 1.1vw, 1.1rem);
      line-height: 1.55;
      color: color-mix(in oklab, var(--color-cream) 80%, transparent);
      margin: 0;
    }

    /* Wave reveal par ligne — v9 retour Morgan « comme dans CHAQUE
       ESPACE, déclenché ligne par ligne au scroll, mais la ligne
       s'affiche entièrement sans avoir besoin de continuer à scroller ».
       Pattern inView trigger (pas scroll-driven) + cascade word-by-word
       interne via custom property --i. Le script en bas pose data-revealed
       sur la row quand elle entre dans le viewport. */
    /* v10 retour Morgan : plus lent + reversible. Le transition-delay
       sur l'état BASE est appliqué dans les deux sens (reveal +
       un-reveal), donc la cascade s'inverse naturellement au re-scroll
       vers le haut. */
    [data-parcours-row] .studio-parcours-word {
      display: inline-block;
      opacity: 0;
      transform: translateY(18px);
      will-change: opacity, transform;
      transition:
        opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: calc(var(--i, 0) * 32ms);
    }
    [data-parcours-row][data-revealed] .studio-parcours-word {
      opacity: 1;
      transform: translateY(0);
    }
    @media (prefers-reduced-motion: reduce) {
      [data-parcours-row] .studio-parcours-word,
      [data-parcours-row][data-revealed] .studio-parcours-word {
        transition: opacity 0.2s linear;
        transition-delay: 0s;
        transform: none;
      }
    }

    /* full-bleed-bg : sécurité au cas où le layout pose des marges latérales
     non désirées sur les sections (cohérence avec home). */
    .studio-bienvenue,
    .studio-manifeste,
    .studio-architectures,
    .studio-parcours {
      width: 100%;
    }

    /* ═══ DA FINALE beige/noir 2026-06-04 — hero « Bienvenue », intro, et
       recolor de toutes les sections (override des couleurs cream/rouge). ═══ */
    .studio-hero {
      width: 100%;
      min-height: 100svh;
      display: flex;
      align-items: flex-end;
      box-sizing: border-box;
      padding: clamp(2rem, 6vh, 5rem) clamp(1.5rem, 4vw, 4rem) clamp(3rem, 8vh, 6rem);
    }
    .studio-hero__word {
      margin: 0;
      font-family: var(--font-heading), sans-serif;
      font-weight: 900;
      font-size: clamp(3rem, 13vw, 14rem);
      line-height: 0.9;
      letter-spacing: -0.02em;
      text-transform: none;
      color: var(--color-ink);
    }
    .studio-intro {
      width: 100%;
      padding: clamp(2rem, 5vw, 4rem) 0 clamp(4rem, 8vw, 7rem);
    }
    .studio-bienvenue__body p {
      color: var(--color-ink);
    }
    .studio-bienvenue__visual {
      background-color: color-mix(in oklab, var(--color-ink) 6%, var(--color-cream));
      border-radius: clamp(12px, 1.5vw, 22px);
    }
    /* Manifeste beige : phrase Bold casse normale, aligné gauche. */
    .studio-manifeste__quote {
      color: var(--color-ink);
      text-transform: none;
      text-align: left;
      max-width: 24ch;
    }
    /* Accordéon architectures beige : filets + textes en ink, titres Bold. */
    .studio-architectures__list,
    .studio-architectures__item,
    .studio-architectures__summary {
      border-color: color-mix(in oklab, var(--color-ink) 22%, transparent);
    }
    .studio-architectures__title {
      color: var(--color-ink);
      font-weight: 700;
    }
    .studio-architectures__icon {
      color: var(--color-ink);
    }
    .studio-architectures__text,
    .studio-architectures__panel p {
      color: color-mix(in oklab, var(--color-ink) 92%, transparent);
    }
    .studio-architectures__summary:focus-visible {
      outline-color: color-mix(in oklab, var(--color-ink) 45%, transparent);
    }
    /* Séparateurs accordéon arrondis à droite (parti-pris trames). */
    .studio-architectures__summary {
      border-bottom: 1px solid color-mix(in oklab, var(--color-ink) 22%, transparent);
      border-right: 1px solid color-mix(in oklab, var(--color-ink) 22%, transparent);
      border-bottom-right-radius: clamp(18px, 2.5vw, 32px);
    }
    .studio-architectures__list {
      border-top: 0;
    }
    .studio-architectures__item {
      border-bottom: 0;
    }
    /* Parcours beige : titre Bold casse normale aligné gauche. */
    .studio-parcours__title-line {
      text-transform: none;
      text-align: left;
      text-align-last: left;
      white-space: normal;
      color: var(--color-ink);
      font-size: clamp(2rem, 5vw, 4.5rem);
      font-weight: 800;
    }
    .studio-parcours__timeline,
    .studio-parcours__row {
      border-color: color-mix(in oklab, var(--color-ink) 22%, transparent);
    }
    .studio-parcours__row-annee {
      color: var(--color-ink);
      text-transform: none;
    }
    .studio-parcours__row-detail {
      color: color-mix(in oklab, var(--color-ink) 70%, transparent);
    }
    .studio-parcours__photo {
      background-color: color-mix(in oklab, var(--color-ink) 6%, var(--color-cream));
      border-radius: clamp(12px, 1.5vw, 22px);
    }
  </style>

  {
    /* Script inline pour la wave reveal par ligne du parcours.
     1. Split annee + detail en spans .studio-parcours-word avec --i
     2. IntersectionObserver par ligne → ajoute data-revealed à l'entrée. */
  }
  <script>
    (() => {
      const rows = document.querySelectorAll<HTMLElement>('[data-parcours-row]');
      if (rows.length === 0) return;

      rows.forEach((row) => {
        // Split chaque <p> enfant en mots, en preservant les espaces.
        row.querySelectorAll<HTMLElement>('p').forEach((p) => {
          const text = p.textContent ?? '';
          p.textContent = '';
          let i = 0;
          text.split(/(\s+)/).forEach((token) => {
            if (/^\s+$/.test(token)) {
              p.appendChild(document.createTextNode(token));
            } else if (token) {
              const span = document.createElement('span');
              span.className = 'studio-parcours-word';
              span.style.setProperty('--i', String(i));
              span.textContent = token;
              p.appendChild(span);
              i++;
            }
          });
        });
      });

      // inView trigger réversible (v10 retour Morgan) : on toggle
      // data-revealed selon entry/exit. Re-scroll vers le haut →
      // la cascade s'inverse naturellement via les mêmes transitions.
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const el = entry.target as HTMLElement;
            if (entry.isIntersecting) {
              el.setAttribute('data-revealed', '');
            } else {
              el.removeAttribute('data-revealed');
            }
          });
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.1 },
      );

      rows.forEach((row) => io.observe(row));
    })();
  </script>
</BaseLayout>
