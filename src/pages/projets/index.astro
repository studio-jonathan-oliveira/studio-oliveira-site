---
/*
 * /projets — Hub unifié "Projets" (PDF l. 727).
 * Agrège les deux portefeuilles : réalisations (photos réelles) + conceptions (rendus Twinmotion scroll-scrub).
 *
 * Source PDF Jonathan : ligne 727 — "Projets" est un des 6 onglets du menu déroulé.
 * Ce hub sert à orienter le visiteur vers :
 *   - /realisations        — projets livrés avec photos réelles
 *   - /conceptions         — projets en conception avec rendus immersifs
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/astro/Section.astro';
import SectionHeader from '@/components/astro/SectionHeader.astro';
import { jsonLdGraph, organization, localBusiness, breadcrumbs } from '@/lib/schema-org';

const schema = jsonLdGraph([
  organization(),
  localBusiness(),
  breadcrumbs([
    { name: 'Accueil', item: '/' },
    { name: 'Projets', item: '/projets' },
  ]),
]);
---

<BaseLayout
  title="Projets — Studio J Oliveira"
  description="Portefeuille du Studio J Oliveira. Projets réalisés (photos) et conceptions immersives (rendus Twinmotion). Jardins, intérieurs, LCD atypiques."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <Section variant="cream" class="pt-40 md:pt-48">
    <div class="max-w-3xl" data-reveal="up">
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-[var(--color-moss)]">
        Portefeuille
      </p>
      <h1
        class="mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-5xl)] leading-[1.02] tracking-tight text-[var(--color-forest)]"
      >
        Projets — <em class="italic">réalisations</em> et <em class="italic">conceptions</em>.
      </h1>
      <p class="mt-10 max-w-2xl text-[length:var(--text-lg)] leading-relaxed text-[var(--color-forest)]/80">
        Deux portefeuilles parallèles. D'un côté les <a href="/realisations" class="border-b border-[var(--color-forest)]/30 hover:border-[var(--color-moss)]">réalisations</a> — projets livrés, photographiés. De l'autre les <a href="/conceptions" class="border-b border-[var(--color-forest)]/30 hover:border-[var(--color-moss)]">conceptions</a> — études approfondies, parcourues en rendu photoréaliste.
      </p>
    </div>
  </Section>

  <Section variant="cream" topDivider>
    <ul
      data-reveal-stagger="0.14"
      data-reveal="up"
      class="grid grid-cols-1 gap-px bg-[var(--color-forest)]/10 md:grid-cols-2"
    >
      <li class="bg-[var(--color-cream)]">
        <a
          href="/realisations"
          class="group flex h-full flex-col justify-between p-10 transition-colors hover:bg-[var(--color-moss)]/5 md:p-14"
        >
          <div>
            <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-moss)]">
              01 · Réalisations
            </p>
            <h2 class="mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-3xl)] leading-tight text-[var(--color-forest)]">
              Projets livrés.
            </h2>
            <p class="mt-4 text-sm leading-relaxed text-[var(--color-forest)]/70">
              Photographies des projets menés à terme. Jardins, intérieurs végétalisés, LCD
              atypiques. [À ENRICHIR — inventaire projets Jonathan.]
            </p>
          </div>
          <span class="mt-10 inline-flex items-center gap-2 text-sm text-[var(--color-forest)] transition-transform group-hover:translate-x-1">
            Parcourir les réalisations
            <span aria-hidden="true">→</span>
          </span>
        </a>
      </li>

      <li class="bg-[var(--color-cream)]">
        <a
          href="/conceptions"
          class="group flex h-full flex-col justify-between p-10 transition-colors hover:bg-[var(--color-moss)]/5 md:p-14"
        >
          <div>
            <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-moss)]">
              02 · Conceptions
            </p>
            <h2 class="mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-3xl)] leading-tight text-[var(--color-forest)]">
              Études immersives.
            </h2>
            <p class="mt-4 text-sm leading-relaxed text-[var(--color-forest)]/70">
              Rendus photoréalistes parcourus au scroll. Jonathan livre les parcours caméra
              Twinmotion, le site les transforme en expériences immersives scroll-scrub.
            </p>
          </div>
          <span class="mt-10 inline-flex items-center gap-2 text-sm text-[var(--color-forest)] transition-transform group-hover:translate-x-1">
            Parcourir les conceptions
            <span aria-hidden="true">→</span>
          </span>
        </a>
      </li>
    </ul>
  </Section>

  <Section variant="forest" topDivider>
    <div class="mx-auto max-w-4xl text-center" data-reveal="slow">
      <p class="font-mono text-xs uppercase tracking-[0.28em] text-[var(--color-moss)]">
        Engager la conversation
      </p>
      <h2
        class="mt-8 font-[family-name:var(--font-heading)] text-[length:var(--text-4xl)] leading-[1.05] text-[var(--color-cream)]"
      >
        Un projet à <em class="italic text-[var(--color-gold)]">étudier</em> ?
      </h2>
      <a
        href="/contact"
        data-magnetic="0.3"
        class="mt-12 inline-flex items-center gap-3 border border-[var(--color-cream)] px-7 py-3.5 text-sm tracking-wide text-[var(--color-cream)] transition-colors hover:bg-[var(--color-cream)] hover:text-[var(--color-forest)]"
      >
        Démarrer un projet
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </Section>
</BaseLayout>
