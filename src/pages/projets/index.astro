---
/*
 * /projets — refonte DA finale 2026-06-04 (trame « projet » + 3 trames
 * accordéons). Hub = hero noir « Projets » + 3 accordéons exclusifs :
 *   1. Etudes et Conceptions   (trame accordeon-etude-et-conception)
 *   2. Réalisations            (trame accordeon-realisations)
 *   3. Galerie Studio          (trame accordeon-galerie-studio)
 *
 * Accordéon natif <details name> (exclusif, sans JS). Icône + → × via CSS.
 * Chaque accordéon déploie une grille de cartes projet (zoom-card → lightbox
 * global, flou au survol + « Agrandir »).
 *
 * CONTENU = verbatim extrait des trames (fautes conservées). IMAGES =
 * placeholders en attendant les visuels Jonathan (sous-dossiers 01-/02-…).
 * Voir _brief/trames-finales-specs/accordeon-*.md.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { jsonLdGraph, organization, localBusiness, breadcrumbs } from '@/lib/schema-org';

const schema = jsonLdGraph([
  organization(),
  localBusiness(),
  breadcrumbs([
    { name: 'Accueil', item: '/' },
    { name: 'Projets', item: '/projets' },
  ]),
]);

// ── Cartes ÉTUDES & CONCEPTIONS (vignette Twinmotion + overlay 4 lignes) ──
const conceptions = [
  { l1: 'Coeur urbain', l2: 'Jardin de ville', l3: 'Conception, 2024', l4: 'Corrèze' },
  { l1: 'Frange urbaine', l2: 'Jardin familial', l3: 'Conception, 2026', l4: 'Corrèze' },
  { l1: 'Domaine & Caractère', l2: 'Domaine familial', l3: 'Conception, 2023', l4: 'Corrèze' },
  {
    l1: 'Jardin Forêt',
    l2: 'Projet Public',
    l3: 'Conception, 2023',
    l4: 'Polyclinique Chénieux – Limoges',
  },
  { l1: 'Micro urbain', l2: 'Patio extérieur', l3: 'Conception, 2022', l4: 'Corrèze' },
  {
    l1: 'Airbnb atypique',
    l2: "Collab. archi. d'intérieur",
    l3: 'Co-conception, 2025',
    l4: 'Agde',
  },
  { l1: 'Airbnb atypique', l2: '', l3: 'Conception, 2026', l4: 'Valenciennes' },
  { l1: 'Micro urbain', l2: "Terrasse d'appartement", l3: 'Conception, 2021', l4: 'Haute-Vienne' },
  { l1: 'Domaine & Caractère', l2: 'Château classé XIIIs.', l3: 'Conception, 2024', l4: 'Corrèze' },
];

// ── Cartes RÉALISATIONS (overlay Titre / Établissement / Type / année / ville) ──
const realisations = [
  {
    titre: 'Airbnb atypique',
    etab: 'Jungle Room — Chammartz Suite',
    annee: '2024',
    ville: 'Uzerche',
  },
  { titre: 'Façade végétalisée', etab: 'Café de Paris — Brasserie', annee: '2025', ville: 'Brive' },
  {
    titre: 'Verrière végétalisée',
    etab: 'Café de Paris — Brasserie',
    annee: '2025',
    ville: 'Brive',
  },
  {
    titre: 'Glycine artificielle 5m',
    etab: 'Atelier Elite Coiffure',
    annee: '2022',
    ville: 'Brive',
  },
  { titre: 'Plafond arboré', etab: 'Atelier Elite Coiffure', annee: '2026', ville: 'Brive' },
  {
    titre: 'Mur en bouteille floral',
    etab: 'Café de Paris — Brasserie',
    annee: '2025',
    ville: 'Brive',
  },
  { titre: 'Jungle Work Box', etab: 'Schmidt Cuisine', annee: '2025', ville: 'Brive' },
  { titre: 'Airbnb atypique', etab: 'Jungle Room — Eden Suite', annee: '2025', ville: 'Roanne' },
  { titre: 'Mur végétalisé', etab: 'YG coiffure', annee: '2023', ville: 'Objat' },
  { titre: 'Jardinet tropical', etab: '', annee: '2021', ville: 'Limoges' },
];

// Conceptions en 2 colonnes QUINCONCE (trame : colonne droite décalée vers
// le bas). Positions d'overlay variées par carte (trame : le texte change de
// coin d'une carte à l'autre). On évite « bas-gauche » (réservé à la pill).
const concPos = ['pos-tl', 'pos-br', 'pos-tc', 'pos-tr', 'pos-cl', 'pos-bc'];
// On conserve l'index original (n) pour mapper la photo correspondante
// (public/projets/conceptions/0N.webp) malgré le split quinconce.
const concItems = conceptions.map((c, i) => ({ ...c, n: i + 1 }));
const concGauche = concItems.filter((_, i) => i % 2 === 0);
const concDroite = concItems.filter((_, i) => i % 2 === 1);

// ── Galerie Studio : masonry 3 colonnes, ratios variés. 28 photos Jonathan
// (public/projets/galerie/0N.webp). ──
const galerie = Array.from({ length: 28 }, (_, i) => i + 1);
const galCols: number[][] = [[], [], []];
galerie.forEach((n, i) => {
  (galCols[i % 3] as number[]).push(n);
});
// Ratios cyclés pour évoquer le masonry tant que les vraies photos manquent.
const galRatios = ['3 / 4', '1 / 1', '4 / 3', '3 / 4', '4 / 3', '1 / 1'];
---

<BaseLayout
  title="Projets — études, conceptions, réalisations & galerie studio"
  description="Portefeuille du Studio J Oliveira. Études et conceptions en rendu Twinmotion, réalisations photographiées et galerie du studio."
  darkHero
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={schema} is:inline />
  </Fragment>

  {/* ───── HERO noir « Projets » ───── */}
  <section
    id="hero"
    data-section-label="Projets"
    data-theme="dark"
    class="proj-hero"
    aria-labelledby="proj-title"
  >
    <h1 id="proj-title" class="proj-hero__title">Projets</h1>
  </section>

  {/* ───── 3 accordéons exclusifs ───── */}
  <section data-theme="dark" class="proj-acc" aria-label="Portefeuille du studio">
    {/* 1 · Études et Conceptions — 2 colonnes quinconce, texte crème sur image */}
    <details class="proj-acc__item" name="projets-acc">
      <summary class="proj-acc__summary">
        <span class="proj-acc__title">Etudes et Conceptions</span>
        <span class="proj-acc__icon" aria-hidden="true"></span>
      </summary>
      <div class="proj-acc__panel">
        <div class="proj-masonry proj-masonry--2">
          <div class="proj-col">
            {
              concGauche.map((c, j) => (
                <button
                  class={`zoom-card proj-card proj-card--conc ${concPos[(2 * j) % concPos.length]}`}
                  data-zoom-src={`/projets/conceptions/${String(c.n).padStart(2, '0')}.webp`}
                  data-zoom-alt={`${c.l1} — ${c.l4}`}
                >
                  <img
                    class="zoom-card__img"
                    src={`/projets/conceptions/${String(c.n).padStart(2, '0')}.webp`}
                    alt={`${c.l1} — ${c.l4}`}
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="zoom-card__pill">Agrandir</span>
                  <span class="proj-card__overlay">
                    <span class="proj-card__l1">{c.l1}</span>
                    {c.l2 && <span class="proj-card__l">{c.l2}</span>}
                    <span class="proj-card__l">{c.l3}</span>
                    <span class="proj-card__l">{c.l4}</span>
                  </span>
                </button>
              ))
            }
          </div>
          <div class="proj-col proj-col--offset">
            {
              concDroite.map((c, j) => (
                <button
                  class={`zoom-card proj-card proj-card--conc ${concPos[(2 * j + 1) % concPos.length]}`}
                  data-zoom-src={`/projets/conceptions/${String(c.n).padStart(2, '0')}.webp`}
                  data-zoom-alt={`${c.l1} — ${c.l4}`}
                >
                  <img
                    class="zoom-card__img"
                    src={`/projets/conceptions/${String(c.n).padStart(2, '0')}.webp`}
                    alt={`${c.l1} — ${c.l4}`}
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="zoom-card__pill">Agrandir</span>
                  <span class="proj-card__overlay">
                    <span class="proj-card__l1">{c.l1}</span>
                    {c.l2 && <span class="proj-card__l">{c.l2}</span>}
                    <span class="proj-card__l">{c.l3}</span>
                    <span class="proj-card__l">{c.l4}</span>
                  </span>
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </details>

    {/* 2 · Réalisations — 2 colonnes régulières, texte crème haut-gauche */}
    <details class="proj-acc__item" name="projets-acc">
      <summary class="proj-acc__summary">
        <span class="proj-acc__title">Réalisations</span>
        <span class="proj-acc__icon" aria-hidden="true"></span>
      </summary>
      <div class="proj-acc__panel">
        <div class="proj-grid proj-grid--2">
          {
            realisations.map((r, i) => (
              <button
                class="zoom-card proj-card proj-card--real"
                data-zoom-src={`/projets/realisations/${String(i + 1).padStart(2, '0')}.webp`}
                data-zoom-alt={`${r.titre} — ${r.ville}`}
              >
                <img
                  class="zoom-card__img"
                  src={`/projets/realisations/${String(i + 1).padStart(2, '0')}.webp`}
                  alt={`${r.titre} — ${r.ville}`}
                  loading="lazy"
                  decoding="async"
                />
                <span class="zoom-card__pill">Agrandir</span>
                <span class="proj-card__overlay">
                  <span class="proj-card__l1">{r.titre}</span>
                  {r.etab && <span class="proj-card__l">{r.etab}</span>}
                  <span class="proj-card__l">Réalisation, {r.annee}</span>
                  <span class="proj-card__l">{r.ville}</span>
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </details>

    {/* 3 · Galerie Studio — masonry 3 colonnes, vignettes seules (sans texte) */}
    <details class="proj-acc__item" name="projets-acc">
      <summary class="proj-acc__summary">
        <span class="proj-acc__title">Galerie Studio</span>
        <span class="proj-acc__icon" aria-hidden="true"></span>
      </summary>
      <div class="proj-acc__panel">
        <div class="proj-masonry proj-masonry--3">
          {
            galCols.map((col) => (
              <div class="proj-col">
                {col.map((n) => (
                  <button
                    class="zoom-card proj-card proj-card--gal"
                    data-zoom-src={`/projets/galerie/${String(n).padStart(2, '0')}.webp`}
                    data-zoom-alt={`Galerie studio ${n}`}
                    style={`aspect-ratio:${galRatios[(n - 1) % galRatios.length]}`}
                  >
                    <img
                      class="zoom-card__img"
                      src={`/projets/galerie/${String(n).padStart(2, '0')}.webp`}
                      alt={`Galerie studio ${n}`}
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="zoom-card__pill">Agrandir</span>
                  </button>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </details>
  </section>

  <style>
    /* Hero noir plein, H1 « Projets » bas-gauche, Bold. */
    .proj-hero {
      width: 100%;
      min-height: 100svh;
      background-color: var(--color-ink);
      color: var(--color-cream);
      display: flex;
      align-items: flex-end;
      box-sizing: border-box;
      padding: clamp(2rem, 6vh, 5rem) clamp(1.5rem, 4vw, 4rem) clamp(3rem, 8vh, 6rem);
    }
    .proj-hero__title {
      margin: 0;
      font-family: var(--font-heading), sans-serif;
      font-weight: 900;
      font-size: clamp(3.5rem, 14vw, 15rem);
      line-height: 0.9;
      letter-spacing: -0.02em;
      text-transform: none;
      color: var(--color-cream);
    }

    /* Accordéons sur fond noir, texte cream. */
    .proj-acc {
      width: 100%;
      background-color: var(--color-ink);
      color: var(--color-cream);
      padding: clamp(2rem, 5vw, 4rem) 0 clamp(4rem, 8vw, 7rem);
    }
    /* Liserets COURBÉS À DROITE (réf. TypologieHero, uniformisation sitewide
       Morgan 2026-06-05) : trait bas + trait droit qui se rejoignent en courbe
       au coin bas-droit. Épaisseur unique --stroke-liseret. */
    .proj-acc__item {
      border-bottom: var(--stroke-liseret) solid
        color-mix(in oklab, var(--color-cream) 22%, transparent);
      border-right: var(--stroke-liseret) solid
        color-mix(in oklab, var(--color-cream) 22%, transparent);
      border-bottom-right-radius: var(--radius-liseret);
    }
    .proj-acc__item:first-of-type {
      border-top: var(--stroke-liseret) solid
        color-mix(in oklab, var(--color-cream) 22%, transparent);
    }
    .proj-acc__summary {
      list-style: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      /* Écart titre→liseret = padding-bottom, égal à l'écart liseret→texte
         (panel padding-top) — règle accordéon globale Morgan 2026-06-05. */
      padding: clamp(1.5rem, 3.5vw, 2.5rem) clamp(1.5rem, 5vw, 4rem) clamp(1.25rem, 2.5vw, 2rem);
    }
    .proj-acc__summary::-webkit-details-marker {
      display: none;
    }
    /* Titre : graisse normale au repos → GRAS quand l'accordéon est ouvert
       (règle accordéon globale). */
    .proj-acc__title {
      font-family: var(--font-heading), sans-serif;
      font-weight: 400;
      font-size: clamp(1.6rem, 4vw, 3.5rem);
      line-height: 1;
      letter-spacing: -0.01em;
      color: var(--color-cream);
      transition: font-weight 0.3s var(--ease-out-editorial);
    }
    .proj-acc__item[open] .proj-acc__title {
      font-weight: 700;
    }
    /* Icône + (fermé) → × (ouvert) via rotation 45°. */
    .proj-acc__icon {
      position: relative;
      flex-shrink: 0;
      width: clamp(22px, 2.4vw, 34px);
      height: clamp(22px, 2.4vw, 34px);
      transition: transform 0.4s var(--ease-out-editorial);
    }
    .proj-acc__icon::before,
    .proj-acc__icon::after {
      content: '';
      position: absolute;
      background-color: var(--color-cream);
    }
    .proj-acc__icon::before {
      top: 50%;
      left: 0;
      right: 0;
      height: 2px;
      transform: translateY(-50%);
    }
    .proj-acc__icon::after {
      left: 50%;
      top: 0;
      bottom: 0;
      width: 2px;
      transform: translateX(-50%);
    }
    .proj-acc__item[open] .proj-acc__icon {
      transform: rotate(45deg);
    }
    .proj-acc__panel {
      padding: 0 clamp(1.5rem, 5vw, 4rem) clamp(2.5rem, 5vw, 4rem);
    }

    /* Grille régulière (réalisations) — 2 colonnes, cartes paysage. */
    .proj-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(1rem, 2.5vw, 2rem);
    }
    @media (min-width: 768px) {
      .proj-grid--2 {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    /* Masonry par colonnes (conceptions 2 col quinconce, galerie 3 col). */
    .proj-masonry {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(1rem, 2.5vw, 2rem);
      align-items: start;
    }
    @media (min-width: 768px) {
      .proj-masonry--2 {
        grid-template-columns: repeat(2, 1fr);
      }
      .proj-masonry--3 {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    .proj-col {
      display: flex;
      flex-direction: column;
      gap: clamp(1rem, 2.5vw, 2rem);
    }
    /* Quinconce : colonne droite décalée vers le bas (trame conceptions). */
    @media (min-width: 768px) {
      .proj-col--offset {
        margin-top: clamp(3rem, 8vw, 7rem);
      }
    }

    /* Ratios par défaut des cartes (galerie surchargée inline par carte). */
    .proj-card--conc {
      aspect-ratio: 3 / 2;
    }
    .proj-card--real {
      aspect-ratio: 16 / 10;
    }

    /* Placeholder visuel (en attendant les vraies photos Jonathan) : carte
       charbon nettement plus claire que le fond noir → la carte se lit, et le
       texte crème reste lisible par-dessus. Remplacé par la vraie photo
       (.zoom-card__img) quand data-zoom-src est renseigné. */
    .proj-card__ph {
      position: absolute;
      inset: 0;
      background-color: color-mix(in oklab, var(--color-cream) 16%, var(--color-ink));
    }
    /* Vraies photos Jonathan : l'image remplit la carte (comme l'ancien
       placeholder). Le flou au survol vient du composant zoom-card global. */
    .proj-card .zoom-card__img {
      position: absolute;
      inset: 0;
    }
    .proj-card--gal .proj-card__ph::after {
      content: 'Visuel à venir';
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-body), sans-serif;
      font-size: clamp(0.7rem, 0.9vw, 0.85rem);
      letter-spacing: 0.04em;
      color: color-mix(in oklab, var(--color-cream) 55%, transparent);
    }

    /* Overlay texte — crème DIRECTEMENT sur la carte (trame : pas d'encart),
       text-shadow pour rester lisible sur photo claire. Position variable. */
    .proj-card__overlay {
      position: absolute;
      display: flex;
      flex-direction: column;
      gap: 0.05rem;
      padding: clamp(0.85rem, 1.5vw, 1.3rem);
      max-width: 88%;
      color: var(--color-cream);
      text-shadow: 0 1px 14px color-mix(in oklab, var(--color-ink) 75%, transparent);
      pointer-events: none;
      z-index: 2;
    }
    /* Réalisations : texte constant en haut-gauche (trame). */
    .proj-card--real .proj-card__overlay {
      top: 0;
      left: 0;
    }
    /* Conceptions : positions variées (trame). */
    .proj-card.pos-tl .proj-card__overlay {
      top: 0;
      left: 0;
    }
    .proj-card.pos-tr .proj-card__overlay {
      top: 0;
      right: 0;
      text-align: right;
      align-items: flex-end;
    }
    .proj-card.pos-tc .proj-card__overlay {
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      text-align: center;
      align-items: center;
    }
    .proj-card.pos-cl .proj-card__overlay {
      top: 50%;
      left: 0;
      transform: translateY(-50%);
    }
    .proj-card.pos-bc .proj-card__overlay {
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      text-align: center;
      align-items: center;
    }
    .proj-card.pos-br .proj-card__overlay {
      bottom: 0;
      right: 0;
      text-align: right;
      align-items: flex-end;
    }
    .proj-card__l1 {
      font-family: var(--font-heading), sans-serif;
      font-weight: 700;
      font-size: clamp(0.9rem, 1.2vw, 1.15rem);
      line-height: 1.15;
    }
    .proj-card__l {
      font-family: var(--font-body), sans-serif;
      font-weight: 300;
      font-size: clamp(0.72rem, 0.95vw, 0.9rem);
      line-height: 1.3;
      color: color-mix(in oklab, var(--color-cream) 88%, transparent);
    }

    /* Pill « Agrandir » (composant global zoom-card) : repositionnée par la
       trame — bas-gauche sur conceptions/réalisations, centrée sur la galerie.
       Rayon squircle (pas une pill pleine). Les styles scoped page priment sur
       le global grâce à l'attribut de scope Astro. */
    .proj-card .zoom-card__pill {
      top: auto;
      right: auto;
      bottom: clamp(0.7rem, 1.4vw, 1.1rem);
      left: clamp(0.7rem, 1.4vw, 1.1rem);
      border-radius: 14px;
      transform: translateY(6px);
    }
    @media (hover: hover) {
      .proj-card:hover .zoom-card__pill,
      .proj-card:focus-visible .zoom-card__pill {
        transform: translateY(0);
      }
    }
    .proj-card--gal .zoom-card__pill {
      top: 50%;
      left: 50%;
      right: auto;
      bottom: auto;
      transform: translate(-50%, calc(-50% + 6px));
    }
    @media (hover: hover) {
      .proj-card--gal:hover .zoom-card__pill,
      .proj-card--gal:focus-visible .zoom-card__pill {
        transform: translate(-50%, -50%);
      }
    }
  </style>
</BaseLayout>
