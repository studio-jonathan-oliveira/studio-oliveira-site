---
/*
 * /projets — refonte DA finale 2026-06-04 (trame « projet » + 3 trames
 * accordéons). Hub = hero noir « Projets » + 3 accordéons exclusifs :
 *   1. Etudes et Conceptions   (trame accordeon-etude-et-conception)
 *   2. Réalisations            (trame accordeon-realisations)
 *   3. Galerie Studio          (trame accordeon-galerie-studio)
 *
 * Accordéon natif <details name> (exclusif, sans JS). Icône + → × via CSS.
 * Chaque accordéon déploie une grille de cartes projet (zoom-card → lightbox
 * global, flou au survol + « Agrandir »).
 *
 * CONTENU = verbatim extrait des trames (fautes conservées). IMAGES =
 * placeholders en attendant les visuels Jonathan (sous-dossiers 01-/02-…).
 * Voir _brief/trames-finales-specs/accordeon-*.md.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { jsonLdGraph, organization, localBusiness, breadcrumbs } from '@/lib/schema-org';

const schema = jsonLdGraph([
  organization(),
  localBusiness(),
  breadcrumbs([
    { name: 'Accueil', item: '/' },
    { name: 'Projets', item: '/projets' },
  ]),
]);

// ── Cartes ÉTUDES & CONCEPTIONS (vignette Twinmotion + overlay 4 lignes) ──
const conceptions = [
  { l1: 'Coeur urbain', l2: 'Jardin de ville', l3: 'Conception, 2024', l4: 'Corrèze' },
  { l1: 'Frange urbaine', l2: 'Jardin familial', l3: 'Conception, 2026', l4: 'Corrèze' },
  { l1: 'Domaine & Caractère', l2: 'Domaine familial', l3: 'Conception, 2023', l4: 'Corrèze' },
  {
    l1: 'Jardin Forêt',
    l2: 'Projet Public',
    l3: 'Conception, 2023',
    l4: 'Polyclinique Chénieux – Limoges',
  },
  { l1: 'Micro urbain', l2: 'Patio extérieur', l3: 'Conception, 2022', l4: 'Corrèze' },
  {
    l1: 'Airbnb atypique',
    l2: "Collab. archi. d'intérieur",
    l3: 'Co-conception, 2025',
    l4: 'Agde',
  },
  { l1: 'Airbnb atypique', l2: '', l3: 'Conception, 2026', l4: 'Valenciennes' },
  { l1: 'Micro urbain', l2: "Terrasse d'appartement", l3: 'Conception, 2021', l4: 'Haute-Vienne' },
  { l1: 'Domaine & Caractère', l2: 'Château classé XIIIs.', l3: 'Conception, 2024', l4: 'Corrèze' },
];

// ── Cartes RÉALISATIONS (overlay Titre / Établissement / Type / année / ville) ──
const realisations = [
  {
    titre: 'Airbnb atypique',
    etab: 'Jungle Room — Chammartz Suite',
    annee: '2024',
    ville: 'Uzerche',
  },
  { titre: 'Façade végétalisée', etab: 'Café de Paris — Brasserie', annee: '2025', ville: 'Brive' },
  {
    titre: 'Verrière végétalisée',
    etab: 'Café de Paris — Brasserie',
    annee: '2025',
    ville: 'Brive',
  },
  {
    titre: 'Glycine artificielle 5m',
    etab: 'Atelier Elite Coiffure',
    annee: '2022',
    ville: 'Brive',
  },
  { titre: 'Plafond arboré', etab: 'Atelier Elite Coiffure', annee: '2026', ville: 'Brive' },
  {
    titre: 'Mur en bouteille floral',
    etab: 'Café de Paris — Brasserie',
    annee: '2025',
    ville: 'Brive',
  },
  { titre: 'Jungle Work Box', etab: 'Schmidt Cuisine', annee: '2025', ville: 'Brive' },
  { titre: 'Airbnb atypique', etab: 'Jungle Room — Eden Suite', annee: '2025', ville: 'Roanne' },
  { titre: 'Mur végétalisé', etab: 'YG coiffure', annee: '2023', ville: 'Objat' },
  { titre: 'Jardinet tropical', etab: '', annee: '2021', ville: 'Limoges' },
];

// ── Galerie Studio : grille de vignettes (placeholders en attendant photos) ──
const galerie = Array.from({ length: 12 }, (_, i) => i + 1);
---

<BaseLayout
  title="Projets — études, conceptions, réalisations & galerie studio"
  description="Portefeuille du Studio J Oliveira. Études et conceptions en rendu Twinmotion, réalisations photographiées et galerie du studio."
  darkHero
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={schema} is:inline />
  </Fragment>

  {/* ───── HERO noir « Projets » ───── */}
  <section
    id="hero"
    data-section-label="Projets"
    data-theme="dark"
    class="proj-hero"
    aria-labelledby="proj-title"
  >
    <h1 id="proj-title" class="proj-hero__title">Projets</h1>
  </section>

  {/* ───── 3 accordéons exclusifs ───── */}
  <section data-theme="dark" class="proj-acc" aria-label="Portefeuille du studio">
    {/* 1 · Études et Conceptions */}
    <details class="proj-acc__item" name="projets-acc">
      <summary class="proj-acc__summary">
        <span class="proj-acc__title">Etudes et Conceptions</span>
        <span class="proj-acc__icon" aria-hidden="true"></span>
      </summary>
      <div class="proj-acc__panel">
        <div class="proj-grid">
          {
            conceptions.map((c) => (
              <button
                class="zoom-card proj-card"
                data-zoom-src=""
                data-zoom-alt={`${c.l1} — ${c.l4}`}
              >
                <span class="proj-card__ph" aria-hidden="true" />
                <span class="zoom-card__pill">Agrandir</span>
                <span class="proj-card__overlay">
                  <span class="proj-card__l1">{c.l1}</span>
                  {c.l2 && <span class="proj-card__l">{c.l2}</span>}
                  <span class="proj-card__l">{c.l3}</span>
                  <span class="proj-card__l">{c.l4}</span>
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </details>

    {/* 2 · Réalisations */}
    <details class="proj-acc__item" name="projets-acc">
      <summary class="proj-acc__summary">
        <span class="proj-acc__title">Réalisations</span>
        <span class="proj-acc__icon" aria-hidden="true"></span>
      </summary>
      <div class="proj-acc__panel">
        <div class="proj-grid proj-grid--3">
          {
            realisations.map((r) => (
              <button
                class="zoom-card proj-card"
                data-zoom-src=""
                data-zoom-alt={`${r.titre} — ${r.ville}`}
              >
                <span class="proj-card__ph" aria-hidden="true" />
                <span class="zoom-card__pill">Agrandir</span>
                <span class="proj-card__overlay">
                  <span class="proj-card__l1">{r.titre}</span>
                  {r.etab && <span class="proj-card__l">{r.etab}</span>}
                  <span class="proj-card__l">Réalisation, {r.annee}</span>
                  <span class="proj-card__l">{r.ville}</span>
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </details>

    {/* 3 · Galerie Studio */}
    <details class="proj-acc__item" name="projets-acc">
      <summary class="proj-acc__summary">
        <span class="proj-acc__title">Galerie Studio</span>
        <span class="proj-acc__icon" aria-hidden="true"></span>
      </summary>
      <div class="proj-acc__panel">
        <div class="proj-grid proj-grid--3">
          {
            galerie.map((n) => (
              <button
                class="zoom-card proj-card proj-card--gal"
                data-zoom-src=""
                data-zoom-alt={`Galerie studio ${n}`}
              >
                <span class="proj-card__ph" aria-hidden="true" />
                <span class="zoom-card__pill">Agrandir</span>
              </button>
            ))
          }
        </div>
      </div>
    </details>
  </section>

  <style>
    /* Hero noir plein, H1 « Projets » bas-gauche, Bold. */
    .proj-hero {
      width: 100%;
      min-height: 100svh;
      background-color: var(--color-ink);
      color: var(--color-cream);
      display: flex;
      align-items: flex-end;
      box-sizing: border-box;
      padding: clamp(2rem, 6vh, 5rem) clamp(1.5rem, 4vw, 4rem) clamp(3rem, 8vh, 6rem);
    }
    .proj-hero__title {
      margin: 0;
      font-family: var(--font-heading), sans-serif;
      font-weight: 900;
      font-size: clamp(3.5rem, 14vw, 15rem);
      line-height: 0.9;
      letter-spacing: -0.02em;
      text-transform: none;
      color: var(--color-cream);
    }

    /* Accordéons sur fond noir, texte cream. */
    .proj-acc {
      width: 100%;
      background-color: var(--color-ink);
      color: var(--color-cream);
      padding: clamp(2rem, 5vw, 4rem) 0 clamp(4rem, 8vw, 7rem);
    }
    .proj-acc__item {
      border-top: 1px solid color-mix(in oklab, var(--color-cream) 20%, transparent);
    }
    .proj-acc__item:last-of-type {
      border-bottom: 1px solid color-mix(in oklab, var(--color-cream) 20%, transparent);
    }
    .proj-acc__summary {
      list-style: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      padding: clamp(1.5rem, 3.5vw, 2.5rem) clamp(1.5rem, 5vw, 4rem);
    }
    .proj-acc__summary::-webkit-details-marker {
      display: none;
    }
    .proj-acc__title {
      font-family: var(--font-heading), sans-serif;
      font-weight: 700;
      font-size: clamp(1.6rem, 4vw, 3.5rem);
      line-height: 1;
      letter-spacing: -0.01em;
      color: var(--color-cream);
    }
    /* Icône + (fermé) → × (ouvert) via rotation 45°. */
    .proj-acc__icon {
      position: relative;
      flex-shrink: 0;
      width: clamp(22px, 2.4vw, 34px);
      height: clamp(22px, 2.4vw, 34px);
      transition: transform 0.4s var(--ease-out-editorial);
    }
    .proj-acc__icon::before,
    .proj-acc__icon::after {
      content: '';
      position: absolute;
      background-color: var(--color-cream);
    }
    .proj-acc__icon::before {
      top: 50%;
      left: 0;
      right: 0;
      height: 2px;
      transform: translateY(-50%);
    }
    .proj-acc__icon::after {
      left: 50%;
      top: 0;
      bottom: 0;
      width: 2px;
      transform: translateX(-50%);
    }
    .proj-acc__item[open] .proj-acc__icon {
      transform: rotate(45deg);
    }
    .proj-acc__panel {
      padding: 0 clamp(1.5rem, 5vw, 4rem) clamp(2.5rem, 5vw, 4rem);
    }

    /* Grille de cartes projet. */
    .proj-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: clamp(1rem, 2.5vw, 2rem);
    }
    @media (min-width: 768px) {
      .proj-grid--3 {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    .proj-card {
      aspect-ratio: 4 / 5;
    }
    .proj-card--gal {
      aspect-ratio: 3 / 4;
    }
    /* Placeholder visuel (en attendant les vraies photos Jonathan). */
    .proj-card__ph {
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        135deg,
        color-mix(in oklab, var(--color-cream) 10%, var(--color-ink)),
        color-mix(in oklab, var(--color-cream) 10%, var(--color-ink)) 14px,
        color-mix(in oklab, var(--color-cream) 6%, var(--color-ink)) 14px,
        color-mix(in oklab, var(--color-cream) 6%, var(--color-ink)) 28px
      );
    }
    /* Overlay infos (bloc beige posé sur la carte). */
    .proj-card__overlay {
      position: absolute;
      top: clamp(0.6rem, 1.2vw, 1rem);
      left: clamp(0.6rem, 1.2vw, 1rem);
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      padding: 0.6rem 0.85rem;
      background-color: color-mix(in oklab, var(--color-cream) 92%, transparent);
      color: var(--color-ink);
      border-radius: 10px;
      text-align: left;
      max-width: 80%;
    }
    .proj-card__l1 {
      font-family: var(--font-heading), sans-serif;
      font-weight: 700;
      font-size: clamp(0.85rem, 1.1vw, 1.05rem);
      line-height: 1.1;
    }
    .proj-card__l {
      font-family: var(--font-body), sans-serif;
      font-weight: 400;
      font-size: clamp(0.7rem, 0.9vw, 0.85rem);
      line-height: 1.25;
      color: color-mix(in oklab, var(--color-ink) 80%, transparent);
    }
  </style>
</BaseLayout>
