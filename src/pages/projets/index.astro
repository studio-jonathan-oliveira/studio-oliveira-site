---
/*
 * /projets — refonte DA finale 2026-06-04 (trame « projet » + 3 trames
 * accordéons). Hub = hero noir « Projets » + 3 accordéons exclusifs :
 *   1. Etudes et Conceptions   (trame accordeon-etude-et-conception)
 *   2. Réalisations            (trame accordeon-realisations)
 *   3. Galerie Studio          (trame accordeon-galerie-studio)
 *
 * Accordéon natif <details name> (exclusif, sans JS). Icône + → × via CSS.
 * Chaque accordéon déploie une grille de cartes projet (zoom-card → lightbox
 * global, flou au survol + curseur « Agrandir » qui suit le pointeur — plus de
 * pastille fixe sur l'image, cf. data-cursor-label).
 *
 * CONTENU = verbatim extrait des trames (fautes conservées). IMAGES =
 * placeholders en attendant les visuels Jonathan (sous-dossiers 01-/02-…).
 * Voir _brief/trames-finales-specs/accordeon-*.md.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { jsonLdGraph, organization, localBusiness, breadcrumbs } from '@/lib/schema-org';

const schema = jsonLdGraph([
  organization(),
  localBusiness(),
  breadcrumbs([
    { name: 'Accueil', item: '/' },
    { name: 'Projets', item: '/projets' },
  ]),
]);

// ── Cartes ÉTUDES & CONCEPTIONS ──
// `approche` = texte « Approche projet » affiché dans la lightbox (carte beige
// qui suit le curseur). Contenu extrait par OCR des trames Jonathan
// (`accordeon etude et conception.jpg`) puis ORTHOGRAPHE CORRIGÉE (validé Morgan
// 2026-06-08 : « faut corriger ça absolument »). Le fond/verbe restent ceux de
// Jonathan ; seules les fautes (accents, accords, doublons) sont rectifiées.
// Paragraphes séparés par une ligne vide.
const conceptions = [
  {
    l1: 'Coeur urbain',
    l2: 'Jardin de ville',
    l3: 'Conception, 2024',
    l4: 'Corrèze',
    approche: [
      "Conception d'un jardin de ville surplombant une piscine centrale au jardin.",
      "Rénovation de la terrasse piscine avec création d'une plage pour transats, réalignement des éléments du jardin à la piscine, création d'un escalier esprit « suspendu » en pierre à l'arrière de la piscine, recomposition globale de la végétation dans un esprit tropical ont été les directives de ce projet.",
    ],
  },
  {
    l1: 'Frange urbaine',
    l2: 'Jardin familial',
    l3: 'Conception, 2026',
    l4: 'Corrèze',
    approche: [
      "Conception d'un jardin familial dans les hauteurs de Cosnac, en Corrèze.",
      'Jardin tout en pente avec mur de soutènement en parpaing existant qui scindait le terrain en deux.',
      "Composition et réflexion fonctionnelle des espaces sous forme de terrasses et paliers en créant des identités différentes, habillage du mur de soutènement en l'intégrant à l'architecture de la maison, nouvelle plateforme de jeu pour les enfants en enrochement, intégration paysagère avec nouvelle composition arborée en gérant les vis-à-vis gênants.",
    ],
  },
  {
    l1: 'Domaine & Caractère',
    l2: 'Domaine familial',
    l3: 'Conception, 2023',
    l4: 'Corrèze',
    approche: [
      "Conception d'un domaine familial en Corrèze.",
      "La réflexion s'est portée sur l'entrée, l'accueil des convives, la circulation comprenant l'accès des véhicules au carport, un passage piéton du carport jusqu'à l'entrée traversant la voie carrossable, l'intégration architecturale et environnementale des éléments de construction et de la palette végétale, dans un style Provence romantique.",
      "La structuration du projet s'articule autour de la courbe de Fibonacci qui, en son centre, accueille la statue et distribue selon sa géométrie native tous les accès de cette entrée.",
    ],
  },
  {
    l1: 'Jardin Forêt',
    l2: 'Projet Public',
    l3: 'Conception, 2023',
    l4: 'Polyclinique Chénieux – Limoges',
    approche: [
      "Réflexion d'un jardin-forêt pour les patients en chimiothérapie et oncologie de la Polyclinique de Chénieux à Limoges.",
      "Autour de la forêt, la volonté d'offrir aux patients les bienfaits que procure cet environnement sur la santé humaine a été l'axe majeur de cette conception.",
