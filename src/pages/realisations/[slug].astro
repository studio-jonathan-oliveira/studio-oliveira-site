---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/astro/Section.astro';
import Prose from '@/components/astro/Prose.astro';
import MaskRevealHeading from '@/components/astro/MaskRevealHeading.astro';
import CtaLink from '@/components/astro/CtaLink.astro';
import { Picture } from 'astro:assets';
import { fetch } from '@/lib/sanity';
import { projectSlugsQuery } from '@/lib/queries';
import { mockProjects, type MockProject } from '@/data/mock-projects';
import {
  jsonLdGraph,
  breadcrumbs,
  organization,
  localBusiness,
  person,
  creativeWorkProject,
} from '@/lib/schema-org';

export const getStaticPaths = (async () => {
  const slugsFromSanity = await fetch<{ realisations: string[]; conceptions: string[] }>(
    projectSlugsQuery,
    {},
    { realisations: [], conceptions: [] },
  );

  const paths: {
    params: { slug: string };
    props: { project: MockProject | null; slug: string };
  }[] = [];

  for (const slug of slugsFromSanity.realisations) {
    paths.push({ params: { slug }, props: { project: null, slug } });
  }

  // Fallback mock si Sanity est vide — évite d'avoir 0 pages de réalisation au build.
  if (slugsFromSanity.realisations.length === 0) {
    for (const project of mockProjects.filter((p) => p.section === 'realisations')) {
      paths.push({ params: { slug: project.slug }, props: { project, slug: project.slug } });
    }
  }

  return paths;
}) satisfies GetStaticPaths;

interface Props {
  project: MockProject | null;
  slug: string;
}

const { project, slug } = Astro.props;

// TODO: quand project === null (Sanity path), fetcher le détail via projectBySlugQuery.
// Pour l'instant, on redirige si non-trouvé en mock.
if (!project) {
  return Astro.redirect('/realisations', 301);
}

const breadcrumbItems = [
  { name: 'Accueil', item: '/' },
  { name: 'Réalisations', item: '/realisations' },
  { name: project.title, item: `/realisations/${slug}` },
];

const schema = jsonLdGraph([
  organization(),
  person(),
  localBusiness(),
  creativeWorkProject({
    title: project.title,
    slug: project.slug,
    section: 'realisations',
    year: project.year,
    location: project.location,
    description: project.summary,
  }),
  breadcrumbs(breadcrumbItems),
]);
---

<BaseLayout title={project.title} description={project.summary}>
  <Section variant="cream" tight class="pt-32 pb-0 md:pt-40">
    <nav
      aria-label="Fil d'Ariane"
      class="font-mono text-[11px] tracking-[0.2em] text-[var(--color-forest)]/50 uppercase"
    >
      <ol class="flex flex-wrap items-center gap-2">
        {
          breadcrumbItems.map((b, i) => (
            <li class="flex items-center gap-2">
              {i < breadcrumbItems.length - 1 ? (
                <a href={b.item} class="hover:text-[var(--color-forest)]">
                  {b.name}
                </a>
              ) : (
                <span class="line-clamp-1 max-w-[40ch] text-[var(--color-forest)]/80">
                  {b.name}
                </span>
              )}
              {i < breadcrumbItems.length - 1 && <span aria-hidden="true">/</span>}
            </li>
          ))
        }
      </ol>
    </nav>
  </Section>

  <!-- Hero projet -->
  <Section variant="cream" tight class="pt-0 pb-0">
    <article>
      <header class="mb-16 max-w-3xl">
        <p class="font-mono text-xs tracking-[0.22em] text-[var(--color-forest)]/55 uppercase">
          Réalisation · {project.typologyLabel} · {project.year}
        </p>
        <MaskRevealHeading
          text={project.title}
          as="h1"
          class="mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-5xl)] leading-[1.02] tracking-tight"
        />
        <p
          class="mt-8 font-[family-name:var(--font-heading)] text-[length:var(--text-2xl)] text-[var(--color-forest)]/60 italic"
        >
          {project.location}
        </p>
      </header>

      {
        /* Image couverture full-width éditorial — pattern designbyad
         (scroll_projet.mp4) : clip-reveal bas→haut + image-rise translate+scale. */
      }
      <figure class="mb-16 md:mb-24" data-img-reveal data-scroll-rise data-scroll-rise-amp="200">
        <Picture
          src={project.cover}
          alt={project.title}
          widths={[640, 960, 1280, 1600, 1920]}
          sizes="100vw"
          formats={['avif', 'webp']}
          quality={85}
          class="aspect-[16/10] w-full object-cover"
          loading="eager"
          data-reveal="image-rise"
        />
      </figure>

      <!-- Description projet -->
      <div class="grid gap-16 md:grid-cols-[1fr_2fr] md:gap-20">
        <aside class="md:sticky md:top-32 md:self-start">
          <div class="border-t border-[var(--color-forest)]/20 pt-6">
            <dl class="space-y-4 text-sm">
              <div>
                <dt
                  class="font-mono text-[10px] tracking-[0.22em] text-[var(--color-forest)]/50 uppercase"
                >
                  Lieu
                </dt>
                <dd class="mt-1">{project.location}</dd>
              </div>
              <div>
                <dt
                  class="font-mono text-[10px] tracking-[0.22em] text-[var(--color-forest)]/50 uppercase"
                >
                  Année
                </dt>
                <dd class="mt-1">{project.year}</dd>
              </div>
              <div>
                <dt
                  class="font-mono text-[10px] tracking-[0.22em] text-[var(--color-forest)]/50 uppercase"
                >
                  Typologie
                </dt>
                <dd class="mt-1">
                  {
                    project.typologySlug ? (
                      <a
                        href={`/architecture-paysagere/${project.typologySlug}`}
                        class="border-b border-[var(--color-forest)]/30 hover:border-[var(--color-forest)]"
                      >
                        {project.typologyLabel}
                      </a>
                    ) : (
                      project.typologyLabel
                    )
                  }
                </dd>
              </div>
            </dl>
          </div>
        </aside>

        <Prose size="lg">
          <p>{project.summary}</p>
        </Prose>
      </div>

      <!-- Galerie immersive — layout 12 cols, 4 patterns en rotation, quinconce vertical
           via translate-y, clip-reveal bas→haut + image-rise + parallax léger.
           Pattern designbyad (scroll_projet.mp4) appliqué pleinement. -->
      {
        project.gallery.length > 0 && (
          <div class="gallery-immersive mt-24 grid grid-cols-12 gap-y-20 md:mt-32 md:gap-y-32">
            {project.gallery.map((img, i) => {
              const layout = i % 4;
              const colClass =
                layout === 0
                  ? 'col-span-12'
                  : layout === 1
                    ? 'col-span-12 md:col-start-5 md:col-span-8'
                    : layout === 2
                      ? 'col-span-12 md:col-start-1 md:col-span-7'
                      : 'col-span-12 md:col-start-2 md:col-span-10';
              const aspectClass =
                layout === 0
                  ? 'aspect-[16/10]'
                  : layout === 1
                    ? 'aspect-[4/5]'
                    : layout === 2
                      ? 'aspect-[3/4]'
                      : 'aspect-[16/9]';
              const offsetClass =
                layout === 1
                  ? 'md:translate-y-12'
                  : layout === 2
                    ? 'md:-translate-y-8'
                    : layout === 3
                      ? 'md:translate-y-6'
                      : '';
              return (
                <figure
                  class={`${colClass} ${offsetClass}`}
                  data-clip-reveal="top"
                  data-scroll-rise
                  data-scroll-rise-amp={String(80 + (i % 3) * 30)}
                >
                  <Picture
                    src={img.src}
                    alt={img.alt}
                    widths={[720, 1080, 1440, 1920, 2400]}
                    sizes="(min-width: 1024px) 70vw, (min-width: 768px) 80vw, 92vw"
                    formats={['avif', 'webp']}
                    quality={85}
                    class={`${aspectClass} w-full object-cover`}
                    loading="lazy"
                    data-reveal="image-rise"
                  />
                  {img.caption && (
                    <figcaption class="mt-4 font-mono text-[11px] tracking-[0.18em] text-[var(--color-forest)]/60 uppercase">
                      {img.caption}
                    </figcaption>
                  )}
                </figure>
              );
            })}
          </div>
        )
      }
    </article>
  </Section>

  <!-- Navigation inter-projets (placeholder) -->
  <Section variant="cream" topDivider tight>
    <div class="flex items-center justify-between gap-6">
      <a
        href="/realisations"
        class="inline-flex items-center gap-3 text-sm tracking-wide transition-colors hover:text-[var(--color-forest)]"
      >
        <span aria-hidden="true">←</span>
        Toutes les réalisations
      </a>
      <CtaLink href="/contact" label="Discuter de votre projet" tone="light" />
    </div>
  </Section>

  <Fragment slot="head">
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
</BaseLayout>
