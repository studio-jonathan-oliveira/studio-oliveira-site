---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/astro/Section.astro';
import { Picture } from 'astro:assets';
import { fetch } from '@/lib/sanity';
import { projectsListQuery } from '@/lib/queries';
import { mockProjectsBySection } from '@/data/mock-projects';
import { SITE } from '@/lib/site-config';
import { jsonLdGraph, breadcrumbs, organization, localBusiness } from '@/lib/schema-org';

const sanityProjects = await fetch<unknown[]>(projectsListQuery, { section: 'realisations' }, []);
const useMock = sanityProjects.length === 0;
const projects = useMock ? mockProjectsBySection.realisations : [];

const schema = jsonLdGraph([
  organization(),
  localBusiness(),
  breadcrumbs([
    { name: 'Accueil', item: '/' },
    { name: 'Réalisations', item: '/realisations' },
  ]),
  {
    '@type': 'CollectionPage',
    name: `Réalisations — ${SITE.name}`,
    description:
      'Projets réalisés par le Studio J Oliveira — conception biophilique et aménagement végétalisé.',
    url: `${SITE.url}/realisations`,
  },
]);
---

<BaseLayout
  title="Réalisations"
  description="Projets aboutis du Studio J Oliveira — conception biophilique et aménagement végétalisé. Jardins, intérieurs, scénographies végétales."
>
  <Section variant="cream" id="hero" sectionLabel="Réalisations" class="pt-40 md:pt-48">
    <div class="max-w-3xl">
      <p class="font-mono text-xs tracking-[0.22em] text-[var(--color-forest)]/55 uppercase">
        Portefeuille · Réalisations
      </p>
      <h1
        data-mask-reveal
        data-mask-stagger="0.14"
        class="mt-6 font-[family-name:var(--font-heading)] leading-[1.02] tracking-tight"
      >
        <span data-mask-line class="block pb-[0.05em] text-[length:var(--text-4xl)] italic"
          >Projets</span
        >
        <span
          data-mask-line
          class="block pb-[0.18em] text-[length:var(--text-5xl)] md:text-[length:var(--text-hero)]"
          style="font-weight: 500; letter-spacing: -0.012em; line-height: 0.96;">ABOUTIS.</span
        >
      </h1>
      <p
        class="mt-8 max-w-2xl text-[length:var(--text-lg)] leading-relaxed text-[var(--color-forest)]/80"
      >
        Les projets livrés, photographiés dans leur contexte réel. Pour les études en cours en rendu
        photoréaliste, voir <a
          href="/conceptions"
          class="border-b border-[var(--color-forest)]/30 hover:border-[var(--color-forest)]"
          >Conceptions</a
        >.
      </p>
    </div>
  </Section>

  <Section variant="cream" topDivider id="projets" sectionLabel="Projets">
    {
      projects.length === 0 ? (
        <div class="border border-dashed border-[var(--color-forest)]/20 p-12 text-center">
          <p class="font-mono text-[11px] tracking-[0.22em] text-[var(--color-forest)]/55 uppercase">
            En préparation
          </p>
          <p class="mx-auto mt-4 max-w-lg text-[length:var(--text-base)] leading-relaxed text-[var(--color-forest)]/70">
            Les réalisations seront publiées prochainement depuis Sanity Studio.
          </p>
        </div>
      ) : (
        <ul class="grid grid-cols-1 gap-16 md:grid-cols-2 md:gap-x-10 md:gap-y-24">
          {projects.map((project) => (
            <li>
              <a href={`/realisations/${project.slug}`} class="group block">
                <div class="aspect-[4/5] w-full overflow-hidden bg-[var(--color-forest)]/5">
                  <Picture
                    src={project.cover}
                    alt={project.title}
                    widths={[480, 720, 960, 1280]}
                    sizes="(min-width: 768px) 44vw, 88vw"
                    formats={['avif', 'webp']}
                    class="h-full w-full object-cover transition-transform duration-[700ms] group-hover:scale-[1.02]"
                    loading="lazy"
                  />
                </div>
                <div class="mt-6">
                  <p class="font-mono text-[11px] tracking-[0.22em] text-[var(--color-forest)]/55 uppercase">
                    {project.typologyLabel} · {project.location} · {project.year}
                  </p>
                  <h2 class="mt-3 font-[family-name:var(--font-heading)] text-[length:var(--text-2xl)] leading-tight transition-colors group-hover:text-[var(--color-forest)]/55">
                    {project.title}
                  </h2>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      useMock && projects.length > 0 && (
        <p class="mt-16 text-center font-mono text-[10px] tracking-[0.22em] text-[var(--color-forest)]/40 uppercase">
          Affichage de démonstration — sera remplacé par les données Sanity une fois connecté.
        </p>
      )
    }
  </Section>

  <Fragment slot="head">
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
</BaseLayout>
