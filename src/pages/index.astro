  <style>
    /*
     * Bifurcation — deux cards éditoriales "Particuliers / Professionnels"
     * Grande asymétrie, numéro décoratif Fraunces en background, filet fin
     * de séparation entre les 2 cards. Pas de box shadow, pas de card
     * arrondie : rester dans le vocabulaire magazine.
     */
    .bifurcation-grid {
      border-top: 1px solid var(--color-forest, #1a2b1f);
      border-top-color: color-mix(in srgb, var(--color-forest) 15%, transparent);
    }
    .bifurcation-card {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 3.5rem 2rem 3rem;
      min-height: 420px;
      text-decoration: none;
      color: inherit;
      border-bottom: 1px solid color-mix(in srgb, var(--color-forest) 15%, transparent);
      overflow: hidden;
      transition: background-color 0.5s var(--ease-out-editorial);
      isolation: isolate;
    }
    @media (min-width: 768px) {
      .bifurcation-card {
        padding: 5rem 4rem 4.5rem;
        min-height: 480px;
      }
      .bifurcation-card--a {
        border-right: 1px solid color-mix(in srgb, var(--color-forest) 15%, transparent);
      }
      .bifurcation-card--b {
        border-right: none;
      }
    }
    .bifurcation-card:hover,
    .bifurcation-card:focus-visible {
      background-color: color-mix(in srgb, var(--color-moss) 4%, transparent);
    }

    /* Numéro décoratif en background, très grand, caractère Fraunces */
    .bifurcation-num {
      position: absolute;
      top: -0.15em;
      right: 1.5rem;
      font-family: var(--font-heading), serif;
      font-style: italic;
      font-size: clamp(8rem, 14vw, 16rem);
      line-height: 1;
      color: var(--color-forest);
      opacity: 0.05;
      font-variation-settings:
        'opsz' 144,
        'SOFT' 100;
      pointer-events: none;
      user-select: none;
      transition: opacity 0.6s var(--ease-out-editorial);
    }
    .bifurcation-card:hover .bifurcation-num,
    .bifurcation-card:focus-visible .bifurcation-num {
      opacity: 0.1;
      color: var(--color-laterite);
    }

    .bifurcation-meta {
      position: relative;
      z-index: 1;
    }

    .bifurcation-cta {
      position: relative;
      z-index: 1;
      margin-top: 3rem;
      display: inline-flex;
      align-items: center;
      gap: 0.9rem;
      padding-bottom: 0.25rem;
      font-family: var(--font-mono), ui-monospace, monospace;
      font-size: 11px;
      letter-spacing: 0.26em;
      text-transform: uppercase;
      color: var(--color-forest);
      border-bottom: 1px solid color-mix(in srgb, var(--color-forest) 30%, transparent);
      width: fit-content;
      transition:
        color 0.3s ease,
        border-color 0.3s ease;
    }
    .bifurcation-card:hover .bifurcation-cta,
    .bifurcation-card:focus-visible .bifurcation-cta {
      color: var(--color-laterite);
      border-color: var(--color-laterite);
    }
    .bifurcation-arrow {
      display: inline-block;
      transition: transform 0.4s var(--ease-out-editorial);
    }
    .bifurcation-card:hover .bifurcation-arrow,
    .bifurcation-card:focus-visible .bifurcation-arrow {
      transform: translateX(6px);
    }

    /* Hero image : zoom + dim + blur pilotés par Motion via data-hero-zoom */
    .hero-image {
      transform: scale(1.06);
      transform-origin: center;
      will-change: transform, filter;
    }

    .scroll-cue-line {
      animation: scroll-pulse 2.8s var(--ease-out-editorial) infinite;
      transform-origin: top;
    }
    @keyframes scroll-pulse {
      0%,
      100% {
        transform: scaleY(0.3);
        opacity: 0.3;
      }
      50% {
        transform: scaleY(1);
        opacity: 1;
      }
    }

    /* Pull-quote scroll-pin — raccourci à 160vh (reco audit DA : quiet luxury) */
    .pull-quote-section {
      min-height: 160vh;
      position: relative;
    }
    .pull-quote-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
    }
    [data-quote-word] {
      transition: opacity 60ms linear;
    }

    /* Typologies — scroll horizontal pinned (signature PDF l.750) */
    .htypo-section {
      /* Hauteur = nb panneaux × viewport pour mapper scroll vertical → translateX rail.
         400vh = 4 panneaux. Ajuster si nombre de typologies change. */
      height: 400vh;
      position: relative;
    }
    .htypo-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
    }

    /* Header en surimpression haut gauche */
    .htypo-header {
      position: absolute;
      top: 2.5rem;
      left: 2.5rem;
      right: 2.5rem;
      z-index: 3;
      pointer-events: none;
    }
    @media (min-width: 768px) {
      .htypo-header {
        top: 3rem;
        left: 4rem;
      }
    }

    /* Rail horizontal — largeur totale = nb panneaux × 100vw */
    .htypo-rail {
      display: flex;
      height: 100%;
      width: 400vw;
      will-change: transform;
    }

    /* Panneau individuel = 1 viewport plein, grid 2 colonnes */
    .htypo-panel {
      flex: 0 0 100vw;
      width: 100vw;
      height: 100vh;
      display: grid;
      grid-template-rows: 55vh auto;
      position: relative;
      text-decoration: none;
      color: inherit;
      overflow: hidden;
    }
    @media (min-width: 1024px) {
      .htypo-panel {
        grid-template-rows: 1fr;
        grid-template-columns: 55fr 45fr;
      }
    }

    /* Colonne visuel */
    .htypo-visual {
      position: relative;
      overflow: hidden;
      background: var(--color-forest);
    }
    .htypo-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transform: scale(1.06);
      transition: transform 1.2s var(--ease-out-editorial);
    }
    .htypo-panel:hover .htypo-img,
    .htypo-panel:focus-visible .htypo-img {
      transform: scale(1.12);
    }
    .htypo-veil {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom right,
        rgba(26, 43, 31, 0.25) 0%,
        rgba(26, 43, 31, 0.55) 100%
      );
      transition: opacity 0.6s ease;
    }
    .htypo-panel:hover .htypo-veil {
      opacity: 0.55;
    }
    /* Grand index décoratif en surimpression sur le visuel */
    .htypo-index-xl {
      position: absolute;
      bottom: 1.5rem;
      left: 1.75rem;
      font-family: var(--font-heading), serif;
      font-size: clamp(6rem, 14vw, 14rem);
      line-height: 0.85;
      color: var(--color-cream);
      opacity: 0.18;
      pointer-events: none;
      font-style: italic;
      letter-spacing: -0.03em;
    }

    /* Colonne copy */
    .htypo-copy {
      padding: 3rem 2rem 4rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      max-width: 620px;
    }
    @media (min-width: 768px) {
      .htypo-copy {
        padding: 4rem 4rem 5rem;
      }
    }
    @media (min-width: 1024px) {
      .htypo-copy {
        padding: 5rem 5rem 5rem 6rem;
      }
    }

    .htypo-phrase {
      max-width: 520px;
    }
    /*
     * Metadata : VRAI hover reveal (reco audit DA).
     * Masquée par défaut, révélée uniquement au hover/focus du panel.
     * Sur mobile (pas de hover), on force l'affichage permanent.
     */
    .htypo-meta {
      opacity: 0;
      transform: translateY(16px);
      transition:
        transform 0.7s var(--ease-out-editorial),
        opacity 0.5s ease;
    }
    @media (hover: hover) and (min-width: 1024px) {
      .htypo-panel:hover .htypo-meta,
      .htypo-panel:focus-visible .htypo-meta {
        opacity: 1;
        transform: translateY(0);
      }
    }
    /* Tactile / fallback : meta toujours visible (hover n'existe pas) */
    @media (hover: none), (max-width: 1023px) {
      .htypo-meta {
        opacity: 1;
        transform: none;
      }
    }

    /* CTA statique (mobile + fallback clavier) */
    .htypo-cta-static {
      align-self: flex-start;
    }
    @media (min-width: 1024px) {
      /* Sur desktop, le CTA suiveur souris remplace l'indicateur statique */
      .htypo-cta-static {
        opacity: 0.7;
      }
    }

    /*
     * Curseur panel : outline minimal crème (vs disque plein latérite du
     * ScrollCursorCta global sur /pros). Hiérarchie visuelle entre les 2
     * systèmes de curseur (reco audit DA : « double cursor system sans
     * hiérarchie »).
     */
    .htypo-cursor-cta {
      position: absolute;
      top: 0;
      left: 0;
      width: 88px;
      height: 88px;
      margin-left: -44px;
      margin-top: -44px;
      border-radius: 50%;
      background: transparent;
      border: 1px solid var(--color-cream);
      color: var(--color-cream);
      display: none;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      z-index: 5;
      opacity: 0;
      transform: scale(0.7);
      transition:
        opacity 0.35s var(--ease-out-editorial),
        transform 0.45s var(--ease-out-editorial),
        border-color 0.3s ease,
        color 0.3s ease,
        background-color 0.3s ease;
      will-change: transform, opacity, translate;
      mix-blend-mode: difference;
    }
    .htypo-cursor-cta-inner {
      font-family: var(--font-mono), ui-monospace, monospace;
      font-size: 9px;
      letter-spacing: 0.26em;
      text-transform: uppercase;
      text-align: center;
      line-height: 1;
    }
    @media (min-width: 1024px) and (hover: hover) {
      .htypo-cursor-cta {
        display: flex;
      }
      .htypo-panel:hover .htypo-cursor-cta,
      .htypo-panel:focus-visible .htypo-cursor-cta {
        opacity: 1;
        transform: scale(1);
      }
    }

    /* Progress ticks */
    .htypo-progress {
      position: absolute;
      bottom: 2.5rem;
      left: 2.5rem;
      display: flex;
      gap: 10px;
      z-index: 3;
      pointer-events: none;
    }
    @media (min-width: 768px) {
      .htypo-progress {
        left: 4rem;
        bottom: 3rem;
      }
    }
    .htypo-tick {
      width: 28px;
      height: 1px;
      background-color: var(--color-cream);
      opacity: 0.25;
      transition:
        width 0.45s var(--ease-out-editorial),
        opacity 0.3s ease;
    }
    .htypo-tick.is-active {
      width: 56px;
      opacity: 1;
    }
    .htypo-tick.is-passed {
      opacity: 0.65;
    }

    /* Mobile : scroll horizontal snap natif au lieu du pin (touch-friendly) */
    @media (max-width: 1023px) {
      .htypo-section {
        height: auto;
      }
      .htypo-sticky {
        position: relative;
        height: auto;
        overflow: visible;
      }
      .htypo-header {
        position: static;
        padding: 3rem 1.5rem 0;
      }
      .htypo-rail {
        width: 100%;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      }
      .htypo-rail::-webkit-scrollbar {
        display: none;
      }
      .htypo-panel {
        scroll-snap-align: start;
        height: auto;
        min-height: 90vh;
      }
      .htypo-progress {
        position: static;
        justify-content: center;
        padding: 2rem 0 3rem;
      }
    }

    /* Reduce-motion : stack vertical complet */
    @media (prefers-reduced-motion: reduce) {
      .htypo-section {
        height: auto;
      }
      .htypo-sticky {
        position: static;
        height: auto;
        overflow: visible;
      }
      .htypo-header {
        position: static;
        padding: 3rem 2rem 0;
      }
      .htypo-rail {
        width: 100%;
        flex-direction: column;
        overflow: visible;
        transform: none !important;
      }
      .htypo-panel {
        width: 100%;
        height: auto;
        min-height: 80vh;
      }
      .htypo-img {
        transform: none;
      }
      .htypo-cursor-cta {
        display: none !important;
      }
      .htypo-progress {
        display: none;
      }
    }
  </style>
</BaseLayout>
