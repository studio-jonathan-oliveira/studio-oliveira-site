    /* Pull-quote scroll-pin — 120vh pour fluidité (feedback Morgan 2026-04-23 :
     * « très sticky, faudrait davantage de fluidité »). 120vh = 20vh de sticky
     * actif, assez pour voir la coloration, pas assez pour se sentir collé. */
    .pull-quote-section {
      min-height: 120vh;
      position: relative;
    }
    .pull-quote-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
    }
    [data-quote-word] {
      transition: opacity 60ms linear;
    }

    /* Typologies — scroll horizontal pinned. Refonte 2026-04-30 v3 :
       hauteur encore réduite 320vh → 200vh (Jonathan : « grandement
       accélérer encore »). Avec padding-right rail 70vw, le travel
       horizontal couvre maintenant ~125vw (panel 5 arrive à la position
       initiale de panel 1) et tient sur 200vh de scroll vertical. */
    /* Hauteur augmentée 2026-05-02 (Morgan) : sticky de fin renforcé,
       on veut que la dernière typologie reste à la place de la première
       avant que le scroll ne reprenne. 200vh → 320vh + DWELL_END remontée. */
    .htypo-section {
      height: 320vh;
      position: relative;
    }
    .htypo-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
    }

    /* Header — texte intro Jonathan, plus gros + plus près des images
       (refonte 2026-04-30 retours #2). Position rapprochée du rail
       (top mid-viewport au lieu de juste sous le header site). */
    .htypo-header {
      position: absolute;
      top: clamp(7rem, 16vh, 11rem);
      left: 2rem;
      right: 2rem;
      z-index: 3;
      pointer-events: none;
    }
    @media (min-width: 768px) {
      .htypo-header {
        left: 3rem;
        right: 3rem;
      }
    }
    /* Taille augmentée 2026-05-02 (Morgan, capture screenshot designbyad) :
       clamp 1.2/2.2/2 → 1.6/3/2.8rem. */
    .htypo-intro {
      font-family: var(--font-heading), sans-serif;
      font-weight: 600;
      font-size: clamp(1.6rem, 3vw, 2.8rem);
      line-height: 1.25;
      letter-spacing: 0.01em;
      text-transform: uppercase;
      color: var(--color-ink);
      max-width: 56ch;
      margin: 0;
    }

    /* Rail horizontal — 5 panneaux, ~30vw + gap (4 visibles + 5e cropée).
       Travel auto = (rail width - viewport) géré par setupHorizontalTypologies.
       padding-right ÉTENDU 2026-04-30 v3 (retours Jonathan) : doit permettre
       au panel 5 (Architecture publique) d'atteindre l'emplacement initial
       du panel 1 (Micro urbain) en fin de scroll → besoin de ~4 × largeur
       panneau en travel total. padding-right gonflé en conséquence. */
    .htypo-rail {
      display: flex;
      align-items: flex-end;
      gap: clamp(0.6rem, 1.2vw, 1.4rem);
      height: 100%;
      width: max-content;
      padding: 0 70vw 0 clamp(2rem, 4vw, 5rem);
      will-change: transform;
    }

    /* Panneau simplifié 2026-04-30 (Jonathan, capture typologies-01.png) :
       carte simple = nom au-dessus + image en dessous + CTA. Largeur ~30vw
       pour avoir 4 visibles + 5e cropée à droite. */
    .htypo-panel {
      flex: 0 0 clamp(260px, 26vw, 420px);
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding-bottom: clamp(2rem, 5vh, 4rem);
      text-decoration: none;
      color: inherit;
    }

    .htypo-card {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      width: 100%;
    }

    .htypo-name {
      font-family: var(--font-heading), sans-serif;
      font-weight: 700;
      font-size: clamp(0.85rem, 1.05vw, 1.05rem);
      line-height: 1.2;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--color-ink);
      margin: 0;
    }

    /* Images réduites 2026-05-02 (Morgan : « réduit un peu, faut un peu
       plus d'espace entre le texte et les images »). 4/5 portrait → 1/1
       carré, panel max-width passé de 480px → 420px : la photo perd
       en hauteur, libérant de l'espace entre l'intro et le rail. */
    .htypo-visual {
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
      overflow: hidden;
      background: color-mix(in srgb, var(--color-cream) 10%, var(--color-ink));
    }
    .htypo-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 0.9s var(--ease-out-editorial);
    }
    /* Pas d'animation au hover sur les images (demande Jonathan 2026-04-30). */

    /* .htypo-cta retiré 2026-05-02 (Morgan) avec le span correspondant. */

    /* Mobile : scroll horizontal snap natif au lieu du pin (touch-friendly).
       Le rail devient overflow-x scrollable, panels alignés snap start. */
    @media (max-width: 1023px) {
      .htypo-section {
        height: auto;
      }
      .htypo-sticky {
        position: relative;
        height: auto;
        overflow: visible;
        padding-top: 8rem;
      }
      .htypo-header {
        position: static;
        padding: 0 1.5rem 2rem;
      }
      .htypo-rail {
        height: auto;
        width: 100%;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        padding: 0 1.5rem 3rem;
      }
      .htypo-rail::-webkit-scrollbar {
        display: none;
      }
      .htypo-panel {
        scroll-snap-align: start;
        flex: 0 0 70vw;
        height: auto;
        padding-bottom: 1rem;
      }
    }
  </style>

  <script>
    // Hero slideshow VIDÉO — refonte 2026-04-29.
    //
    // 4 vidéos Jonathan jouent en boucle continue avec cross-fade 800 ms
    // entre chaque clip. Architecture : 2 éléments <video> qui alternent
    // (stage 0 et stage 1). Pendant qu'un stage joue, l'autre précharge le
    // clip suivant (src = next URL, video.load(), reste invisible). À 800 ms
    // de la fin du clip actif, on déclenche le cross-fade : l'autre stage
    // play() + classe .is-active → opacity 1, le stage actif perd .is-active
    // → opacity 0. Quand l'animation est terminée, on prépare le clip d'après
    // sur le stage qui vient d'être désactivé. Cycle infini.
    //
    // Reduced-motion : aucune vidéo ne joue, on affiche juste le poster du
    // 1er clip (paint instantané, comportement statique respectueux).
    function initHeroVideoSlideshow() {
      const container = document.querySelector<HTMLElement>('[data-hero-slideshow]');
      if (!container) return;
      if (container.dataset.slideshowWired === 'true') return;

      const stages = Array.from(
        container.querySelectorAll<HTMLVideoElement>('video[data-hero-stage]'),
      );
      if (stages.length < 2) return;

      let videos: string[] = [];
      try {
        videos = JSON.parse(container.dataset.heroVideos || '[]') as string[];
      } catch {
        videos = [];
      }
      if (videos.length < 1) return;
      container.dataset.slideshowWired = 'true';

      // Reduced-motion : on laisse le poster de la 1re vidéo, pas de play.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) {
        stages[0]!.classList.add('is-active');
        return;
      }

      // Crossfade window : on enchaîne ~CROSSFADE_MS avant la fin pour cacher
      // le swap dans la transition. Doit matcher la transition CSS opacity.
      const CROSSFADE_MS = 800;

      let activeIdx = 0; // 0 = stage 0 visible, 1 = stage 1 visible
      let nextVideoIdx = 1 % videos.length; // prochain clip à charger
      let switching = false;

      // Précharge le clip suivant sur le stage inactif. On compare
      // `currentSrc` (URL résolue, fonctionne avec <source> et avec src=)
      // pour éviter de recharger inutilement quand le stage a déjà le
      // bon clip (notamment au 1er appel — stage 1 a déjà clip 1 via SSR).
      // IMPORTANT : on reset currentTime=0 même quand l'URL est déjà bonne,
      // sinon au tour suivant du cycle (clip déjà joué une fois), play()
      // reprend à la frame courante → "démarre en cours de route".
      const preload = () => {
        const inactive = stages[1 - activeIdx]!;
        const url = videos[nextVideoIdx]!;
        if (inactive.currentSrc.endsWith(url)) {
          try {
            inactive.currentTime = 0;
          } catch {}
          return;
        }
        inactive.src = url;
        inactive.load();
      };

      const swap = () => {
        if (switching) return;
        const active = stages[activeIdx]!;
        const inactive = stages[1 - activeIdx]!;
        // Le stage inactif doit avoir son src prêt (préchargé). On le lance
        // muet (autoplay garanti) avant de basculer l'opacité pour éviter
        // un flash noir si la frame n'est pas encore décodée.
        switching = true;
        // Garantie démarrage à zéro — si le clip a déjà été joué dans un
        // tour précédent du cycle, son currentTime n'est pas remis à 0 par
        // preload() (short-circuit URL identique). On force ici.
        try {
          inactive.currentTime = 0;
        } catch {}
        const startNext = () => {
          inactive.classList.add('is-active');
          active.classList.remove('is-active');
          activeIdx = 1 - activeIdx;
          nextVideoIdx = (nextVideoIdx + 1) % videos.length;
          // Au bout du fade-out (≥ CROSSFADE_MS), on remet l'ex-active à 0
          // et on précharge le clip d'après dessus.
          window.setTimeout(() => {
            active.pause();
            active.currentTime = 0;
            preload();
            switching = false;
          }, CROSSFADE_MS + 50);
        };
        const playPromise = inactive.play();
        if (playPromise && typeof playPromise.then === 'function') {
          playPromise.then(startNext).catch(startNext);
        } else {
          startNext();
        }
      };

      // Polling de la position de lecture du stage actif via timeupdate
      // (déclenché 4 fois/s en moyenne, suffisant pour viser 800 ms avant fin).
      const onTimeUpdate = (e: Event) => {
        const v = e.currentTarget as HTMLVideoElement;
        if (!v.classList.contains('is-active')) return;
        if (!isFinite(v.duration) || v.duration <= 0) return;
        if (v.currentTime >= v.duration - CROSSFADE_MS / 1000 - 0.05) {
          swap();
        }
      };

      // Failsafe : si timeupdate ne déclenche pas (rare, ex. tab inactive),
      // le ended event prend le relais et bascule immédiatement (sans fondu
      // mais sans freeze).
      const onEnded = () => {
        if (!switching) swap();
      };

      stages.forEach((s) => {
        s.addEventListener('timeupdate', onTimeUpdate);
        s.addEventListener('ended', onEnded);
      });

      // Démarrage : stage 0 = clip 0 visible et en lecture, stage 1 = clip 1
      // préchargé invisible.
      stages[0]!.classList.add('is-active');
      const initialPlay = stages[0]!.play();
      if (initialPlay && typeof initialPlay.catch === 'function') {
        // Si l'autoplay est refusé (rare, hors muted+playsinline), on garde
        // le poster comme fallback. Pas de retry agressif.
        initialPlay.catch(() => {});
      }
      preload();

      // Nettoyage Astro view transitions
      document.addEventListener(
        'astro:before-swap',
        () => {
          stages.forEach((s) => {
            s.removeEventListener('timeupdate', onTimeUpdate);
            s.removeEventListener('ended', onEnded);
            s.pause();
          });
          container.dataset.slideshowWired = '';
        },
        { once: true },
      );
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroVideoSlideshow, { once: true });
    } else {
      initHeroVideoSlideshow();
    }
    document.addEventListener('astro:page-load', initHeroVideoSlideshow);

    // Vitrine pagination dots — sync avec le scrollLeft du rail. Pattern
    // designbyad scroll_home f_012 : dot actif suit la card centrée.
    function initVitrineDots() {
      const rail = document.querySelector<HTMLElement>('.vitrine-rail');
      const dotsContainer = document.querySelector<HTMLElement>('[data-vitrine-dots]');
      if (!rail || !dotsContainer) return;
      if (rail.dataset.dotsWired === 'true') return;
      rail.dataset.dotsWired = 'true';

      const dots = Array.from(dotsContainer.querySelectorAll<HTMLButtonElement>('.vitrine-dot'));
      const cards = Array.from(rail.children).filter((c) =>
        (c as HTMLElement).classList.contains('vitrine-card'),
      ) as HTMLElement[];
      if (cards.length === 0 || dots.length === 0) return;

      // State interne — index actif tracké explicitement pour éviter de relire
      // les dots pendant un smooth scroll en cours (Morgan 2026-04-28 : « bouton
      // flèches ne fonctionne pas » — symptôme du stale read).
      let activeIdx = 0;

      // Sync l'index actif depuis le scroll réel (scroll natif drag/swipe).
      const update = () => {
        const maxScroll = Math.max(1, rail.scrollWidth - rail.clientWidth);
        const ratio = Math.max(0, Math.min(1, rail.scrollLeft / maxScroll));
        const idx = Math.min(cards.length - 1, Math.round(ratio * (cards.length - 1)));
        activeIdx = idx;
        dots.forEach((d, i) => d.classList.toggle('is-active', i === idx));
      };

      const goToCard = (i: number) => {
        const clamped = Math.max(0, Math.min(cards.length - 1, i));
        const target = cards[clamped];
        if (!target) return;
        // Maj synchrone du state pour que les clics rapides sur next/prev
        // accumulent correctement (sinon currentIndex() lit le scroll en cours).
        activeIdx = clamped;
        dots.forEach((d, i) => d.classList.toggle('is-active', i === clamped));
        updateArrowsState();
        const targetLeft = target.offsetLeft - (rail.clientWidth - target.clientWidth) / 2;
        rail.scrollTo({ left: targetLeft, behavior: 'smooth' });
      };

      // Click sur dot → scroll smooth vers la card correspondante
      dots.forEach((dot, i) => dot.addEventListener('click', () => goToCard(i)));

      // Boutons prev/next (Morgan 2026-04-27 puis fix 2026-04-28)
      const prevBtn = document.querySelector<HTMLButtonElement>('[data-vitrine-prev]');
      const nextBtn = document.querySelector<HTMLButtonElement>('[data-vitrine-next]');
      prevBtn?.addEventListener('click', () => goToCard(activeIdx - 1));
      nextBtn?.addEventListener('click', () => goToCard(activeIdx + 1));
      const updateArrowsState = () => {
        if (prevBtn) prevBtn.disabled = activeIdx <= 0;
        if (nextBtn) nextBtn.disabled = activeIdx >= cards.length - 1;
      };
      updateArrowsState();

      // Drag-to-scroll souris (Morgan 2026-04-27 : "pouvoir cliquer pour
      // swiper dans les projets"). On suit le pointeur en X et on translate
      // scrollLeft inversement. Threshold 5px pour distinguer drag vs click.
      let isDragging = false;
      let dragStartX = 0;
      let dragStartScroll = 0;
      let movedDist = 0;

      rail.addEventListener('pointerdown', (e) => {
        // Skip si pointer sur un lien (laisser click agir)
        if ((e.target as HTMLElement).closest('a')) {
          // On laisse le click natif passer, mais on track quand même pour
          // pouvoir prevent en cas de drag réel.
        }
        isDragging = true;
        dragStartX = e.clientX;
        dragStartScroll = rail.scrollLeft;
        movedDist = 0;
        rail.style.scrollSnapType = 'none';
        rail.style.cursor = 'grabbing';
      });

      rail.addEventListener('pointermove', (e) => {
        if (!isDragging) return;
        const dx = e.clientX - dragStartX;
        movedDist = Math.abs(dx);
        rail.scrollLeft = dragStartScroll - dx;
      });

      const endDrag = (e: PointerEvent) => {
        if (!isDragging) return;
        isDragging = false;
        rail.style.scrollSnapType = '';
        rail.style.cursor = '';
        // Si l'utilisateur a vraiment dragué (>5px), bloquer le click natif
        // pour éviter d'ouvrir la card par accident.
        if (movedDist > 5) {
          const link = (e.target as HTMLElement).closest('a');
          if (link) {
            const blocker = (ev: Event) => {
              ev.preventDefault();
              ev.stopPropagation();
              link.removeEventListener('click', blocker, true);
            };
            link.addEventListener('click', blocker, true);
          }
        }
      };
      rail.addEventListener('pointerup', endDrag);
      rail.addEventListener('pointercancel', endDrag);
      rail.addEventListener('pointerleave', endDrag);

      const updateAll = () => {
        update();
        updateArrowsState();
      };
      updateAll();
      rail.addEventListener('scroll', updateAll, { passive: true });
      window.addEventListener('resize', updateAll);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initVitrineDots, { once: true });
    } else {
      initVitrineDots();
    }
    document.addEventListener('astro:page-load', initVitrineDots);
  </script>
</BaseLayout>
