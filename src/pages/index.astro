---
/*
 * Home — Studio J Oliveira
 *
 * Architecture v2 (refonte vitrine premium, 2026-04-22 soir) :
 *   01. Hero plein écran
 *   02. Positionnement & territoires (#studio-lead)
 *   03. Typologies scrollytelling (#typologies) — 4 scènes plein écran
 *   04. Méthode 3 étapes (#methode) — sourcé PDF Jonathan
 *   05. Manifeste pull-quote scroll-pin (#manifeste)
 *   06. CTA contact final (#contact-cta)
 *
 * Tous les textes sont soit sourcés du PDF process Jonathan, soit marqués [À FOURNIR].
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaLink from '@/components/astro/CtaLink.astro';
// IntroBumper désactivé 2026-04-24 : couvrait l'écran en noir si la vidéo
// logo ne jouait pas (fallback 3.5s + dismiss parfois laggy). Morgan
// signalait « accueil toujours noir ». À réactiver quand Jonathan fournira
// une vidéo logo plus robuste + une seconde de fallback.
import { Image } from 'astro:assets';
// Slideshow hero VIDÉO — refonte 2026-04-29 (Morgan : 3 vidéos Jonathan
// fournies en full HD, ré-encodées 720p H.264 via scripts/optimize-hero-videos.ts).
// Cycle infini avec cross-fade 800 ms entre chaque clip.
// Sources brutes hors repo : _assets/hero-source/ (gitignored).
import { HERO_LQIP_DATA_URI } from '@/data/hero-lqip';
const heroVideos = [
  { src: '/hero/hero-01.mp4', poster: '/hero/hero-01-poster.jpg' },
  { src: '/hero/hero-02.mp4', poster: '/hero/hero-02-poster.jpg' },
  { src: '/hero/hero-03.mp4', poster: '/hero/hero-03-poster.jpg' },
];
import typoMicroUrbain from '@/assets/typologies/micro-urbain.webp';
import typoCoeurUrbain from '@/assets/typologies/coeur-urbain.webp';
import typoFrangeUrbaine from '@/assets/typologies/frange-urbaine.webp';
import typoDomaine from '@/assets/typologies/domaine-caractere.webp';
import { PROJETS_PAR_SLUG } from '@/lib/projets';

// Typologies — données sourcées du PDF PROCESS-ETUDES-STUDIO-2026 (lignes 29-306)
// Les phrases courtes sont extraites des citations Jonathan (brief consolidé).
const typologies = [
  {
    slug: 'micro-urbain',
    index: '01',
    nom: 'Micro‑urbain',
    requete: 'Aménagement de petit jardin en ville',
    surface: '< 50 m²',
    budget: '< 20 000 €',
    etude: '1 200 € TTC',
    exemples: 'Terrasses · Rooftops · Patios',
    // Source : PDF ligne 99-113
    phrase: "L'espace extérieur devient une pièce à part entière de l'habitation.",
    image: typoMicroUrbain,
    // object-position : centrer l'intérêt visuel (moitié basse pour terrasse)
    imagePosition: 'center 65%',
    imageNote: '[À FOURNIR — image définitive Micro‑urbain, placeholder actuel évocateur]',
  },
  {
    slug: 'coeur-urbain',
    index: '02',
    nom: 'Cœur urbain',
    requete: 'Conception de jardin de ville sur mesure',
    surface: '50 — 300 m²',
    budget: '20 000 — 50 000 €',
    etude: '2 750 € TTC',
    exemples: 'Maison de ville · Cour patrimoniale · Jardin de caractère',
    // Source : PDF ligne 135
    phrase: 'Très technique, très risquée, très précieuse et très stratégique.',
    image: typoCoeurUrbain,
    imagePosition: 'center 55%',
  },
  {
    slug: 'frange-urbaine',
    index: '03',
    nom: 'Frange urbaine',
    requete: 'Aménagement de grand jardin péri-urbain',
    surface: '300 — 1 500 m²',
    budget: '50 000 — 90 000 €',
    etude: '4 250 € TTC',
    exemples: 'Pavillon · Maison de campagne · Finca · Bâti reconverti',
    // Source : PDF ligne 137-159 (reformulation synthétique)
    phrase: 'Un territoire instable entre la ville et la nature.',
    image: typoFrangeUrbaine,
    imagePosition: 'center 50%',
  },
  {
    slug: 'domaine-caractere',
    index: '04',
    nom: 'Domaines & Caractère',
    requete: 'Conception de parc et domaine privé',
    surface: 'Sans limite',
    budget: '> 90 000 €',
    etude: '6 500 € TTC',
    exemples: 'Château · Manoir · Domaine · Grange rénovée',
    // Source : PDF ligne 161-181
    phrase:
      'Un dialogue entre une architecture ancienne, un sol fatigué, un paysage réel et une mémoire invisible.',
    image: typoDomaine,
    imagePosition: 'center 40%',
  },
];

// Méthode — sourcée PDF PROCESS page parcours commercial
// Méthode 3 étapes migrée vers /demarrer-un-projet (refonte 2026-04-28).

// Zones d'intervention — cf. site-config.ts (sourcé)
const zones = ['Brive‑la‑Gaillarde', 'Bordeaux', 'Limoges'];

// Vitrine projets — pattern designbyad (scroll_home.mp4 frame 7-9) :
// portraits 70vh + name UPPERCASE au-dessus + scroll horizontal natif touch.
// Sources sourcées : noms + lieux issus de src/lib/projets.ts (extraits PDF Jonathan).
const vitrine = [
  {
    ...PROJETS_PAR_SLUG['coeur-urbain']!,
    image: typoCoeurUrbain,
    href: '/architecture-paysagere/coeur-urbain',
  },
  {
    ...PROJETS_PAR_SLUG['frange-urbaine']!,
    image: typoFrangeUrbaine,
    href: '/architecture-paysagere/frange-urbaine',
  },
  {
    ...PROJETS_PAR_SLUG['domaine-caractere']!,
    image: typoDomaine,
    href: '/architecture-paysagere/domaine-caractere',
  },
  {
    ...PROJETS_PAR_SLUG['micro-urbain']!,
    image: typoMicroUrbain,
    href: '/architecture-paysagere/micro-urbain',
  },
];
---

<BaseLayout
  title="Studio J Oliveira — Designer paysagiste & design biophilique"
  description="Studio de design paysagiste biophilique à Brive‑la‑Gaillarde. Études et conceptions d'espaces à vivre en Aquitaine et Limousin. Architectures vivantes, bâti × environnement × humain."
  darkHero
>
  {
    /* Preload de l'image hero (Morgan 2026-04-27 : « l'image met un temps
      à s'afficher, on voit d'abord du noir »). fetchpriority="high" pour
      qu'elle charge en parallèle des fonts dès le 1er paint.
      WebP 749 KB (vs 13 MB JPG d'origine) + LQIP base64 inliné en
      background-image initial sur la section → affichage instantané (0 RTT)
      puis swap vers la WebP via JS dès qu'elle est chargée. */
  }
  <Fragment slot="head">
    {
      /* Preload du poster de la 1re vidéo : paint instantané dès le HTML parse,
        sert aussi de fallback (prefers-reduced-motion, JS désactivé, autoplay
        refusé). Le streaming de la vidéo elle-même est piloté par l'attribut
        preload="auto" sur le <video> (pas de link rel=preload as=video qui
        peut causer des doubles téléchargements selon les heuristiques cache). */
    }
    <link
      rel="preload"
      as="image"
      href="/hero/hero-01-poster.jpg"
      type="image/jpeg"
      fetchpriority="high"
    />
  </Fragment>
  {/* IntroBumper retiré 2026-04-24 — bug écran noir persistant */}

  {
    /* Bandeau topbar retiré 2026-04-27 (Morgan : « catastrophique, ça coupe
      le logo en deux »). Approche remplacée par un gradient sombre subtil
      en haut du hero (cf. style background dans la section) qui assombrit
      la zone Header sans coupure visuelle. */
  }

  <!-- 01 · HERO IMMERSIF — sticky "recouvrement" style Polestar 5 (mail Jonathan).
       Le hero reste fixé en arrière-plan pendant que la section suivante
       vient se superposer au scroll (pas un défilement classique). -->
  {
    /* LQIP base64 inliné comme background-image initial sur la section (~0.5 KB,
      0 RTT réseau, affichage instantané dès le HTML parse). Sert de fond ultime
      sous le slideshow vidéo : si la 1re vidéo n'a pas encore son poster décodé,
      le LQIP empêche tout flash noir. Une fois la vidéo en lecture, le LQIP
      est intégralement recouvert. */
  }
  <section
    id="hero"
    data-section-label="Accueil"
    data-theme="dark"
    class="hero-immersive hero-sticky relative isolate overflow-hidden bg-[var(--color-forest)] text-[var(--color-cream)]"
    style={`background-image: url("${HERO_LQIP_DATA_URI}"); background-size: cover; background-position: center; background-repeat: no-repeat;`}
    data-hero-bg
  >
    {
      /* Stacking explicite (Morgan 2026-04-27 « tout noir le fond ») :
        slideshow z-0 par-dessus le bg ink de la section, contenu z-10
        par-dessus. On retire isolate sur la section qui scopait -z-10
        en dessous du paint background. */
    }
    {
      /* DEBUG 2026-04-27 : Morgan voit toujours du noir. data-hero-zoom retiré
        (peut set des filter/transform incorrects), gradient overlay réécrit
        en style inline (la syntaxe Tailwind 4 from-[var(...)]/92 peut ne pas
        compiler le color-mix correctement), opacity 1 forcée inline sur le
        1er slide pour bypass tout CSS récalcitrant. */
    }
    {
      /* Slideshow VIDÉO — refonte 2026-04-29 (Morgan : 3 vidéos Jonathan en
        fond, en boucle continue avec transition fluide entre chaque clip).
        Architecture : 2 éléments <video> qui alternent (stage 0 / 1).
        Pendant qu'un stage joue, l'autre précharge le clip suivant. À ~800 ms
        de la fin du stage actif, on lance le suivant en cross-fade opacity.
        Cycle infini sur les 3 clips. Chaque <video> a son poster JPG en
        fallback (paint instantané + reduced-motion + JS désactivé). */
    }
    <div
      class="absolute inset-0 z-0"
      data-hero-slideshow
      data-hero-videos={JSON.stringify(heroVideos.map((v) => v.src))}
      data-hero-posters={JSON.stringify(heroVideos.map((v) => v.poster))}
    >
      {
        /* Fallback poster : <img> du 1er frame, toujours affiché derrière les
          videos. Si autoplay/preload échoue ou si le browser refuse la lecture
          pour une raison quelconque, on a au moins une image fixe qui couvre
          le hero. Les videos passent par-dessus quand elles jouent. */
      }
      <img
        src={heroVideos[0]!.poster}
        alt=""
        aria-hidden="true"
        class="hero-video-fallback"
        fetchpriority="high"
        decoding="async"
      />
      {
        /* Stage 0 — visible et en lecture au démarrage. <source> enfant (plus
          robuste que src attribute pour autoplay sur Safari iOS notamment). */
      }
      <video
        class="hero-video is-active"
        data-hero-stage="0"
        poster={heroVideos[0]!.poster}
        muted
        playsinline
        preload="auto"
        autoplay
        aria-hidden="true"
      >
        <source src={heroVideos[0]!.src} type="video/mp4" />
      </video>
      {
        /* Stage 1 — préchargé invisible avec le 2ᵉ clip, devient visible quand
          le stage 0 termine (cross-fade 800 ms). Le <source> est en place dès
          le SSR pour que preload="auto" puisse commencer à streamer en background. */
      }
      <video
        class="hero-video"
        data-hero-stage="1"
        poster={heroVideos[1]!.poster}
        muted
        playsinline
        preload="auto"
        aria-hidden="true"
      >
        <source src={heroVideos[1]!.src} type="video/mp4" />
      </video>
      <!-- Overlay lisibilité — voile vignette top/bottom uniquement. La zone
           H1 (top: 22-70%) reste totalement transparente : le mix-blend du
           H1 voit la vidéo en direct → effet inverse exact comme le cursor. -->
      <div
        class="absolute inset-0"
        aria-hidden="true"
        style="background: linear-gradient(to bottom, rgba(0,0,0,0.50) 0%, rgba(0,0,0,0.20) 10%, rgba(0,0,0,0) 22%, rgba(0,0,0,0) 70%, rgba(0,0,0,0.45) 86%, rgba(0,0,0,0.92) 100%);"
      >
      </div>
    </div>

    {
      /* Hero asymétrique — refonte 2026-04-27 (brief Morgan : « le texte n'est
        pas obligé d'être à gauche »). Layout cassé inspiré designbyad : eyebrow
        en haut-droit, "Designer" en milieu-gauche, "paysagiste" Gloock énorme
        décalé bas-droite (déborde la grille), manifesto bas-gauche, CTA + cue
        à des coins différents. Le H1 se lit en diagonale → narration spatiale. */
    }
    <div class="hero-asymmetric relative min-h-[100svh] w-full" data-hero-sequence>
      {/* Eyebrow — haut-droit, vertical signature */}
      <p
        data-hero="eyebrow"
        class="hero-eyebrow font-mono text-[11px] tracking-[0.26em] text-[var(--color-cream)]/70 uppercase"
      >
        <span class="hero-eyebrow-dot" aria-hidden="true"></span>
        Brive‑la‑Gaillarde &nbsp;·&nbsp; Aquitaine &nbsp;·&nbsp; Est. 2021
      </p>

      {
        /* H1 éclaté — refonte 2026-04-27 : passage en CAPS pour gain de poids
          visuel (style designbyad). Plus de jambages descendants problématiques
          (Y, p, g, j). Letter-spacing resserré pour cohésion du bloc. */
      }
      {
        /* H1 inverse vidéo permanent (refonte 2026-04-28 #2 Jonathan) :
          texte blanc + mix-blend-mode: difference au niveau de chaque ligne.
          Pas de bandeau coloré — la couleur inverse se fait directement
          contre la photo / le fond, en permanence. Lisible sur n'importe
          quel arrière-plan, vidéo comprise. */
      }
      <h1 class="hero-title-asym hero-title-cutout text-[var(--color-cream)]">
        <span class="hero-word-designer" data-hero-mask>
          <span data-mask-line class="hero-line block">DESIGNER</span>
        </span>
        <span class="hero-word-paysagiste" data-hero-mask>
          <span data-mask-line class="hero-line block">PAYSAGISTE</span>
        </span>
      </h1>

      {/* Trait vertical signature qui relie les deux mots du H1 (designbyad-like) */}
      <span class="hero-rule" aria-hidden="true"></span>

      {
        /* Manifesto bas-gauche + 2 CTAs hero retirés 2026-04-28 (Jonathan) :
          le hero respire désormais autour du seul H1 inverse vidéo. */
      }

      {
        /* /01 retiré 2026-04-27 (Morgan : « se balade en haut à gauche »).
          Le marqueur faisait artefact visuel sans valeur — pas de référence
          designbyad réelle. */
      }

      <div
        data-hero="cue"
        class="scroll-cue pointer-events-none absolute bottom-6 left-1/2 z-10 -translate-x-1/2 text-[var(--color-cream)]/60"
      >
        <div class="flex flex-col items-center gap-3">
          <span class="font-mono text-[10px] tracking-[0.32em] uppercase">Scroll</span>
          <span class="scroll-cue-line block h-10 w-px bg-[var(--color-cream)]/40"></span>
        </div>
      </div>
    </div>
  </section>

  {
    /* Section Univers retirée 2026-04-24 (brief Jonathan) — priorité architecture
      paysagère seule. Remplacée par la section intro ci-dessous. */
  }

  <!-- 01b · ARCHITECTURE PAYSAGÈRE — refonte 2026-04-28 (Jonathan) :
       constellation typographique de 26 mots-clés répartis sur 5 lignes
       qui bougent au scroll (setupJustifyMulti). Le studio s'écrit en
       vocabulaire, pas en image. Trame cream + texte ink. -->
  <section
    id="archi-intro"
    data-section-label="Identité"
    class="archi-intro relative isolate overflow-hidden bg-[var(--color-cream)] text-[var(--color-ink)]"
    aria-labelledby="archi-intro-title"
  >
    <div class="mx-auto max-w-[1500px] px-6 py-32 md:px-10 md:py-44 lg:py-56">
      <header class="mb-16 md:mb-24" data-reveal="up">
        <h2
          id="archi-intro-title"
          class="archi-intro-title font-[family-name:var(--font-heading)] leading-[1]"
        >
          Le jardin, une architecture.
        </h2>
      </header>

      {
        /* Constellation : 5 lignes de 5 mots-clés extraits du verbe Jonathan
          (cahier des charges + studio.astro). setupJustifyMulti pilote la
          cascade — chaque ligne se déploie avec un décalage progressif
          (lineStep) au scroll. Les rythmes par ligne pourront être
          différenciés ultérieurement (Morgan 2026-04-28). */
      }
      <div
        class="archi-constellation"
        data-justify-multi
        data-justify-target="#archi-intro"
        data-justify-amp="55"
        data-justify-line-step="0.10"
        data-justify-line-window="0.40"
      >
        <p class="archi-constellation-line" data-justify-line>
          IMMERSION CONCEPTION TERRITOIRE DESIGN ARCHITECTURE
        </p>
        <p class="archi-constellation-line" data-justify-line>
          BIOPHILIE ÉCOSYSTÈME ESSENCE VÉGÉTAL HARMONIE
        </p>
        <p class="archi-constellation-line" data-justify-line>
          SCIENTIFIQUE SENSORIALITÉ EXPÉRIENCE MÉTHODE ÉTUDE
        </p>
        <p class="archi-constellation-line" data-justify-line>
          INTÉRIEUR BÂTI HUMAIN EXTÉRIEUR ENVIRONNEMENT
        </p>
        <p class="archi-constellation-line" data-justify-line>
          RÉALISATION VALEUR DISTINCTION AUTHENTICITÉ PARCOURS
        </p>
      </div>
    </div>
  </section>

  <!-- 02 · STUDIO BIOPHILIQUE — refonte 2026-04-24 mail Jonathan :
       fond uni gris foncé (ink) — règle : home + archi + studio = ink.
       Pros = cream. -->
  <section
    id="studio-lead"
    data-section-label="Studio"
    data-theme="dark"
    class="studio-biophilique relative isolate overflow-hidden border-t border-[var(--color-cream)]/10 bg-[var(--color-klein)] text-[var(--color-cream)]"
    aria-labelledby="studio-lead-title"
  >
    <div class="relative mx-auto max-w-[1500px] px-6 py-28 md:px-10 md:py-40">
      {
        /* Pattern designbyad (scroll_home.mp4 frame 2) : bloc mots-clés UPPERCASE
          calé gauche-droite par justify CSS natif. data-justify-scroll → chaque
          mot oscille individuellement autour de sa position justify naturelle
          au scroll (direction/amplitude/phase seedées par mot). Premier et
          dernier mot ancrés → calage gauche-droite préservé. */
      }
      <p
        class="studio-keywords mb-20 md:mb-28"
        data-reveal="up"
        data-justify-scroll
        data-justify-amp="22"
        data-justify-seed="7"
      >
        Architecture paysagère <span aria-hidden="true">·</span>
        Design biophilique <span aria-hidden="true">·</span>
        Études sur‑mesure <span aria-hidden="true">·</span>
        Studio indépendant
      </p>

      <div class="grid gap-16 md:grid-cols-12 md:gap-20">
        <div class="md:col-span-7" data-reveal="up" data-parallax="-0.3">
          {/* Eyebrow de section retiré 2026-04-28 #B8 — labels uniquement dans ScrollNav. */}
          <h2
            id="studio-lead-title"
            data-mask-reveal
            data-mask-stagger="0.14"
            class="mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-5xl)] leading-[1.02] md:text-[length:var(--text-hero)]"
          >
            <span data-mask-line class="block pb-[0.05em]">
              Design <span class="display">végétal</span> en
            </span>
            <span data-mask-line class="display block pb-[0.12em]">Aquitaine, Limousin.</span>
          </h2>
          <p
            class="mt-10 max-w-xl text-[length:var(--text-lg)] leading-relaxed text-[var(--color-cream)]/80"
          >
            Art de conception architecturale inspiré des environnements naturels et de leurs effets
            sur les humains. Une démarche
            <span class="hover-accent">scientifique</span>
            couplée à la <span class="hover-accent">technicité</span> architecturale, pour des espaces
            à vivre proches de ce que l'on ressent dans un lieu à l'état naturel.
          </p>
          <div class="mt-10">
            <CtaLink href="/studio" label="Lire le manifeste complet" tone="dark" size="md" />
          </div>
        </div>

        <aside
          class="md:col-span-5"
          data-reveal="up"
          data-reveal-delay="0.15"
          data-parallax="0.4"
          aria-labelledby="zones-title"
        >
          <p
            id="zones-title"
            class="font-mono text-[11px] tracking-[0.26em] text-[var(--color-cream)]/70 uppercase"
          >
            <span class="studio-zones-dot" aria-hidden="true"></span>
            Zones d'intervention
          </p>
          <ul
            class="mt-8 divide-y divide-[var(--color-cream)]/12 border-t border-b border-[var(--color-cream)]/12"
          >
            {
              zones.map((zone, i) => (
                <li class="studio-zone group flex items-baseline justify-between gap-4 py-5">
                  <span class="flex items-baseline gap-5">
                    <span class="w-7 font-mono text-[10px] tracking-[0.26em] text-[var(--color-cream)]/55 uppercase">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <span class="font-[family-name:var(--font-heading)] text-[length:var(--text-3xl)] leading-none text-[var(--color-cream)] transition-opacity group-hover:opacity-70">
                      {zone}
                    </span>
                  </span>
                  <span class="font-mono text-[11px] tracking-[0.22em] text-[var(--color-cream)]/40 transition-all group-hover:translate-x-1 group-hover:text-[var(--color-cream)]">
                    →
                  </span>
                </li>
              ))
            }
          </ul>
          <p class="mt-6 text-sm leading-relaxed text-[var(--color-cream)]/70">
            Studio basé à Brive‑la‑Gaillarde. Déplacements réguliers vers Bordeaux et Limoges —
            aucun bureau satellite, le studio vient au projet.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <!-- 03 · TYPOLOGIES — fond uni ink (mail Jonathan 2026-04-24) -->
  <section
    id="typologies"
    data-section-label="Typologies"
    data-hscroll-typologies
    class="htypo-section relative border-t border-[var(--color-ink)]/10 bg-[var(--color-cream)] text-[var(--color-ink)]"
    aria-labelledby="typologies-title"
  >
    <div class="htypo-sticky">
      <!-- Header fixe -->
      <header class="htypo-header">
        {/* Eyebrow Typologies retiré 2026-04-28 #B8. */}
        {
          /* Titre typologies agrandi (Morgan 2026-04-27) : il occupe désormais
            une large bande visible tout au long du scroll horizontal grâce au
            sticky du header. Taille passée de text-2xl à hero, line-height
            serré pour compacité éditoriale. Mots clés "habiter" en italic
            display pour ancrage visuel. */
        }
        <h2
          id="typologies-title"
          class="htypo-title mt-4 max-w-3xl pb-[0.12em] font-[family-name:var(--font-heading)] leading-[0.95] text-[var(--color-ink)]"
        >
          Quatre manières <span class="display">d'habiter</span>
          un jardin.
        </h2>
      </header>

      <!-- Rail horizontal : 4 panneaux plein écran -->
      <div class="htypo-rail" data-hscroll-rail>
        {
          typologies.map((t, i) => (
            <a
              href={`/architecture-paysagere/${t.slug}`}
              class="htypo-panel group"
              data-hscroll-panel
              data-cursor-cta-host
              data-cursor-label="EXPLORER"
              aria-label={`Explorer la typologie ${t.nom}`}
            >
              <div class="htypo-visual" data-parallax-layer="frame">
                <div class="htypo-visual-inner" data-parallax-layer="image">
                  <Image
                    src={t.image}
                    alt=""
                    widths={[720, 1080, 1440, 1920]}
                    sizes="(min-width: 1024px) 38vw, 80vw"
                    quality={82}
                    format="webp"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    class="htypo-img"
                    style={`object-position: ${t.imagePosition ?? 'center'}`}
                  />
                  <div class="htypo-veil" aria-hidden="true" />
                </div>
                <span class="htypo-index-xl" aria-hidden="true">
                  {t.index}
                </span>
              </div>

              <div class="htypo-copy" data-parallax-layer="text">
                <p class="font-mono text-[10px] tracking-[0.26em] text-[var(--color-ink)]/70 uppercase">
                  {t.index} &nbsp;·&nbsp; Typologie
                </p>
                <h3 class="htypo-name mt-5 font-[family-name:var(--font-heading)] text-[length:var(--text-5xl)] leading-[0.95] text-[var(--color-ink)] md:text-[length:var(--text-6xl)]">
                  <span class="display">{t.nom}</span>
                </h3>
                <p
                  data-split
                  data-split-types="words"
                  data-split-stagger="0.06"
                  data-split-duration="1.05"
                  class="htypo-phrase mt-6 max-w-md font-[family-name:var(--font-heading)] text-[length:var(--text-xl)] leading-[1.25] text-[var(--color-ink)]/75 md:text-[length:var(--text-2xl)]"
                >
                  {t.phrase}
                </p>

                {/* Meta sans prix étude — brief Jonathan 2026-04-24. Surface + budget travaux + exemples. */}
                <dl class="htypo-meta mt-10 grid max-w-md grid-cols-2 gap-x-6 gap-y-4 font-mono text-[10px] tracking-[0.22em] text-[var(--color-ink)]/70 uppercase">
                  <div>
                    <dt class="text-[var(--color-ink)]/45">Surface</dt>
                    <dd class="mt-1.5 text-[var(--color-ink)]">{t.surface}</dd>
                  </div>
                  <div>
                    <dt class="text-[var(--color-ink)]/45">Budget travaux</dt>
                    <dd class="mt-1.5 text-[var(--color-ink)]">{t.budget}</dd>
                  </div>
                  <div class="col-span-2">
                    <dt class="text-[var(--color-ink)]/45">Exemples</dt>
                    <dd class="mt-1.5 tracking-[0.05em] text-[var(--color-ink)] normal-case">
                      {t.exemples}
                    </dd>
                  </div>
                </dl>

                <span class="htypo-cta-static mt-10 inline-flex items-center gap-3 border-b border-[var(--color-ink)]/35 pb-1 text-sm tracking-wide text-[var(--color-ink)]/85 transition-opacity group-hover:opacity-60">
                  Explorer la typologie
                  <span aria-hidden="true">→</span>
                </span>
              </div>

              <span class="htypo-cursor-cta" data-cursor-cta aria-hidden="true">
                <span class="htypo-cursor-cta-inner">Explorer</span>
              </span>
            </a>
          ))
        }
      </div>

      <!-- Progress ticks -->
      <div class="htypo-progress" aria-hidden="true">
        {typologies.map((_, i) => <span class="htypo-tick" data-tick-index={i} />)}
      </div>
    </div>
  </section>

  {/* Section méthode migrée vers /demarrer-un-projet (refonte 2026-04-28). */}

  <!-- 04b · VITRINE PROJETS — pattern designbyad (scroll_home.mp4 frame 7-9) :
       projets en portraits 70vh + name UPPERCASE au-dessus, scroll horizontal
       natif touch-friendly (snap mandatory). Chaque card image-rise au reveal. -->
  <section
