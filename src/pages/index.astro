---
/*
 * Home — Studio J Oliveira
 *
 * Architecture v2 (refonte vitrine premium, 2026-04-22 soir) :
 *   00. IntroBumper (slot="intro")
 *   01. Hero plein écran
 *   02. Positionnement & territoires (#studio-lead)
 *   03. Typologies scrollytelling (#typologies) — 4 scènes plein écran
 *   04. Méthode 3 étapes (#methode) — sourcé PDF Jonathan
 *   05. Manifeste pull-quote scroll-pin (#manifeste)
 *   06. CTA contact final (#contact-cta)
 *
 * Tous les textes sont soit sourcés du PDF process Jonathan, soit marqués [À FOURNIR].
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import IntroBumper from '@/components/astro/IntroBumper.astro';
import { Image } from 'astro:assets';
import heroImage from '@/assets/home/hero-biophilie.png';
import typoMicroUrbain from '@/assets/typologies/micro-urbain.webp';
import typoCoeurUrbain from '@/assets/typologies/coeur-urbain.webp';
import typoFrangeUrbaine from '@/assets/typologies/frange-urbaine.webp';
import typoDomaine from '@/assets/typologies/domaine-caractere.webp';

// Typologies — données sourcées du PDF PROCESS-ETUDES-STUDIO-2026 (lignes 29-306)
// Les phrases courtes sont extraites des citations Jonathan (brief consolidé).
const typologies = [
  {
    slug: 'micro-urbain',
    index: '01',
    nom: 'Micro-urbain',
    requete: 'Aménagement de petit jardin en ville',
    surface: '< 50 m²',
    budget: '< 20 000 €',
    etude: '1 200 € TTC',
    exemples: 'Terrasses · Rooftops · Patios',
    // Source : PDF ligne 99-113
    phrase:
      "L'espace extérieur devient une pièce à part entière de l'habitation.",
    image: typoMicroUrbain,
    imageNote: '[À FOURNIR — image définitive typologie Micro-urbain, actuellement fallback évocateur]',
  },
  {
    slug: 'coeur-urbain',
    index: '02',
    nom: 'Cœur urbain',
    requete: 'Conception de jardin de ville sur mesure',
    surface: '50 — 300 m²',
    budget: '20 000 — 50 000 €',
    etude: '2 750 € TTC',
    exemples: 'Maison de ville · Cour patrimoniale · Jardin de caractère',
    // Source : PDF ligne 135
    phrase:
      'Très technique, très risquée, très précieuse et très stratégique.',
    image: typoCoeurUrbain,
  },
  {
    slug: 'frange-urbaine',
    index: '03',
    nom: 'Frange urbaine',
    requete: 'Aménagement de grand jardin péri-urbain',
    surface: '300 — 1 500 m²',
    budget: '50 000 — 90 000 €',
    etude: '4 250 € TTC',
    exemples: 'Pavillon · Maison de campagne · Finca · Bâti reconverti',
    // Source : PDF ligne 137-159 (reformulation synthétique)
    phrase:
      'Un territoire instable entre la ville et la nature.',
    image: typoFrangeUrbaine,
  },
  {
    slug: 'domaine-caractere',
    index: '04',
    nom: 'Domaines & Caractère',
    requete: 'Conception de parc et domaine privé',
    surface: 'Sans limite',
    budget: '> 90 000 €',
    etude: '6 500 € TTC',
    exemples: 'Château · Manoir · Domaine · Grange rénovée',
    // Source : PDF ligne 161-181
    phrase:
      'Un dialogue entre une architecture ancienne, un sol fatigué, un paysage réel et une mémoire invisible.',
    image: typoDomaine,
  },
];

// Méthode — sourcée PDF PROCESS page parcours commercial
const methode = [
  {
    num: '01',
    titre: 'Appel de découverte',
    duree: '15 à 25 minutes',
    description:
      'Premier échange téléphonique. On qualifie votre projet, le site, vos attentes. Vous repartez avec une lecture claire de la suite.',
  },
  {
    num: '02',
    titre: "Rendez-vous d'étude",
    duree: '1 h 45 à 2 h',
    description:
      'Sur place ou en visioconférence. Diagnostic approfondi du lieu et du programme. Orientations conceptuelles posées ensemble.',
  },
  {
    num: '03',
    titre: 'Validation à distance',
    duree: '15 minutes',
    description:
      "Cadrage final : périmètre d'étude, livrables, calendrier. Signature et lancement.",
  },
];

// Zones d'intervention — cf. site-config.ts (sourcé)
const zones = ['Brive-la-Gaillarde', 'Bordeaux', 'Limoges', 'Toulouse'];
---

<BaseLayout
  title="Studio J Oliveira — Designer végétal & design biophilique"
  description="Studio de design biophilique à Brive-la-Gaillarde. Études et conceptions de jardins en Aquitaine, Limousin, Toulouse. Architectures vivantes, bâti × environnement × humain."
  darkHero
>
  <IntroBumper slot="intro" />

  <!-- 01 · HERO IMMERSIF ─────────────────────────────────────────── -->
  <section
    id="hero"
    data-section-label="Accueil"
    class="hero-immersive relative isolate overflow-hidden bg-[var(--color-forest)] text-[var(--color-cream)]"
  >
    <div class="absolute inset-0 -z-10">
      <Image
        src={heroImage}
        alt=""
        widths={[640, 960, 1280, 1600, 1920, 2560]}
        sizes="100vw"
        quality={82}
        format="webp"
        class="hero-image h-full w-full object-cover object-center"
        loading="eager"
        data-hero-zoom
      />
      <div class="absolute inset-0 bg-[var(--color-forest)]/40 mix-blend-multiply" aria-hidden="true"></div>
      <div
        class="absolute inset-0 bg-gradient-to-t from-[var(--color-forest)]/95 via-[var(--color-forest)]/50 to-[var(--color-forest)]/20"
        aria-hidden="true"
      ></div>
      <div
        class="absolute inset-0 bg-gradient-to-r from-[var(--color-forest)]/70 via-transparent to-transparent"
        aria-hidden="true"
      ></div>
    </div>

    <div class="relative flex min-h-[100svh] flex-col" data-hero-sequence>
      <div class="mx-auto mt-auto w-full max-w-[1400px] px-6 pt-40 pb-24 md:px-10 md:pt-48 md:pb-32">
        <p
          data-hero="eyebrow"
          class="hero-eyebrow font-mono text-[11px] uppercase tracking-[0.3em] text-[var(--color-cream)]/70"
        >
          Studio · Brive-la-Gaillarde · Aquitaine · Est. 2021
        </p>

        <h1
          class="hero-title mt-8 font-[family-name:var(--font-heading)] text-[length:var(--text-hero)] leading-[1.02] tracking-tight text-[var(--color-cream)]"
        >
          <span data-hero-mask class="hero-mask block leading-[1.02]">
            <span data-mask-line class="hero-line block">Designer</span>
          </span>
          <span data-hero-mask class="hero-mask block leading-[1.02]">
            <span data-mask-line class="hero-line block italic text-[var(--color-gold)]">végétal</span>
          </span>
        </h1>

        <p
          data-hero="manifesto"
          class="hero-manifesto mt-10 max-w-xl text-[length:var(--text-lg)] leading-relaxed text-[var(--color-cream)]/80"
        >
          J'étudie et conçois des espaces à vivre, en dialogue avec le bâti, l'environnement et l'humain. Une démarche biophilique, scientifique et sensible.
        </p>

        <div
          data-hero="cta"
          class="hero-cta mt-14 flex flex-col items-start gap-6 md:flex-row md:items-center md:gap-10"
        >
          <a
            href="#typologies"
            class="inline-flex items-center gap-3 border-b border-[var(--color-cream)] pb-1 text-sm tracking-wide transition-colors hover:border-[var(--color-gold)] hover:text-[var(--color-gold)]"
          >
            Découvrir les typologies
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="/studio"
            class="text-sm text-[var(--color-cream)]/60 transition-colors hover:text-[var(--color-cream)]"
          >
            À propos du studio
          </a>
        </div>
      </div>

      <div
        data-hero="cue"
        class="scroll-cue pointer-events-none absolute bottom-8 left-1/2 z-10 -translate-x-1/2 text-[var(--color-cream)]/60"
      >
        <div class="flex flex-col items-center gap-3">
          <span class="font-mono text-[10px] uppercase tracking-[0.32em]">Explorer</span>
          <span class="scroll-cue-line block h-10 w-px bg-[var(--color-cream)]/40"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 · POSITIONNEMENT & TERRITOIRES ─────────────────────────── -->
  <section
    id="studio-lead"
    data-section-label="Studio"
    class="bg-[var(--color-cream)]"
    aria-labelledby="studio-lead-title"
  >
    <div class="mx-auto max-w-7xl px-6 py-32 md:grid md:grid-cols-12 md:gap-16 md:px-10 md:py-48">
      <div class="md:col-span-7" data-reveal="up">
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-[var(--color-moss)]">
          <span class="text-[var(--color-forest)]/40">01</span> &nbsp;·&nbsp; Studio biophilique
        </p>
        <h2
          id="studio-lead-title"
          data-mask-reveal
          data-mask-stagger="0.14"
          class="mt-4 font-[family-name:var(--font-heading)] text-[length:var(--text-4xl)] leading-[1.08] text-[var(--color-forest)]"
        >
          <span data-mask-line class="block">
            Design végétal en <em class="italic">Aquitaine</em>,
          </span>
          <span data-mask-line class="block">Limousin et Toulouse.</span>
        </h2>
        <p class="mt-8 max-w-xl text-[length:var(--text-lg)] leading-relaxed text-[var(--color-forest)]/80">
          Art de conception architecturale inspiré des environnements naturels et de leurs effets sur les humains. Une démarche scientifique couplée à la technicité architecturale, pour des espaces à vivre proches de ce que l'on ressent dans un lieu à l'état naturel.
        </p>
      </div>

      <aside class="mt-16 md:col-span-5 md:mt-0" data-reveal="up" data-reveal-delay="0.15">
        <p class="font-mono text-[11px] uppercase tracking-[0.28em] text-[var(--color-moss)]">
          Zones d'intervention
        </p>
        <ul class="mt-6 space-y-3 border-t border-[var(--color-forest)]/10 pt-6">
          {
            zones.map((zone) => (
              <li class="flex items-baseline justify-between border-b border-[var(--color-forest)]/10 pb-3">
                <span class="font-[family-name:var(--font-heading)] text-[length:var(--text-2xl)] text-[var(--color-forest)]">
                  {zone}
                </span>
                <span class="font-mono text-[10px] uppercase tracking-[0.28em] text-[var(--color-forest)]/50">
                  →
                </span>
              </li>
            ))
          }
        </ul>
        <a
          href="/studio"
          class="mt-8 inline-flex items-center gap-3 border-b border-[var(--color-forest)]/30 pb-1 text-sm tracking-wide text-[var(--color-forest)] transition-colors hover:border-[var(--color-moss)] hover:text-[var(--color-moss)]"
        >
          Lire le manifeste complet
          <span aria-hidden="true">→</span>
        </a>
      </aside>
    </div>
  </section>

  <!-- 03 · TYPOLOGIES SCROLLYTELLING ─────────────────────────────── -->
  <section
    id="typologies"
    data-section-label="Typologies"
    data-scrolly
    class="scrolly-section relative bg-[var(--color-forest)] text-[var(--color-cream)]"
    aria-labelledby="typologies-title"
  >
    <div class="scrolly-sticky">
      <!-- Stage : 4 images typologies en crossfade -->
      <div class="scrolly-stage">
        {
          typologies.map((t, i) => (
            <div class="scrolly-slide" data-scrolly-slide>
              <Image
                src={t.image}
                alt=""
                widths={[960, 1440, 1920, 2560]}
                sizes="100vw"
                quality={80}
                format="webp"
                loading={i === 0 ? 'eager' : 'lazy'}
                class="scrolly-img"
              />
              <div class="scrolly-veil" aria-hidden="true" />
            </div>
          ))
        }
      </div>

      <!-- Métadonnées haut -->
      <div class="scrolly-meta">
        <h2
          id="typologies-title"
          class="font-mono text-[11px] uppercase tracking-[0.28em] text-[var(--color-cream)]/70"
        >
          <span class="text-[var(--color-cream)]/40">02</span> &nbsp;·&nbsp; Quatre typologies, quatre manières d'habiter un jardin
        </h2>
      </div>

      <!-- Chapitres textuels — un par typologie -->
      <div class="scrolly-chapters">
        {
          typologies.map((t) => (
            <article class="scrolly-chapter" data-scrolly-chapter>
              <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-[var(--color-gold)]">
                {t.index} · {t.nom}
              </p>
              <h3 class="mt-5 font-[family-name:var(--font-heading)] text-[length:var(--text-4xl)] leading-[1.08] italic">
                {t.phrase}
              </h3>
              <dl class="mt-8 grid grid-cols-2 gap-x-8 gap-y-3 max-w-md font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--color-cream)]/70">
                <div>
                  <dt class="text-[var(--color-cream)]/40">Surface</dt>
                  <dd class="mt-1 text-[var(--color-cream)]">{t.surface}</dd>
                </div>
                <div>
                  <dt class="text-[var(--color-cream)]/40">Budget travaux</dt>
                  <dd class="mt-1 text-[var(--color-cream)]">{t.budget}</dd>
                </div>
                <div>
                  <dt class="text-[var(--color-cream)]/40">Prix étude</dt>
                  <dd class="mt-1 text-[var(--color-gold)]">{t.etude}</dd>
                </div>
                <div>
                  <dt class="text-[var(--color-cream)]/40">Exemples</dt>
                  <dd class="mt-1 text-[var(--color-cream)] normal-case tracking-normal text-[11px]">{t.exemples}</dd>
                </div>
              </dl>
              <a
                href={`/architecture-paysagere/${t.slug}`}
                class="mt-8 inline-flex items-center gap-3 border-b border-[var(--color-cream)]/50 pb-1 text-sm tracking-wide transition-colors hover:border-[var(--color-gold)] hover:text-[var(--color-gold)]"
              >
                Explorer la typologie
                <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>

      <!-- Progress ticks -->
      <div class="scrolly-progress" aria-hidden="true">
        {typologies.map((_, i) => <span class="scrolly-tick" data-tick-index={i} />)}
      </div>
    </div>
  </section>

  <!-- 04 · MÉTHODE ─────────────────────────────────────────────── -->
  <section
    id="methode"
    data-section-label="Méthode"
    class="bg-[var(--color-cream)]"
    aria-labelledby="methode-title"
  >
    <div class="mx-auto max-w-7xl px-6 py-32 md:px-10 md:py-48">
      <div class="mb-20 max-w-2xl" data-reveal="up">
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-[var(--color-moss)]">
          <span class="text-[var(--color-forest)]/40">03</span> &nbsp;·&nbsp; Parcours
        </p>
        <h2
          id="methode-title"
          data-mask-reveal
          data-mask-stagger="0.14"
          class="mt-4 font-[family-name:var(--font-heading)] text-[length:var(--text-4xl)] leading-[1.08] text-[var(--color-forest)]"
        >
          <span data-mask-line class="block">Trois temps</span>
          <span data-mask-line class="block italic">avant l'étude.</span>
        </h2>
      </div>

      <ol
        data-reveal-stagger="0.14"
        data-reveal="up"
        class="grid grid-cols-1 gap-px bg-[var(--color-forest)]/10 md:grid-cols-3"
      >
        {
          methode.map((step) => (
            <li class="bg-[var(--color-cream)] p-10 md:p-14">
              <p class="font-[family-name:var(--font-heading)] text-[length:var(--text-5xl)] leading-none text-[var(--color-forest)]/20">
                {step.num}
              </p>
              <p class="mt-8 font-mono text-[10px] uppercase tracking-[0.28em] text-[var(--color-moss)]">
                {step.duree}
              </p>
              <h3 class="mt-3 font-[family-name:var(--font-heading)] text-[length:var(--text-2xl)] leading-tight text-[var(--color-forest)]">
                {step.titre}
              </h3>
              <p class="mt-5 text-sm leading-relaxed text-[var(--color-forest)]/70">
                {step.description}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 05 · PULL-QUOTE SCROLL-PIN ─────────────────────────────────── -->
  <section
    id="manifeste"
    data-section-label="Manifeste"
    class="pull-quote-section relative border-t border-[var(--color-forest)]/10 bg-[var(--color-cream)]"
    aria-label="Citation Jonathan Oliveira"
  >
    <div class="pull-quote-sticky">
      <div class="mx-auto flex min-h-[100vh] max-w-5xl items-center px-6 py-24 md:px-10">
        <blockquote
          data-quote-scroll
          class="font-[family-name:var(--font-heading)] text-[length:var(--text-4xl)] leading-[1.18] text-[var(--color-forest)] md:text-[length:var(--text-5xl)]"
        >
          <p class="mb-8 font-mono text-[11px] uppercase tracking-[0.28em] text-[var(--color-moss)]">
            <span class="text-[var(--color-forest)]/40">04</span> &nbsp;·&nbsp; Manifeste
          </p>
          <span data-quote-word class="inline-block">Je</span>&nbsp;<span data-quote-word class="inline-block">ne</span>&nbsp;<span data-quote-word class="inline-block">vends</span>&nbsp;<span data-quote-word class="inline-block">pas</span>&nbsp;<span data-quote-word class="inline-block">une</span>&nbsp;<span data-quote-word class="inline-block italic text-[var(--color-moss)]">étude</span>,<br />
          <span data-quote-word class="inline-block">je</span>&nbsp;<span data-quote-word class="inline-block">vends</span>&nbsp;<span data-quote-word class="inline-block">une</span>&nbsp;<span data-quote-word class="inline-block italic text-[var(--color-gold)]">vision</span>,&nbsp;<span data-quote-word class="inline-block">une</span>&nbsp;<span data-quote-word class="inline-block italic text-[var(--color-gold)]">méthode</span>,<br />
          <span data-quote-word class="inline-block">une</span>&nbsp;<span data-quote-word class="inline-block italic text-[var(--color-gold)]">expérience</span>,&nbsp;<span data-quote-word class="inline-block">une</span>&nbsp;<span data-quote-word class="inline-block italic text-[var(--color-gold)]">sécurité</span>&nbsp;<span data-quote-word class="inline-block">de</span>&nbsp;<span data-quote-word class="inline-block italic text-[var(--color-gold)]">résultat</span>.
          <footer class="mt-10 font-mono text-[11px] uppercase not-italic tracking-[0.28em] text-[var(--color-forest)]/50">
            Jonathan Oliveira — Fondateur du studio
          </footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- 06 · CTA CONTACT ───────────────────────────────────────────── -->
  <section
    id="contact-cta"
    data-section-label="Contact"
    class="border-t border-[var(--color-forest)]/10 bg-[var(--color-forest)] text-[var(--color-cream)]"
  >
    <div class="mx-auto max-w-4xl px-6 py-32 text-center md:px-10 md:py-48" data-reveal="slow">
      <p class="font-mono text-xs uppercase tracking-[0.28em] text-[var(--color-moss)]">
        <span class="text-[var(--color-cream)]/40">05</span> &nbsp;·&nbsp; Engager la conversation
      </p>
      <h2
        data-mask-reveal
        data-mask-stagger="0.18"
        class="mt-8 font-[family-name:var(--font-heading)] text-[length:var(--text-5xl)] leading-[1.05]"
      >
        <span data-mask-line class="block">Un projet,</span>
        <span data-mask-line class="block italic text-[var(--color-gold)]">une étude.</span>
      </h2>
      <p class="mx-auto mt-10 max-w-xl text-[length:var(--text-base)] leading-relaxed text-[var(--color-cream)]/70">
        Chaque projet commence par un appel de découverte de 15 à 25 minutes. On qualifie ensemble le site, le programme et les attentes.
      </p>
      <div class="mt-12 flex flex-col items-center justify-center gap-6 md:flex-row md:gap-10">
        <a
          href="/contact"
          data-magnetic="0.3"
          class="inline-flex items-center gap-3 border border-[var(--color-cream)] px-7 py-3.5 text-sm tracking-wide transition-colors hover:bg-[var(--color-cream)] hover:text-[var(--color-forest)]"
        >
          Démarrer un projet
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="tel:+33661088444"
          class="text-sm underline underline-offset-4 hover:text-[var(--color-gold)]"
        >
          06 61 08 84 44
        </a>
      </div>
    </div>
  </section>

  <style>
    /* Hero image : zoom + dim + blur pilotés par Motion via data-hero-zoom */
    .hero-image {
      transform: scale(1.06);
      transform-origin: center;
      will-change: transform, filter;
    }

    .scroll-cue-line {
      animation: scroll-pulse 2.8s var(--ease-out-editorial) infinite;
      transform-origin: top;
    }
    @keyframes scroll-pulse {
      0%, 100% { transform: scaleY(0.3); opacity: 0.3; }
      50%      { transform: scaleY(1);   opacity: 1; }
    }

    /* Pull-quote scroll-pin */
    .pull-quote-section {
      min-height: 220vh;
      position: relative;
    }
    .pull-quote-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
    }
    [data-quote-word] {
      transition: opacity 60ms linear;
    }

    /* Scrollytelling section — 4 scènes plein écran typologies */
    .scrolly-section {
      min-height: 500vh; /* 4 typologies × ~125vh par scène */
      position: relative;
    }
    .scrolly-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
    }
    .scrolly-stage {
      position: absolute;
      inset: 0;
      z-index: 0;
    }
    .scrolly-slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      will-change: opacity, transform;
    }
    .scrolly-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }
    .scrolly-veil {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(
          to right,
          rgba(26, 43, 31, 0.8) 0%,
          rgba(26, 43, 31, 0.55) 40%,
          rgba(26, 43, 31, 0.15) 75%,
          rgba(26, 43, 31, 0.05) 100%
        ),
        linear-gradient(
          to bottom,
          rgba(26, 43, 31, 0.4) 0%,
          rgba(26, 43, 31, 0) 30%,
          rgba(26, 43, 31, 0.7) 100%
        );
    }
    .scrolly-meta {
      position: absolute;
      top: 3rem;
      left: 3rem;
      right: 3rem;
      z-index: 2;
    }
    .scrolly-chapters {
      position: absolute;
      inset: 0;
      z-index: 2;
    }
    .scrolly-chapter {
      position: absolute;
      left: 3rem;
      top: 50%;
      transform: translateY(-50%) translateY(30px);
      max-width: 540px;
      opacity: 0;
      will-change: opacity, transform;
    }
