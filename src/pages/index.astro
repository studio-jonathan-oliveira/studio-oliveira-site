---
/*
 * Home — Studio J Oliveira
 *
 * Architecture v2 (refonte vitrine premium, 2026-04-22 soir) :
 *   00. IntroBumper (slot="intro")
 *   01. Hero plein écran
 *   02. Positionnement & territoires (#studio-lead)
 *   03. Typologies scrollytelling (#typologies) — 4 scènes plein écran
 *   04. Méthode 3 étapes (#methode) — sourcé PDF Jonathan
 *   05. Manifeste pull-quote scroll-pin (#manifeste)
 *   06. CTA contact final (#contact-cta)
 *
 * Tous les textes sont soit sourcés du PDF process Jonathan, soit marqués [À FOURNIR].
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import IntroBumper from '@/components/astro/IntroBumper.astro';
import { Image } from 'astro:assets';
import heroImage from '@/assets/home/hero-biophilie.png';
import typoMicroUrbain from '@/assets/typologies/micro-urbain.webp';
import typoCoeurUrbain from '@/assets/typologies/coeur-urbain.webp';
import typoFrangeUrbaine from '@/assets/typologies/frange-urbaine.webp';
import typoDomaine from '@/assets/typologies/domaine-caractere.webp';

// Typologies — données sourcées du PDF PROCESS-ETUDES-STUDIO-2026 (lignes 29-306)
// Les phrases courtes sont extraites des citations Jonathan (brief consolidé).
const typologies = [
  {
    slug: 'micro-urbain',
    index: '01',
    nom: 'Micro-urbain',
    requete: 'Aménagement de petit jardin en ville',
    surface: '< 50 m²',
    budget: '< 20 000 €',
    etude: '1 200 € TTC',
    exemples: 'Terrasses · Rooftops · Patios',
    // Source : PDF ligne 99-113
    phrase: "L'espace extérieur devient une pièce à part entière de l'habitation.",
    image: typoMicroUrbain,
    imageNote:
      '[À FOURNIR — image définitive typologie Micro-urbain, actuellement fallback évocateur]',
  },
  {
    slug: 'coeur-urbain',
    index: '02',
    nom: 'Cœur urbain',
    requete: 'Conception de jardin de ville sur mesure',
    surface: '50 — 300 m²',
    budget: '20 000 — 50 000 €',
    etude: '2 750 € TTC',
    exemples: 'Maison de ville · Cour patrimoniale · Jardin de caractère',
    // Source : PDF ligne 135
    phrase: 'Très technique, très risquée, très précieuse et très stratégique.',
    image: typoCoeurUrbain,
  },
  {
    slug: 'frange-urbaine',
    index: '03',
    nom: 'Frange urbaine',
    requete: 'Aménagement de grand jardin péri-urbain',
    surface: '300 — 1 500 m²',
    budget: '50 000 — 90 000 €',
    etude: '4 250 € TTC',
    exemples: 'Pavillon · Maison de campagne · Finca · Bâti reconverti',
    // Source : PDF ligne 137-159 (reformulation synthétique)
    phrase: 'Un territoire instable entre la ville et la nature.',
    image: typoFrangeUrbaine,
  },
  {
    slug: 'domaine-caractere',
    index: '04',
    nom: 'Domaines & Caractère',
    requete: 'Conception de parc et domaine privé',
    surface: 'Sans limite',
    budget: '> 90 000 €',
    etude: '6 500 € TTC',
    exemples: 'Château · Manoir · Domaine · Grange rénovée',
    // Source : PDF ligne 161-181
    phrase:
      'Un dialogue entre une architecture ancienne, un sol fatigué, un paysage réel et une mémoire invisible.',
    image: typoDomaine,
  },
];

// Méthode — sourcée PDF PROCESS page parcours commercial
const methode = [
  {
    num: '01',
    titre: 'Appel de découverte',
    duree: '15 à 25 minutes',
    description:
      'Premier échange téléphonique. On qualifie votre projet, le site, vos attentes. Vous repartez avec une lecture claire de la suite.',
  },
  {
    num: '02',
    titre: "Rendez-vous d'étude",
    duree: '1 h 45 à 2 h',
    description:
      'Sur place ou en visioconférence. Diagnostic approfondi du lieu et du programme. Orientations conceptuelles posées ensemble.',
  },
  {
    num: '03',
    titre: 'Validation à distance',
    duree: '15 minutes',
    description:
      "Cadrage final : périmètre d'étude, livrables, calendrier. Signature et lancement.",
  },
];

// Zones d'intervention — cf. site-config.ts (sourcé)
const zones = ['Brive-la-Gaillarde', 'Bordeaux', 'Limoges', 'Toulouse'];
---

<BaseLayout
  title="Studio J Oliveira — Designer végétal & design biophilique"
  description="Studio de design biophilique à Brive-la-Gaillarde. Études et conceptions de jardins en Aquitaine, Limousin, Toulouse. Architectures vivantes, bâti × environnement × humain."
  darkHero
>
  <IntroBumper slot="intro" />

  <!-- 01 · HERO IMMERSIF ─────────────────────────────────────────── -->
  <section
    id="hero"
    data-section-label="Accueil"
    class="hero-immersive relative isolate overflow-hidden bg-[var(--color-forest)] text-[var(--color-cream)]"
  >
    <div class="absolute inset-0 -z-10">
      <Image
        src={heroImage}
        alt=""
        widths={[640, 960, 1280, 1600, 1920, 2560]}
        sizes="100vw"
        quality={82}
        format="webp"
        class="hero-image h-full w-full object-cover object-center"
        loading="eager"
        data-hero-zoom
      />
      <!-- Un seul gradient vertical subtil : l'image respire, le texte reste lisible -->
      <div
        class="absolute inset-0 bg-gradient-to-t from-[var(--color-forest)]/92 via-[var(--color-forest)]/35 to-transparent"
        aria-hidden="true"
      >
      </div>
    </div>

    <div class="relative flex min-h-[100svh] flex-col" data-hero-sequence>
      <div
        class="mx-auto mt-auto w-full max-w-[1400px] px-6 pt-40 pb-24 md:px-10 md:pt-48 md:pb-32"
      >
        <p
          data-hero="eyebrow"
          class="hero-eyebrow font-mono text-[11px] tracking-[0.26em] text-[var(--color-cream)]/70 uppercase"
        >
          Studio · Brive-la-Gaillarde · Aquitaine · Est. 2021
        </p>

        <h1
          class="hero-title mt-8 font-[family-name:var(--font-heading)] text-[length:var(--text-hero)] leading-[0.95] tracking-tight text-[var(--color-cream)]"
        >
          <span data-hero-mask class="hero-mask block leading-[0.95]">
            <span data-mask-line class="hero-line block">Designer</span>
          </span>
          <span data-hero-mask class="hero-mask block leading-[0.95]">
            <span data-mask-line class="hero-line block text-[var(--color-laterite)] italic"
              >végétal</span
            >
          </span>
        </h1>

        <p
          data-hero="manifesto"
          class="hero-manifesto mt-10 max-w-xl text-[length:var(--text-lg)] leading-relaxed text-[var(--color-cream)]/80"
        >
          J'étudie et conçois des espaces à vivre, en dialogue avec le bâti, l'environnement et
          l'humain. Une démarche biophilique, scientifique et sensible.
        </p>

        <div
          data-hero="cta"
          class="hero-cta mt-14 flex flex-col items-start gap-6 md:flex-row md:items-center md:gap-10"
        >
          <a
            href="#typologies"
            class="inline-flex items-center gap-3 border-b border-[var(--color-cream)] pb-1 text-sm tracking-wide transition-colors hover:border-[var(--color-gold)] hover:text-[var(--color-gold)]"
          >
            Découvrir les typologies
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="/studio"
            class="text-sm text-[var(--color-cream)]/60 transition-colors hover:text-[var(--color-cream)]"
          >
            À propos du studio
          </a>
        </div>
      </div>

      <div
        data-hero="cue"
        class="scroll-cue pointer-events-none absolute bottom-8 left-1/2 z-10 -translate-x-1/2 text-[var(--color-cream)]/60"
      >
        <div class="flex flex-col items-center gap-3">
          <span class="font-mono text-[10px] tracking-[0.32em] uppercase">Explorer</span>
          <span class="scroll-cue-line block h-10 w-px bg-[var(--color-cream)]/40"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- 01 · BIFURCATION — Deux univers (particuliers / pros) ─────────── -->
  <section
    id="univers"
    data-section-label="Univers"
    class="bifurcation-section relative bg-[var(--color-cream)] text-[var(--color-forest)]"
    aria-labelledby="univers-title"
  >
    <div class="mx-auto max-w-[1400px] px-6 py-28 md:px-10 md:py-40">
      <header class="mb-16 md:mb-24" data-reveal="up">
        <p class="font-mono text-[11px] tracking-[0.26em] text-[var(--color-moss)] uppercase">
          <span class="text-[var(--color-forest)]/40">01</span> &nbsp;·&nbsp; Deux univers
        </p>
        <h2
          id="univers-title"
          data-mask-reveal
          data-mask-stagger="0.12"
          class="mt-6 max-w-3xl font-[family-name:var(--font-heading)] text-[length:var(--text-4xl)] leading-[0.98] md:text-[length:var(--text-5xl)]"
        >
          <span data-mask-line class="block">Un studio,</span>
          <span data-mask-line class="block"
            ><em class="italic">deux</em> manières de travailler.</span
          >
        </h2>
      </header>

      <div class="bifurcation-grid grid gap-0 md:grid-cols-2">
        <!-- Particuliers -->
        <a
          href="#typologies"
          class="bifurcation-card bifurcation-card--a group"
          aria-label="Offre pour les particuliers — quatre typologies de jardin"
        >
          <span class="bifurcation-num" aria-hidden="true">01</span>
          <div class="bifurcation-meta">
            <p class="font-mono text-[10px] tracking-[0.26em] text-[var(--color-moss)] uppercase">
              Particuliers
            </p>
            <h3
              class="mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-3xl)] leading-[1.02] md:text-[length:var(--text-4xl)]"
            >
              Architecture <em class="italic">paysagère</em>.
            </h3>
            <p
              class="mt-5 max-w-sm text-[length:var(--text-base)] leading-relaxed text-[var(--color-forest)]/75"
            >
              Quatre typologies de jardin, du micro-urbain au domaine de caractère. Étude
              préliminaire, conception, suivi.
            </p>
          </div>
          <span class="bifurcation-cta">
            <span>Explorer les typologies</span>
            <span class="bifurcation-arrow" aria-hidden="true">→</span>
          </span>
        </a>

        <!-- Professionnels -->
        <a
          href="/pros"
          class="bifurcation-card bifurcation-card--b group"
          aria-label="Offre pour les professionnels — hôtellerie, restauration, bureaux, commerces"
        >
          <span class="bifurcation-num" aria-hidden="true">02</span>
          <div class="bifurcation-meta">
            <p class="font-mono text-[10px] tracking-[0.26em] text-[var(--color-moss)] uppercase">
              Professionnels
            </p>
            <h3
              class="mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-3xl)] leading-[1.02] md:text-[length:var(--text-4xl)]"
            >
              Décors <em class="italic">végétalisés</em>.
            </h3>
            <p
              class="mt-5 max-w-sm text-[length:var(--text-base)] leading-relaxed text-[var(--color-forest)]/75"
            >
              Hôtellerie, restauration, bureaux, commerces, locations atypiques. Design biophilique
              au service de l'expérience client.
            </p>
          </div>
          <span class="bifurcation-cta">
            <span>Découvrir l'univers pro</span>
            <span class="bifurcation-arrow" aria-hidden="true">→</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- 02 · POSITIONNEMENT & TERRITOIRES ─────────────────────────── -->
  <section
    id="studio-lead"
    data-section-label="Studio"
    class="bg-[var(--color-cream)]"
    aria-labelledby="studio-lead-title"
  >
    <div class="mx-auto max-w-7xl px-6 py-32 md:grid md:grid-cols-12 md:gap-16 md:px-10 md:py-48">
      <div class="md:col-span-7" data-reveal="up">
        <p class="font-mono text-xs tracking-[0.26em] text-[var(--color-moss)] uppercase">
          <span class="text-[var(--color-forest)]/40">02</span> &nbsp;·&nbsp; Studio biophilique
        </p>
        <h2
          id="studio-lead-title"
          data-mask-reveal
          data-mask-stagger="0.14"
          class="mt-4 font-[family-name:var(--font-heading)] text-[length:var(--text-4xl)] leading-[1.08] text-[var(--color-forest)]"
        >
          <span data-mask-line class="block">
            Design végétal en <em class="italic">Aquitaine</em>,
          </span>
          <span data-mask-line class="block">Limousin et Toulouse.</span>
        </h2>
        <p
          class="mt-8 max-w-xl text-[length:var(--text-lg)] leading-relaxed text-[var(--color-forest)]/80"
        >
          Art de conception architecturale inspiré des environnements naturels et de leurs effets
          sur les humains. Une démarche scientifique couplée à la technicité architecturale, pour
          des espaces à vivre proches de ce que l'on ressent dans un lieu à l'état naturel.
        </p>
      </div>

      <aside class="mt-16 md:col-span-5 md:mt-0" data-reveal="up" data-reveal-delay="0.15">
        <p class="font-mono text-[11px] tracking-[0.28em] text-[var(--color-moss)] uppercase">
          Zones d'intervention
        </p>
        <ul class="mt-6 space-y-3 border-t border-[var(--color-forest)]/10 pt-6">
          {
            zones.map((zone) => (
              <li class="flex items-baseline justify-between border-b border-[var(--color-forest)]/10 pb-3">
                <span class="font-[family-name:var(--font-heading)] text-[length:var(--text-2xl)] text-[var(--color-forest)]">
                  {zone}
                </span>
                <span class="font-mono text-[10px] tracking-[0.28em] text-[var(--color-forest)]/50 uppercase">
                  →
                </span>
              </li>
            ))
          }
        </ul>
        <a
          href="/studio"
          class="mt-8 inline-flex items-center gap-3 border-b border-[var(--color-forest)]/30 pb-1 text-sm tracking-wide text-[var(--color-forest)] transition-colors hover:border-[var(--color-moss)] hover:text-[var(--color-moss)]"
        >
          Lire le manifeste complet
          <span aria-hidden="true">→</span>
        </a>
      </aside>
    </div>
  </section>

  <!-- 03 · TYPOLOGIES — SCROLL HORIZONTAL PINNED (signature PDF l.750) ──── -->
  <section
    id="typologies"
    data-section-label="Typologies"
    data-hscroll-typologies
    class="htypo-section relative bg-[var(--color-forest)] text-[var(--color-cream)]"
    aria-labelledby="typologies-title"
  >
    <div class="htypo-sticky">
      <!-- Header fixe -->
      <header class="htypo-header">
        <p class="font-mono text-[11px] tracking-[0.26em] text-[var(--color-cream)]/50 uppercase">
          <span class="text-[var(--color-cream)]/30">03</span> &nbsp;·&nbsp; Typologies
        </p>
        <h2
          id="typologies-title"
          class="mt-3 max-w-lg font-[family-name:var(--font-heading)] text-[length:var(--text-2xl)] leading-[1.08] text-[var(--color-cream)]/90 md:text-[length:var(--text-3xl)]"
        >
          Quatre manières <em class="text-[var(--color-laterite)] italic">d'habiter</em> un jardin.
        </h2>
      </header>

      <!-- Rail horizontal : 4 panneaux plein écran -->
      <div class="htypo-rail" data-hscroll-rail>
        {
          typologies.map((t, i) => (
            <a
              href={`/architecture-paysagere/${t.slug}`}
              class="htypo-panel group"
              data-hscroll-panel
              data-cursor-cta-host
              aria-label={`Explorer la typologie ${t.nom}`}
            >
              <div class="htypo-visual">
                <Image
                  src={t.image}
                  alt=""
                  widths={[720, 1080, 1440, 1920]}
                  sizes="(min-width: 1024px) 50vw, 100vw"
                  quality={82}
                  format="webp"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  class="htypo-img"
                />
                <div class="htypo-veil" aria-hidden="true" />
                <span class="htypo-index-xl" aria-hidden="true">
                  {t.index}
                </span>
              </div>

              <div class="htypo-copy">
                <p class="font-mono text-[10px] tracking-[0.26em] text-[var(--color-laterite)] uppercase">
                  {t.index} · {t.nom}
                </p>
                <h3 class="htypo-phrase mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-3xl)] leading-[1.08] italic md:text-[length:var(--text-4xl)]">
                  {t.phrase}
                </h3>

                <dl class="htypo-meta mt-8 grid max-w-md grid-cols-3 gap-x-6 gap-y-4 font-mono text-[10px] tracking-[0.22em] text-[var(--color-cream)]/70 uppercase">
                  <div>
                    <dt class="text-[var(--color-cream)]/40">Surface</dt>
                    <dd class="mt-1.5 text-[var(--color-cream)]">{t.surface}</dd>
                  </div>
                  <div>
                    <dt class="text-[var(--color-cream)]/40">Budget</dt>
                    <dd class="mt-1.5 text-[var(--color-cream)]">{t.budget}</dd>
                  </div>
                  <div>
                    <dt class="text-[var(--color-cream)]/40">Étude</dt>
                    <dd class="mt-1.5 text-[var(--color-laterite)]">{t.etude}</dd>
                  </div>
                </dl>

                <span class="htypo-cta-static mt-10 inline-flex items-center gap-3 border-b border-[var(--color-cream)]/40 pb-1 text-sm tracking-wide text-[var(--color-cream)]/80 transition-colors group-hover:border-[var(--color-laterite)] group-hover:text-[var(--color-laterite)]">
                  Explorer la typologie
                  <span aria-hidden="true">→</span>
                </span>
              </div>

              <span class="htypo-cursor-cta" data-cursor-cta aria-hidden="true">
                <span class="htypo-cursor-cta-inner">Explorer</span>
              </span>
            </a>
          ))
        }
      </div>

      <!-- Progress ticks -->
      <div class="htypo-progress" aria-hidden="true">
        {typologies.map((_, i) => <span class="htypo-tick" data-tick-index={i} />)}
      </div>
    </div>
  </section>

  <!-- 04 · MÉTHODE ─────────────────────────────────────────────── -->
  <section
    id="methode"
    data-section-label="Méthode"
    class="bg-[var(--color-cream)]"
    aria-labelledby="methode-title"
  >
    <div class="mx-auto max-w-7xl px-6 py-32 md:px-10 md:py-48">
      <div class="mb-20 max-w-2xl" data-reveal="up">
        <p class="font-mono text-xs tracking-[0.22em] text-[var(--color-moss)] uppercase">
          <span class="text-[var(--color-forest)]/40">04</span> &nbsp;·&nbsp; Parcours
        </p>
        <h2
          id="methode-title"
          data-mask-reveal
          data-mask-stagger="0.14"
          class="mt-4 font-[family-name:var(--font-heading)] text-[length:var(--text-4xl)] leading-[1.08] text-[var(--color-forest)]"
        >
          <span data-mask-line class="block">Trois temps</span>
          <span data-mask-line class="block italic">avant l'étude.</span>
        </h2>
      </div>

      <ol
        data-reveal-stagger="0.14"
        data-reveal="up"
        class="grid grid-cols-1 gap-px bg-[var(--color-forest)]/10 md:grid-cols-3"
      >
        {
          methode.map((step) => (
            <li class="bg-[var(--color-cream)] p-10 md:p-14">
              <p class="font-[family-name:var(--font-heading)] text-[length:var(--text-5xl)] leading-none text-[var(--color-forest)]/20">
                {step.num}
              </p>
              <p class="mt-8 font-mono text-[10px] tracking-[0.28em] text-[var(--color-moss)] uppercase">
                {step.duree}
              </p>
              <h3 class="mt-3 font-[family-name:var(--font-heading)] text-[length:var(--text-2xl)] leading-tight text-[var(--color-forest)]">
                {step.titre}
              </h3>
              <p class="mt-5 text-sm leading-relaxed text-[var(--color-forest)]/70">
                {step.description}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 05 · PULL-QUOTE SCROLL-PIN ─────────────────────────────────── -->
  <section
    id="manifeste"
    data-section-label="Manifeste"
    class="pull-quote-section relative border-t border-[var(--color-forest)]/10 bg-[var(--color-cream)]"
    aria-label="Citation Jonathan Oliveira"
  >
    <div class="pull-quote-sticky">
      <div class="mx-auto flex min-h-[100vh] max-w-5xl items-center px-6 py-24 md:px-10">
        <blockquote
          data-quote-scroll
          class="font-[family-name:var(--font-heading)] text-[length:var(--text-4xl)] leading-[1.18] text-[var(--color-forest)] md:text-[length:var(--text-5xl)]"
        >
          <p
            class="mb-8 font-mono text-[11px] tracking-[0.26em] text-[var(--color-moss)] uppercase"
          >
            <span class="text-[var(--color-forest)]/40">05</span> &nbsp;·&nbsp; Manifeste
          </p>
          <span data-quote-word class="inline-block">Je</span>&nbsp;<span
            data-quote-word
            class="inline-block">ne</span
          >&nbsp;<span data-quote-word class="inline-block">vends</span>&nbsp;<span
            data-quote-word
            class="inline-block">pas</span
          >&nbsp;<span data-quote-word class="inline-block">une</span>&nbsp;<span
            data-quote-word
            class="inline-block italic">étude</span
          >,<br />
          <span data-quote-word class="inline-block">je</span>&nbsp;<span
            data-quote-word
            class="inline-block">vends</span
          >&nbsp;<span data-quote-word class="inline-block">une</span>&nbsp;<span
            data-quote-word
            class="inline-block text-[var(--color-laterite)] italic">vision</span
          >,&nbsp;<span data-quote-word class="inline-block">une</span>&nbsp;<span
            data-quote-word
            class="inline-block italic">méthode</span
          >,<br />
          <span data-quote-word class="inline-block">une</span>&nbsp;<span
            data-quote-word
            class="inline-block italic">expérience</span
          >,&nbsp;<span data-quote-word class="inline-block">une</span>&nbsp;<span
            data-quote-word
            class="inline-block italic">sécurité</span
          >&nbsp;<span data-quote-word class="inline-block">de</span>&nbsp;<span
            data-quote-word
            class="inline-block text-[var(--color-laterite)] italic">résultat</span
          >.
          <footer
            class="mt-10 font-mono text-[11px] tracking-[0.28em] text-[var(--color-forest)]/50 uppercase not-italic"
          >
            Jonathan Oliveira — Fondateur du studio
          </footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- 06 · CTA CONTACT ───────────────────────────────────────────── -->
  <section
    id="contact-cta"
    data-section-label="Contact"
