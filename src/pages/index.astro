                {/* Meta sans prix étude — brief Jonathan 2026-04-24. Surface + budget travaux + exemples. */}
                <dl class="htypo-meta mt-10 grid max-w-md grid-cols-2 gap-x-6 gap-y-4 font-mono text-[10px] tracking-[0.22em] text-[var(--color-cream)]/70 uppercase">
                  <div>
                    <dt class="text-[var(--color-cream)]/45">Surface</dt>
                    <dd class="mt-1.5 text-[var(--color-cream)]">{t.surface}</dd>
                  </div>
                  <div>
                    <dt class="text-[var(--color-cream)]/45">Budget travaux</dt>
                    <dd class="mt-1.5 text-[var(--color-cream)]">{t.budget}</dd>
                  </div>
                  <div class="col-span-2">
                    <dt class="text-[var(--color-cream)]/45">Exemples</dt>
                    <dd class="mt-1.5 tracking-[0.05em] text-[var(--color-cream)] normal-case">
                      {t.exemples}
                    </dd>
                  </div>
                </dl>

                <span class="htypo-cta-static mt-10 inline-flex items-center gap-3 border-b border-[var(--color-cream)]/35 pb-1 text-sm tracking-wide text-[var(--color-cream)]/85 transition-opacity group-hover:opacity-60">
                  Explorer la typologie
