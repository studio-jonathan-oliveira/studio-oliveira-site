---
/*
 * Home — Studio J Oliveira
 *
 * Architecture v2 (refonte vitrine premium, 2026-04-22 soir) :
 *   01. Hero plein écran
 *   02. Positionnement & territoires (#studio-lead)
 *   03. Typologies scrollytelling (#typologies) — 4 scènes plein écran
 *   04. Méthode 3 étapes (#methode) — sourcé PDF Jonathan
 *   05. Manifeste pull-quote scroll-pin (#manifeste)
 *   06. CTA contact final (#contact-cta)
 *
 * Tous les textes sont soit sourcés du PDF process Jonathan, soit marqués [À FOURNIR].
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
// IntroBumper désactivé 2026-04-24 : couvrait l'écran en noir si la vidéo
// logo ne jouait pas (fallback 3.5s + dismiss parfois laggy). Morgan
// signalait « accueil toujours noir ». À réactiver quand Jonathan fournira
// une vidéo logo plus robuste + une seconde de fallback.
import { Image } from 'astro:assets';
// Slideshow hero — 4 créations Jonathan qui crossfadent en boucle (brief Morgan)
import hero01 from '@/assets/home/hero-01.jpg';
import hero02 from '@/assets/home/hero-02.jpg';
import hero03 from '@/assets/home/hero-03.jpg';
import hero04 from '@/assets/home/hero-04.jpg';
const heroSlides = [
  { src: hero01, alt: 'Jardin nocturne — Parenthèse exotique, Cœur urbain' },
  { src: hero02, alt: 'Terrasse méditerranéenne — Restanque corrézienne' },
  { src: hero03, alt: 'Demeure corrézienne — Provence intérieure' },
  { src: hero04, alt: 'Entrée de jardin contemporain — Cœur urbain' },
];
import typoMicroUrbain from '@/assets/typologies/micro-urbain.webp';
import typoCoeurUrbain from '@/assets/typologies/coeur-urbain.webp';
import typoFrangeUrbaine from '@/assets/typologies/frange-urbaine.webp';
import typoDomaine from '@/assets/typologies/domaine-caractere.webp';
import { PROJETS_PAR_SLUG } from '@/lib/projets';

// Typologies — données sourcées du PDF PROCESS-ETUDES-STUDIO-2026 (lignes 29-306)
// Les phrases courtes sont extraites des citations Jonathan (brief consolidé).
const typologies = [
  {
    slug: 'micro-urbain',
    index: '01',
    nom: 'Micro-urbain',
    requete: 'Aménagement de petit jardin en ville',
    surface: '< 50 m²',
    budget: '< 20 000 €',
    etude: '1 200 € TTC',
    exemples: 'Terrasses · Rooftops · Patios',
    // Source : PDF ligne 99-113
    phrase: "L'espace extérieur devient une pièce à part entière de l'habitation.",
    image: typoMicroUrbain,
    // object-position : centrer l'intérêt visuel (moitié basse pour terrasse)
    imagePosition: 'center 65%',
    imageNote: '[À FOURNIR — image définitive Micro-urbain, placeholder actuel évocateur]',
  },
  {
    slug: 'coeur-urbain',
    index: '02',
    nom: 'Cœur urbain',
    requete: 'Conception de jardin de ville sur mesure',
    surface: '50 — 300 m²',
    budget: '20 000 — 50 000 €',
    etude: '2 750 € TTC',
    exemples: 'Maison de ville · Cour patrimoniale · Jardin de caractère',
    // Source : PDF ligne 135
    phrase: 'Très technique, très risquée, très précieuse et très stratégique.',
    image: typoCoeurUrbain,
    imagePosition: 'center 55%',
  },
  {
    slug: 'frange-urbaine',
    index: '03',
    nom: 'Frange urbaine',
    requete: 'Aménagement de grand jardin péri-urbain',
    surface: '300 — 1 500 m²',
    budget: '50 000 — 90 000 €',
    etude: '4 250 € TTC',
    exemples: 'Pavillon · Maison de campagne · Finca · Bâti reconverti',
    // Source : PDF ligne 137-159 (reformulation synthétique)
    phrase: 'Un territoire instable entre la ville et la nature.',
    image: typoFrangeUrbaine,
    imagePosition: 'center 50%',
  },
  {
    slug: 'domaine-caractere',
    index: '04',
    nom: 'Domaines & Caractère',
    requete: 'Conception de parc et domaine privé',
    surface: 'Sans limite',
    budget: '> 90 000 €',
    etude: '6 500 € TTC',
    exemples: 'Château · Manoir · Domaine · Grange rénovée',
    // Source : PDF ligne 161-181
    phrase:
      'Un dialogue entre une architecture ancienne, un sol fatigué, un paysage réel et une mémoire invisible.',
    image: typoDomaine,
    imagePosition: 'center 40%',
  },
];

// Méthode — sourcée PDF PROCESS page parcours commercial
const methode = [
  {
    num: '01',
    titre: 'Appel de découverte',
    duree: '15 à 25 minutes',
    description:
      'Premier échange téléphonique. On qualifie votre projet, le site, vos attentes. Vous repartez avec une lecture claire de la suite.',
  },
  {
    num: '02',
    titre: "Rendez-vous d'étude",
    duree: '1 h 45 à 2 h',
    description:
      'Sur place ou en visioconférence. Diagnostic approfondi du lieu et du programme. Orientations conceptuelles posées ensemble.',
  },
  {
    num: '03',
    titre: 'Validation à distance',
    duree: '15 minutes',
    description:
      "Cadrage final : périmètre d'étude, livrables, calendrier. Signature et lancement.",
  },
];

// Zones d'intervention — cf. site-config.ts (sourcé)
const zones = ['Brive-la-Gaillarde', 'Bordeaux', 'Limoges'];

// Vitrine projets — pattern designbyad (scroll_home.mp4 frame 7-9) :
// portraits 70vh + name UPPERCASE au-dessus + scroll horizontal natif touch.
// Sources sourcées : noms + lieux issus de src/lib/projets.ts (extraits PDF Jonathan).
const vitrine = [
  {
    ...PROJETS_PAR_SLUG['coeur-urbain']!,
    image: typoCoeurUrbain,
    href: '/architecture-paysagere/coeur-urbain',
  },
  {
    ...PROJETS_PAR_SLUG['frange-urbaine']!,
    image: typoFrangeUrbaine,
    href: '/architecture-paysagere/frange-urbaine',
  },
  {
    ...PROJETS_PAR_SLUG['domaine-caractere']!,
    image: typoDomaine,
    href: '/architecture-paysagere/domaine-caractere',
  },
  {
    ...PROJETS_PAR_SLUG['micro-urbain']!,
    image: typoMicroUrbain,
    href: '/architecture-paysagere/micro-urbain',
  },
];
---

<BaseLayout
  title="Studio J Oliveira — Designer paysagiste & design biophilique"
  description="Studio de design paysagiste biophilique à Brive-la-Gaillarde. Études et conceptions d'espaces à vivre en Aquitaine et Limousin. Architectures vivantes, bâti × environnement × humain."
  darkHero
>
  {/* IntroBumper retiré 2026-04-24 — bug écran noir persistant */}

  <!-- 01 · HERO IMMERSIF — sticky "recouvrement" style Polestar 5 (mail Jonathan).
       Le hero reste fixé en arrière-plan pendant que la section suivante
       vient se superposer au scroll (pas un défilement classique). -->
  <section
    id="hero"
    data-section-label="Accueil"
    data-theme="dark"
    class="hero-immersive hero-sticky relative isolate overflow-hidden bg-[var(--color-forest)] text-[var(--color-cream)]"
  >
    <div class="absolute inset-0 -z-10" data-hero-slideshow>
      {
        heroSlides.map((slide, i) => (
          <Image
            src={slide.src}
            alt={i === 0 ? slide.alt : ''}
            widths={[640, 960, 1280, 1600, 1920, 2560]}
            sizes="100vw"
            quality={82}
            format="webp"
            class={`hero-slide h-full w-full object-cover object-center ${i === 0 ? 'is-active' : ''}`}
            loading={i === 0 ? 'eager' : 'lazy'}
            data-hero-slide-index={i}
            data-hero-zoom={i === 0 ? '' : undefined}
          />
        ))
      }
      <!-- Gradient overlay : subtil, texte lisible sur toutes les slides -->
      <div
        data-parallax="0.35"
        class="absolute inset-0 bg-gradient-to-t from-[var(--color-forest)]/92 via-[var(--color-forest)]/35 to-transparent"
        aria-hidden="true"
      >
      </div>
    </div>

    <div class="relative flex min-h-[100svh] flex-col" data-hero-sequence>
      <div
        class="mx-auto mt-auto w-full max-w-[1400px] px-6 pt-40 pb-24 md:px-10 md:pt-48 md:pb-32"
      >
        <p
          data-hero="eyebrow"
          class="hero-eyebrow font-mono text-[11px] tracking-[0.26em] text-[var(--color-cream)]/70 uppercase"
        >
          Studio · Brive-la-Gaillarde · Aquitaine · Est. 2021
        </p>

        <h1
          class="hero-title mt-8 font-[family-name:var(--font-heading)] text-[length:var(--text-hero)] leading-[1.05] tracking-tight text-[var(--color-cream)]"
        >
          <span data-hero-mask class="hero-mask block pb-[0.05em] leading-[1.05]">
            <span data-mask-line class="hero-line block">Designer</span>
          </span>
          <span data-hero-mask class="hero-mask block pb-[0.12em] leading-[1.08]">
            <span data-mask-line class="hero-line display block">paysagiste</span>
          </span>
        </h1>

        <p
          data-hero="manifesto"
          class="hero-manifesto mt-10 max-w-xl text-[length:var(--text-lg)] leading-relaxed text-[var(--color-cream)]/80"
        >
          J'étudie et conçois des espaces à vivre, en dialogue avec le bâti, l'environnement et
          l'humain. Une démarche biophilique, scientifique et sensible.
        </p>

        <div
          data-hero="cta"
          class="hero-cta mt-14 flex flex-col items-start gap-6 md:flex-row md:items-center md:gap-10"
        >
          <a
            href="#typologies"
            class="inline-flex items-center gap-3 border-b border-[var(--color-cream)] pb-1 text-sm tracking-wide transition-colors hover:border-[var(--color-gold)] hover:text-[var(--color-gold)]"
          >
            Découvrir les typologies
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="/studio"
            class="text-sm text-[var(--color-cream)]/60 transition-colors hover:text-[var(--color-cream)]"
          >
            À propos du studio
          </a>
        </div>
      </div>

      <div
        data-hero="cue"
        class="scroll-cue pointer-events-none absolute bottom-8 left-1/2 z-10 -translate-x-1/2 text-[var(--color-cream)]/60"
      >
        <div class="flex flex-col items-center gap-3">
          <span class="font-mono text-[10px] tracking-[0.32em] uppercase">Explorer</span>
          <span class="scroll-cue-line block h-10 w-px bg-[var(--color-cream)]/40"></span>
        </div>
      </div>
    </div>
  </section>

  {
    /* Section Univers retirée 2026-04-24 (brief Jonathan) — priorité architecture
      paysagère seule. Remplacée par la section intro ci-dessous. */
  }

  <!-- 01b · ARCHITECTURE PAYSAGÈRE — section RESPIRATION cream (option C
       Morgan 2026-04-24 : alternance designbyad adaptée à palette Oliveira).
       Première section après hero = cream clair pour rupture visuelle. -->
  <section
    id="archi-intro"
    data-section-label="Architecture paysagère"
    class="archi-intro relative isolate overflow-hidden bg-[var(--color-cream)] text-[var(--color-ink)]"
    aria-labelledby="archi-intro-title"
  >
    <div
      class="mx-auto grid max-w-[1500px] grid-cols-1 gap-12 px-6 py-24 md:grid-cols-12 md:gap-16 md:px-10 md:py-32 lg:pl-24 xl:pl-32"
    >
      <header class="md:col-span-5" data-reveal="up" data-parallax="-0.25">
        <p class="font-mono text-[11px] tracking-[0.26em] text-[var(--color-ink)]/70 uppercase">
          <span class="text-[var(--color-ink)]/40">01</span> &nbsp;·&nbsp; Architecture paysagère
        </p>
        <h2
          id="archi-intro-title"
          class="mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-5xl)] leading-[0.98] md:text-[length:var(--text-hero)]"
        >
          <span class="block">Le jardin,</span>
          <span class="display block">une architecture.</span>
        </h2>
        <p
          class="mt-8 max-w-md text-[length:var(--text-base)] leading-relaxed text-[var(--color-ink)]/75"
        >
          Chaque lieu appelle une <span class="hover-accent">écriture</span> précise. Le studio conçoit
          des jardins comme des <span class="hover-accent">pièces à vivre</span> — en dialogue avec le
          bâti, le sol, l'orientation, les usages.
        </p>
        <a
          href="/architecture-paysagere"
          class="mt-10 inline-flex items-center gap-3 border-b border-[var(--color-ink)]/35 pb-1 font-mono text-[11px] tracking-[0.26em] text-[var(--color-ink)] uppercase transition-opacity hover:opacity-60"
        >
          Découvrir les typologies
          <span aria-hidden="true">→</span>
        </a>
      </header>

      <div
        class="archi-intro-visual relative md:col-span-7"
        data-clip-reveal="top"
        data-clip-duration="1.6"
        data-parallax="0.15"
      >
        <Image
          src={hero02}
          alt="Projet architecture paysagère — Restanque corrézienne, terrasse méditerranéenne"
          widths={[720, 1080, 1440, 1920]}
          sizes="(min-width: 768px) 55vw, 100vw"
          quality={82}
          format="webp"
          class="archi-intro-img"
          loading="lazy"
          data-reveal="image-rise"
        />
        <ul class="archi-intro-legendes" aria-label="Légendes du projet">
          <li>
            <span class="archi-legende-num">01</span>
            <span>Ouvrages paysagers sur mesure</span>
          </li>
          <li>
            <span class="archi-legende-num">02</span>
            <span>Essences sélectionnées au site</span>
          </li>
          <li>
            <span class="archi-legende-num">03</span>
            <span>Éclairage architectural nocturne</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 02 · STUDIO BIOPHILIQUE — refonte 2026-04-24 mail Jonathan :
       fond uni gris foncé (ink) — règle : home + archi + studio = ink.
       Pros = cream. -->
  <section
    id="studio-lead"
    data-section-label="Studio"
    data-theme="dark"
    class="studio-biophilique relative isolate overflow-hidden border-t border-[var(--color-cream)]/10 bg-[var(--color-ink)] text-[var(--color-cream)]"
    aria-labelledby="studio-lead-title"
  >
    <div class="relative mx-auto max-w-[1500px] px-6 py-28 md:px-10 md:py-40">
      {
        /* Pattern designbyad (scroll_home.mp4 frame 2) : bloc mots-clés UPPERCASE
          calé gauche-droite par justify CSS natif. data-justify-scroll → chaque
          mot oscille individuellement autour de sa position justify naturelle
          au scroll (direction/amplitude/phase seedées par mot). Premier et
          dernier mot ancrés → calage gauche-droite préservé. */
      }
      <p
        class="studio-keywords mb-20 md:mb-28"
        data-reveal="up"
        data-justify-scroll
        data-justify-amp="14"
        data-justify-seed="7"
      >
        Architecture paysagère <span aria-hidden="true">·</span>
        Design biophilique <span aria-hidden="true">·</span>
        Études sur-mesure <span aria-hidden="true">·</span>
        Studio indépendant
      </p>

      <div class="grid gap-16 md:grid-cols-12 md:gap-20">
        <div class="md:col-span-7" data-reveal="up" data-parallax="-0.3">
          <p class="font-mono text-xs tracking-[0.26em] text-[var(--color-cream)]/70 uppercase">
            <span class="studio-zones-dot" aria-hidden="true"></span>
            02 &nbsp;·&nbsp; Studio biophilique
          </p>
          <h2
            id="studio-lead-title"
            data-mask-reveal
            data-mask-stagger="0.14"
            class="mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-5xl)] leading-[1.02] md:text-[length:var(--text-hero)]"
          >
            <span data-mask-line class="block pb-[0.05em]">
              Design <span class="display">végétal</span> en
            </span>
            <span data-mask-line class="display block pb-[0.12em]">Aquitaine, Limousin.</span>
          </h2>
          <p
            class="mt-10 max-w-xl text-[length:var(--text-lg)] leading-relaxed text-[var(--color-cream)]/80"
          >
            Art de conception architecturale inspiré des environnements naturels et de leurs effets
            sur les humains. Une démarche
            <span class="hover-accent">scientifique</span>
            couplée à la <span class="hover-accent">technicité</span> architecturale, pour des espaces
            à vivre proches de ce que l'on ressent dans un lieu à l'état naturel.
          </p>
          <a
            href="/studio"
            class="mt-10 inline-flex items-center gap-3 border-b border-[var(--color-cream)]/30 pb-1 font-mono text-[11px] tracking-[0.26em] text-[var(--color-cream)] uppercase transition-colors hover:opacity-60"
          >
            Lire le manifeste complet
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <aside
          class="md:col-span-5"
          data-reveal="up"
          data-reveal-delay="0.15"
          data-parallax="0.4"
          aria-labelledby="zones-title"
        >
          <p
            id="zones-title"
            class="font-mono text-[11px] tracking-[0.26em] text-[var(--color-cream)]/70 uppercase"
          >
            <span class="studio-zones-dot" aria-hidden="true"></span>
            Zones d'intervention
          </p>
          <ul
            class="mt-8 divide-y divide-[var(--color-cream)]/12 border-t border-b border-[var(--color-cream)]/12"
          >
            {
              zones.map((zone, i) => (
                <li class="studio-zone group flex items-baseline justify-between gap-4 py-5">
                  <span class="flex items-baseline gap-5">
                    <span class="w-7 font-mono text-[10px] tracking-[0.26em] text-[var(--color-cream)]/55 uppercase">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <span class="font-[family-name:var(--font-heading)] text-[length:var(--text-3xl)] leading-none text-[var(--color-cream)] transition-opacity group-hover:opacity-70">
                      {zone}
                    </span>
                  </span>
                  <span class="font-mono text-[11px] tracking-[0.22em] text-[var(--color-cream)]/40 transition-all group-hover:translate-x-1 group-hover:text-[var(--color-cream)]">
                    →
                  </span>
                </li>
              ))
            }
          </ul>
          <p class="mt-6 text-sm leading-relaxed text-[var(--color-cream)]/70">
            Studio basé à Brive-la-Gaillarde. Déplacements réguliers vers Bordeaux et Limoges —
            aucun bureau satellite, le studio vient au projet.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <!-- 03 · TYPOLOGIES — fond uni ink (mail Jonathan 2026-04-24) -->
  <section
    id="typologies"
    data-section-label="Typologies"
    data-hscroll-typologies
    data-theme="dark"
    class="htypo-section relative border-t border-[var(--color-cream)]/10 bg-[var(--color-ink)] text-[var(--color-cream)]"
    aria-labelledby="typologies-title"
  >
    <div class="htypo-sticky">
      <!-- Header fixe -->
      <header class="htypo-header">
        <p class="font-mono text-[11px] tracking-[0.26em] text-[var(--color-cream)]/70 uppercase">
          <span class="text-[var(--color-cream)]/40">03</span> &nbsp;·&nbsp; Typologies
        </p>
        <h2
          id="typologies-title"
          class="mt-4 max-w-md pb-[0.12em] font-[family-name:var(--font-heading)] text-[length:var(--text-xl)] leading-[1.15] text-[var(--color-cream)] md:text-[length:var(--text-2xl)]"
        >
          Quatre manières <span class="display">d'habiter</span>
          un jardin.
        </h2>
      </header>

      <!-- Rail horizontal : 4 panneaux plein écran -->
      <div class="htypo-rail" data-hscroll-rail>
        {
          typologies.map((t, i) => (
            <a
              href={`/architecture-paysagere/${t.slug}`}
              class="htypo-panel group"
              data-hscroll-panel
              data-cursor-cta-host
              data-cursor-label="EXPLORER"
              aria-label={`Explorer la typologie ${t.nom}`}
            >
              <div class="htypo-visual" data-parallax-layer="frame">
                <div class="htypo-visual-inner" data-parallax-layer="image">
                  <Image
                    src={t.image}
                    alt=""
                    widths={[720, 1080, 1440, 1920]}
                    sizes="(min-width: 1024px) 38vw, 80vw"
                    quality={82}
                    format="webp"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    class="htypo-img"
                    style={`object-position: ${t.imagePosition ?? 'center'}`}
                  />
                  <div class="htypo-veil" aria-hidden="true" />
                </div>
                <span class="htypo-index-xl" aria-hidden="true">
                  {t.index}
                </span>
              </div>

              <div class="htypo-copy" data-parallax-layer="text">
                <p class="font-mono text-[10px] tracking-[0.26em] text-[var(--color-cream)]/70 uppercase">
                  {t.index} &nbsp;·&nbsp; Typologie
                </p>
                <h3 class="htypo-name mt-5 font-[family-name:var(--font-heading)] text-[length:var(--text-5xl)] leading-[0.95] text-[var(--color-cream)] md:text-[length:var(--text-6xl)]">
                  <span class="display">{t.nom}</span>
                </h3>
                <p
                  data-split
                  data-split-types="words"
                  data-split-stagger="0.06"
                  data-split-duration="1.05"
                  class="htypo-phrase mt-6 max-w-md font-[family-name:var(--font-heading)] text-[length:var(--text-xl)] leading-[1.25] text-[var(--color-cream)]/75 md:text-[length:var(--text-2xl)]"
                >
                  {t.phrase}
                </p>

                {/* Meta sans prix étude — brief Jonathan 2026-04-24. Surface + budget travaux + exemples. */}
                <dl class="htypo-meta mt-10 grid max-w-md grid-cols-2 gap-x-6 gap-y-4 font-mono text-[10px] tracking-[0.22em] text-[var(--color-cream)]/70 uppercase">
                  <div>
                    <dt class="text-[var(--color-cream)]/45">Surface</dt>
                    <dd class="mt-1.5 text-[var(--color-cream)]">{t.surface}</dd>
                  </div>
                  <div>
                    <dt class="text-[var(--color-cream)]/45">Budget travaux</dt>
                    <dd class="mt-1.5 text-[var(--color-cream)]">{t.budget}</dd>
                  </div>
                  <div class="col-span-2">
                    <dt class="text-[var(--color-cream)]/45">Exemples</dt>
                    <dd class="mt-1.5 tracking-[0.05em] text-[var(--color-cream)] normal-case">
                      {t.exemples}
                    </dd>
                  </div>
                </dl>

                <span class="htypo-cta-static mt-10 inline-flex items-center gap-3 border-b border-[var(--color-cream)]/35 pb-1 text-sm tracking-wide text-[var(--color-cream)]/85 transition-opacity group-hover:opacity-60">
                  Explorer la typologie
                  <span aria-hidden="true">→</span>
                </span>
              </div>

              <span class="htypo-cursor-cta" data-cursor-cta aria-hidden="true">
                <span class="htypo-cursor-cta-inner">Explorer</span>
              </span>
            </a>
          ))
        }
      </div>

