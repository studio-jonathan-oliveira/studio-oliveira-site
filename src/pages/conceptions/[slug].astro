---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/astro/Section.astro';
import Prose from '@/components/astro/Prose.astro';
import PortableText from '@/components/astro/portable-text/PortableText.astro';
import MaskRevealHeading from '@/components/astro/MaskRevealHeading.astro';
import CtaLink from '@/components/astro/CtaLink.astro';
import type { PtNode } from '@/lib/portable-text';
import { fetch } from '@/lib/sanity';
import { projectSlugsQuery, projectBySlugQuery } from '@/lib/queries';
import {
  jsonLdGraph,
  breadcrumbs,
  organization,
  localBusiness,
  person,
  creativeWorkProject,
} from '@/lib/schema-org';

export const getStaticPaths = (async () => {
  const slugs = await fetch<{ realisations: string[]; conceptions: string[] }>(
    projectSlugsQuery,
    {},
    { realisations: [], conceptions: [] },
  );
  return slugs.conceptions.map((slug) => ({ params: { slug } }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;

interface FullProject {
  _id: string;
  title: string;
  slug: string;
  year?: number;
  location?: string;
  typology?: { title: string; slug: string };
  scrollFramesSlug?: string;
  scrollFramesCount?: number;
  twinmotionVideo?: string;
  coverImage?: unknown;
  description?: PtNode[];
  challenge?: PtNode[];
  solution?: PtNode[];
  outcomeStats?: { value: string; label: string }[];
  seoTitle?: string;
  seoDescription?: string;
}

const project = await fetch<FullProject | null>(projectBySlugQuery, { slug }, null);

if (!project) {
  return Astro.redirect('/conceptions', 301);
}

const breadcrumbItems = [
  { name: 'Accueil', item: '/' },
  { name: 'Conceptions', item: '/conceptions' },
  { name: project.title, item: `/conceptions/${project.slug}` },
];

const schema = jsonLdGraph([
  organization(),
  person(),
  localBusiness(),
  creativeWorkProject({
    title: project.title,
    slug: project.slug,
    section: 'conceptions',
    year: project.year,
    location: project.location,
  }),
  breadcrumbs(breadcrumbItems),
]);
---

<BaseLayout
  title={project.seoTitle ?? project.title}
  description={project.seoDescription ??
    `Étude de conception — ${project.title}, ${project.location ?? ''}.`}
>
  <Section variant="cream" space="compact" class="pt-32 pb-0 md:pt-40">
    <nav
      aria-label="Fil d'Ariane"
      class="font-mono text-[11px] tracking-[0.2em] text-[var(--color-cream)]/50 uppercase"
    >
      <ol class="flex flex-wrap items-center gap-2">
        {
          breadcrumbItems.map((b, i) => (
            <li class="flex items-center gap-2">
              {i < breadcrumbItems.length - 1 ? (
                <a href={b.item} class="hover:text-[var(--color-cream)]">
                  {b.name}
                </a>
              ) : (
                <span class="line-clamp-1 max-w-[40ch] text-[var(--color-cream)]/80">{b.name}</span>
              )}
              {i < breadcrumbItems.length - 1 && <span aria-hidden="true">/</span>}
            </li>
          ))
        }
      </ol>
    </nav>
  </Section>

  <Section variant="cream" space="compact" class="pt-0 pb-0">
    <article>
      <header class="mb-16 max-w-3xl">
        <p class="font-mono text-xs tracking-[0.22em] text-[var(--color-cream)]/55 uppercase">
          Conception · {project.typology?.title}
          {project.year && ` · ${project.year}`}
        </p>
        <MaskRevealHeading
          text={project.title}
          as="h1"
          class="mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-5xl)] leading-[1.02] tracking-tight"
        />
        {
          project.location && (
            <p class="mt-8 font-[family-name:var(--font-heading)] text-[length:var(--text-2xl)] text-[var(--color-cream)]/60 italic">
              {project.location}
            </p>
          )
        }
      </header>

      {/* Chiffres-clés */}
      {
        project.outcomeStats && project.outcomeStats.length > 0 && (
          <dl class="mb-16 grid grid-cols-2 gap-8 border-y border-[var(--color-cream)]/10 py-10 md:grid-cols-4 md:gap-12">
            {project.outcomeStats.map((stat) => (
              <div>
                <dt class="font-mono text-[11px] tracking-[0.22em] text-[var(--color-cream)]/55 uppercase">
                  {stat.label}
                </dt>
                <dd class="mt-3 font-[family-name:var(--font-heading)] text-[length:var(--text-2xl)] leading-tight">
                  {stat.value}
                </dd>
              </div>
            ))}
          </dl>
        )
      }

      {/* Description */}
      <div class="grid gap-16 md:grid-cols-[1fr_2fr] md:gap-20">
        <aside>
          <p class="font-mono text-xs tracking-[0.22em] text-[var(--color-cream)]/55 uppercase">
            Parti-pris
          </p>
        </aside>
        <Prose size="lg">
          <PortableText value={project.description} />
        </Prose>
      </div>
    </article>
  </Section>

  {/* Bloc scroll-scrub immersif — ScrollFrames island activé si scrollFramesSlug défini */}
  {
    project.scrollFramesSlug && project.scrollFramesCount && (
      <section
        class="relative bg-[var(--color-ink)]"
        aria-label={`Visite immersive de ${project.title}`}
      >
        <div class="sr-only">
          Séquence photoréaliste de {project.scrollFramesCount} images. Utilisez le scroll pour
          naviguer dans l'espace.
        </div>
        {/* ScrollFrames React island — à intégrer :
            <ScrollFrames slug={project.scrollFramesSlug} frameCount={project.scrollFramesCount} client:visible /> */}
        <div class="flex h-screen items-center justify-center text-[var(--color-cream)]/50">
          <p class="font-mono text-[11px] tracking-[0.3em] uppercase">
            [ScrollFrames · slug={project.scrollFramesSlug} · frames={project.scrollFramesCount}]
          </p>
        </div>
      </section>
    )
  }

  {
    project.challenge && project.challenge.length > 0 && (
      <Section variant="cream" topDivider>
        <div class="grid gap-16 md:grid-cols-[1fr_2fr] md:gap-20">
          <div>
            <p class="font-mono text-xs tracking-[0.22em] text-[var(--color-cream)]/55 uppercase">
              Le défi
            </p>
          </div>
          <Prose size="lg">
            <PortableText value={project.challenge} />
          </Prose>
        </div>
      </Section>
    )
  }

  {
    project.solution && project.solution.length > 0 && (
      <Section variant="cream" topDivider>
        <div class="grid gap-16 md:grid-cols-[1fr_2fr] md:gap-20">
          <div>
            <p class="font-mono text-xs tracking-[0.22em] text-[var(--color-cream)]/55 uppercase">
              La réponse
            </p>
          </div>
          <Prose size="lg">
            <PortableText value={project.solution} />
          </Prose>
        </div>
      </Section>
    )
  }

  <Section variant="forest" topDivider id="contact-cta" sectionLabel="Contact">
    <div class="text-center">
      <p class="font-mono text-xs tracking-[0.28em] text-[var(--color-ink)]/55 uppercase">
        Votre tour
      </p>
      <h2
        data-mask-reveal
        data-mask-stagger="0.14"
        class="mt-8 font-[family-name:var(--font-heading)] text-[length:var(--text-5xl)] leading-[1.05]"
      >
        <span data-mask-line class="block pb-[0.05em]">Votre lieu,</span>
        <span data-mask-line class="block pb-[0.12em]"
          ><em class="text-[var(--color-ink)]/55 italic">conçu précisément</em>.</span
        >
      </h2>
      <div class="mt-12 flex flex-col items-center justify-center gap-6 md:flex-row md:gap-10">
        <CtaLink href="/contact" label="Lancer une étude" tone="dark" size="lg" magnetic={0} />
        <a href="/conceptions" class="text-sm underline underline-offset-4">
          Toutes les conceptions
        </a>
      </div>
    </div>
  </Section>

  <Fragment slot="head">
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
</BaseLayout>
