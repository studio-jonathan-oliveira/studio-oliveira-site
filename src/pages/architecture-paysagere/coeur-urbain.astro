---
/*
 * /architecture-paysagere/coeur-urbain — PILOTE refonte DA finale 2026-06-04
 * (trames « modif finales » Jonathan). Bascule beige/noir :
 *   - Hero typographique beige (H1 noir Black « Coeur / urbain », sans photo)
 *     + specs beige — via `<TypologieHero>` partagé.
 *   - Galerie sur fond BEIGE (était noir), avec 2 blocs titrés « Définir » et
 *     « Comprendre » intercalés (manifeste scindé, titres noirs visibles).
 *   - FAQ beige + marquee « découvrir les projets » via `<TypologieFaq>`.
 *   - Suppression de l'ancien CTA rouge full-width (remplacé par le marquee
 *     de la FAQ, cf. trame).
 *
 * Verbatim trame (casse/fautes conservées). Réponses FAQ trouvées dans la
 * colonne droite de la trame micro-urbain (cf. _brief/trames-finales-specs/
 * _FAQ-reponses-trame-micro-urbain.md).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import TypologieHero from '@/components/astro/TypologieHero.astro';
import TypologieFaq from '@/components/astro/TypologieFaq.astro';
import { SITE } from '@/lib/site-config';
import {
  jsonLdGraph,
  breadcrumbs,
  localBusiness,
  organization,
  service as serviceSchema,
  faqPage,
} from '@/lib/schema-org';
import { fetch } from '@/lib/sanity';
import { typologyEditableBySlugQuery } from '@/lib/queries';
import type { FaqItem } from '@/lib/schema-org';

// Galerie — ordre piloté par le préfixe numérique (Morgan 2026-05-21).
import gal02 from '@/assets/typologies/coeur-urbain/02-jardinet.jpg';
import gal03 from '@/assets/typologies/coeur-urbain/03-chemin.jpg';
import gal04 from '@/assets/typologies/coeur-urbain/04-terrasse.jpg';
import gal05 from '@/assets/typologies/coeur-urbain/05-terrasse.jpg';
import gal06 from '@/assets/typologies/coeur-urbain/06-restaurant.jpg';
import gal07 from '@/assets/typologies/coeur-urbain/07-piscine.jpg';
import gal08 from '@/assets/typologies/coeur-urbain/08-porche.jpg';
import gal09 from '@/assets/typologies/coeur-urbain/09-cheminement.jpg';
import gal10 from '@/assets/typologies/coeur-urbain/10-terrasse.jpg';
import gal11 from '@/assets/typologies/coeur-urbain/11-chemin.jpg';

const typologie = SITE.typologies.find((t) => t.slug === 'coeur-urbain')!;

// 4 valeurs droite — VERBATIM trame finale (casse conservée).
const valeurs = [
  'Zone urbaine / Coeur de ville et alentours',
  'de 100 à 500 m² (hors cas spécifique)',
  'Cours urbaines / Jardins confinés / Jardins de ville',
  'Accès / exposition / réseaux souterrains / urbanisme',
] as const;

// Manifeste — VERBATIM trame (scindé en « Définir » et « Comprendre »).
const manifeste = {
  bloc1:
    "La typologie coeur urbaine se caractérise par des espaces de vie extérieurs, enclavés et confinés. Elle représente des cours arrières à l'habitat souvent minéralisées, en prolongement de l'habitat intérieur, des entrées de propriétés traversants sous les bâtiments ou de simples zones d'accueil des convives avec de potentiels stationnements.",
  bloc2:
    'Ce sont des espaces généralement cosy de part leur enclavement mais perturbés par le manque de place disponible au sol et en hauteur.',
  precision:
    "La complexité de cette typologie repose principalement sur la disponibilité des sols, saturés par les réseaux souterrains, ainsi que l'ensoleillement, souvent coupé par les bâtiments environnants, rendant ces espaces complexes dans leurs aménagements structurels et naturels.",
};

// FAQ — 3 Q/R VERBATIM trame (colonne droite micro-urbain, accordéons ouverts).
// Fautes conservées : « règlementaire », « étude végétales », « des entreprise »,
// « a établit », « nécessité », « compte rendus », « tranquilité ».
const faqFallback = [
  {
    question: 'Comment se compose une étude ?',
    answer:
      "Il y a 3 phases : l'étude préliminaire, l'étude projet et le suivi de chantier.\n\nL'étude préliminaire : elle recadre le contexte du projet et structure les orientations de projet. C'est une synthèse de la commande et de la structuration des axes directeurs du projet avec une budgétisation des grands lots travaux.\n\nL'étude projet : elle rentre dans le détail de conception suite à la validation de l'étude préliminaire. Dans cette phase, le studio développe, organise, et consulte les entreprises et artisans pour le chiffrage précis des travaux.\n\nLe suivi de chantier : c'est la partie pilotage chantier. Elle est importante car elle permet de garantir un résultat final entre les intentions de projet et la réalisation. Le studio gère les compte rendus, le suivi financier ainsi que le pilotage des travaux avec les différentes entreprises sur le chantier. Vous payez une tranquilité d'esprit et de la disponibilité.",
  },
  {
    question: "Quels sont les livrables d'une étude ?",
    answer:
      "Étude préliminaire : étude du contexte projet, étude règlementaire et urbanisme, étude fonctionnelle et besoins, synthèse graphique, étude estimative budgétaire.\n\nÉtude projet : conception paysagère, étude végétales, dossier de consultation des entreprise, détails techniques, consultation des entreprises, dossier de réalisation.\n\nSuivi de chantier : comptes rendus de chantier, suivi d'avancement, validation des ouvrages, suivi financier, réception des travaux.",
  },
  {
    question: "Quel est le prix de l'étude pour cette typologie ?",
    answer:
      "En fonction de la typologie des jardins, le studio a établit des forfaits de base.\n\nViennent s'ajouter à ces forfaits de base :\n- des frais correspondant aux déplacements du studio (frais d'essence, péages, ...)\n- la mission géomètre\nen fonction de votre emplacement et des nécessité du projet et de l'étude.\n\nPour connaître le montant exact de votre étude, je vous invite à me contacter (ou remplir le formulaire via l'onglet \"démarrer un projet\" en haut de la page) afin que nous puissions échanger ensemble et définir tous les paramètres liés à votre projet.",
  },
];

// FAQ éditable via Sanity (typology.faq) — fallback verbatim trame si vide.
const cmsTypologie = await fetch<{ faq?: FaqItem[] } | null>(
  typologyEditableBySlugQuery,
  { slug: 'coeur-urbain' },
  null,
);
const faq: FaqItem[] =
  cmsTypologie?.faq && cmsTypologie.faq.length > 0 ? cmsTypologie.faq : faqFallback;

const breadcrumbItems = [
  { name: 'Accueil', item: '/' },
  { name: 'Projets', item: '/projets' },
  { name: typologie.nomProprietaire, item: `/architecture-paysagere/${typologie.slug}` },
];

const schema = jsonLdGraph([
  organization(),
  localBusiness(),
  serviceSchema({
    name: typologie.h1Seo,
    slug: typologie.slug,
    description: `${typologie.h1Seo} — Studio J Oliveira, designer paysagiste biophilique. Étude ${typologie.prixEtude}, budget travaux ${typologie.budgetTravaux}.`,
    priceRangeMin: typologie.coutEtudeNumeric,
    priceRangeMax: typologie.coutEtudeNumeric,
  }),
  faqPage(faq),
  breadcrumbs(breadcrumbItems),
]);
---

<BaseLayout
  title={`${typologie.h1Seo} — Cœur urbain`}
  description={`${typologie.h1Seo} avec le Studio J Oliveira — maison de ville, cour patrimoniale, jardin enclavé. Étude ${typologie.prixEtude}, budget travaux ${typologie.budgetTravaux}. Studio biophilique à Brive‑la‑Gaillarde.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={schema} />
  </Fragment>

  {/* ═════════ 1 · HERO beige typographique + specs (composant partagé) ════ */}
  <TypologieHero h1Lines={['Coeur', 'urbain']} valeurs={valeurs} sectionLabel="Cœur urbain" />

  {/* ═════════ 2 · GALERIE beige + manifeste « Définir » / « Comprendre » ══ */}
  <section data-theme="dark" class="cu-gallery" aria-label="Sélection de projets cœur urbain">
    <div class="cu-gallery__diptyque cu-gallery__diptyque--top">
      <figure class="cu-gallery__diptyque-left" data-reveal="image-rise">
        <Image
          src={gal02}
          alt="Projet cœur urbain — ruelle de jardin contre maison de ville en briques"
          widths={[480, 720, 1100]}
          sizes="(min-width: 1024px) 38vw, 92vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="cu-gallery__img"
        />
      </figure>
      <figure class="cu-gallery__diptyque-right" data-reveal="image-rise">
        <Image
          src={gal03}
          alt="Projet cœur urbain — porte verte ouvrant sur une allée minérale jusqu'à un patio"
          widths={[640, 960, 1300]}
          sizes="(min-width: 1024px) 54vw, 96vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="cu-gallery__img"
        />
      </figure>
    </div>

    {/* Manifeste « Définir » */}
    <div class="cu-manifeste cu-manifeste--definir">
      <h2 class="cu-manifeste__title">Définir</h2>
      <div
        class="cu-manifeste__body"
        data-words-fade
        data-words-fade-stagger="0.006"
        data-words-fade-window="0.05,0.5"
      >
        <p class="cu-manifeste__para">{manifeste.bloc1}</p>
        <p class="cu-manifeste__para">{manifeste.bloc2}</p>
      </div>
    </div>

    <figure class="cu-gallery__large" data-reveal="image-rise">
      <Image
        src={gal04}
        alt="Projet cœur urbain — terrasse couverte jungle intérieur-extérieur"
        widths={[960, 1440, 1800]}
        sizes="(min-width: 1024px) 92vw, 96vw"
        quality={92}
        format="webp"
        loading="lazy"
        class="cu-gallery__img"
      />
    </figure>

    <div class="cu-gallery__diptyque cu-gallery__diptyque--mid">
      <figure class="cu-gallery__diptyque-left" data-reveal="image-rise">
        <Image
          src={gal05}
          alt="Projet cœur urbain — mur de lierre, escalier suspendu et mange-debout"
          widths={[640, 960, 1300]}
          sizes="(min-width: 1024px) 50vw, 96vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="cu-gallery__img"
        />
      </figure>
      <figure class="cu-gallery__diptyque-right" data-reveal="image-rise">
        <Image
          src={gal06}
          alt="Projet cœur urbain — terrasse de restaurant en fer forgé sous palmiers"
          widths={[640, 960, 1300]}
          sizes="(min-width: 1024px) 50vw, 96vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="cu-gallery__img"
        />
      </figure>
    </div>

    <div class="cu-gallery__diptyque cu-gallery__diptyque--bot">
      <figure class="cu-gallery__diptyque-left" data-reveal="image-rise">
        <Image
          src={gal07}
          alt="Projet cœur urbain — piscine bordée d'héliconia et d'un porche blanc"
          widths={[640, 960, 1300]}
          sizes="(min-width: 1024px) 54vw, 96vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="cu-gallery__img"
        />
      </figure>
      <figure class="cu-gallery__diptyque-right" data-reveal="image-rise">
        <Image
          src={gal08}
          alt="Projet cœur urbain — porche bois ouvrant sur un patio de briques végétalisé"
          widths={[480, 720, 1100]}
          sizes="(min-width: 1024px) 38vw, 92vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="cu-gallery__img"
        />
      </figure>
    </div>

    <div class="cu-gallery__diptyque cu-gallery__diptyque--mid">
      <figure class="cu-gallery__diptyque-left" data-reveal="image-rise">
        <Image
          src={gal10}
          alt="Projet cœur urbain — terrasse paysagère"
          widths={[480, 720, 1100]}
          sizes="(min-width: 1024px) 46vw, 92vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="cu-gallery__img"
        />
      </figure>
      <figure class="cu-gallery__diptyque-right" data-reveal="image-rise">
        <Image
          src={gal11}
          alt="Projet cœur urbain — cheminement végétalisé"
          widths={[480, 720, 1100]}
          sizes="(min-width: 1024px) 46vw, 92vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="cu-gallery__img"
        />
      </figure>
    </div>

    <figure class="cu-gallery__coda" data-reveal="image-rise">
      <Image
        src={gal09}
        alt="Projet cœur urbain — vue plongeante sur un érable jaune et orange au-dessus d'une table ronde"
        widths={[960, 1440, 1800]}
        sizes="(min-width: 1024px) 92vw, 96vw"
        quality={92}
        format="webp"
        loading="lazy"
        class="cu-gallery__img"
      />
    </figure>

    {/* Manifeste « Comprendre » */}
    <div class="cu-manifeste cu-manifeste--comprendre">
      <h2 class="cu-manifeste__title">Comprendre</h2>
      <p class="cu-manifeste__para">{manifeste.precision}</p>
    </div>
  </section>

  {/* ═════════ 3 · FAQ beige + marquee (composant partagé) ═══════════════ */}
  <TypologieFaq items={faq} />

  <style is:global>
    /* ═══════════════════════════════════════════════════════════════════════
     * /architecture-paysagere/coeur-urbain — pilote DA finale beige/noir.
     * Galerie + manifeste locaux (préfixe `cu-`). Hero/FAQ factorisés.
     * ═══════════════════════════════════════════════════════════════════ */

    /* ─── Galerie magazine sur fond BEIGE ───────────────────────────────── */
    .cu-gallery {
      width: 100%;
      background-color: var(--color-ink);
      color: var(--color-cream);
      padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 3vw, 2.5rem);
    }
    .cu-gallery__large {
      margin: 0;
      width: 100%;
      aspect-ratio: 3 / 2;
      overflow: hidden;
      border-radius: clamp(12px, 1.5vw, 22px);
      background-color: color-mix(in oklab, var(--color-cream) 6%, var(--color-ink));
    }
    @media (min-width: 1024px) {
      .cu-gallery__large {
        aspect-ratio: 16 / 10;
      }
    }
    .cu-gallery__diptyque {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(1.25rem, 3vw, 2.5rem);
    }
    @media (min-width: 768px) {
      .cu-gallery__diptyque--top {
        grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
        align-items: stretch;
      }
      .cu-gallery__diptyque--mid {
        grid-template-columns: 1fr 1fr;
        align-items: stretch;
      }
      .cu-gallery__diptyque--bot {
        grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr);
        align-items: stretch;
      }
    }
    .cu-gallery__diptyque-left,
    .cu-gallery__diptyque-right {
      margin: 0;
      overflow: hidden;
      border-radius: clamp(12px, 1.5vw, 22px);
      background-color: color-mix(in oklab, var(--color-cream) 6%, var(--color-ink));
    }
    .cu-gallery__diptyque--top .cu-gallery__diptyque-left,
    .cu-gallery__diptyque--top .cu-gallery__diptyque-right {
      aspect-ratio: 4 / 5;
    }
    @media (min-width: 768px) {
      .cu-gallery__diptyque--top .cu-gallery__diptyque-left {
        aspect-ratio: 3 / 4;
        align-self: start;
        max-height: 78%;
      }
      .cu-gallery__diptyque--top .cu-gallery__diptyque-right {
        aspect-ratio: 4 / 5;
        align-self: end;
      }
    }
    .cu-gallery__diptyque--mid .cu-gallery__diptyque-left,
    .cu-gallery__diptyque--mid .cu-gallery__diptyque-right {
      aspect-ratio: 4 / 5;
    }
    @media (min-width: 768px) {
      .cu-gallery__diptyque--mid .cu-gallery__diptyque-left,
      .cu-gallery__diptyque--mid .cu-gallery__diptyque-right {
        aspect-ratio: 5 / 6;
      }
    }
    .cu-gallery__diptyque--bot .cu-gallery__diptyque-left,
    .cu-gallery__diptyque--bot .cu-gallery__diptyque-right {
      aspect-ratio: 4 / 5;
    }
    @media (min-width: 768px) {
      .cu-gallery__diptyque--bot .cu-gallery__diptyque-left {
        aspect-ratio: 4 / 5;
        align-self: start;
      }
      .cu-gallery__diptyque--bot .cu-gallery__diptyque-right {
        aspect-ratio: 3 / 4;
        align-self: end;
        max-height: 78%;
      }
    }
    .cu-gallery__coda {
      margin: 0;
      width: 100%;
      aspect-ratio: 3 / 2;
      overflow: hidden;
      border-radius: clamp(12px, 1.5vw, 22px);
      background-color: color-mix(in oklab, var(--color-cream) 6%, var(--color-ink));
    }
    @media (min-width: 1024px) {
      .cu-gallery__coda {
        aspect-ratio: 16 / 10;
      }
    }
    .cu-gallery__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    /* ─── Manifeste « Définir » / « Comprendre » (beige/noir) ───────────── */
    .cu-manifeste {
      width: 100%;
      padding: clamp(2.5rem, 6vw, 5rem) 0;
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }
    @media (min-width: 1024px) {
      .cu-manifeste {
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr);
        column-gap: clamp(3rem, 6vw, 5rem);
        align-items: start;
      }
    }
    .cu-manifeste__title {
      font-family: var(--font-heading), sans-serif;
      font-weight: 900;
      font-size: clamp(2rem, 4.5vw, 4rem);
      line-height: 1;
      letter-spacing: -0.01em;
      color: var(--color-cream);
      margin: 0;
      /* « Définir » / « Comprendre » en casse normale (annule uppercase global). */
      text-transform: none;
    }
    .cu-manifeste__body {
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 2.2vw, 1.85rem);
    }
    .cu-manifeste__para {
      font-family: var(--font-body), sans-serif;
      font-weight: 200;
      font-size: clamp(1.1rem, 1.5vw, 1.5rem);
      line-height: 1.5;
      letter-spacing: -0.005em;
      color: var(--color-cream);
      margin: 0;
    }
    .cu-manifeste__body .word {
      display: inline-block;
      opacity: 0;
      transform: translateY(10px);
      will-change: opacity, transform;
    }

    .cu-gallery,
    .cu-manifeste {
      box-sizing: border-box;
    }
  </style>
</BaseLayout>
