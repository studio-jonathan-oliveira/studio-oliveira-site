---
/*
 * /architecture-paysagere/coeur-urbain — page typologie 2026-05-19.
 * Copie structurelle de `micro-urbain.astro` (pilote validé v9). Route
 * statique : Astro priorise ce fichier sur `[slug].astro`. Mêmes patterns
 * (hero overlay + specs, galerie magazine, manifeste décalé droite, FAQ,
 * CTA full-width + pill rouge). Seul différe :
 *   - Photos (6 vs 5) → la galerie devient diptyque + large + diptyque
 *     (cf. trame `C:\tmp\trame pages typologies.png`, colonne droite).
 *   - Specs verbatim trame Jonathan (Cœur urbain).
 *   - Manifeste : Jonathan a recopié dans la trame le placeholder
 *     micro-urbain → texte à valider, listé dans `_brief/contenus-manquants.md`
 *     sous TYPOLOGIE-COEUR-URBAIN-MANIFESTE. On conserve verbatim trame
 *     pour ne pas inventer.
 *
 * H1 sans accent (« COEUR » conservé tel quel — esthétique designbyad,
 * cf. commentaire pilote micro-urbain). Fautes typo conservées si présentes.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import TypologieHero from '@/components/astro/TypologieHero.astro';
import FaqAccordion from '@/components/islands/FaqAccordion';
import { SITE } from '@/lib/site-config';
import {
  jsonLdGraph,
  breadcrumbs,
  localBusiness,
  organization,
  service as serviceSchema,
  faqPage,
} from '@/lib/schema-org';

import heroPhoto from '@/assets/typologies/coeur-urbain/01-hero.jpg';
// Galerie — ordre piloté par le préfixe numérique (Morgan 2026-05-21).
import gal02 from '@/assets/typologies/coeur-urbain/02-jardinet.jpg';
import gal03 from '@/assets/typologies/coeur-urbain/03-chemin.jpg';
import gal04 from '@/assets/typologies/coeur-urbain/04-terrasse.jpg';
import gal05 from '@/assets/typologies/coeur-urbain/05-terrasse.jpg';
import gal06 from '@/assets/typologies/coeur-urbain/06-restaurant.jpg';
import gal07 from '@/assets/typologies/coeur-urbain/07-piscine.jpg';
import gal08 from '@/assets/typologies/coeur-urbain/08-porche.jpg';
import gal09 from '@/assets/typologies/coeur-urbain/09-cheminement.jpg';

const typologie = SITE.typologies.find((t) => t.slug === 'coeur-urbain')!;

// 4 valeurs droite — verbatim dictée Morgan 2026-05-19 (les 4 labels sont
// figés et viennent du composant `<TypologieHero>` partagé).
const valeurs = [
  'Zone urbaine / cœur de ville et alentours',
  'De 100 à 500 m² (hors cas spécifique)',
  'Cours urbaines / jardins confinés / jardins de ville',
  'Accès / exposition / réseaux souterrain / urbanisme',
] as const;

// Manifeste — texte Jonathan VERBATIM (correctif Morgan 2026-05-21).
// Le placeholder copié-collé depuis micro-urbain a été remplacé par le
// vrai texte cœur urbain.
const manifeste = {
  bloc1:
    "La typologie coeur urbaine se caractérise par des espaces de vie extérieurs, enclavés et confinés. Elle représente des cours arrières à l'habitat souvent minéralisées, en prolongement de l'habitat intérieur, des entrées de propriétés traversants sous les bâtiments ou de simples zones d'accueil des convives avec des potentiels stationnements.",
  bloc2:
    'Ce sont des espaces généralement cosy de part leur enclavement mais perturbés par le manque de place disponible au sol et en hauteur.',
  precision:
    "La complexité de cette typologie repose principalement sur les sols, saturés par les réseaux souterrains, ainsi que l'ensoleillement, souvent coupé par les bâtiments environnants, rendant ces espaces complexes dans leurs aménagements structurels et naturels.",
};

// FAQ — copie du pilote micro-urbain (pattern réutilisable, prix typologie
// pris depuis SITE.typologies). À valider par Jonathan pour adapter le ton.
const faq = [
  {
    question: "Pourquoi facturer une étude alors que beaucoup de paysagistes l'offrent ?",
    answer:
      "Parce que c'est le cœur du métier. L'étude comprend le plan masse, les plans de plantations, le DCE, la mise en concurrence des entreprises et le suivi de chantier. Le chiffrage travaux vient ensuite, précisément.",
  },
  {
    question: `Est-ce que le prix d'étude (${typologie.prixEtude}) est ferme ?`,
    answer:
      "Oui — le prix est défini dès la signature du devis, en fonction de la typologie. Aucun ajout en cours d'étude sauf demande explicite du client (extension de périmètre, options, géomètre complémentaire).",
  },
  {
    question: 'Vous réalisez les travaux vous-mêmes ?',
    answer:
      'Non. Je conçois et je coordonne — je sélectionne et je pilote des entreprises mises en concurrence sur chaque lot (terrassement, maçonnerie paysagère, arrosage, éclairage, plantations).',
  },
];

const breadcrumbItems = [
  { name: 'Accueil', item: '/' },
  { name: 'Architecture paysagère', item: '/architecture-paysagere' },
  { name: typologie.nomProprietaire, item: `/architecture-paysagere/${typologie.slug}` },
];

const schema = jsonLdGraph([
  organization(),
  localBusiness(),
  serviceSchema({
    name: typologie.h1Seo,
    slug: typologie.slug,
    description: `${typologie.h1Seo} — Studio J Oliveira, designer paysagiste biophilique. Étude ${typologie.prixEtude}, budget travaux ${typologie.budgetTravaux}.`,
    priceRangeMin: typologie.coutEtudeNumeric,
    priceRangeMax: typologie.coutEtudeNumeric,
  }),
  faqPage(faq),
  breadcrumbs(breadcrumbItems),
]);
---

<BaseLayout
  title={`${typologie.h1Seo} — Cœur urbain`}
  description={`${typologie.h1Seo} avec le Studio J Oliveira — maison de ville, cour patrimoniale, jardin enclavé. Étude ${typologie.prixEtude}, budget travaux ${typologie.budgetTravaux}. Studio biophilique à Brive‑la‑Gaillarde.`}
  darkHero
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={schema} />
  </Fragment>

  {/* ═════════ 1 · HERO — via composant partagé `<TypologieHero>` ════════ */}
  <TypologieHero
    photo={heroPhoto}
    alt="Cour urbaine patrimoniale cœur urbain — projet Studio J Oliveira"
    h1Lines={['COEUR', 'URBAIN']}
    valeurs={valeurs}
    sectionLabel="Cœur urbain"
  />

  {
    /* ═════════ 2 · GALERIE — 8 photos rythme magazine ════════════════════
     Ordre piloté par le préfixe numérique (Morgan 2026-05-21).
       (1) diptyque quinconce HAUT       : 02 small + 03 large
       (2) photo large landscape         : 04 (pivot)
       (3) diptyque 50/50 milieu         : 05 + 06
       (4) diptyque quinconce inverse    : 07 large + 08 small (miroir du haut)
       (5) coda portrait centrée         : 09 (signature chromatique)
     Gouttières noires généreuses, aucun bord-à-bord. */
  }
  <section
    data-theme="dark"
    class="cu-gallery bg-[var(--color-black-deep)]"
    aria-label="Sélection de projets cœur urbain"
  >
    <div class="cu-gallery__diptyque cu-gallery__diptyque--top">
      <figure class="cu-gallery__diptyque-left" data-reveal="image-rise">
        <Image
          src={gal02}
          alt="Projet cœur urbain — ruelle de jardin contre maison de ville en briques"
          widths={[480, 720, 1100]}
          sizes="(min-width: 1024px) 38vw, 92vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="cu-gallery__img"
        />
      </figure>
      <figure class="cu-gallery__diptyque-right" data-reveal="image-rise">
        <Image
          src={gal03}
          alt="Projet cœur urbain — porte verte ouvrant sur une allée minérale jusqu'à un patio"
          widths={[640, 960, 1300]}
          sizes="(min-width: 1024px) 54vw, 96vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="cu-gallery__img"
        />
      </figure>
    </div>

    <figure class="cu-gallery__large" data-reveal="image-rise">
      <Image
        src={gal04}
        alt="Projet cœur urbain — terrasse couverte jungle intérieur-extérieur"
        widths={[960, 1440, 1800]}
        sizes="(min-width: 1024px) 92vw, 96vw"
        quality={92}
        format="webp"
        loading="lazy"
        class="cu-gallery__img"
      />
    </figure>

    <div class="cu-gallery__diptyque cu-gallery__diptyque--mid">
      <figure class="cu-gallery__diptyque-left" data-reveal="image-rise">
        <Image
          src={gal05}
          alt="Projet cœur urbain — mur de lierre, escalier suspendu et mange-debout"
          widths={[640, 960, 1300]}
          sizes="(min-width: 1024px) 50vw, 96vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="cu-gallery__img"
        />
      </figure>
      <figure class="cu-gallery__diptyque-right" data-reveal="image-rise">
        <Image
          src={gal06}
          alt="Projet cœur urbain — terrasse de restaurant en fer forgé sous palmiers"
          widths={[640, 960, 1300]}
          sizes="(min-width: 1024px) 50vw, 96vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="cu-gallery__img"
        />
      </figure>
    </div>

    <div class="cu-gallery__diptyque cu-gallery__diptyque--bot">
      <figure class="cu-gallery__diptyque-left" data-reveal="image-rise">
        <Image
          src={gal07}
          alt="Projet cœur urbain — piscine bordée d'héliconia et d'un porche blanc"
          widths={[640, 960, 1300]}
          sizes="(min-width: 1024px) 54vw, 96vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="cu-gallery__img"
        />
      </figure>
      <figure class="cu-gallery__diptyque-right" data-reveal="image-rise">
        <Image
          src={gal08}
          alt="Projet cœur urbain — porche bois ouvrant sur un patio de briques végétalisé"
          widths={[480, 720, 1100]}
          sizes="(min-width: 1024px) 38vw, 92vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="cu-gallery__img"
        />
      </figure>
    </div>

    <figure class="cu-gallery__coda" data-reveal="image-rise">
      <Image
        src={gal09}
        alt="Projet cœur urbain — vue plongeante sur un érable jaune et orange au-dessus d'une table ronde"
        widths={[640, 960, 1300]}
        sizes="(min-width: 1024px) 62vw, 96vw"
        quality={92}
        format="webp"
        loading="lazy"
        class="cu-gallery__img"
      />
    </figure>
  </section>

  {/* ═════════ 3 · MANIFESTE typologie ════════════════════════════════════ */}
  <section
    id="manifeste"
    data-section-label="Manifeste"
    data-theme="dark"
    class="cu-manifeste bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="manifeste-title"
  >
    <div class="cu-manifeste__inner">
      <h2 id="manifeste-title" class="sr-only">La typologie cœur urbain</h2>
      <div
        class="cu-manifeste__body"
        data-words-fade
        data-words-fade-stagger="0.006"
        data-words-fade-window="0.05,0.5"
      >
        <p class="cu-manifeste__para">{manifeste.bloc1}</p>
        <p class="cu-manifeste__para">{manifeste.bloc2}</p>
      </div>
      <p class="cu-manifeste__precision">{manifeste.precision}</p>
    </div>
  </section>

  {/* ═════════ 4 · FAQ discrète ══════════════════════════════════════════ */}
  <section
    id="faq"
    data-section-label="FAQ"
    data-theme="dark"
    class="cu-faq bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="faq-title"
  >
    <div class="cu-faq__inner">
      <div class="cu-faq__head">
        <p class="cu-faq__eyebrow">Questions fréquentes</p>
        <h2 id="faq-title" class="cu-faq__title">Avant d'appeler.</h2>
      </div>
      <FaqAccordion items={faq} client:visible />
    </div>
  </section>

  {/* ═════════ 5 · CTA full-width « DECOUVRIR LES PROJETS COEUR URBAIN » ══ */}
  <section
    data-theme="dark"
    class="cu-cta bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="cta-title"
  >
    <a href="/realisations" class="cu-cta__link" data-cursor-label="VOIR">
      <h2
        id="cta-title"
        class="cu-cta__title"
        data-justify-multi
        data-justify-amp="50"
        data-justify-line-step="0.15"
        data-justify-line-window="0.55"
      >
        <span class="cu-cta__title-line" data-justify-line data-justify-direction="from-right">
          DECOUVRIR LES PROJETS COEUR URBAIN
        </span>
      </h2>
    </a>
    <a href="/demarrer-un-projet" class="cu-cta__pill-red" data-magnetic="0.2" data-cursor-skip>
      <span class="cu-cta__pill-dot" aria-hidden="true"></span>
      <span class="cu-cta__pill-label">Démarrer un projet</span>
      <img
        src="/brand/fleche-white.webp"
        alt=""
        aria-hidden="true"
        class="cu-cta__pill-arrow"
        width="32"
        height="32"
      />
    </a>
  </section>

  <style is:global>
    /* ═══════════════════════════════════════════════════════════════════════
     * /architecture-paysagere/coeur-urbain — copie structurelle micro-urbain.
     * Le hero est désormais factorisé dans `<TypologieHero>` (refactor
     * 2026-05-19). Galerie / manifeste / FAQ / CTA restent locaux (préfixe
     * `cu-`) car la galerie diverge par typologie (5 vs 6 photos, layouts
     * différents) ; le reste est candidat à un futur `<TypologieLayout>`
     * une fois que les 4 pages auront convergé.
     * ═══════════════════════════════════════════════════════════════════ */

    /* ─── 1 · Hero ── désormais géré par `<TypologieHero>` (composant
       partagé, refactor 2026-05-19). Plus de CSS hero ici. */

    /* ─── 2 · Galerie magazine ──────────────────────────────────────────── */
    .cu-gallery {
      width: 100%;
      padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 3vw, 2.5rem);
    }
    .cu-gallery__large {
      margin: 0;
      width: 100%;
      aspect-ratio: 3 / 2;
      overflow: hidden;
      background-color: var(--color-black-deep);
    }
    @media (min-width: 1024px) {
      .cu-gallery__large {
        aspect-ratio: 16 / 10;
      }
    }
    /* Diptyques — rythme magazine :
       - top : quinconce. Portrait gauche petit (38%) align-start, portrait
         droite grand (54%) align-end. Décalage vertical éditorial.
       - mid : 50/50 équilibré, sans quinconce (les deux photos se répondent
         en miroir).
       - bot : quinconce INVERSE (miroir vertical+horizontal du top).
         Portrait gauche grand (54%) align-start + portrait droite petit
         (38%) align-end. Crée une symétrie globale top↔bot. */
    .cu-gallery__diptyque {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(1.25rem, 3vw, 2.5rem);
    }
    @media (min-width: 768px) {
      .cu-gallery__diptyque--top {
        grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
        align-items: stretch;
      }
      .cu-gallery__diptyque--mid {
        grid-template-columns: 1fr 1fr;
        align-items: stretch;
      }
      .cu-gallery__diptyque--bot {
        grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr);
        align-items: stretch;
      }
    }
    .cu-gallery__diptyque-left,
    .cu-gallery__diptyque-right {
      margin: 0;
      overflow: hidden;
      background-color: var(--color-black-deep);
    }
    /* --top : petit-gauche / grand-droite */
    .cu-gallery__diptyque--top .cu-gallery__diptyque-left,
    .cu-gallery__diptyque--top .cu-gallery__diptyque-right {
      aspect-ratio: 4 / 5;
    }
    @media (min-width: 768px) {
      .cu-gallery__diptyque--top .cu-gallery__diptyque-left {
        aspect-ratio: 3 / 4;
        align-self: start;
        max-height: 78%;
      }
      .cu-gallery__diptyque--top .cu-gallery__diptyque-right {
        aspect-ratio: 4 / 5;
        align-self: end;
      }
    }
    /* --mid : 50/50 */
    .cu-gallery__diptyque--mid .cu-gallery__diptyque-left,
    .cu-gallery__diptyque--mid .cu-gallery__diptyque-right {
      aspect-ratio: 4 / 5;
    }
    @media (min-width: 768px) {
      .cu-gallery__diptyque--mid .cu-gallery__diptyque-left,
      .cu-gallery__diptyque--mid .cu-gallery__diptyque-right {
        aspect-ratio: 5 / 6;
      }
    }
    /* --bot : quinconce inverse (miroir du top) */
    .cu-gallery__diptyque--bot .cu-gallery__diptyque-left,
    .cu-gallery__diptyque--bot .cu-gallery__diptyque-right {
      aspect-ratio: 4 / 5;
    }
    @media (min-width: 768px) {
      .cu-gallery__diptyque--bot .cu-gallery__diptyque-left {
        aspect-ratio: 4 / 5;
        align-self: start;
      }
      .cu-gallery__diptyque--bot .cu-gallery__diptyque-right {
        aspect-ratio: 3 / 4;
        align-self: end;
        max-height: 78%;
      }
    }
    /* Coda — photo 09 portrait, centrée, signature chromatique de fin de
       galerie (l'érable jaune/orange tranche sur tout ce qui précède). */
    .cu-gallery__coda {
      margin: 0 auto;
      width: 100%;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      background-color: var(--color-black-deep);
    }
    @media (min-width: 1024px) {
      .cu-gallery__coda {
        max-width: 62%;
        aspect-ratio: 4 / 5;
      }
    }
    .cu-gallery__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    /* ─── 3 · Manifeste ─────────────────────────────────────────────────── */
    .cu-manifeste {
      width: 100%;
      padding: clamp(5rem, 10vw, 9rem) clamp(1.5rem, 5vw, 4rem);
    }
    .cu-manifeste__inner {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(2rem, 4vw, 3.5rem);
    }
    @media (min-width: 1024px) {
      .cu-manifeste__inner {
        grid-template-columns: 1fr 1.35fr;
        column-gap: clamp(3rem, 6vw, 5rem);
        align-items: start;
      }
      .cu-manifeste__body,
      .cu-manifeste__precision {
        grid-column: 2;
      }
    }
    .cu-manifeste__body {
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 2.2vw, 1.85rem);
    }
    .cu-manifeste__para {
      font-family: var(--font-body), sans-serif;
      font-weight: 400;
      font-size: clamp(1.2rem, 1.65vw, 1.65rem);
      line-height: 1.45;
      letter-spacing: -0.005em;
      color: var(--color-cream);
      margin: 0;
    }
    .cu-manifeste__body .word {
      display: inline-block;
      opacity: 0;
      transform: translateY(10px);
      will-change: opacity, transform;
    }
    .cu-manifeste__precision {
      font-family: var(--font-body), sans-serif;
      font-weight: 300;
      font-size: clamp(0.85rem, 0.95vw, 0.95rem);
      line-height: 1.6;
      color: color-mix(in oklab, var(--color-cream) 80%, transparent);
      text-align: left;
      margin: clamp(2.5rem, 4.5vw, 4rem) 0 0;
    }

    /* ─── 4 · FAQ discrète ──────────────────────────────────────────────── */
    .cu-faq {
      width: 100%;
      padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
      border-top: 1px solid color-mix(in oklab, var(--color-cream) 14%, transparent);
    }
    .cu-faq__inner {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }
    @media (min-width: 1024px) {
      .cu-faq__inner {
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr);
        column-gap: clamp(3rem, 6vw, 5rem);
        align-items: start;
      }
    }
    .cu-faq__head {
      display: flex;
      flex-direction: column;
      gap: clamp(0.4rem, 0.8vw, 0.7rem);
    }
    .cu-faq__eyebrow {
      font-family: var(--font-mono), monospace;
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: color-mix(in oklab, var(--color-cream) 55%, transparent);
      margin: 0;
    }
    .cu-faq__title {
      font-family: var(--font-heading), sans-serif;
      font-weight: 200;
      font-size: clamp(1.8rem, 3.5vw, 3rem);
      line-height: 1.05;
      letter-spacing: -0.01em;
      color: var(--color-cream);
      margin: 0;
    }
    @media (min-width: 1024px) {
      .cu-faq__inner .faq-acc__list {
        grid-column: 2;
      }
    }

    /* ─── 5 · CTA full-width « DECOUVRIR LES PROJETS COEUR URBAIN » ─────── */
    .cu-cta {
      width: 100%;
      padding: clamp(4rem, 8vw, 7rem) 0 clamp(4rem, 8vw, 7rem);
      border-top: 1px solid color-mix(in oklab, var(--color-cream) 18%, transparent);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(2rem, 4vw, 3rem);
    }
    .cu-cta__link {
      display: block;
      width: 100%;
      padding: 0 clamp(1.5rem, 5vw, 4rem);
      text-decoration: none;
      color: inherit;
    }
    .cu-cta__title {
      width: 100%;
      margin: 0;
    }
    .cu-cta__title-line {
      display: block;
      width: 100%;
      font-family: var(--font-heading), sans-serif;
      font-weight: 200;
      font-size: clamp(1.4rem, 5.5vw, 5rem);
      line-height: 1.1;
      letter-spacing: 0;
      text-transform: uppercase;
      text-align: justify;
      text-align-last: justify;
      color: var(--color-cream);
      margin: 0;
      hyphens: none;
      white-space: nowrap;
      overflow: hidden;
    }
    @media (max-width: 767px) {
      .cu-cta__title-line {
        white-space: normal;
        text-align: left;
        text-align-last: left;
      }
    }
    .cu-cta__pill-red {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
