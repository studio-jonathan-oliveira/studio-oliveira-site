---
/*
 * /architecture-paysagere — page pilier business (PDF l.708-709 PRIORITÉ ABSOLUE).
 *
 * Refonte DA 2026-05-19 (Morgan) : alignement total avec la nouvelle DA
 * insufflée sur /studio + les 4 pages typologies (micro/cœur/frange/domaine).
 * Pattern noir + cream + accent rouge, Inter ExtraLight UPPERCASE pour les
 * titres, FaqAccordion partagé pour la cohérence des FAQ.
 *
 * Structure validée Morgan 2026-05-19 :
 *   1. Hero plein-bleed photo + H1 split « ARCHITECTURE / PAYSAGÈRE »
 *   2. Manifeste court (col droite, structure typologies)
 *   3. 5 typologies en grid asymétrique cards cliquables — la 5e
 *      (architecture publique) est en mode « Prochainement » car la
 *      page est en cours de repensée par Jonathan (cf. mémoire
 *      project_oliveira_architecture_publique_orientation)
 *   4. Process 3 étapes (étude préliminaire / étude projet / suivi chantier)
 *   5. FAQ étoffée via <FaqAccordion> partagé
 *   6. CTA final pill rouge
 *
 * Voix éditoriale §2 cahier : retenue, zéro pub. Contenu sourcé du PDF
 * Jonathan + brief existant. Pas de contenu inventé (rule CLAUDE.md §5).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import FaqAccordion from '@/components/islands/FaqAccordion';
import { SITE } from '@/lib/site-config';
import { isDraft } from '@/lib/drafts';
import {
  jsonLdGraph,
  breadcrumbs,
  localBusiness,
  organization,
  service,
  faqPage,
} from '@/lib/schema-org';

// Hero — visuel biophilie déjà utilisé sur la home, cohérent visuellement.
import heroPhoto from '@/assets/home/hero-biophilie.jpg';

// 5 visuels typologies (cards) — webp optimisés existants.
import typoMicroUrbain from '@/assets/typologies/micro-urbain.webp';
import typoCoeurUrbain from '@/assets/typologies/coeur-urbain.webp';
import typoFrangeUrbaine from '@/assets/typologies/frange-urbaine.webp';
import typoDomaineCaractere from '@/assets/typologies/domaine-caractere.webp';
import typoArchitecturePublique from '@/assets/typologies/architecture-publique.webp';

// Tableau enrichi des 5 typologies à afficher en grid. On reprend
// SITE.typologies (4 jardins) + on ajoute architecture-publique en 5e
// avec son flag `bientot` pour le styliser distinctement.
interface TypoCard {
  slug: string;
  nom: string;
  exemple: string;
  image: ImageMetadata;
  bientot?: boolean;
}

const typologies: TypoCard[] = [
  ...SITE.typologies.map((t) => {
    const map: Record<string, ImageMetadata> = {
      'micro-urbain': typoMicroUrbain,
      'coeur-urbain': typoCoeurUrbain,
      'frange-urbaine': typoFrangeUrbaine,
      'domaine-caractere': typoDomaineCaractere,
    };
    return {
      slug: t.slug,
      nom: t.nomProprietaire,
      exemple: t.exemple,
      image: map[t.slug]!,
    };
  }),
  {
    slug: 'architecture-publique',
    nom: 'Architecture publique',
    exemple: 'Marché public, génie végétal, design biophilique',
    image: typoArchitecturePublique,
    bientot: true,
  },
];

// FAQ — questions clé de la page pilier (sourcées PDF Jonathan + audit UX).
// Les items draft sont filtrés en prod via isDraft().
const pageFaqAll = [
  {
    question: "Qu'est-ce qu'une typologie de jardin ?",
    answer:
      "Une typologie désigne un contexte d'intervention — micro-urbain, cœur de ville, frange péri-urbaine, domaine de caractère. Chaque typologie a ses contraintes techniques, réglementaires et son niveau d'étude dédié.",
  },
  {
    question: "Pourquoi facturer une étude alors que beaucoup de paysagistes l'offrent ?",
    answer:
      "Parce que c'est le cœur du métier. L'étude comprend le plan masse, les plans de plantations, le DCE, la mise en concurrence des entreprises et le suivi de chantier. Le chiffrage travaux vient ensuite, précisément.",
  },
  {
    question: 'Vous réalisez les travaux vous-mêmes ?',
    answer:
      'Non. Je conçois et je coordonne — je sélectionne et je pilote des entreprises mises en concurrence sur chaque lot (terrassement, maçonnerie paysagère, arrosage, éclairage, plantations).',
  },
  {
    question: "Quel est le délai moyen d'une étude complète ?",
    answer:
      'De 2,5 jours-homme pour un micro-urbain à 12 jours pour un domaine — soit 6 à 14 semaines calendaires selon la complexité et la disponibilité des intervenants.',
  },
  {
    question: "En quoi un designer paysagiste diffère-t-il d'un paysagiste classique ?",
    answer:
      "[À FOURNIR PAR JONATHAN : 120-180 mots. Angle suggéré : positionnement studio de design (concepteur) vs artisan exécutant, rôle d'architecte coordinateur, priorité à la vision biophilique avant le catalogue végétal.]",
  },
  {
    question: "Le design biophilique, c'est du greenwashing ?",
    answer:
      '[À FOURNIR PAR JONATHAN : 100-150 mots. Angle suggéré : référence aux 14 principes Browning-Ryan-Clancy, littérature scientifique, distinction avec la simple décoration végétale.]',
  },
  {
    question:
      'Vous êtes basé à Brive mais vous intervenez à Bordeaux et Limoges — comment ça marche ?',
    answer:
      '[À FOURNIR PAR JONATHAN : 80-120 mots. Angle suggéré : modalités de déplacement, fréquence des visites sur site, outils collaboratifs à distance, planification pour optimiser les allers-retours.]',
  },
];
const pageFaq = pageFaqAll.filter((f) => !isDraft(f.answer));

const schema = jsonLdGraph([
  organization(),
  localBusiness(),
  service({
    name: 'Architecture paysagère sur mesure',
    slug: '',
    description:
      'Studio de design biophilique à Brive-la-Gaillarde. Études préliminaires, conception, DCE et suivi de chantier pour 4 typologies de jardin.',
    priceRangeMin: 1200,
    priceRangeMax: 6500,
  }),
  faqPage(pageFaq),
  breadcrumbs([
    { name: 'Accueil', item: '/' },
    { name: 'Architecture paysagère', item: '/architecture-paysagere' },
  ]),
]);
---

<BaseLayout
  title="Architecture paysagère — jardins sur mesure en Aquitaine"
  description="Designer paysagiste à Brive. Conception de jardins biophiliques sur mesure pour particuliers et professionnels en Aquitaine et Limousin."
  darkHero
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={schema} />
  </Fragment>

  {/* ═════════ 1 · HERO — photo plein-bleed + H1 split « ARCHITECTURE / PAYSAGÈRE » */}
  <section
    id="hero"
    data-section-label="Architecture paysagère"
    data-theme="dark"
    class="ap-hero relative overflow-hidden bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="hero-title"
  >
    <div class="ap-hero__media">
      <Image
        src={heroPhoto}
        alt="Studio de design paysager biophilique — Brive-la-Gaillarde"
        widths={[960, 1440, 1920, 2560]}
        sizes="100vw"
        quality={92}
        format="webp"
        loading="eager"
        class="ap-hero__img"
      />
      <div class="ap-hero__veil" aria-hidden="true"></div>
    </div>

    <div class="ap-hero__overlay">
      <h1 id="hero-title" class="ap-hero__title">
        <span class="ap-hero__title-line">ARCHITECTURE</span>
        <span class="ap-hero__title-line">PAYSAGÈRE</span>
      </h1>
      <p class="ap-hero__lead">
        Je conçois, je ne réalise pas. Le studio pense le projet, consulte les artisans, coordonne
        le chantier — sans jamais être juge et partie.
      </p>
    </div>
  </section>

  {/* ═════════ 2 · MANIFESTE — col droite, structure typologies ═══════════ */}
  <section
    id="manifeste"
    data-section-label="Démarche"
    data-theme="dark"
    class="ap-manifeste bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="manifeste-title"
  >
    <div class="ap-manifeste__inner">
      <h2 id="manifeste-title" class="sr-only">Démarche du studio</h2>
      <div
        class="ap-manifeste__body"
        data-words-fade
        data-words-fade-stagger="0.006"
        data-words-fade-window="0.05,0.5"
      >
        <p class="ap-manifeste__para">
          Chaque lieu a son <em>territoire</em>, ses contraintes, son niveau d'étude.
        </p>
        <p class="ap-manifeste__para">
          La méthode, elle, reste la même — <span class="ap-manifeste__accent"
            >biophilique, rigoureuse, sensible</span
          >.
        </p>
      </div>
      <p class="ap-manifeste__precision">
        Cinq typologies, un même process en trois étapes (étude préliminaire, étude projet, suivi de
        chantier). L'étude est rémunérée — c'est elle qui garantit la qualité du dessin et
        l'indépendance vis-à-vis des entreprises.
      </p>
    </div>
  </section>

  {/* ═════════ 3 · 5 TYPOLOGIES — grid cards cliquables ══════════════════ */}
  <section
    id="typologies"
    data-section-label="Typologies"
    data-theme="dark"
    class="ap-typos bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="typos-title"
  >
    <div class="ap-typos__header">
      <p class="ap-typos__eyebrow">Les cinq typologies</p>
      <h2 id="typos-title" class="ap-typos__title">Chaque jardin a son territoire.</h2>
    </div>

    {
      /* Grid asymétrique : 5 cards, layout 2-col desktop avec card grande
         pour la 1re et la 5e. Ordre :
            ┌──────┐ ┌──┐
            │  01  │ │02│
            └──────┘ ├──┤
            ┌──┐ ┌──┤03│
            │04│ │05│
            └──┘ └──┘
         Mobile : empilé en colonne. Architecture publique (5e, bientôt)
         a un style distinct (badge + opacité légère). */
    }
    <ul class="ap-typos__grid" data-typo-cards>
      {
        typologies.map((t, i) => (
          <li class={`ap-typos__card ap-typos__card--${i + 1}${t.bientot ? ' is-bientot' : ''}`}>
            <a
              href={`/architecture-paysagere/${t.slug}`}
              class="ap-typos__link"
              aria-label={`Découvrir la typologie ${t.nom}`}
            >
              <div class="ap-typos__visual">
                <Image
                  src={t.image}
                  alt={`Typologie ${t.nom} — ${t.exemple}`}
                  widths={[480, 720, 960, 1280]}
                  sizes="(min-width: 1024px) 44vw, 92vw"
                  quality={86}
                  format="webp"
                  class="ap-typos__img"
                  loading={i < 2 ? 'eager' : 'lazy'}
                />
                <div class="ap-typos__veil" aria-hidden="true" />
                {t.bientot && (
                  <span class="ap-typos__badge" aria-hidden="true">
                    Prochainement
                  </span>
                )}
              </div>
              <div class="ap-typos__copy">
                <span class="ap-typos__num">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="ap-typos__name">{t.nom}</h3>
                <p class="ap-typos__tagline">{t.exemple}</p>
                <span class="ap-typos__cta" aria-hidden="true">
                  Explorer
                  <span class="ap-typos__arrow">→</span>
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* ═════════ 4 · PROCESS 3 ÉTAPES ══════════════════════════════════════ */}
  <section
    id="process"
    data-section-label="Process"
    data-theme="dark"
    class="ap-process bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="process-title"
  >
    <div class="ap-process__inner">
      <div class="ap-process__header">
        <p class="ap-process__eyebrow">Le process</p>
        <h2 id="process-title" class="ap-process__title">Deux études, un suivi.</h2>
      </div>

      <ol class="ap-process__list">
        <li class="ap-process__item">
          <span class="ap-process__step">Étape 1</span>
          <h3 class="ap-process__step-title">Étude préliminaire</h3>
          <p class="ap-process__step-text">
            Contextualisation, diagnostic de site, analyse réglementaire, synthèse graphique,
            fourchette budgétaire. Durée calibrée selon la typologie.
          </p>
        </li>
        <li class="ap-process__item">
          <span class="ap-process__step">Étape 2</span>
          <h3 class="ap-process__step-title">Étude projet</h3>
          <p class="ap-process__step-text">
            Conception approfondie, plan masse, plans d'exécution, palettes végétales et matériaux,
            DCE, budgétisation détaillée.
          </p>
        </li>
        <li class="ap-process__item">
          <span class="ap-process__step">Étape 3</span>
          <h3 class="ap-process__step-title">Suivi de chantier</h3>
          <p class="ap-process__step-text">
            Coordination des artisans mis en concurrence, pilotage du planning, réunions de
            chantier, respect des intentions de projet jusqu'à la réception. Rémunération de 6 à 12
            % des travaux selon la typologie.
          </p>
        </li>
      </ol>
    </div>
  </section>

  {/* ═════════ 5 · FAQ via <FaqAccordion> partagé ═══════════════════════ */}
  <section
    id="faq"
    data-section-label="FAQ"
    data-theme="dark"
    class="ap-faq bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="faq-title"
  >
    <div class="ap-faq__inner">
      <p class="ap-faq__eyebrow">Questions fréquentes</p>
      <h2 id="faq-title" class="ap-faq__title">Avant d'appeler.</h2>
      <FaqAccordion items={pageFaq} client:visible />
    </div>
  </section>

  {/* ═════════ 6 · CTA final — pill rouge ═══════════════════════════════ */}
  <section
    data-theme="dark"
    class="ap-cta bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="cta-title"
  >
    <a href="/demarrer-un-projet" class="ap-cta__link" data-cursor-label="DÉMARRER">
      <h2
        id="cta-title"
        class="ap-cta__title"
        data-justify-multi
        data-justify-amp="50"
        data-justify-line-step="0.15"
        data-justify-line-window="0.55"
      >
        <span class="ap-cta__title-line" data-justify-line data-justify-direction="from-right">
          VOTRE JARDIN EST UNE ARCHITECTURE
        </span>
      </h2>
    </a>
    <a href="/demarrer-un-projet" class="ap-cta__pill-red" data-magnetic="0.2" data-cursor-skip>
      <span class="ap-cta__pill-dot" aria-hidden="true"></span>
      <span class="ap-cta__pill-label">Démarrer un projet</span>
      <img
        src="/brand/fleche-white.webp"
        alt=""
        aria-hidden="true"
        class="ap-cta__pill-arrow"
        width="32"
        height="32"
      />
    </a>
  </section>

  <style is:global>
    /* ═══════════════════════════════════════════════════════════════════════
     * /architecture-paysagere — page pilier, DA noir + cream + accent rouge.
     * Réutilise les patterns établis sur les 4 typologies + /studio :
     *   - Hero plein-bleed + voile gradient haut
     *   - H1 split Inter ExtraLight 200 UPPERCASE
     *   - Manifeste décalé col droite avec accent rouge
     *   - Cards cliquables avec hover scale image + arrow translate
     *   - FAQ via <FaqAccordion> partagé (CSS .faq-acc__* dans global.css)
     *   - CTA final pill rouge
     * ═══════════════════════════════════════════════════════════════════ */

    /* ─── 1 · Hero ─────────────────────────────────────────────────────── */
    .ap-hero {
      position: relative;
      width: 100%;
      min-height: 100svh;
      isolation: isolate;
    }
    .ap-hero__media {
      position: absolute;
      inset: 0;
      overflow: hidden;
    }
    .ap-hero__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }
    .ap-hero__veil {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        color-mix(in oklab, var(--color-black-deep) 70%, transparent) 0%,
        color-mix(in oklab, var(--color-black-deep) 30%, transparent) 30%,
        transparent 55%,
        color-mix(in oklab, var(--color-black-deep) 55%, transparent) 100%
      );
      pointer-events: none;
    }
    .ap-hero__overlay {
      position: relative;
      z-index: 1;
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      gap: clamp(1.5rem, 3vw, 2.5rem);
      padding: clamp(5.5rem, 12vh, 8rem) clamp(1.5rem, 5vw, 4rem) clamp(4rem, 8vh, 6rem);
    }
    .ap-hero__title {
      font-family: var(--font-heading), sans-serif;
      font-weight: 200;
      font-size: clamp(2.4rem, 8.5vw, 7.5rem);
      line-height: 0.95;
      letter-spacing: -0.005em;
      text-transform: uppercase;
      color: var(--color-cream);
      margin: 0;
      max-width: none;
    }
    .ap-hero__title-line {
      display: block;
    }
    .ap-hero__lead {
      font-family: var(--font-body), sans-serif;
      font-weight: 300;
      font-size: clamp(1rem, 1.25vw, 1.25rem);
      line-height: 1.55;
      color: color-mix(in oklab, var(--color-cream) 90%, transparent);
      margin: 0;
      max-width: 38ch;
    }

    /* ─── 2 · Manifeste ────────────────────────────────────────────────── */
    .ap-manifeste {
      width: 100%;
      padding: clamp(5rem, 10vw, 9rem) clamp(1.5rem, 5vw, 4rem);
    }
    .ap-manifeste__inner {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(2rem, 4vw, 3.5rem);
    }
    @media (min-width: 1024px) {
      .ap-manifeste__inner {
        grid-template-columns: 1fr 1.35fr;
        column-gap: clamp(3rem, 6vw, 5rem);
        align-items: start;
      }
      .ap-manifeste__body,
      .ap-manifeste__precision {
        grid-column: 2;
      }
    }
    .ap-manifeste__body {
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 2.2vw, 1.85rem);
    }
    .ap-manifeste__para {
      font-family: var(--font-body), sans-serif;
      font-weight: 400;
      font-size: clamp(1.2rem, 1.65vw, 1.65rem);
      line-height: 1.45;
      letter-spacing: -0.005em;
      color: var(--color-cream);
      margin: 0;
    }
    .ap-manifeste__para em {
      font-style: italic;
      color: color-mix(in oklab, var(--color-cream) 70%, transparent);
    }
    /* Accent rouge sur les 3 adjectifs « biophilique, rigoureuse, sensible » —
       signature DA accent (cf. home + typologies). */
    .ap-manifeste__accent {
      color: var(--color-red);
      font-style: italic;
    }
    .ap-manifeste__body .word {
      display: inline-block;
      opacity: 0;
      transform: translateY(10px);
      will-change: opacity, transform;
    }
    .ap-manifeste__precision {
      font-family: var(--font-body), sans-serif;
      font-weight: 300;
      font-size: clamp(0.9rem, 1vw, 1.05rem);
      line-height: 1.6;
      color: color-mix(in oklab, var(--color-cream) 80%, transparent);
      text-align: left;
      margin: clamp(2.5rem, 4.5vw, 4rem) 0 0;
      max-width: 60ch;
    }

    /* ─── 3 · 5 typologies grid ────────────────────────────────────────── */
    .ap-typos {
      width: 100%;
      padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem) clamp(5rem, 10vw, 8rem);
      border-top: 1px solid color-mix(in oklab, var(--color-cream) 14%, transparent);
    }
    .ap-typos__header {
      max-width: 60ch;
      margin: 0 0 clamp(3rem, 6vw, 5rem);
    }
    .ap-typos__eyebrow {
      font-family: var(--font-mono), monospace;
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: color-mix(in oklab, var(--color-cream) 55%, transparent);
      margin: 0;
    }
    .ap-typos__title {
      font-family: var(--font-heading), sans-serif;
      font-weight: 200;
      font-size: clamp(1.8rem, 3.5vw, 3rem);
      line-height: 1.05;
      letter-spacing: -0.01em;
      color: var(--color-cream);
      margin: clamp(0.5rem, 1vw, 0.85rem) 0 0;
    }
    /* Grid : empilé en colonne sur mobile, asymétrique 5-cards sur desktop.
       Layout signature designbyad — pas un grid 2x2 fade carré ennuyeux. */
    .ap-typos__grid {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }
    @media (min-width: 1024px) {
      /* 12 colonnes virtuelles, layout 5 cards en mosaïque :
           card 1 (large gauche, span 7)  | card 2 (portrait droit, span 5)
           card 3 (portrait gauche, span 5) | card 4 (large droit, span 7)
           card 5 (full-width architecture publique, span 12) */
      .ap-typos__grid {
        grid-template-columns: repeat(12, 1fr);
        gap: clamp(1.5rem, 2.5vw, 2.5rem);
      }
      .ap-typos__card--1 {
        grid-column: span 7;
      }
      .ap-typos__card--2 {
        grid-column: span 5;
      }
      .ap-typos__card--3 {
        grid-column: span 5;
      }
      .ap-typos__card--4 {
        grid-column: span 7;
      }
      .ap-typos__card--5 {
        grid-column: span 12;
      }
    }
    .ap-typos__card {
      position: relative;
      overflow: hidden;
      isolation: isolate;
    }
    .ap-typos__link {
      display: block;
      color: inherit;
      text-decoration: none;
      height: 100%;
    }
    .ap-typos__visual {
      position: relative;
      width: 100%;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background-color: var(--color-black-deep);
    }
    @media (min-width: 1024px) {
      /* Variations de ratio par tile pour rythme magazine. */
      .ap-typos__card--1 .ap-typos__visual,
      .ap-typos__card--4 .ap-typos__visual {
        aspect-ratio: 4 / 3;
      }
      .ap-typos__card--2 .ap-typos__visual,
      .ap-typos__card--3 .ap-typos__visual {
        aspect-ratio: 3 / 4;
      }
      .ap-typos__card--5 .ap-typos__visual {
        aspect-ratio: 21 / 9;
      }
    }
    .ap-typos__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
