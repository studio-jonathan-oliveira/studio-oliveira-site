---
/*
 * /architecture-paysagere — page pilier business (PDF l.708-709 PRIORITÉ ABSOLUE).
 *
 * Refonte style Polestar (PDF l.775-777 + audit DA 2026-04-23) :
 *   Hero immersif → manifeste court → 5 chapitres thématiques scroll-zoom
 *   (Végétal, Matières, Textures, Luminaires, Modèles biophiliques) →
 *   grille 4 typologies → process 3 étapes → FAQ étoffée → CTA final.
 *
 * Voix éditoriale §2 cahier : retenue, zéro pub, zéro « aucun engagement ».
 * Contenu sourcé PDF Jonathan. Images thèmes = [À FOURNIR PAR JONATHAN],
 * placeholders visuels avec assets existants typologies.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/astro/Section.astro';
import CtaLink from '@/components/astro/CtaLink.astro';
import { Image } from 'astro:assets';
import { SITE } from '@/lib/site-config';
import {
  jsonLdGraph,
  breadcrumbs,
  localBusiness,
  organization,
  service,
  faqPage,
} from '@/lib/schema-org';

// Assets existants — placeholders visuels en attendant images dédiées Jonathan
import visuelVegetal from '@/assets/typologies/frange-urbaine.webp';
import visuelMatieres from '@/assets/typologies/domaine-caractere.webp';
import visuelTextures from '@/assets/typologies/coeur-urbain.webp';
import visuelLuminaires from '@/assets/typologies/micro-urbain.webp';
import visuelBiophilie from '@/assets/home/hero-biophilie.jpg';

// Mapping typologie.slug → image pour les cards (enrichit visuel section 02)
import typoMicroUrbain from '@/assets/typologies/micro-urbain.webp';
import typoCoeurUrbain from '@/assets/typologies/coeur-urbain.webp';
import typoFrangeUrbaine from '@/assets/typologies/frange-urbaine.webp';
import typoDomaineCaractere from '@/assets/typologies/domaine-caractere.webp';

// Image full-bleed de respiration entre typologies et process (Morgan
// 2026-04-27 : « grand espace vide, faut une image »). Projet livré en
// nocturne, bonne respiration éditoriale.
import respirationProcess from '@/assets/projets/coeur-urbain-parenthese/02.webp';

// On construit un tableau enrichi avec les images explicitement associées
// (pattern plus sûr qu'un Record<string, ImageMetadata> pour <Image> Astro
// qui peut rater les imports dynamiques au build).
const typoImageMap: Record<string, ImageMetadata> = {
  'micro-urbain': typoMicroUrbain,
  'coeur-urbain': typoCoeurUrbain,
  'frange-urbaine': typoFrangeUrbaine,
  'domaine-caractere': typoDomaineCaractere,
};

const typologies = SITE.typologies;

// 5 chapitres thématiques — titres et copy issus de la démarche Jonathan
// (cahier §2, PDF « démarche biophilique »).
const chapitres = [
  {
    num: '01',
    titre: 'Végétal',
    accroche: 'Le vivant comme matériau premier.',
    phrase:
      "Chaque essence est choisie pour son comportement dans le lieu — exposition, sol, climat, biodiversité locale. Pas de catalogue, pas d'essence importée pour l'effet.",
    image: visuelVegetal,
    imageNote:
      '[À FOURNIR PAR JONATHAN : image macro végétal — feuillage détail, port d\'une plante, texture de feuille. Placeholder actuel = typologie "frange-urbaine".]',
  },
  {
    num: '02',
    titre: 'Matières',
    accroche: 'Ce qui dure, ce qui patine.',
    phrase:
      "Pierre locale, bois non-traité, métal brut. Le jardin vieillit bien parce qu'il est fait de matériaux qui prennent le temps avec grâce.",
    image: visuelMatieres,
    imageNote:
      '[À FOURNIR PAR JONATHAN : image macro matière — pierre taillée, bois brut, acier corten, gravier. Placeholder actuel = typologie "domaine-caractere".]',
  },
  {
    num: '03',
    titre: 'Textures',
    accroche: 'La peau du lieu.',
    phrase:
      'Mousse sur la pierre, herbe rase entre les pas japonais, corten rouillé, bois érodé. Les textures racontent le passage du temps et ancrent le jardin dans son territoire.',
    image: visuelTextures,
    imageNote:
      '[À FOURNIR PAR JONATHAN : image macro texture — détails tactiles, proximité sensorielle. Placeholder = typologie "coeur-urbain".]',
  },
  {
    num: '04',
    titre: 'Luminaires',
    accroche: 'La nuit révèle le dessin.',
    phrase:
      "L'éclairage architectural n'est pas un add-on. Il prolonge l'usage, sculpte les volumes, met les essences en valeur à la tombée du jour. Étudié avec le dessin, pas après.",
    image: visuelLuminaires,
    imageNote:
      '[À FOURNIR PAR JONATHAN : image nocturne — jardin ou terrasse éclairée, luminaire détail. Placeholder = typologie "micro-urbain".]',
  },
  {
    num: '05',
    titre: 'Modèles biophiliques',
    accroche: 'Les 14 principes Browning, Ryan, Clancy.',
    phrase:
      "Le design biophilique s'appuie sur 14 principes scientifiques documentés — connexion sensorielle, refuges, prospect, mystère, transitoire. Chaque projet active ceux qui servent le lieu.",
    image: visuelBiophilie,
    imageNote:
      '[À FOURNIR PAR JONATHAN : visuel conceptuel sur les 14 principes ou liste animée. Placeholder = image hero biophilie.]',
  },
];

// FAQ étoffée — questions existantes (sourcées PDF) + questions d'objection
// (audit UX 2026-04-23 §4) en placeholder copie Jonathan.
const pageFaq = [
  {
    question: "Qu'est-ce qu'une typologie de jardin ?",
    answer:
      "Une typologie désigne un contexte d'intervention — micro-urbain, cœur de ville, frange péri-urbaine, domaine de caractère. Chaque typologie a ses contraintes techniques, réglementaires et son niveau d'étude dédié.",
  },
  {
    question: "Pourquoi facturer une étude alors que beaucoup de paysagistes l'offrent ?",
    answer:
      "Parce que c'est le cœur du métier. L'étude comprend le plan masse, les plans de plantations, le DCE, la mise en concurrence des entreprises et le suivi de chantier. Le chiffrage travaux vient ensuite, précisément.",
  },
  {
    question: 'Vous réalisez les travaux vous-mêmes ?',
    answer:
      'Non. Je conçois et je coordonne — je sélectionne et je pilote des entreprises mises en concurrence sur chaque lot (terrassement, maçonnerie paysagère, arrosage, éclairage, plantations).',
  },
  {
    question: "Quel est le délai moyen d'une étude complète ?",
    answer:
      'De 2,5 jours-homme pour un micro-urbain à 12 jours pour un domaine — soit 6 à 14 semaines calendaires selon la complexité et la disponibilité des intervenants.',
  },
  {
    question: "En quoi un designer paysagiste diffère-t-il d'un paysagiste classique ?",
    answer:
      "[À FOURNIR PAR JONATHAN : 120-180 mots. Angle suggéré : positionnement studio de design (concepteur) vs artisan exécutant, rôle d'architecte coordinateur, priorité à la vision biophilique avant le catalogue végétal.]",
  },
  {
    question: "Le design biophilique, c'est du greenwashing ?",
    answer:
      '[À FOURNIR PAR JONATHAN : 100-150 mots. Angle suggéré : référence aux 14 principes Browning-Ryan-Clancy, littérature scientifique, distinction avec la simple décoration végétale.]',
  },
  {
    question:
      'Vous êtes basé à Brive mais vous intervenez à Bordeaux et Limoges — comment ça marche ?',
    answer:
      '[À FOURNIR PAR JONATHAN : 80-120 mots. Angle suggéré : modalités de déplacement, fréquence des visites sur site, outils collaboratifs à distance, planification pour optimiser les allers-retours.]',
  },
  {
    question: 'Peut-on voir un projet réalisé avant de commencer ?',
    answer:
      '[À FOURNIR PAR JONATHAN : 80-120 mots. Angle suggéré : visite de projets livrés sur demande qualifiée, portfolio Twinmotion accessible, études de cas en journal.]',
  },
];

const schema = jsonLdGraph([
  organization(),
  localBusiness(),
  service({
    name: 'Architecture paysagère sur mesure',
    slug: '',
    description:
      'Studio de design biophilique à Brive‑la‑Gaillarde. Études préliminaires, conception, DCE et suivi de chantier pour 4 typologies de jardin.',
    priceRangeMin: 1200,
    priceRangeMax: 6500,
  }),
  faqPage(pageFaq),
  breadcrumbs([
    { name: 'Accueil', item: '/' },
    { name: 'Architecture paysagère', item: '/architecture-paysagere' },
  ]),
]);
---

<BaseLayout
  title="Architecture paysagère sur mesure"
  description="Studio de design biophilique. Quatre typologies de jardin — micro-urbain, cœur urbain, frange péri-urbaine, domaine. Étude préliminaire, conception, DCE, suivi de chantier."
  darkHero
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={schema} />
  </Fragment>

  {/* ───── HERO IMMERSIF FOREST — pleine page éditoriale ───── */}
  <section
    id="hero"
    data-section-label="Architecture paysagère"
    data-theme="light"
    class="ap-hero relative isolate overflow-hidden bg-[var(--color-cream)] text-[var(--color-ink)]"
  >
    <div class="absolute inset-0 -z-10">
      <Image
        src={visuelBiophilie}
        alt=""
        widths={[960, 1440, 1920, 2560]}
        sizes="100vw"
        quality={80}
        format="webp"
        class="ap-hero-image h-full w-full object-cover object-center"
        loading="eager"
        data-hero-zoom
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-[var(--color-forest)]/95 via-[var(--color-forest)]/40 to-transparent"
        aria-hidden="true"
      >
      </div>
    </div>

    <div class="relative flex min-h-[100svh] flex-col justify-end">
      <div
        class="mx-auto w-full max-w-[1400px] px-6 pt-40 pb-24 md:px-10 md:pt-48 md:pb-32"
        data-scroll-rise
        data-scroll-rise-amp="-90"
      >
        <p class="font-mono text-[11px] tracking-[0.26em] text-[var(--color-ink)]/70 uppercase">
          <span class="text-[var(--color-ink)]/40">Studio</span>
          &nbsp;·&nbsp; Architecture paysagère
        </p>
        {
          /* H1 cassé designbyad (Morgan 2026-04-27) : ARCHITECTURE PAYSAGÈRE
            CAPS Jost monumentales + "sur mesure." italic Cormorant laterite
            en contrepoint. Asymétrie typo qui signe la voix du studio. */
        }
        <h1
          data-mask-reveal
          data-mask-stagger="0.14"
          class="ap-h1-broken mt-8 font-[family-name:var(--font-heading)] leading-[0.94] tracking-tight"
        >
          <span data-mask-line class="ap-h1-positioning block">ARCHITECTURE PAYSAGÈRE</span>
          <span data-mask-line class="block text-[var(--color-ink)]/55 italic"> sur mesure. </span>
        </h1>
        <p
          data-reveal="up"
          data-reveal-delay="0.4"
          class="mt-10 max-w-xl text-[length:var(--text-lg)] leading-relaxed text-[var(--color-ink)]/85"
        >
          Je conçois, je ne réalise pas. Le studio pense le projet, consulte les artisans, coordonne
          le chantier — sans jamais être juge et partie.
        </p>
      </div>
    </div>
  </section>

  {/* ───── MANIFESTE — court, éditorial, en cream ───── */}
  <Section variant="forest" tight>
    <div class="mx-auto max-w-3xl py-20 md:py-32" data-reveal="up">
      <p class="font-mono text-[11px] tracking-[0.26em] text-[var(--color-ink)]/55 uppercase">
        <span class="text-[var(--color-ink)]/40">02</span> &nbsp;·&nbsp; Démarche
      </p>
      <p
        class="mt-8 font-[family-name:var(--font-heading)] text-[length:var(--text-3xl)] leading-[1.18] text-[var(--color-ink)] md:text-[length:var(--text-4xl)]"
      >
        Chaque lieu a son <em class="text-[var(--color-ink)]/55 italic">territoire</em>, ses
        contraintes, son niveau d'étude. La méthode, elle, reste la même —
        <em class="italic">biophilique, rigoureuse, sensible</em>.
      </p>
    </div>

    {
      /* Bande keywords designbyad — mots-clés CAPS justify-scroll. Mots issus
        du process Jonathan déjà présents plus bas dans la page (étapes 1/2/3
        + déclinaisons). Pattern signature du studio. */
    }
    <p
      class="ap-keywords-band mx-auto mt-10 max-w-[1500px] px-6 pb-20 md:px-10 md:pb-28"
      data-reveal="up"
      data-justify-scroll
      data-justify-amp="20"
      data-justify-seed="11"
    >
      Étude préliminaire <span aria-hidden="true">·</span>
      Conception <span aria-hidden="true">·</span>
      DCE <span aria-hidden="true">·</span>
      Coordination <span aria-hidden="true">·</span>
      Suivi
    </p>
  </Section>

  {/* ───── 5 CHAPITRES THÉMATIQUES — style Polestar scroll-driven ───── */}
  <section
    id="chapitres"
    data-section-label="Démarche"
    data-theme="light"
    class="ap-chapters relative bg-[var(--color-cream)] text-[var(--color-ink)]"
    aria-label="Cinq dimensions de l'architecture paysagère"
  >
    {
      chapitres.map((ch, i) => (
        <article class="ap-chapter" data-ap-chapter aria-labelledby={`chapter-${ch.num}`}>
          {/* offset alterné par parité — pattern designbyad asymétrique :
              chapitre pair entre depuis la gauche, impair depuis la droite. */}
          <div
            class="ap-chapter-visual"
            data-ap-chapter-visual
            data-img-reveal
            data-img-reveal-speed="1"
            data-img-reveal-offset={i % 2 === 0 ? 'left' : 'right'}
            data-img-reveal-offset-amp="60"
          >
            <Image
              src={ch.image}
              alt=""
              widths={[720, 1080, 1440, 1920]}
              sizes="(min-width: 1024px) 55vw, 100vw"
              quality={82}
              format="webp"
              loading={i === 0 ? 'eager' : 'lazy'}
              class="ap-chapter-img"
              data-ap-chapter-img
            />
            <div class="ap-chapter-veil" aria-hidden="true" />
          </div>

          <div class="ap-chapter-copy">
            <p class="font-mono text-[10px] tracking-[0.28em] text-[var(--color-ink)]/55 uppercase">
              {ch.num} · Chapitre
            </p>
            <h2
              id={`chapter-${ch.num}`}
              class="ap-chapter-title mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-5xl)] leading-[0.95] md:text-[length:var(--text-hero)]"
            >
              <em class="italic">{ch.titre}</em>
            </h2>
            <p class="mt-6 max-w-md font-[family-name:var(--font-heading)] text-[length:var(--text-2xl)] leading-[1.18] text-[var(--color-ink)]/90 italic">
              {ch.accroche}
            </p>
            <p class="mt-8 max-w-md text-[length:var(--text-base)] leading-relaxed text-[var(--color-ink)]/75">
              {ch.phrase}
            </p>
          </div>
        </article>
      ))
    }
  </section>

  {/* ───── 4 TYPOLOGIES — grille asymétrique éditoriale ───── */}
  <Section variant="forest" id="typologies" sectionLabel="Typologies" labelledBy="typologies-title">
    <div class="mb-16 max-w-3xl" data-reveal="up">
      <p class="font-mono text-[11px] tracking-[0.26em] text-[var(--color-ink)]/55 uppercase">
        <span class="text-[var(--color-ink)]/40">03</span> &nbsp;·&nbsp; Les quatre typologies
      </p>
      <h2
        id="typologies-title"
        data-mask-reveal
        data-mask-stagger="0.14"
        class="mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-4xl)] leading-[1.02] md:text-[length:var(--text-5xl)]"
      >
        <span data-mask-line class="block pb-[0.12em]"
          >Chaque jardin a son <em class="text-[var(--color-ink)]/55 italic">territoire</em>.</span
        >
      </h2>
    </div>

    {
      /* Animation cards : CSS pure avec animation-delay nth-child + Intersection
        Observer inline page-level pour trigger au scroll (Morgan 2026-04-27 :
        « je veux de l'animation sur ces cards, c'est mort »). Pas de
        data-reveal/-stagger (qui buggaient sur cette grid avec aspect-ratio
        4/5). Approche bétonnée : observer simple, classe .is-revealed
        qui démarre l'animation par card avec stagger. */
    }
    <ul data-typo-cards class="grid grid-cols-1 gap-px bg-[var(--color-forest)]/10 md:grid-cols-2">
      {
        typologies.map((t) => {
          const img = typoImageMap[t.slug];
          return (
            <li class="ap-typo-card group bg-[var(--color-cream)]">
              <a href={`/architecture-paysagere/${t.slug}`} class="flex h-full flex-col">
                {img && (
                  <div class="ap-typo-card-visual overflow-hidden">
                    <Image
                      src={img}
                      alt=""
                      widths={[480, 720, 960, 1280]}
                      sizes="(min-width: 768px) 44vw, 92vw"
                      quality={80}
                      format="webp"
                      class={`ap-typo-card-img h-full w-full object-cover ${t.slug === 'domaine-caractere' ? 'object-top' : 'object-center'}`}
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="flex flex-1 flex-col justify-between p-8 text-[var(--color-forest)] md:p-12">
                  <div>
                    <p class="font-mono text-[11px] tracking-[0.22em] text-[var(--color-forest)]/65 uppercase">
                      {t.surface} · {t.exemple}
                    </p>
                    <h3 class="mt-5 font-[family-name:var(--font-heading)] text-[length:var(--text-3xl)] leading-tight">
                      <em class="italic">{t.nomProprietaire}</em>
                    </h3>
                    <p class="mt-3 text-sm text-[var(--color-forest)]/70">{t.h1Seo}</p>

                    <dl class="mt-8 grid grid-cols-2 gap-4 border-t border-[var(--color-forest)]/15 pt-6 text-xs">
                      <div>
                        <dt class="font-mono tracking-[0.22em] text-[var(--color-forest)]/55 uppercase">
                          Budget travaux
                        </dt>
                        <dd class="mt-1 text-sm">{t.budgetTravaux}</dd>
                      </div>
                      <div>
                        <dt class="font-mono tracking-[0.22em] text-[var(--color-forest)]/55 uppercase">
                          Étude
                        </dt>
                        <dd class="mt-1 text-sm text-[var(--color-forest)]/70">
                          À partir de {t.prixEtude}
                        </dd>
                      </div>
                    </dl>
                  </div>
                  <span class="mt-8 inline-flex items-center gap-2 font-mono text-sm tracking-[0.22em] uppercase transition-all group-hover:translate-x-1">
                    Explorer
                    <span aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>

    <style>
      /* Cards typologies — aspect-ratio plus haut sur desktop pour l'immersion
         (Morgan 2026-04-27). 4/5 portrait desktop = vertical élégant. */
      .ap-typo-card-visual {
        aspect-ratio: 4 / 3;
        background-color: var(--color-forest);
        overflow: hidden;
      }
      @media (min-width: 768px) {
        .ap-typo-card-visual {
          aspect-ratio: 4 / 5;
        }
      }
      .ap-typo-card-img {
        transform: scale(1.04);
        transition: transform 1.2s var(--ease-out-editorial);
      }
      .ap-typo-card:hover .ap-typo-card-img,
      .ap-typo-card:focus-within .ap-typo-card-img {
        transform: scale(1.1);
      }

      /* Animation reveal — pre-state + classe .is-revealed posée par observer
         inline (script en bas du fichier). Stagger via nth-child : card 1
         apparait sans delay, puis +0.15s par card. Image sur clip-path qui
         se révèle, contenu qui fade-up légèrement. */
      .ap-typo-card {
        opacity: 0;
        transform: translateY(40px);
        transition:
          opacity 1s var(--ease-out-editorial),
          transform 1s var(--ease-out-editorial);
      }
      .ap-typo-card-visual .ap-typo-card-img {
        clip-path: inset(100% 0 0 0);
        transition:
          clip-path 1.2s var(--ease-out-editorial),
          transform 1.2s var(--ease-out-editorial);
      }
      [data-typo-cards].is-revealed .ap-typo-card {
        opacity: 1;
        transform: translateY(0);
      }
      [data-typo-cards].is-revealed .ap-typo-card-img {
        clip-path: inset(0 0 0 0);
      }
      [data-typo-cards].is-revealed .ap-typo-card:nth-child(1) {
        transition-delay: 0s;
      }
      [data-typo-cards].is-revealed .ap-typo-card:nth-child(1) .ap-typo-card-img {
        transition-delay: 0s;
      }
      [data-typo-cards].is-revealed .ap-typo-card:nth-child(2) {
        transition-delay: 0.12s;
      }
      [data-typo-cards].is-revealed .ap-typo-card:nth-child(2) .ap-typo-card-img {
        transition-delay: 0.12s;
      }
      [data-typo-cards].is-revealed .ap-typo-card:nth-child(3) {
        transition-delay: 0.24s;
      }
      [data-typo-cards].is-revealed .ap-typo-card:nth-child(3) .ap-typo-card-img {
        transition-delay: 0.24s;
      }
      [data-typo-cards].is-revealed .ap-typo-card:nth-child(4) {
        transition-delay: 0.36s;
      }
      [data-typo-cards].is-revealed .ap-typo-card:nth-child(4) .ap-typo-card-img {
        transition-delay: 0.36s;
      }
    </style>

    <script>
      // Observer simple page-level pour déclencher l'animation des cards
      // typologies (data-reveal-stagger ne fonctionnait pas sur cette grid,
      // cause non identifiée). Pattern bétonné : add class .is-revealed dès
      // que l'élément entre dans le viewport.
      function initTypoCardsObserver() {
        const ul = document.querySelector<HTMLElement>('[data-typo-cards]');
        if (!ul) return;
        if (ul.dataset.observerWired === 'true') return;
        ul.dataset.observerWired = 'true';

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                ul.classList.add('is-revealed');
                observer.disconnect();
                break;
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        observer.observe(ul);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTypoCardsObserver, { once: true });
      } else {
        initTypoCardsObserver();
      }
      document.addEventListener('astro:page-load', initTypoCardsObserver);
    </script>
  </Section>

  {
    /* ───── BANDE RESPIRATION full-bleed (Morgan 2026-04-27 : « grand espace
      vide entre typologies et process, manque une image »). Photo projet
      livré en bande horizontale 60vh, data-img-reveal lent au scroll pour
      effet cinématique. Pas de texte par-dessus — pure respiration visuelle. */
  }
  <section
    class="ap-respiration relative overflow-hidden bg-[var(--color-cream)]"
    aria-hidden="true"
    data-theme="light"
  >
    <div data-img-reveal data-img-reveal-speed="1" class="ap-respiration-frame">
      <Image
        src={respirationProcess}
        alt=""
        widths={[960, 1440, 1920, 2560]}
        sizes="100vw"
        quality={82}
        format="webp"
        class="ap-respiration-img h-full w-full object-cover object-center"
        loading="lazy"
      />
    </div>
  </section>

  {
    /* ───── PROCESS 3 ÉTAPES ─────
       Padding "default" (compact retiré 2026-04-27 — Morgan : « 3 étapes
       n'apparaissaient pas, section super vide »). La bande respiration
       full-bleed au-dessus assure désormais la transition visuelle. */
  }
  <Section
    variant="forest"
    topDivider
    id="process"
    sectionLabel="Process"
    labelledBy="process-title"
  >
    <div class="grid gap-12 md:grid-cols-[1fr_2fr] md:gap-20">
      <div data-reveal="up">
        <p class="font-mono text-[11px] tracking-[0.26em] text-[var(--color-ink)]/55 uppercase">
          <span class="text-[var(--color-ink)]/40">04</span> &nbsp;·&nbsp; Le process
        </p>
        <h2
          id="process-title"
          data-mask-reveal
          data-mask-stagger="0.14"
          class="mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-4xl)] leading-[1.02]"
        >
          <span data-mask-line class="block pb-[0.05em]">Deux études,</span>
          <span data-mask-line class="block pb-[0.05em]">un <em class="italic">suivi</em>.</span>
        </h2>
      </div>

      {
        /* data-reveal retiré 2026-04-27 — même bug que typologies (3 étapes
         invisibles au load, observer ne déclenche pas). Affichage direct. */
      }
      <ol class="space-y-12">
        <li class="border-l border-[var(--color-ink)]/15 pl-6">
          <p class="font-mono text-[10px] tracking-[0.28em] text-[var(--color-ink)]/55 uppercase">
            Étape 1
          </p>
          <h3
            class="mt-3 font-[family-name:var(--font-heading)] text-[length:var(--text-2xl)] leading-tight"
          >
            Étude préliminaire
          </h3>
          <p class="mt-3 text-[length:var(--text-base)] leading-relaxed text-[var(--color-ink)]/75">
            Contextualisation, diagnostic de site, analyse réglementaire, synthèse graphique,
            fourchette budgétaire. Durée calibrée selon la typologie.
          </p>
        </li>
        <li class="border-l border-[var(--color-ink)]/15 pl-6">
          <p class="font-mono text-[10px] tracking-[0.28em] text-[var(--color-ink)]/55 uppercase">
            Étape 2
          </p>
          <h3
            class="mt-3 font-[family-name:var(--font-heading)] text-[length:var(--text-2xl)] leading-tight"
          >
            Étude projet
          </h3>
          <p class="mt-3 text-[length:var(--text-base)] leading-relaxed text-[var(--color-ink)]/75">
            Conception approfondie, plan masse, plans d'exécution, palettes végétales et matériaux,
            DCE, budgétisation détaillée.
          </p>
        </li>
        <li class="border-l border-[var(--color-ink)]/15 pl-6">
          <p class="font-mono text-[10px] tracking-[0.28em] text-[var(--color-ink)]/55 uppercase">
            Étape 3
          </p>
          <h3
            class="mt-3 font-[family-name:var(--font-heading)] text-[length:var(--text-2xl)] leading-tight"
          >
            Suivi de chantier
          </h3>
          <p class="mt-3 text-[length:var(--text-base)] leading-relaxed text-[var(--color-ink)]/75">
            Coordination des artisans mis en concurrence, pilotage du planning, réunions de
            chantier, respect des intentions de projet jusqu'à la réception. Rémunération de 6 à 12
            % des travaux selon la typologie.
          </p>
        </li>
      </ol>
    </div>
  </Section>

  {/* ───── FAQ — 8 questions étoffées ───── */}
  <Section variant="forest" topDivider id="faq" sectionLabel="FAQ" labelledBy="faq-title">
    <div class="mb-12 max-w-3xl" data-reveal="up">
      <p class="font-mono text-[11px] tracking-[0.26em] text-[var(--color-ink)]/55 uppercase">
        <span class="text-[var(--color-ink)]/40">05</span> &nbsp;·&nbsp; Questions fréquentes
      </p>
      <h2
        id="faq-title"
        data-mask-reveal
        data-mask-stagger="0.14"
        class="mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-4xl)] leading-[1.02]"
      >
        <span data-mask-line class="block pb-[0.05em]">Les objections,</span>
        <span data-mask-line class="block pb-[0.05em]"
          ><em class="italic">avant d'appeler</em>.</span
        >
      </h2>
    </div>
    <ul class="divide-y divide-[var(--color-ink)]/10 border-y border-[var(--color-ink)]/10">
      {
        pageFaq.map((item) => (
          <li>
            <details class="group">
              <summary class="flex cursor-pointer items-start justify-between gap-6 py-6 font-[family-name:var(--font-heading)] text-[length:var(--text-xl)] leading-tight transition-colors hover:text-[var(--color-ink)]">
                <span>{item.question}</span>
                <span
                  class="mt-2 text-base opacity-60 transition-transform group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <p class="pr-10 pb-6 text-[length:var(--text-base)] leading-relaxed text-[var(--color-ink)]/80">
                {item.answer}
              </p>
            </details>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* ───── CTA FINAL forest ───── */}
  <Section variant="forest" topDivider id="contact-cta" sectionLabel="Contact">
    <div class="text-center">
      <p class="font-mono text-xs tracking-[0.26em] text-[var(--color-ink)]/55 uppercase">
        <span class="text-[var(--color-ink)]/40">06</span> &nbsp;·&nbsp; Démarrer
      </p>
      <h2
        data-mask-reveal
        data-mask-stagger="0.14"
        class="mt-8 font-[family-name:var(--font-heading)] text-[length:var(--text-5xl)] leading-[0.98]"
      >
        <span data-mask-line class="block">Votre jardin est</span>
        <span data-mask-line class="block text-[var(--color-ink)]/55 italic">
          une architecture.
        </span>
      </h2>
      <p class="mx-auto mt-10 max-w-xl text-[length:var(--text-base)] leading-relaxed opacity-70">
        Un appel de 15 à 25 minutes pour qualifier le projet. Sans devis préalable, sans formalisme.
      </p>
      <div class="mt-12 flex flex-col items-center justify-center gap-6 md:flex-row md:gap-10">
        <CtaLink href="/contact" label="Prendre contact" tone="dark" size="lg" magnetic={0} />
        <a
          href={`tel:${SITE.contact.phone}`}
          class="text-sm underline underline-offset-4 hover:text-[var(--color-ink)]"
        >
          {SITE.contact.phoneDisplay}
        </a>
      </div>
    </div>
  </Section>

  <style>
    /* H1 cassé designbyad — ARCHITECTURE PAYSAGÈRE CAPS monumentales +
       "sur mesure." italic en contrepoint laterite. */
    .ap-h1-positioning {
      font-family: var(--font-heading), sans-serif;
      font-weight: 500;
      font-size: clamp(2.4rem, 7vw, 6rem);
      line-height: 0.92;
      letter-spacing: -0.015em;
    }

    /* Bande keywords — CAPS justify-scroll, signature studio. */
    .ap-keywords-band {
      font-family: var(--font-heading), sans-serif;
      font-weight: 500;
      font-size: clamp(1.1rem, 2.8vw, 2.1rem);
      line-height: 1.1;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--color-ink);
      text-align: justify;
    }
    .ap-keywords-band > span[aria-hidden] {
      display: inline-block;
      margin: 0 0.35em;
      color: var(--color-ink);
      opacity: 0.4;
      font-weight: 400;
    }

    /* ───── Bande respiration full-bleed (entre typologies et process) ─────
       Hauteur 60vh desktop / 50vh mobile, image plein cadre projet livré.
       Léger zoom in subtil au scroll via parallax pour donner du mouvement. */
    .ap-respiration {
      height: 60vh;
      min-height: 320px;
    }
    @media (max-width: 768px) {
      .ap-respiration {
        height: 50vh;
      }
    }
    .ap-respiration-frame {
      position: absolute;
      inset: 0;
    }
    .ap-respiration-img {
      transform: scale(1.04);
      transition: transform 1.4s var(--ease-out-editorial);
    }
    .ap-respiration:hover .ap-respiration-img {
      transform: scale(1.08);
    }

    /* ───── Hero image — zoom scroll-driven ───── */
    .ap-hero-image {
      transform: scale(1.06);
      transform-origin: center;
      will-change: transform, filter;
    }

    /* ───── Chapitres thématiques — scroll-driven zoom ─────
       Chaque chapitre est pinné en sticky, l'image zoome (scale 1 → 1.15)
       pendant le scroll, la copy apparaît avec un léger translateY. */
    .ap-chapters {
      position: relative;
    }
    .ap-chapter {
      position: relative;
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr;
      align-items: stretch;
    }
    @media (min-width: 1024px) {
      .ap-chapter {
        grid-template-columns: 55fr 45fr;
      }
    }
    .ap-chapter + .ap-chapter {
      border-top: 1px solid color-mix(in oklab, var(--color-ink) 10%, transparent);
    }

    .ap-chapter-visual {
      position: relative;
      overflow: hidden;
      min-height: 55vh;
    }
    @media (min-width: 1024px) {
      .ap-chapter-visual {
        min-height: 100vh;
        position: sticky;
        top: 0;
        height: 100vh;
      }
    }
    .ap-chapter-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transform: scale(1.05);
      transform-origin: center;
      will-change: transform, filter;
      transition: transform 1s var(--ease-out-editorial);
    }
    .ap-chapter:hover .ap-chapter-img {
      transform: scale(1.1);
    }
    .ap-chapter-veil {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom right,
        rgba(26, 43, 31, 0.3) 0%,
        rgba(26, 43, 31, 0.5) 100%
      );
      pointer-events: none;
    }

    .ap-chapter-copy {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 4rem 2rem 5rem;
      max-width: 640px;
    }
    @media (min-width: 768px) {
      .ap-chapter-copy {
        padding: 5rem 4rem;
      }
    }
    @media (min-width: 1024px) {
      .ap-chapter-copy {
        padding: 6rem 5rem 6rem 6rem;
        min-height: 100vh;
      }
    }

    .ap-chapter-title em {
      font-variation-settings:
        'opsz' 144,
        'SOFT' 70;
    }

    /* Alternance visuel/copy : pair à gauche, impair à droite */
    @media (min-width: 1024px) {
      .ap-chapter:nth-child(even) {
        grid-template-columns: 45fr 55fr;
      }
      .ap-chapter:nth-child(even) .ap-chapter-visual {
        order: 2;
      }
      .ap-chapter:nth-child(even) .ap-chapter-copy {
        order: 1;
        padding: 6rem 5rem 6rem 6rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .ap-chapter-img {
        transition: none;
        transform: scale(1);
      }
      .ap-hero-image {
        transform: none;
      }
    }
  </style>
</BaseLayout>
