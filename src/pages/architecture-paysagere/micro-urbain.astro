---
/*
 * /architecture-paysagere/micro-urbain — page typologie pilote (refonte trame
 * Jonathan 2026-05-15). Route statique : Astro priorise ce fichier sur
 * `[slug].astro`, donc les 3 autres typologies (coeur-urbain, frange-urbaine,
 * domaine-caractere) gardent l'ancien template inchangé.
 *
 * Architecture issue de la trame Jonathan (re-lecture Morgan 2026-05-15 v3) :
 *   1. Hero photo plein-bleed (01-hero / terrasse-salon) :
 *      - H1 split « MICRO / URBAIN » en HAUT-GAUCHE
 *      - 4 specs (Secteur géo / Surface / Contexte / Complexité) en
 *        overlay sur le BAS de la photo (pas section séparée)
 *      - Voile gradient double (haut + bas) pour lisibilité
 *   2. Galerie magazine 4 photos :
 *      - 02-large-top (full-width 21:9)
 *      - 03 + 04 diptyque portraits asymétrique (38% + 54%)
 *      - 05-roof (coda portrait centrée — remplacement 2026-05-21)
 *   3. Manifeste — bloc texte décalé colonne DROITE sur desktop,
 *      taille agrandie (~1.2-1.65rem), précision italique petit dessous
 *   4. FAQ discrète 3 questions (densification SEO légère sur fond noir)
 *   5. CTA full-width « DECOUVRIR LES PROJETS MICRO URBAIN » + pill ROUGE
 *      plein (fond rouge + texte cream, ancien tone="accent" était invisible
 *      car laterite re-aliased en ink, cf. purge latérite 2026-05-02)
 *
 * Contenu Jonathan : VERBATIM trame (retour Morgan v3 — restauration des
 * fautes typo conservées) : « connectes », « soit pas une », « accéssibilité »,
 * « voir obligatoire ». H1 sans accent + « COEUR » sans ligature respectés
 * (esthétique designbyad signée Jonathan). À valider ensuite avec Jonathan.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import TypologieHero from '@/components/astro/TypologieHero.astro';
import TypologieFaq from '@/components/astro/TypologieFaq.astro';
import { SITE } from '@/lib/site-config';
import {
  jsonLdGraph,
  breadcrumbs,
  localBusiness,
  organization,
  service as serviceSchema,
  faqPage,
} from '@/lib/schema-org';

import heroPhoto from '@/assets/typologies/micro-urbain/01-hero.jpg';
import largeTop from '@/assets/typologies/micro-urbain/02-large-top.jpg';
import diptyqueLeft from '@/assets/typologies/micro-urbain/03-diptyque-left.jpg';
import diptyqueRight from '@/assets/typologies/micro-urbain/04-diptyque-right.jpg';
import coda from '@/assets/typologies/micro-urbain/05-roof.jpg';

const typologie = SITE.typologies.find((t) => t.slug === 'micro-urbain')!;

// 4 valeurs droite — verbatim dictée Morgan 2026-05-19 (les 4 labels sont
// figés et viennent du composant `<TypologieHero>` partagé).
const valeurs = [
  'Hyper urbain',
  'Moins de 100m² (hors cas spécifique)',
  'Roof tops / patios / micro jardins',
  'Hauteur / accès / exposition / poids',
] as const;

// Manifeste — texte Jonathan VERBATIM trame, fautes typo conservées
// (retour Morgan 2026-05-15 v3 : restauration verbatim, on n'invente
// rien et on garde la voix Jonathan brute, à valider ensuite avec lui).
// Mots à NE PAS corriger ici : « connectes », « soit pas une »,
// « accéssibilité », « voir obligatoire ».
const manifeste = {
  bloc1:
    'La typologie micro urbaine se caractérise par des espaces de vie réduits, en hauteur ou encore enclavés entre les murs intérieurs du bâti.',
  bloc2:
    "Ce sont des espaces fortement connectes à la vie des habitations, soit par des perspectives directes depuis l'intérieur, soit pas une accéssibilité directe voir obligatoire depuis les circulations de l'intérieur vers l'extérieur.",
  precision:
    "Les contraintes liées à l'exposition aux vents forts et la portance structurelle pour les terrasses, l'ombre excessive et le taux élevé de l'hygrométrie pour les patios ou encore les accès difficiles à ces différents espaces établissent des contraintes très spécifiques dans l'élaboration de l'étude et la réalisation des ouvrages.",
};

// FAQ — verbatim Morgan/Jonathan 2026-05-21 (3 Q/R communes aux 4 pages
// typologies). Typos conservées tel quel : `strucurer`, `aloué`,
// `compte rendus`, `tranquilité`, `établit`, `forfait`, `puission`.
const faq = [
  {
    question: "Pourquoi facturer une étude alors que beaucoup de paysagistes l'offrent ?",
    answer:
      "L'étude d'un projet est un processus obligatoire qui permet de comprendre un projet, de le strucurer efficacement et d'anticiper les travaux et le budget qui lui sera aloué. Le studio n'a pas de standard matériaux, styles, tendances et autres. Il construit, de la conception jusqu'à la livraison, l'entièreté sur-mesure selon les caractéristiques du projet, de son environnement et de ses usagers.\n\nMon travail repose sur la réflexion, l'anticipation et le pilotage. Je ne réalise pas sur le chantier le projet, je suis le chef d'orchestre qui pense, accompagne et dirige le projet pour le rendre à la hauteur de vos attentes.",
  },
  {
    question: 'Comment se compose une étude ?',
    answer:
      "Il y a 3 phases : l'étude préliminaire, l'étude projet et le suivi de chantier.\n\nL'étude préliminaire : elle recadre le contexte du projet et structure les orientations de projet. C'est une synthèse de la commande et de la structuration des axes directeurs du projet avec une budgétisation des grands lots travaux.\n\nL'étude projet : elle rentre dans le détail de conception suite à la validation de l'étude préliminaire. Dans cette phase, le studio développe, organise, et consulte les entreprises et artisans pour le chiffrage précis des travaux.\n\nLe suivi de chantier : c'est la partie pilotage chantier. Elle est importante car elle permet de garantir un résultat final entre les intentions de projet et la réalisation. Le studio gère les compte rendus, le suivi financier ainsi que le pilotage des travaux avec les différentes entreprises sur le chantier. Vous payez une tranquilité d'esprit et de la disponibilité.",
  },
  {
    question: "Quel est le prix de l'étude pour cette typologie ?",
    answer:
      "En fonction de la typologie de votre propriété, le studio a établit des forfait de base.\n\nViennent s'ajouter à ce forfait de base des frais correspondant aux déplacements du studio (frais d'essence, péages, ...) en fonction de votre emplacement et du nombre de déplacements prévus par le besoin du projet.\n\nPour connaître le montant exact de votre étude, je vous invite à me contacter afin que nous puission échanger ensemble de votre projet pour définir ensemble tous les paramètres de l'étude.",
  },
];

const breadcrumbItems = [
  { name: 'Accueil', item: '/' },
  { name: 'Architecture paysagère', item: '/architecture-paysagere' },
  { name: typologie.nomProprietaire, item: `/architecture-paysagere/${typologie.slug}` },
];

const schema = jsonLdGraph([
  organization(),
  localBusiness(),
  serviceSchema({
    name: typologie.h1Seo,
    slug: typologie.slug,
    description: `${typologie.h1Seo} — Studio J Oliveira, designer paysagiste biophilique. Étude ${typologie.prixEtude}, budget travaux ${typologie.budgetTravaux}.`,
    priceRangeMin: typologie.coutEtudeNumeric,
    priceRangeMax: typologie.coutEtudeNumeric,
  }),
  faqPage(faq),
  breadcrumbs(breadcrumbItems),
]);
---

<BaseLayout
  title={`${typologie.h1Seo} — Micro urbain`}
  description={`${typologie.h1Seo} avec le Studio J Oliveira — terrasse, rooftop, patio. Étude ${typologie.prixEtude}, budget travaux ${typologie.budgetTravaux}. Studio biophilique à Brive‑la‑Gaillarde.`}
  darkHero
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={schema} />
  </Fragment>

  {/* ═════════ 1 · HERO — via composant partagé `<TypologieHero>` ════════ */}
  <TypologieHero
    photo={heroPhoto}
    alt="Terrasse urbaine micro-urbain — projet Studio J Oliveira"
    h1Lines={['MICRO', 'URBAIN']}
    valeurs={valeurs}
    sectionLabel="Micro urbain"
  />

  {
    /* ═════════ 2 · GALERIE — 4 photos rythme magazine ════════════════════
     Disposition trame Jonathan (capture Morgan 2026-05-15) :
       (1) photo large pleine largeur (02-large-top)
       (2) diptyque deux portraits : 03 plus petit gauche + 04 plus grand droite
       (3) coda portrait centrée (05-roof) — signature verticale de fin
     Gouttières noires généreuses, aucun bord-à-bord. */
  }
  <section
    data-theme="dark"
    class="mu-gallery bg-[var(--color-black-deep)]"
    aria-label="Sélection de projets micro urbain"
  >
    <figure class="mu-gallery__large" data-reveal="image-rise">
      <Image
        src={largeTop}
        alt="Projet micro urbain — terrasse végétalisée sous ciel d'altitude"
        widths={[960, 1440, 1800]}
        sizes="(min-width: 1024px) 92vw, 96vw"
        quality={92}
        format="webp"
        loading="lazy"
        class="mu-gallery__img"
      />
    </figure>

    <div class="mu-gallery__diptyque">
      <figure class="mu-gallery__diptyque-left" data-reveal="image-rise">
        <Image
          src={diptyqueLeft}
          alt="Projet micro urbain — escalier patio jardin minéral"
          widths={[480, 720, 1100]}
          sizes="(min-width: 1024px) 38vw, 92vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="mu-gallery__img"
        />
      </figure>
      <figure class="mu-gallery__diptyque-right" data-reveal="image-rise">
        <Image
          src={diptyqueRight}
          alt="Projet micro urbain — patio tropical intérieur-extérieur"
          widths={[640, 960, 1300]}
          sizes="(min-width: 1024px) 54vw, 96vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="mu-gallery__img"
        />
      </figure>
    </div>

    <figure class="mu-gallery__coda" data-reveal="image-rise">
      <Image
        src={coda}
        alt="Projet micro urbain — patio sol mosaïque sous arches béton, bordé de fougères"
        widths={[960, 1440, 1800]}
        sizes="(min-width: 1024px) 92vw, 96vw"
        quality={92}
        format="webp"
        loading="lazy"
        class="mu-gallery__img"
      />
    </figure>
  </section>

  {/* ═════════ 3 · MANIFESTE typologie ════════════════════════════════════ */}
  <section
    id="manifeste"
    data-section-label="Manifeste"
    data-theme="dark"
    class="mu-manifeste bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="manifeste-title"
  >
    <div class="mu-manifeste__inner">
      <h2 id="manifeste-title" class="sr-only">La typologie micro urbain</h2>
      <div
        class="mu-manifeste__body"
        data-words-fade
        data-words-fade-stagger="0.006"
        data-words-fade-window="0.05,0.5"
      >
        <p class="mu-manifeste__para">{manifeste.bloc1}</p>
        <p class="mu-manifeste__para">{manifeste.bloc2}</p>
      </div>
      <p class="mu-manifeste__precision">{manifeste.precision}</p>
    </div>
  </section>

  {/* ═════════ 4 · FAQ — composant partagé `<TypologieFaq>` ═════════════ */}
  <TypologieFaq items={faq} />

  {/* ═════════ 5 · CTA full-width « DECOUVRIR LES PROJETS MICRO URBAIN » ══ */}
  <section
    data-theme="dark"
    class="mu-cta bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="cta-title"
  >
    <a href="/realisations" class="mu-cta__link" data-cursor-label="VOIR">
      <h2
        id="cta-title"
        class="mu-cta__title"
        data-justify-multi
        data-justify-amp="50"
        data-justify-line-step="0.15"
        data-justify-line-window="0.55"
      >
        <span class="mu-cta__title-line" data-justify-line data-justify-direction="from-right">
          DECOUVRIR LES PROJETS MICRO URBAIN
        </span>
      </h2>
    </a>
    <a href="/demarrer-un-projet" class="mu-cta__pill-red" data-magnetic="0.2" data-cursor-skip>
      <span class="mu-cta__pill-dot" aria-hidden="true"></span>
      <span class="mu-cta__pill-label">Démarrer un projet</span>
      <img
        src="/brand/fleche-white.webp"
        alt=""
        aria-hidden="true"
        class="mu-cta__pill-arrow"
        width="32"
        height="32"
      />
    </a>
  </section>

  <style is:global>
    /* ═══════════════════════════════════════════════════════════════════════
     * /architecture-paysagere/micro-urbain — refonte trame Jonathan 2026-05-15.
     * Pattern noir + cream + accent rouge. Reproduit les tokens et conventions
     * des pages home + studio (full-bleed sections, padding cohérent, no max-width
     * sur les inners pour la respiration designbyad).
     * ═══════════════════════════════════════════════════════════════════ */

    /* ─── 1 · Hero ── désormais géré par `<TypologieHero>` (composant
       partagé, refactor 2026-05-19). Plus de CSS hero ici. */

    /* ─── 2 · Galerie magazine ──────────────────────────────────────────── */
    .mu-gallery {
      width: 100%;
      padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 3vw, 2.5rem);
    }
    /* Photos « large » pleine largeur — ratio cinéma allégé pour montrer
       plus de l'image (Morgan v4 2026-05-15 : « image 02 trop zoomée »).
       Passe de 21:9 → 16:10 desktop, 4:3 → 3:2 mobile. */
    .mu-gallery__large {
      margin: 0;
      width: 100%;
      aspect-ratio: 3 / 2;
      overflow: hidden;
      background-color: var(--color-black-deep);
    }
    @media (min-width: 1024px) {
      .mu-gallery__large {
        aspect-ratio: 16 / 10;
      }
    }
    /* Diptyque 03 + 04 — pattern trame Jonathan : portrait gauche plus
       petit (38%) + portrait droite plus grand (54%) + gouttière.
       Alignement vertical décalé pour effet quinconce magazine. */
    .mu-gallery__diptyque {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(1.25rem, 3vw, 2.5rem);
    }
    @media (min-width: 768px) {
      .mu-gallery__diptyque {
        grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
        align-items: stretch;
      }
    }
    .mu-gallery__diptyque-left,
    .mu-gallery__diptyque-right {
      margin: 0;
      overflow: hidden;
      background-color: var(--color-black-deep);
    }
    .mu-gallery__diptyque-left {
      aspect-ratio: 4 / 5;
    }
    .mu-gallery__diptyque-right {
      aspect-ratio: 4 / 5;
    }
    @media (min-width: 768px) {
      .mu-gallery__diptyque-left {
        aspect-ratio: 3 / 4;
        align-self: start;
        max-height: 78%;
      }
      .mu-gallery__diptyque-right {
        aspect-ratio: 4 / 5;
        align-self: end;
      }
    }
    /* Coda — photo 05, pleine largeur (Morgan 2026-05-21 : « prennait la
       largeur totale de la zone d'affichage »). Aspect aligné sur les
       __large pour cohérence : 3/2 mobile, 16/10 desktop. La photo
       portrait sera croppée top+bottom — compromis assumé. */
    .mu-gallery__coda {
      margin: 0;
      width: 100%;
      aspect-ratio: 3 / 2;
      overflow: hidden;
      background-color: var(--color-black-deep);
    }
    @media (min-width: 1024px) {
      .mu-gallery__coda {
        aspect-ratio: 16 / 10;
      }
    }
    .mu-gallery__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    /* ─── 3 · Manifeste ─────────────────────────────────────────────────── */
    /* Pattern capture Morgan 2026-05-15 v3 : bloc texte décalé en col DROITE
       sur desktop (col gauche vide pour la respiration), taille de texte
       AGRANDIE (clamp ~1.25-1.6rem), poids regular/light pour rester lisible
       sur fond noir sans crier. Italique précision en plus petit dessous.
       v6 retour Morgan : padding-right = 0 → la section texte va JUSQU'AU
       BORD DROIT de l'écran (la col droite du grid 1fr 2fr le fait aller
       au bord). Padding-left conservé pour la respiration côté gauche. */
    .mu-manifeste {
      width: 100%;
      padding: clamp(5rem, 10vw, 9rem) clamp(1.5rem, 5vw, 4rem);
    }
    .mu-manifeste__inner {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(2rem, 4vw, 3.5rem);
    }
    @media (min-width: 1024px) {
      /* Retour Morgan v8 2026-05-15 (nouvelle capture) : le bloc texte
         commence vers ~42% de la largeur (pas 33%), lignes courtes
         ~35-40ch, marge à droite naturelle. Grid 1fr 1.35fr donne
         ~42% vide à gauche + ~58% pour la col texte. */
      .mu-manifeste__inner {
        grid-template-columns: 1fr 1.35fr;
        column-gap: clamp(3rem, 6vw, 5rem);
        align-items: start;
      }
      /* Texte + précision posés en colonne DROITE. */
      .mu-manifeste__body,
      .mu-manifeste__precision {
        grid-column: 2;
      }
    }
    .mu-manifeste__body {
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 2.2vw, 1.85rem);
      /* Pas de max-width : le texte va jusqu'au bord droit de la colonne
         (retour Morgan v9 « le texte va davantage jusqu'au bord droit »).
         La marge à droite vient du padding section clamp(1.5rem, 5vw, 4rem). */
    }
    .mu-manifeste__para {
      font-family: var(--font-body), sans-serif;
      font-weight: 400;
      font-size: clamp(1.2rem, 1.65vw, 1.65rem);
      line-height: 1.45;
      letter-spacing: -0.005em;
      color: var(--color-cream);
      margin: 0;
    }
    .mu-manifeste__body .word {
      display: inline-block;
      opacity: 0;
      transform: translateY(10px);
      will-change: opacity, transform;
    }
    .mu-manifeste__precision {
      font-family: var(--font-body), sans-serif;
      font-weight: 300;
      font-size: clamp(0.85rem, 0.95vw, 0.95rem);
      line-height: 1.6;
      color: color-mix(in oklab, var(--color-cream) 80%, transparent);
      text-align: left;
      margin: clamp(2.5rem, 4.5vw, 4rem) 0 0;
      /* Pas de max-width : la précision suit la même règle que le body,
         elle s'étend jusqu'au bord droit de la colonne. */
    }

    /* ─── 4 · FAQ ── désormais géré par `<TypologieFaq>` (composant
       partagé, refactor 2026-05-21). Plus de CSS FAQ ici. */

    /* ─── 5 · CTA full-width « DECOUVRIR LES PROJETS MICRO URBAIN » ────── */
    .mu-cta {
      width: 100%;
      padding: clamp(4rem, 8vw, 7rem) 0 clamp(4rem, 8vw, 7rem);
      border-top: 1px solid color-mix(in oklab, var(--color-cream) 18%, transparent);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(2rem, 4vw, 3rem);
    }
    .mu-cta__link {
      display: block;
      width: 100%;
      padding: 0 clamp(1.5rem, 5vw, 4rem);
      text-decoration: none;
      color: inherit;
    }
    .mu-cta__title {
      width: 100%;
      margin: 0;
    }
    .mu-cta__title-line {
      display: block;
      width: 100%;
      font-family: var(--font-heading), sans-serif;
      font-weight: 200;
      font-size: clamp(1.4rem, 5.5vw, 5rem);
      line-height: 1.1;
      letter-spacing: 0;
      text-transform: uppercase;
      text-align: justify;
      text-align-last: justify;
      color: var(--color-cream);
      margin: 0;
      hyphens: none;
      white-space: nowrap;
      overflow: hidden;
    }
    @media (max-width: 767px) {
      .mu-cta__title-line {
        white-space: normal;
        text-align: left;
        text-align-last: left;
      }
    }
    /* Pill rouge plein sous le CTA texte — fond rouge plein, texte cream
       Bold, dot + flèche. Réplique le pattern du Header (cta-pill) mais
       visible sur fond noir (l'ancienne variante CtaLink tone="accent"
       était invisible car accent ≈ ink suite à la purge latérite 2026-05-02). */
    .mu-cta__pill-red {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      padding: 0.85rem 1.6rem;
      background-color: var(--color-red);
      color: var(--color-cream);
      border-radius: 9999px;
      font-family: var(--font-body), sans-serif;
      font-weight: 600;
      font-size: clamp(0.9rem, 1.05vw, 1rem);
      letter-spacing: 0.01em;
      text-decoration: none;
      transition: transform 0.35s var(--ease-out-editorial);
      will-change: transform;
    }
    @media (hover: hover) {
      .mu-cta__pill-red:hover,
      .mu-cta__pill-red:focus-visible {
        transform: scale(1.04);
      }
    }
    .mu-cta__pill-dot {
      display: inline-block;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background-color: var(--color-cream);
      flex-shrink: 0;
    }
    .mu-cta__pill-label {
      white-space: nowrap;
    }
    .mu-cta__pill-arrow {
      width: 14px;
      height: 14px;
      display: inline-block;
      object-fit: contain;
      flex-shrink: 0;
    }

    /* full-bleed garde-fou — pas de marge latérale parasite sur les sections. */
    .mu-hero,
    .mu-gallery,
    .mu-manifeste,
    .mu-cta {
      box-sizing: border-box;
    }
  </style>
</BaseLayout>
