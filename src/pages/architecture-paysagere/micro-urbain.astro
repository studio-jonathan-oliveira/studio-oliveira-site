---
/*
 * /architecture-paysagere/micro-urbain — DA finale beige/noir 2026-06-04
 * (trames « modif finales »). Même patron que coeur-urbain (pilote validé) :
 * hero beige typographique, galerie beige + Définir/Comprendre, FAQ beige
 * + marquee. Plus de photo hero, plus de CTA rouge, casse normale.
 *
 * Contenu Jonathan VERBATIM trame (fautes conservées : « connectes »,
 * « soit pas une », « accéssibilité », « voir obligatoire »).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import TypologieHero from '@/components/astro/TypologieHero.astro';
import TypologieFaq from '@/components/astro/TypologieFaq.astro';
import { SITE } from '@/lib/site-config';
import {
  jsonLdGraph,
  breadcrumbs,
  localBusiness,
  organization,
  service as serviceSchema,
  faqPage,
} from '@/lib/schema-org';

import largeTop from '@/assets/typologies/micro-urbain/02-large-top.jpg';
import diptyqueLeft from '@/assets/typologies/micro-urbain/03-diptyque-left.jpg';
import diptyqueRight from '@/assets/typologies/micro-urbain/04-diptyque-right.jpg';
import coda from '@/assets/typologies/micro-urbain/05-roof.jpg';

const typologie = SITE.typologies.find((t) => t.slug === 'micro-urbain')!;

// 4 valeurs droite — verbatim dictée Morgan/Jonathan (confirmées au re-audit).
const valeurs = [
  'Hyper urbain',
  'Moins de 100 m² (hors cas spécifique)',
  'Roof tops / Patios / Micro jardins',
  'Hauteur / accès / exposition / poids',
] as const;

// Manifeste VERBATIM trame (scindé Définir / Comprendre). Fautes conservées.
const manifeste = {
  bloc1:
    'La typologie micro urbaine se caractérise par des espaces de vie réduits, en hauteur ou encore enclavés entre les murs intérieurs du bâti.',
  bloc2:
    "Ce sont des espaces fortement connectes à la vie des habitations, soit par des perspectives directes depuis l'intérieur, soit pas une accéssibilité directe voir obligatoire depuis les circulations de l'intérieur vers l'extérieur.",
  precision:
    "Les contraintes liées à l'exposition aux vents forts et la portance structurelle pour les terrasses, l'ombre excessive et le taux élevé de l'hygrométrie pour les patios ou encore les accès difficiles à ces différents espaces établissent des contraintes très spécifiques dans l'élaboration de l'étude et la réalisation des ouvrages.",
};

// FAQ — 3 Q/R VERBATIM trame (communes aux 4 typologies, état ouvert
// colonne droite micro-urbain). Voir _FAQ-reponses-trame-micro-urbain.md.
const faq = [
  {
    question: 'Comment se compose une étude ?',
    answer:
      "Il y a 3 phases : l'étude préliminaire, l'étude projet et le suivi de chantier.\n\nL'étude préliminaire : elle recadre le contexte du projet et structure les orientations de projet. C'est une synthèse de la commande et de la structuration des axes directeurs du projet avec une budgétisation des grands lots travaux.\n\nL'étude projet : elle rentre dans le détail de conception suite à la validation de l'étude préliminaire. Dans cette phase, le studio développe, organise, et consulte les entreprises et artisans pour le chiffrage précis des travaux.\n\nLe suivi de chantier : c'est la partie pilotage chantier. Elle est importante car elle permet de garantir un résultat final entre les intentions de projet et la réalisation. Le studio gère les compte rendus, le suivi financier ainsi que le pilotage des travaux avec les différentes entreprises sur le chantier. Vous payez une tranquilité d'esprit et de la disponibilité.",
  },
  {
    question: "Quels sont les livrables d'une étude ?",
    answer:
      "Étude préliminaire : étude du contexte projet, étude règlementaire et urbanisme, étude fonctionnelle et besoins, synthèse graphique, étude estimative budgétaire.\n\nÉtude projet : conception paysagère, étude végétales, dossier de consultation des entreprise, détails techniques, consultation des entreprises, dossier de réalisation.\n\nSuivi de chantier : comptes rendus de chantier, suivi d'avancement, validation des ouvrages, suivi financier, réception des travaux.",
  },
  {
    question: "Quel est le prix de l'étude pour cette typologie ?",
    answer:
      "En fonction de la typologie des jardins, le studio a établit des forfaits de base.\n\nViennent s'ajouter à ces forfaits de base :\n- des frais correspondant aux déplacements du studio (frais d'essence, péages, ...)\n- la mission géomètre\nen fonction de votre emplacement et des nécessité du projet et de l'étude.\n\nPour connaître le montant exact de votre étude, je vous invite à me contacter (ou remplir le formulaire via l'onglet \"démarrer un projet\" en haut de la page) afin que nous puissions échanger ensemble et définir tous les paramètres liés à votre projet.",
  },
];

const breadcrumbItems = [
  { name: 'Accueil', item: '/' },
  { name: 'Projets', item: '/projets' },
  { name: typologie.nomProprietaire, item: `/architecture-paysagere/${typologie.slug}` },
];

const schema = jsonLdGraph([
  organization(),
  localBusiness(),
  serviceSchema({
    name: typologie.h1Seo,
    slug: typologie.slug,
    description: `${typologie.h1Seo} — Studio J Oliveira, designer paysagiste biophilique. Étude ${typologie.prixEtude}, budget travaux ${typologie.budgetTravaux}.`,
    priceRangeMin: typologie.coutEtudeNumeric,
    priceRangeMax: typologie.coutEtudeNumeric,
  }),
  faqPage(faq),
  breadcrumbs(breadcrumbItems),
]);
---

<BaseLayout
  title={`${typologie.h1Seo} — Micro urbain`}
  description={`${typologie.h1Seo} avec le Studio J Oliveira — terrasse, rooftop, patio. Étude ${typologie.prixEtude}, budget travaux ${typologie.budgetTravaux}. Studio biophilique à Brive‑la‑Gaillarde.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={schema} />
  </Fragment>

  {/* ═════════ 1 · HERO beige typographique + specs ═══════════════════════ */}
  <TypologieHero h1Lines={['Micro', 'urbain']} valeurs={valeurs} sectionLabel="Micro urbain" />

  {/* ═════════ 2 · GALERIE beige + manifeste Définir / Comprendre ═════════ */}
  <section data-theme="light" class="mu-gallery" aria-label="Sélection de projets micro urbain">
    <figure class="mu-gallery__large" data-reveal="image-rise">
      <Image
        src={largeTop}
        alt="Projet micro urbain — terrasse végétalisée sous ciel d'altitude"
        widths={[960, 1440, 1800]}
        sizes="(min-width: 1024px) 92vw, 96vw"
        quality={92}
        format="webp"
        loading="lazy"
        class="mu-gallery__img"
      />
    </figure>

    {/* Manifeste « Définir » */}
    <div class="mu-manifeste mu-manifeste--definir">
      <h2 class="mu-manifeste__title">Définir</h2>
      <div
        class="mu-manifeste__body"
        data-words-fade
        data-words-fade-stagger="0.006"
        data-words-fade-window="0.05,0.5"
      >
        <p class="mu-manifeste__para">{manifeste.bloc1}</p>
        <p class="mu-manifeste__para">{manifeste.bloc2}</p>
      </div>
    </div>

    <div class="mu-gallery__diptyque">
      <figure class="mu-gallery__diptyque-left" data-reveal="image-rise">
        <Image
          src={diptyqueLeft}
          alt="Projet micro urbain — escalier patio jardin minéral"
          widths={[480, 720, 1100]}
          sizes="(min-width: 1024px) 38vw, 92vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="mu-gallery__img"
        />
      </figure>
      <figure class="mu-gallery__diptyque-right" data-reveal="image-rise">
        <Image
          src={diptyqueRight}
          alt="Projet micro urbain — patio tropical intérieur-extérieur"
          widths={[640, 960, 1300]}
          sizes="(min-width: 1024px) 54vw, 96vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="mu-gallery__img"
        />
      </figure>
    </div>

    <figure class="mu-gallery__coda" data-reveal="image-rise">
      <Image
        src={coda}
        alt="Projet micro urbain — patio sol mosaïque sous arches béton, bordé de fougères"
        widths={[960, 1440, 1800]}
        sizes="(min-width: 1024px) 92vw, 96vw"
        quality={92}
        format="webp"
        loading="lazy"
        class="mu-gallery__img"
      />
    </figure>

    {/* Manifeste « Comprendre » */}
    <div class="mu-manifeste mu-manifeste--comprendre">
      <h2 class="mu-manifeste__title">Comprendre</h2>
      <p class="mu-manifeste__para">{manifeste.precision}</p>
    </div>
  </section>

  {/* ═════════ 3 · FAQ beige + marquee ═══════════════════════════════════ */}
  <TypologieFaq items={faq} />

  <style is:global>
    /* /architecture-paysagere/micro-urbain — DA finale beige/noir. */
    .mu-gallery {
      width: 100%;
      background-color: var(--color-cream);
      color: var(--color-ink);
      padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 3vw, 2.5rem);
    }
    .mu-gallery__large,
    .mu-gallery__coda {
      margin: 0;
      width: 100%;
      aspect-ratio: 3 / 2;
      overflow: hidden;
      border-radius: clamp(12px, 1.5vw, 22px);
      background-color: color-mix(in oklab, var(--color-ink) 6%, var(--color-cream));
    }
    @media (min-width: 1024px) {
      .mu-gallery__large,
      .mu-gallery__coda {
        aspect-ratio: 16 / 10;
      }
    }
    .mu-gallery__diptyque {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(1.25rem, 3vw, 2.5rem);
    }
    @media (min-width: 768px) {
      .mu-gallery__diptyque {
        grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
        align-items: stretch;
      }
    }
    .mu-gallery__diptyque-left,
    .mu-gallery__diptyque-right {
      margin: 0;
      overflow: hidden;
      border-radius: clamp(12px, 1.5vw, 22px);
      background-color: color-mix(in oklab, var(--color-ink) 6%, var(--color-cream));
      aspect-ratio: 4 / 5;
    }
    @media (min-width: 768px) {
      .mu-gallery__diptyque-left {
        aspect-ratio: 3 / 4;
        align-self: start;
        max-height: 78%;
      }
      .mu-gallery__diptyque-right {
        aspect-ratio: 4 / 5;
        align-self: end;
      }
    }
    .mu-gallery__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    .mu-manifeste {
      width: 100%;
      padding: clamp(2.5rem, 6vw, 5rem) 0;
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }
    @media (min-width: 1024px) {
      .mu-manifeste {
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr);
        column-gap: clamp(3rem, 6vw, 5rem);
        align-items: start;
      }
    }
    .mu-manifeste__title {
      font-family: var(--font-heading), sans-serif;
      font-weight: 900;
      font-size: clamp(2rem, 4.5vw, 4rem);
      line-height: 1;
      letter-spacing: -0.01em;
      color: var(--color-ink);
      margin: 0;
      text-transform: none;
    }
    .mu-manifeste__body {
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 2.2vw, 1.85rem);
    }
    .mu-manifeste__para {
      font-family: var(--font-body), sans-serif;
      font-weight: 400;
      font-size: clamp(1.1rem, 1.5vw, 1.5rem);
      line-height: 1.5;
      letter-spacing: -0.005em;
      color: var(--color-ink);
      margin: 0;
    }
    .mu-manifeste__body .word {
      display: inline-block;
      opacity: 0;
      transform: translateY(10px);
      will-change: opacity, transform;
    }
    .mu-gallery,
    .mu-manifeste {
      box-sizing: border-box;
    }
  </style>
</BaseLayout>
