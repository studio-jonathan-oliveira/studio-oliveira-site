---
/*
 * /architecture-paysagere/micro-urbain — page typologie pilote (refonte trame
 * Jonathan 2026-05-15). Route statique : Astro priorise ce fichier sur
 * `[slug].astro`, donc les 3 autres typologies (coeur-urbain, frange-urbaine,
 * domaine-caractere) gardent l'ancien template inchangé.
 *
 * Architecture issue de la trame Jonathan (re-lecture Morgan 2026-05-15 v3) :
 *   1. Hero photo plein-bleed (01-hero / terrasse-salon) :
 *      - H1 split « MICRO / URBAIN » en HAUT-GAUCHE
 *      - 4 specs (Secteur géo / Surface / Contexte / Complexité) en
 *        overlay sur le BAS de la photo (pas section séparée)
 *      - Voile gradient double (haut + bas) pour lisibilité
 *   2. Galerie magazine 4 photos :
 *      - 02-large-top (full-width 21:9)
 *      - 03 + 04 diptyque portraits asymétrique (38% + 54%)
 *      - 05-large-bottom (full-width 21:9)
 *   3. Manifeste — bloc texte décalé colonne DROITE sur desktop,
 *      taille agrandie (~1.2-1.65rem), précision italique petit dessous
 *   4. FAQ discrète 3 questions (densification SEO légère sur fond noir)
 *   5. CTA full-width « DECOUVRIR LES PROJETS MICRO URBAIN » + pill ROUGE
 *      plein (fond rouge + texte cream, ancien tone="accent" était invisible
 *      car laterite re-aliased en ink, cf. purge latérite 2026-05-02)
 *
 * Contenu Jonathan : VERBATIM trame (retour Morgan v3 — restauration des
 * fautes typo conservées) : « connectes », « soit pas une », « accéssibilité »,
 * « voir obligatoire ». H1 sans accent + « COEUR » sans ligature respectés
 * (esthétique designbyad signée Jonathan). À valider ensuite avec Jonathan.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { SITE } from '@/lib/site-config';
import {
  jsonLdGraph,
  breadcrumbs,
  localBusiness,
  organization,
  service as serviceSchema,
  faqPage,
} from '@/lib/schema-org';

import heroPhoto from '@/assets/typologies/micro-urbain/01-hero.jpg';
import largeTop from '@/assets/typologies/micro-urbain/02-large-top.jpg';
import diptyqueLeft from '@/assets/typologies/micro-urbain/03-diptyque-left.jpg';
import diptyqueRight from '@/assets/typologies/micro-urbain/04-diptyque-right.jpg';
import largeBottom from '@/assets/typologies/micro-urbain/05-large-bottom.jpg';

const typologie = SITE.typologies.find((t) => t.slug === 'micro-urbain')!;

// 4 specs hero — verbatim trame Jonathan, ordre exact.
const specs = [
  { label: 'Secteur géographique', valeur: 'Hyper urbain' },
  { label: 'Moyenne surface jardin', valeur: 'Moins de 100m² (hors cas spécifique)' },
  { label: 'Contexte environnemental', valeur: 'Roof-top / patios / micro jardins' },
  {
    label: 'Complexité spatiale et environnementale',
    valeur: 'Hauteur / accès / exposition / poids',
  },
];

// Manifeste — texte Jonathan VERBATIM trame, fautes typo conservées
// (retour Morgan 2026-05-15 v3 : restauration verbatim, on n'invente
// rien et on garde la voix Jonathan brute, à valider ensuite avec lui).
// Mots à NE PAS corriger ici : « connectes », « soit pas une »,
// « accéssibilité », « voir obligatoire ».
const manifeste = {
  bloc1:
    'La typologie micro urbaine se caractérise par des espaces de vie réduits, en hauteur ou encore enclavés entre les murs intérieurs du bâti.',
  bloc2:
    "Ce sont des espaces fortement connectes à la vie des habitations, soit par des perspectives directes depuis l'intérieur, soit pas une accéssibilité directe voir obligatoire depuis les circulations de l'intérieur vers l'extérieur.",
  precision:
    "Les contraintes liées à l'exposition aux vents forts et la portance structurelle pour les terrasses, l'ombre excessive et le taux élevé de l'hygrométrie pour les patios ou encore les accès difficiles à ces différents espaces établissent des contraintes très spécifiques dans l'élaboration de l'étude et la réalisation des ouvrages.",
};

// FAQ discrète — 3 questions à réponse validée (pas de placeholder draft
// pour ne pas polluer le pilote). Reformulations issues du process Jonathan
// + audit business existant sur /architecture-paysagere.
const faq = [
  {
    question: "Pourquoi facturer une étude alors que beaucoup de paysagistes l'offrent ?",
    answer:
      "Parce que c'est le cœur du métier. L'étude comprend le plan masse, les plans de plantations, le DCE, la mise en concurrence des entreprises et le suivi de chantier. Le chiffrage travaux vient ensuite, précisément.",
  },
  {
    question: `Est-ce que le prix d'étude (${typologie.prixEtude}) est ferme ?`,
    answer:
      "Oui — le prix est défini dès la signature du devis, en fonction de la typologie. Aucun ajout en cours d'étude sauf demande explicite du client (extension de périmètre, options, géomètre complémentaire).",
  },
  {
    question: 'Vous réalisez les travaux vous-mêmes ?',
    answer:
      'Non. Je conçois et je coordonne — je sélectionne et je pilote des entreprises mises en concurrence sur chaque lot (terrassement, maçonnerie paysagère, arrosage, éclairage, plantations).',
  },
];

const breadcrumbItems = [
  { name: 'Accueil', item: '/' },
  { name: 'Architecture paysagère', item: '/architecture-paysagere' },
  { name: typologie.nomProprietaire, item: `/architecture-paysagere/${typologie.slug}` },
];

const schema = jsonLdGraph([
  organization(),
  localBusiness(),
  serviceSchema({
    name: typologie.h1Seo,
    slug: typologie.slug,
    description: `${typologie.h1Seo} — Studio J Oliveira, designer paysagiste biophilique. Étude ${typologie.prixEtude}, budget travaux ${typologie.budgetTravaux}.`,
    priceRangeMin: typologie.coutEtudeNumeric,
    priceRangeMax: typologie.coutEtudeNumeric,
  }),
  faqPage(faq),
  breadcrumbs(breadcrumbItems),
]);
---

<BaseLayout
  title={`${typologie.h1Seo} — Micro urbain`}
  description={`${typologie.h1Seo} avec le Studio J Oliveira — terrasse, rooftop, patio. Étude ${typologie.prixEtude}, budget travaux ${typologie.budgetTravaux}. Studio biophilique à Brive‑la‑Gaillarde.`}
  darkHero
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={schema} />
  </Fragment>

  {
    /* ═════════ 1 · HERO photo + H1 haut-gauche + specs overlay bas ════════
     Refonte 2026-05-15 (retour Morgan trame) :
     - H1 « MICRO / URBAIN » en HAUT-GAUCHE de la photo (pas bas)
     - Les 4 specs sont POSÉES en overlay sur le BAS de la photo hero,
       pas dans une section noire séparée. Voile gradient double (haut +
       bas) pour lisibilité simultanée H1 et specs. */
  }
  <section
    id="hero"
    data-section-label="Micro urbain"
    data-theme="dark"
    class="mu-hero relative overflow-hidden bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="hero-title"
  >
    <div class="mu-hero__media">
      <Image
        src={heroPhoto}
        alt="Terrasse urbaine micro-urbain — projet Studio J Oliveira"
        widths={[960, 1440, 1920, 2560]}
        sizes="100vw"
        quality={92}
        format="webp"
        loading="eager"
        class="mu-hero__img"
      />
      {
        /* Voile gradient double — assombrit haut (lisibilité H1) ET bas
          (lisibilité specs), milieu transparent. Pas de flou (Jonathan). */
      }
      <div class="mu-hero__veil" aria-hidden="true"></div>
    </div>

    <div class="mu-hero__overlay">
      <div class="mu-hero__top">
        <h1 id="hero-title" class="mu-hero__title">
          <span class="mu-hero__title-line">MICRO</span>
          <span class="mu-hero__title-line">URBAIN</span>
        </h1>
      </div>

      <div class="mu-hero__bottom">
        <dl class="mu-hero__specs" aria-label="Caractéristiques typologie">
          {
            specs.map((s) => (
              <div class="mu-hero__spec-row">
                <dt class="mu-hero__spec-label">{s.label}</dt>
                <dd class="mu-hero__spec-value">{s.valeur}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  {
    /* ═════════ 2 · GALERIE — 4 photos rythme magazine ════════════════════
     Disposition trame Jonathan (capture Morgan 2026-05-15) :
       (1) photo large pleine largeur (02-large-top)
       (2) diptyque deux portraits : 03 plus petit gauche + 04 plus grand droite
       (3) photo large pleine largeur (05-large-bottom)
     Gouttières noires généreuses, aucun bord-à-bord. */
  }
  <section
    data-theme="dark"
    class="mu-gallery bg-[var(--color-black-deep)]"
    aria-label="Sélection de projets micro urbain"
  >
    <figure class="mu-gallery__large" data-reveal="image-rise">
      <Image
        src={largeTop}
        alt="Projet micro urbain — terrasse végétalisée sous ciel d'altitude"
        widths={[960, 1440, 1800]}
        sizes="(min-width: 1024px) 92vw, 96vw"
        quality={92}
        format="webp"
        loading="lazy"
        class="mu-gallery__img"
      />
    </figure>

    <div class="mu-gallery__diptyque">
      <figure class="mu-gallery__diptyque-left" data-reveal="image-rise">
        <Image
          src={diptyqueLeft}
          alt="Projet micro urbain — escalier patio jardin minéral"
          widths={[480, 720, 1100]}
          sizes="(min-width: 1024px) 38vw, 92vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="mu-gallery__img"
        />
      </figure>
      <figure class="mu-gallery__diptyque-right" data-reveal="image-rise">
        <Image
          src={diptyqueRight}
          alt="Projet micro urbain — patio tropical intérieur-extérieur"
          widths={[640, 960, 1300]}
          sizes="(min-width: 1024px) 54vw, 96vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="mu-gallery__img"
        />
      </figure>
    </div>

    <figure class="mu-gallery__large" data-reveal="image-rise">
      <Image
        src={largeBottom}
        alt="Projet micro urbain — rooftop avec vue panoramique urbaine"
        widths={[960, 1440, 1800]}
        sizes="(min-width: 1024px) 92vw, 96vw"
        quality={92}
        format="webp"
        loading="lazy"
        class="mu-gallery__img"
      />
    </figure>
  </section>

  {/* ═════════ 3 · MANIFESTE typologie ════════════════════════════════════ */}
  <section
    id="manifeste"
    data-section-label="Manifeste"
    data-theme="dark"
    class="mu-manifeste bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="manifeste-title"
  >
    <div class="mu-manifeste__inner">
      <h2 id="manifeste-title" class="sr-only">La typologie micro urbain</h2>
      <div
        class="mu-manifeste__body"
        data-words-fade
        data-words-fade-stagger="0.006"
        data-words-fade-window="0.05,0.5"
      >
        <p class="mu-manifeste__para">{manifeste.bloc1}</p>
        <p class="mu-manifeste__para">{manifeste.bloc2}</p>
      </div>
      <p class="mu-manifeste__precision">{manifeste.precision}</p>
    </div>
  </section>

  {/* ═════════ 4 · FAQ discrète ══════════════════════════════════════════ */}
  <section
    id="faq"
    data-section-label="FAQ"
    data-theme="dark"
    class="mu-faq bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="faq-title"
  >
    <div class="mu-faq__inner">
      <p class="mu-faq__eyebrow">Questions fréquentes</p>
      <h2 id="faq-title" class="mu-faq__title">Avant d'appeler.</h2>
      <ul class="mu-faq__list">
        {
          faq.map((item) => (
            <li class="mu-faq__item">
              <details class="mu-faq__details group">
                <summary class="mu-faq__summary">
                  <span>{item.question}</span>
                  <span class="mu-faq__plus" aria-hidden="true">
                    +
                  </span>
                </summary>
                <p class="mu-faq__answer">{item.answer}</p>
              </details>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ═════════ 5 · CTA full-width « DECOUVRIR LES PROJETS MICRO URBAIN » ══ */}
  <section
    data-theme="dark"
    class="mu-cta bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="cta-title"
  >
    <a href="/realisations" class="mu-cta__link" data-cursor-label="VOIR">
      <h2
        id="cta-title"
        class="mu-cta__title"
        data-justify-multi
        data-justify-amp="50"
        data-justify-line-step="0.15"
        data-justify-line-window="0.55"
      >
        <span class="mu-cta__title-line" data-justify-line data-justify-direction="from-right">
          DECOUVRIR LES PROJETS MICRO URBAIN
        </span>
      </h2>
    </a>
    <a href="/demarrer-un-projet" class="mu-cta__pill-red" data-magnetic="0.2" data-cursor-skip>
      <span class="mu-cta__pill-dot" aria-hidden="true"></span>
      <span class="mu-cta__pill-label">Démarrer un projet</span>
      <img
        src="/brand/fleche-white.webp"
        alt=""
        aria-hidden="true"
        class="mu-cta__pill-arrow"
        width="32"
        height="32"
      />
    </a>
  </section>

  <style is:global>
    /* ═══════════════════════════════════════════════════════════════════════
     * /architecture-paysagere/micro-urbain — refonte trame Jonathan 2026-05-15.
     * Pattern noir + cream + accent rouge. Reproduit les tokens et conventions
     * des pages home + studio (full-bleed sections, padding cohérent, no max-width
     * sur les inners pour la respiration designbyad).
     * ═══════════════════════════════════════════════════════════════════ */

    /* ─── 1 · Hero photo + H1 haut-gauche + specs overlay bas ───────────── */
    .mu-hero {
      position: relative;
      width: 100%;
      min-height: 100svh;
      isolation: isolate;
    }
    .mu-hero__media {
      position: absolute;
      inset: 0;
      overflow: hidden;
    }
    .mu-hero__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }
    /* Voile gradient DOUBLE — sombre en haut (zone H1) + sombre en bas
       (zone specs), transparent au milieu. Pas de flou (Jonathan).
       Garantit la lisibilité du texte cream overlay sur n'importe quelle
       photo, sans rogner la zone visuelle centrale de l'image. */
    .mu-hero__veil {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        color-mix(in oklab, var(--color-black-deep) 72%, transparent) 0%,
        color-mix(in oklab, var(--color-black-deep) 30%, transparent) 20%,
        transparent 45%,
        transparent 60%,
        color-mix(in oklab, var(--color-black-deep) 30%, transparent) 80%,
        color-mix(in oklab, var(--color-black-deep) 75%, transparent) 100%
      );
      pointer-events: none;
    }
    .mu-hero__overlay {
      position: relative;
      z-index: 1;
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: clamp(5.5rem, 12vh, 8rem) clamp(1.5rem, 5vw, 4rem) clamp(2rem, 5vw, 3.5rem);
    }
    .mu-hero__top {
      width: 100%;
      display: flex;
      justify-content: flex-start;
      align-items: flex-start;
    }
    .mu-hero__bottom {
      width: 100%;
    }
    /* H1 split — ExtraLight 200 UPPERCASE (retour Morgan v6 2026-05-15 :
       le titre passe en thin pour respecter la signature designbyad et
       contraster avec les éventuelles photos hero chargées). 2 lignes
       empilées tight, posé HAUT-GAUCHE. Pas d'animation : LCP immédiat. */
    .mu-hero__title {
      font-family: var(--font-heading), sans-serif;
      font-weight: 200;
      font-size: clamp(2.6rem, 9vw, 8rem);
      line-height: 0.95;
      letter-spacing: -0.005em;
      text-transform: uppercase;
      color: var(--color-cream);
      margin: 0;
      max-width: none;
    }
    .mu-hero__title-line {
      display: block;
    }

    /* Specs overlay bas — 4 paires label/valeur en 2 colonnes desktop,
       posées sur la photo (pas de fond noir séparé, le voile gradient bas
       du veil suffit à les rendre lisibles). Border-top fine cream pour
       les détacher du visuel sans rompre la continuité de la photo. */
    .mu-hero__specs {
      margin: 0;
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(0.85rem, 1.5vw, 1.25rem);
      padding-top: clamp(1.25rem, 2.5vw, 1.75rem);
      border-top: 1px solid color-mix(in oklab, var(--color-cream) 35%, transparent);
    }
    @media (min-width: 768px) {
      .mu-hero__specs {
        grid-template-columns: 1fr 1fr;
        column-gap: clamp(2.5rem, 6vw, 5rem);
        row-gap: clamp(0.85rem, 1.5vw, 1.25rem);
      }
    }
    .mu-hero__spec-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(1rem, 2vw, 2rem);
      align-items: baseline;
    }
    .mu-hero__spec-label {
      font-family: var(--font-body), sans-serif;
      font-weight: 200;
      font-size: clamp(0.78rem, 0.95vw, 0.95rem);
      line-height: 1.35;
      color: color-mix(in oklab, var(--color-cream) 75%, transparent);
      margin: 0;
    }
    .mu-hero__spec-value {
      font-family: var(--font-body), sans-serif;
      font-weight: 400;
      font-size: clamp(0.78rem, 0.95vw, 0.95rem);
      line-height: 1.35;
      color: var(--color-cream);
      text-align: right;
      margin: 0;
    }

    /* ─── 2 · Galerie magazine ──────────────────────────────────────────── */
    .mu-gallery {
      width: 100%;
      padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 3vw, 2.5rem);
    }
    /* Photos « large » pleine largeur — ratio cinéma allégé pour montrer
       plus de l'image (Morgan v4 2026-05-15 : « image 02 trop zoomée »).
       Passe de 21:9 → 16:10 desktop, 4:3 → 3:2 mobile. */
    .mu-gallery__large {
      margin: 0;
      width: 100%;
      aspect-ratio: 3 / 2;
      overflow: hidden;
      background-color: var(--color-black-deep);
    }
    @media (min-width: 1024px) {
      .mu-gallery__large {
        aspect-ratio: 16 / 10;
      }
    }
    /* Diptyque 03 + 04 — pattern trame Jonathan : portrait gauche plus
       petit (38%) + portrait droite plus grand (54%) + gouttière.
       Alignement vertical décalé pour effet quinconce magazine. */
    .mu-gallery__diptyque {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(1.25rem, 3vw, 2.5rem);
    }
    @media (min-width: 768px) {
      .mu-gallery__diptyque {
        grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
        align-items: stretch;
      }
    }
    .mu-gallery__diptyque-left,
    .mu-gallery__diptyque-right {
      margin: 0;
      overflow: hidden;
      background-color: var(--color-black-deep);
    }
    .mu-gallery__diptyque-left {
      aspect-ratio: 4 / 5;
    }
    .mu-gallery__diptyque-right {
      aspect-ratio: 4 / 5;
    }
    @media (min-width: 768px) {
      .mu-gallery__diptyque-left {
        aspect-ratio: 3 / 4;
        align-self: start;
        max-height: 78%;
      }
      .mu-gallery__diptyque-right {
        aspect-ratio: 4 / 5;
        align-self: end;
      }
    }
    .mu-gallery__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    /* ─── 3 · Manifeste ─────────────────────────────────────────────────── */
    /* Pattern capture Morgan 2026-05-15 v3 : bloc texte décalé en col DROITE
       sur desktop (col gauche vide pour la respiration), taille de texte
       AGRANDIE (clamp ~1.25-1.6rem), poids regular/light pour rester lisible
       sur fond noir sans crier. Italique précision en plus petit dessous.
       v6 retour Morgan : padding-right = 0 → la section texte va JUSQU'AU
       BORD DROIT de l'écran (la col droite du grid 1fr 2fr le fait aller
       au bord). Padding-left conservé pour la respiration côté gauche. */
    .mu-manifeste {
      width: 100%;
      padding: clamp(5rem, 10vw, 9rem) 0 clamp(5rem, 10vw, 9rem) clamp(1.5rem, 5vw, 4rem);
    }
    .mu-manifeste__inner {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(2rem, 4vw, 3.5rem);
    }
    @media (min-width: 1024px) {
      /* Retour Morgan v5 2026-05-15 : le bloc texte doit occuper les 2/3
         DROITS de la largeur (1/3 vide à gauche pour la respiration).
         Grid 1fr 2fr donne pile ce ratio. */
      .mu-manifeste__inner {
        grid-template-columns: 1fr 2fr;
        column-gap: clamp(3rem, 6vw, 5rem);
        align-items: start;
      }
      /* Texte + précision posés en colonne DROITE (2/3). */
      .mu-manifeste__body,
      .mu-manifeste__precision {
        grid-column: 2;
      }
    }
    .mu-manifeste__body {
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 2.2vw, 1.85rem);
      /* Pas de max-width : le texte va jusqu'au bord droit, respect du
         retour Morgan v6 « jusqu'au bord droit de l'écran ». Le padding
         de section pose la marge gauche. */
      padding-right: clamp(1.5rem, 5vw, 4rem);
    }
    .mu-manifeste__para {
      font-family: var(--font-body), sans-serif;
      font-weight: 400;
      font-size: clamp(1.2rem, 1.65vw, 1.65rem);
      line-height: 1.45;
      letter-spacing: -0.005em;
      color: var(--color-cream);
      margin: 0;
    }
    .mu-manifeste__body .word {
      display: inline-block;
      opacity: 0;
      transform: translateY(10px);
      will-change: opacity, transform;
    }
    .mu-manifeste__precision {
      font-family: var(--font-body), sans-serif;
      font-style: italic;
      font-weight: 300;
      font-size: clamp(0.85rem, 0.95vw, 0.95rem);
      line-height: 1.6;
      color: color-mix(in oklab, var(--color-cream) 80%, transparent);
      text-align: left;
      margin: clamp(2rem, 3.5vw, 3rem) 0 0;
      padding-right: clamp(1.5rem, 5vw, 4rem);
      max-width: 64ch;
    }

    /* ─── 4 · FAQ discrète ──────────────────────────────────────────────── */
    .mu-faq {
      width: 100%;
