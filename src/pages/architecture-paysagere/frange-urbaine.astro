---
/*
 * /architecture-paysagere/frange-urbaine — DA finale beige/noir 2026-06-04
 * (trames « modif finales »). Même patron que coeur-urbain (pilote validé).
 * Hero beige typographique, galerie beige + Définir/Comprendre, FAQ beige
 * + marquee. Contenu Jonathan VERBATIM.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import TypologieHero from '@/components/astro/TypologieHero.astro';
import TypologieFaq from '@/components/astro/TypologieFaq.astro';
import { SITE } from '@/lib/site-config';
import {
  jsonLdGraph,
  breadcrumbs,
  localBusiness,
  organization,
  service as serviceSchema,
  faqPage,
} from '@/lib/schema-org';

// Galerie — ordre piloté par le préfixe numérique (Morgan 2026-05-21).
import gal02 from '@/assets/typologies/frange-urbaine/02-palmiers.jpg';
import gal03 from '@/assets/typologies/frange-urbaine/03-maison.jpg';
import gal04 from '@/assets/typologies/frange-urbaine/04-chemin.jpg';
import gal05 from '@/assets/typologies/frange-urbaine/05-maison.jpg';
import gal06 from '@/assets/typologies/frange-urbaine/06-piscine.jpg';
import gal07 from '@/assets/typologies/frange-urbaine/07-photo.jpg';
import gal08 from '@/assets/typologies/frange-urbaine/08-photo.jpg';

const typologie = SITE.typologies.find((t) => t.slug === 'frange-urbaine')!;

// 4 valeurs droite — verbatim dictée Morgan 2026-05-21.
const valeurs = [
  'Zone péri urbaine et province',
  'de 500 à 1500 m² (hors cas spécifique)',
  'Jardins en pente / Jardins péri-urbains / Propriétés principales, secondaires et résidentielles',
  'Accès / topographie / surface / environnement',
] as const;

// Manifeste VERBATIM Jonathan (scindé Définir / Comprendre).
const manifeste = {
  bloc1:
    'La typologie Frange urbaine se caractérise par de grands espaces de vie extérieurs dont les propriétés animent les couronnes extérieures du tissu urbain vers la province.',
  bloc2:
    "Ces propriétés familiales offrent des points de vue à fort potentiel sur les paysages environnants et le jardin est une pièce à part entière d'usage intensif, souvent composées d'un espace de stationnement et d'accueil et d'un jardin arrière destiné à la vie de la famille.",
  precision:
    "La complexité de cette typologie repose principalement sur la topographie du jardin, souvent en pente qu'il faut remodeler pour améliorer l'usage et la fonctionnalité de l'espace. La typologie est rythmée par des structures qui viennent impacter à la fois l'usage du site et le paysage dans son ensemble.",
};

// FAQ — 3 Q/R VERBATIM trame (communes aux 4 typologies).
const faq = [
  {
    question: 'Comment se compose une étude ?',
    answer:
      "Il y a 3 phases : l'étude préliminaire, l'étude projet et le suivi de chantier.\n\nL'étude préliminaire : elle recadre le contexte du projet et structure les orientations de projet. C'est une synthèse de la commande et de la structuration des axes directeurs du projet avec une budgétisation des grands lots travaux.\n\nL'étude projet : elle rentre dans le détail de conception suite à la validation de l'étude préliminaire. Dans cette phase, le studio développe, organise, et consulte les entreprises et artisans pour le chiffrage précis des travaux.\n\nLe suivi de chantier : c'est la partie pilotage chantier. Elle est importante car elle permet de garantir un résultat final entre les intentions de projet et la réalisation. Le studio gère les compte rendus, le suivi financier ainsi que le pilotage des travaux avec les différentes entreprises sur le chantier. Vous payez une tranquilité d'esprit et de la disponibilité.",
  },
  {
    question: "Quels sont les livrables d'une étude ?",
    answer:
      "Étude préliminaire : étude du contexte projet, étude règlementaire et urbanisme, étude fonctionnelle et besoins, synthèse graphique, étude estimative budgétaire.\n\nÉtude projet : conception paysagère, étude végétales, dossier de consultation des entreprise, détails techniques, consultation des entreprises, dossier de réalisation.\n\nSuivi de chantier : comptes rendus de chantier, suivi d'avancement, validation des ouvrages, suivi financier, réception des travaux.",
  },
  {
    question: "Quel est le prix de l'étude pour cette typologie ?",
    answer:
      "En fonction de la typologie des jardins, le studio a établit des forfaits de base.\n\nViennent s'ajouter à ces forfaits de base :\n- des frais correspondant aux déplacements du studio (frais d'essence, péages, ...)\n- la mission géomètre\nen fonction de votre emplacement et des nécessité du projet et de l'étude.\n\nPour connaître le montant exact de votre étude, je vous invite à me contacter (ou remplir le formulaire via l'onglet \"démarrer un projet\" en haut de la page) afin que nous puissions échanger ensemble et définir tous les paramètres liés à votre projet.",
  },
];

const breadcrumbItems = [
  { name: 'Accueil', item: '/' },
  { name: 'Projets', item: '/projets' },
  { name: typologie.nomProprietaire, item: `/architecture-paysagere/${typologie.slug}` },
];

const schema = jsonLdGraph([
  organization(),
  localBusiness(),
  serviceSchema({
    name: typologie.h1Seo,
    slug: typologie.slug,
    description: `${typologie.h1Seo} — Studio J Oliveira, designer paysagiste biophilique. Étude ${typologie.prixEtude}, budget travaux ${typologie.budgetTravaux}.`,
    priceRangeMin: typologie.coutEtudeNumeric,
    priceRangeMax: typologie.coutEtudeNumeric,
  }),
  faqPage(faq),
  breadcrumbs(breadcrumbItems),
]);
---

<BaseLayout
  title={`${typologie.h1Seo} — Frange urbaine`}
  description={`${typologie.h1Seo} avec le Studio J Oliveira. Étude ${typologie.prixEtude}, budget travaux ${typologie.budgetTravaux}. Studio biophilique à Brive‑la‑Gaillarde.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={schema} />
  </Fragment>

  {/* ═════════ 1 · HERO beige typographique + specs ═══════════════════════ */}
  <TypologieHero h1Lines={['Frange', 'urbaine']} valeurs={valeurs} sectionLabel="Frange urbaine" />

  {/* ═════════ 2 · GALERIE beige + manifeste Définir / Comprendre ═════════ */}
  <section data-theme="dark" class="fu-gallery" aria-label="Sélection de projets frange urbaine">
    <figure class="fu-gallery__large" data-reveal="image-rise">
      <Image
        src={gal02}
        alt="Projet frange urbaine — villa méditerranéenne sur fairway, palmiers en silhouette"
        widths={[960, 1440, 1800]}
        sizes="(min-width: 1024px) 92vw, 96vw"
        quality={92}
        format="webp"
        loading="lazy"
        class="fu-gallery__img"
      />
    </figure>

    {/* Manifeste « Définir » */}
    <div class="fu-manifeste fu-manifeste--definir">
      <h2 class="fu-manifeste__title">Définir</h2>
      <div
        class="fu-manifeste__body"
        data-words-fade
        data-words-fade-stagger="0.006"
        data-words-fade-window="0.05,0.5"
      >
        <p class="fu-manifeste__para">{manifeste.bloc1}</p>
        <p class="fu-manifeste__para">{manifeste.bloc2}</p>
      </div>
    </div>

    <figure class="fu-gallery__large" data-reveal="image-rise">
      <Image
        src={gal03}
        alt="Projet frange urbaine — façade méditerranéenne à arches avec cactus sculptural et agaves"
        widths={[960, 1440, 1800]}
        sizes="(min-width: 1024px) 92vw, 96vw"
        quality={92}
        format="webp"
        loading="lazy"
        class="fu-gallery__img"
      />
    </figure>

    <div class="fu-gallery__diptyque fu-gallery__diptyque--portraits">
      <figure class="fu-gallery__diptyque-left" data-reveal="image-rise">
        <Image
          src={gal04}
          alt="Projet frange urbaine — jardin japonais zen, pas japonais minéraux et érables verts"
          widths={[480, 720, 1100]}
          sizes="(min-width: 1024px) 38vw, 92vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="fu-gallery__img"
        />
      </figure>
      <figure class="fu-gallery__diptyque-right" data-reveal="image-rise">
        <Image
          src={gal05}
          alt="Projet frange urbaine — maison hispanique blanche avec escalier extérieur, bougainvilliers et monstera"
          widths={[640, 960, 1300]}
          sizes="(min-width: 1024px) 54vw, 96vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="fu-gallery__img"
        />
      </figure>
    </div>

    <div class="fu-gallery__diptyque fu-gallery__diptyque--landscapes">
      <figure class="fu-gallery__diptyque-left" data-reveal="image-rise">
        <Image
          src={gal06}
          alt="Projet frange urbaine — patio moderne avec banquette outdoor, parasol et dalles minérales"
          widths={[640, 960, 1300]}
          sizes="(min-width: 1024px) 50vw, 96vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="fu-gallery__img"
        />
      </figure>
      <figure class="fu-gallery__diptyque-right" data-reveal="image-rise">
        <Image
          src={gal07}
          alt="Projet frange urbaine — architecture contemporaine avec bassin sombre et frangipanier"
          widths={[640, 960, 1300]}
          sizes="(min-width: 1024px) 50vw, 96vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="fu-gallery__img"
        />
      </figure>
    </div>

    <figure class="fu-gallery__large" data-reveal="image-rise">
      <Image
        src={gal08}
        alt="Projet frange urbaine — aménagement paysager"
        widths={[960, 1440, 1800]}
        sizes="(min-width: 1024px) 92vw, 96vw"
        quality={92}
        format="webp"
        loading="lazy"
        class="fu-gallery__img"
      />
    </figure>

    {/* Manifeste « Comprendre » */}
    <div class="fu-manifeste fu-manifeste--comprendre">
      <h2 class="fu-manifeste__title">Comprendre</h2>
      <p class="fu-manifeste__para">{manifeste.precision}</p>
    </div>
  </section>

  {/* ═════════ 3 · FAQ beige + marquee ═══════════════════════════════════ */}
  <TypologieFaq items={faq} />

  <style is:global>
    /* /architecture-paysagere/frange-urbaine — DA finale beige/noir. */
    .fu-gallery {
      width: 100%;
      background-color: var(--color-ink);
      color: var(--color-cream);
      padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 3vw, 2.5rem);
    }
    .fu-gallery__large {
      margin: 0;
      width: 100%;
      aspect-ratio: 3 / 2;
      overflow: hidden;
      border-radius: clamp(12px, 1.5vw, 22px);
      background-color: color-mix(in oklab, var(--color-cream) 6%, var(--color-ink));
    }
    @media (min-width: 1024px) {
      .fu-gallery__large {
        aspect-ratio: 16 / 10;
      }
    }
    .fu-gallery__diptyque {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(1.25rem, 3vw, 2.5rem);
    }
    @media (min-width: 768px) {
      .fu-gallery__diptyque--portraits {
        grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
        align-items: stretch;
      }
      .fu-gallery__diptyque--landscapes {
        grid-template-columns: 1fr 1fr;
        align-items: stretch;
      }
    }
    .fu-gallery__diptyque-left,
    .fu-gallery__diptyque-right {
      margin: 0;
      overflow: hidden;
      border-radius: clamp(12px, 1.5vw, 22px);
      background-color: color-mix(in oklab, var(--color-cream) 6%, var(--color-ink));
    }
    .fu-gallery__diptyque--portraits .fu-gallery__diptyque-left,
    .fu-gallery__diptyque--portraits .fu-gallery__diptyque-right {
      aspect-ratio: 4 / 5;
    }
    @media (min-width: 768px) {
      .fu-gallery__diptyque--portraits .fu-gallery__diptyque-left {
        aspect-ratio: 3 / 4;
        align-self: start;
        max-height: 78%;
      }
      .fu-gallery__diptyque--portraits .fu-gallery__diptyque-right {
        aspect-ratio: 4 / 5;
        align-self: end;
      }
    }
    .fu-gallery__diptyque--landscapes .fu-gallery__diptyque-left,
    .fu-gallery__diptyque--landscapes .fu-gallery__diptyque-right {
      aspect-ratio: 3 / 2;
    }
    .fu-gallery__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    .fu-manifeste {
      width: 100%;
      padding: clamp(2.5rem, 6vw, 5rem) 0;
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }
    @media (min-width: 1024px) {
      .fu-manifeste {
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr);
        column-gap: clamp(3rem, 6vw, 5rem);
        align-items: start;
      }
    }
    .fu-manifeste__title {
      font-family: var(--font-heading), sans-serif;
      font-weight: 900;
      font-size: clamp(2rem, 4.5vw, 4rem);
      line-height: 1;
      letter-spacing: -0.01em;
      color: var(--color-cream);
      margin: 0;
      text-transform: none;
    }
    .fu-manifeste__body {
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 2.2vw, 1.85rem);
    }
    .fu-manifeste__para {
      font-family: var(--font-body), sans-serif;
      font-weight: 400;
      font-size: clamp(1.1rem, 1.5vw, 1.5rem);
      line-height: 1.5;
      letter-spacing: -0.005em;
      color: var(--color-cream);
      margin: 0;
    }
    .fu-manifeste__body .word {
      display: inline-block;
      opacity: 0;
      transform: translateY(10px);
      will-change: opacity, transform;
    }
    .fu-gallery,
    .fu-manifeste {
      box-sizing: border-box;
    }
  </style>
</BaseLayout>
