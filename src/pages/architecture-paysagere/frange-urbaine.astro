---
/*
 * /architecture-paysagere/frange-urbaine — page typologie 2026-05-19.
 *
 * Structure identique aux pilotes micro-urbain + coeur-urbain :
 *   1. TypologieHero (composant partagé) avec H1 split + 4 specs sous H1
 *   2. Galerie magazine (TODO — Morgan doit sélectionner les images 02 → 0n)
 *   3. Manifeste typologie (placeholder Jonathan)
 *   4. FAQ discrète
 *   5. CTA full-width « DECOUVRIR LES PROJETS FRANGE URBAINE » + pill rouge
 *
 * Hero photo : `01-hero.jpg` (rendu Twinmotion fourni par Morgan
 * 2026-05-21 — maison + palmier + banquette outdoor + muret pierre).
 * Le hero placeholder précédent (carousel home `01-hero-home.jpg`) a
 * été retiré.
 *
 * Galerie : 6 photos, disposition magazine respectant l'ordre numérique :
 *   1. Singleton portrait centré        : 02-palmiers (opener)
 *   2. Large landscape full-width       : 03-maison
 *   3. Diptyque quinconce portraits     : 04-chemin small + 05-maison large
 *   4. Diptyque landscapes 50/50        : 06-piscine + 07-photo
 *
 * Manifeste + specs en placeholder explicite (rule CLAUDE.md §5 — ne JAMAIS
 * inventer de contenu pour Jonathan). À fournir par Morgan/Jonathan.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import TypologieHero from '@/components/astro/TypologieHero.astro';
import FaqAccordion from '@/components/islands/FaqAccordion';
import { SITE } from '@/lib/site-config';
import {
  jsonLdGraph,
  breadcrumbs,
  localBusiness,
  organization,
  service as serviceSchema,
  faqPage,
} from '@/lib/schema-org';

import heroPhoto from '@/assets/typologies/frange-urbaine/01-hero.jpg';
// Galerie — ordre piloté par le préfixe numérique (Morgan 2026-05-21).
import gal02 from '@/assets/typologies/frange-urbaine/02-palmiers.jpg';
import gal03 from '@/assets/typologies/frange-urbaine/03-maison.jpg';
import gal04 from '@/assets/typologies/frange-urbaine/04-chemin.jpg';
import gal05 from '@/assets/typologies/frange-urbaine/05-maison.jpg';
import gal06 from '@/assets/typologies/frange-urbaine/06-piscine.jpg';
import gal07 from '@/assets/typologies/frange-urbaine/07-photo.jpg';

const typologie = SITE.typologies.find((t) => t.slug === 'frange-urbaine')!;

// 4 valeurs droite — verbatim dictée Morgan 2026-05-21. Les 4 labels sont
// figés et viennent du composant `<TypologieHero>`.
const valeurs = [
  'Zone péri urbaine et province',
  'De 300 à 1500 m² (hors cas spécifique)',
  'Jardins en pente / propriétés principales, secondaires ou résidentielles',
  'Accès / topographie / surface / environnement',
] as const;

// Manifeste — texte VERBATIM Jonathan/Morgan 2026-05-21.
const manifeste = {
  bloc1:
    'La typologie Frange urbaine se caractérise par de grands espaces de vie extérieurs dont les propriétés animent les couronnes extérieures du tissu urbain vers la province.',
  bloc2:
    "Ces propriétés familiales offrent des points de vue à fort potentiel sur les paysages environnants et le jardin est une pièce à part entière d'usage intensif, souvent composées d'un espace de stationnement et d'accueil et d'un jardin arrière destiné à la vie de la famille.",
  precision:
    "La complexité de cette typologie repose principalement sur la topographie du jardin, souvent en pente qu'il faut remodeler pour améliorer l'usage et la fonctionnalité de l'espace. La typologie est rythmée par des structures qui viennent impacter à la fois l'usage du site et le paysage dans son ensemble.",
};

// FAQ — reprise du pattern micro/coeur urbain (générique inter-typologies).
const faq = [
  {
    question: "Pourquoi facturer une étude alors que beaucoup de paysagistes l'offrent ?",
    answer:
      "Parce que c'est le cœur du métier. L'étude comprend le plan masse, les plans de plantations, le DCE, la mise en concurrence des entreprises et le suivi de chantier. Le chiffrage travaux vient ensuite, précisément.",
  },
  {
    question: `Est-ce que le prix d'étude (${typologie.prixEtude}) est ferme ?`,
    answer:
      "Oui — le prix est défini dès la signature du devis, en fonction de la typologie. Aucun ajout en cours d'étude sauf demande explicite du client (extension de périmètre, options, géomètre complémentaire).",
  },
  {
    question: 'Vous réalisez les travaux vous-mêmes ?',
    answer:
      'Non. Je conçois et je coordonne — je sélectionne et je pilote des entreprises mises en concurrence sur chaque lot (terrassement, maçonnerie paysagère, arrosage, éclairage, plantations).',
  },
];

const breadcrumbItems = [
  { name: 'Accueil', item: '/' },
  { name: 'Architecture paysagère', item: '/architecture-paysagere' },
  { name: typologie.nomProprietaire, item: `/architecture-paysagere/${typologie.slug}` },
];

const schema = jsonLdGraph([
  organization(),
  localBusiness(),
  serviceSchema({
    name: typologie.h1Seo,
    slug: typologie.slug,
    description: `${typologie.h1Seo} — Studio J Oliveira, designer paysagiste biophilique. Étude ${typologie.prixEtude}, budget travaux ${typologie.budgetTravaux}.`,
    priceRangeMin: typologie.coutEtudeNumeric,
    priceRangeMax: typologie.coutEtudeNumeric,
  }),
  faqPage(faq),
  breadcrumbs(breadcrumbItems),
]);
---

<BaseLayout
  title={`${typologie.h1Seo} — Frange urbaine`}
  description={`${typologie.h1Seo} avec le Studio J Oliveira. Étude ${typologie.prixEtude}, budget travaux ${typologie.budgetTravaux}. Studio biophilique à Brive‑la‑Gaillarde.`}
  darkHero
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={schema} />
  </Fragment>

  {/* ═════════ 1 · HERO — composant partagé `<TypologieHero>` ═══════════ */}
  <TypologieHero
    photo={heroPhoto}
    alt="Frange urbaine — jardin résidentiel en pente avec banquette outdoor sous palmier"
    h1Lines={['FRANGE', 'URBAINE']}
    valeurs={valeurs}
    sectionLabel="Frange urbaine"
  />

  {
    /* ═════════ 2 · GALERIE — 6 photos rythme magazine ════════════════════
     Ordre piloté par le préfixe numérique (Morgan 2026-05-21).
       (1) Singleton portrait centré       : 02-palmiers (opener)
       (2) Large landscape full-width      : 03-maison
       (3) Diptyque quinconce portraits    : 04-chemin small + 05-maison large
       (4) Diptyque landscapes 50/50       : 06-piscine + 07-photo
     Gouttières noires généreuses, aucun bord-à-bord. */
  }
  <section
    data-theme="dark"
    class="fu-gallery bg-[var(--color-black-deep)]"
    aria-label="Sélection de projets frange urbaine"
  >
    <figure class="fu-gallery__single" data-reveal="image-rise">
      <Image
        src={gal02}
        alt="Projet frange urbaine — villa méditerranéenne sur fairway, palmiers en silhouette"
        widths={[480, 720, 1100]}
        sizes="(min-width: 1024px) 50vw, 92vw"
        quality={92}
        format="webp"
        loading="lazy"
        class="fu-gallery__img"
      />
    </figure>

    <figure class="fu-gallery__large" data-reveal="image-rise">
      <Image
        src={gal03}
        alt="Projet frange urbaine — façade méditerranéenne à arches avec cactus sculptural et agaves"
        widths={[960, 1440, 1800]}
        sizes="(min-width: 1024px) 92vw, 96vw"
        quality={92}
        format="webp"
        loading="lazy"
        class="fu-gallery__img"
      />
    </figure>

    <div class="fu-gallery__diptyque fu-gallery__diptyque--portraits">
      <figure class="fu-gallery__diptyque-left" data-reveal="image-rise">
        <Image
          src={gal04}
          alt="Projet frange urbaine — jardin japonais zen, pas japonais minéraux et érables verts"
          widths={[480, 720, 1100]}
          sizes="(min-width: 1024px) 38vw, 92vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="fu-gallery__img"
        />
      </figure>
      <figure class="fu-gallery__diptyque-right" data-reveal="image-rise">
        <Image
          src={gal05}
          alt="Projet frange urbaine — maison hispanique blanche avec escalier extérieur, bougainvilliers et monstera"
          widths={[640, 960, 1300]}
          sizes="(min-width: 1024px) 54vw, 96vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="fu-gallery__img"
        />
      </figure>
    </div>

    <div class="fu-gallery__diptyque fu-gallery__diptyque--landscapes">
      <figure class="fu-gallery__diptyque-left" data-reveal="image-rise">
        <Image
          src={gal06}
          alt="Projet frange urbaine — patio moderne avec banquette outdoor, parasol et dalles minérales"
          widths={[640, 960, 1300]}
          sizes="(min-width: 1024px) 50vw, 96vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="fu-gallery__img"
        />
      </figure>
      <figure class="fu-gallery__diptyque-right" data-reveal="image-rise">
        <Image
          src={gal07}
          alt="Projet frange urbaine — architecture contemporaine avec bassin sombre et frangipanier"
          widths={[640, 960, 1300]}
          sizes="(min-width: 1024px) 50vw, 96vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="fu-gallery__img"
        />
      </figure>
    </div>
  </section>

  {/* ═════════ 3 · MANIFESTE typologie ════════════════════════════════════ */}
  <section
    id="manifeste"
    data-section-label="Manifeste"
    data-theme="dark"
    class="fu-manifeste bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="manifeste-title"
  >
    <div class="fu-manifeste__inner">
      <h2 id="manifeste-title" class="sr-only">La typologie frange urbaine</h2>
      <div
        class="fu-manifeste__body"
        data-words-fade
        data-words-fade-stagger="0.006"
        data-words-fade-window="0.05,0.5"
      >
        <p class="fu-manifeste__para">{manifeste.bloc1}</p>
        <p class="fu-manifeste__para">{manifeste.bloc2}</p>
      </div>
      <p class="fu-manifeste__precision">{manifeste.precision}</p>
    </div>
  </section>

  {/* ═════════ 4 · FAQ discrète ══════════════════════════════════════════ */}
  <section
    id="faq"
    data-section-label="FAQ"
    data-theme="dark"
    class="fu-faq bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="faq-title"
  >
    <div class="fu-faq__inner">
      <div class="fu-faq__head">
        <p class="fu-faq__eyebrow">Questions fréquentes</p>
        <h2 id="faq-title" class="fu-faq__title">Avant d'appeler.</h2>
      </div>
      <FaqAccordion items={faq} client:visible />
    </div>
  </section>

  {/* ═════════ 5 · CTA full-width « DECOUVRIR LES PROJETS FRANGE URBAINE » */}
  <section
    data-theme="dark"
    class="fu-cta bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="cta-title"
  >
    <a href="/realisations" class="fu-cta__link" data-cursor-label="VOIR">
      <h2
        id="cta-title"
        class="fu-cta__title"
        data-justify-multi
        data-justify-amp="50"
        data-justify-line-step="0.15"
        data-justify-line-window="0.55"
      >
        <span class="fu-cta__title-line" data-justify-line data-justify-direction="from-right">
          DECOUVRIR LES PROJETS FRANGE URBAINE
        </span>
      </h2>
    </a>
    <a href="/demarrer-un-projet" class="fu-cta__pill-red" data-magnetic="0.2" data-cursor-skip>
      <span class="fu-cta__pill-dot" aria-hidden="true"></span>
      <span class="fu-cta__pill-label">Démarrer un projet</span>
      <img
        src="/brand/fleche-white.webp"
        alt=""
        aria-hidden="true"
        class="fu-cta__pill-arrow"
        width="32"
        height="32"
      />
    </a>
  </section>

  <style is:global>
    /* /architecture-paysagere/frange-urbaine — galerie / manifeste / FAQ / CTA
       en copie directe de micro/coeur-urbain (préfixe `fu-`). Le hero est
       dans `<TypologieHero>` partagé. */

    /* ─── 2 · Galerie magazine ──────────────────────────────────────────── */
    .fu-gallery {
      width: 100%;
      padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 3vw, 2.5rem);
    }
    /* Singleton portrait — opener atmosphere. Centré, max-width modéré
       sur desktop pour rester intime (pas pleine largeur, qui serait
       écrasant avec une photo très portrait avec beaucoup de ciel). */
    .fu-gallery__single {
      margin: 0 auto;
      width: 100%;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      background-color: var(--color-black-deep);
    }
    @media (min-width: 1024px) {
      .fu-gallery__single {
        max-width: 50%;
        aspect-ratio: 4 / 5;
      }
    }
    /* Large landscape — pleine largeur, ratio cinéma allégé. */
    .fu-gallery__large {
      margin: 0;
      width: 100%;
      aspect-ratio: 3 / 2;
      overflow: hidden;
      background-color: var(--color-black-deep);
    }
    @media (min-width: 1024px) {
      .fu-gallery__large {
        aspect-ratio: 16 / 10;
      }
    }
    /* Diptyques — 2 variantes :
       - portraits : quinconce 38%/54% avec décalage vertical magazine.
       - landscapes : 50/50 stretch, deux paysages côte à côte. */
    .fu-gallery__diptyque {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(1.25rem, 3vw, 2.5rem);
    }
    @media (min-width: 768px) {
      .fu-gallery__diptyque--portraits {
        grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
        align-items: stretch;
      }
      .fu-gallery__diptyque--landscapes {
        grid-template-columns: 1fr 1fr;
        align-items: stretch;
      }
    }
    .fu-gallery__diptyque-left,
    .fu-gallery__diptyque-right {
      margin: 0;
      overflow: hidden;
      background-color: var(--color-black-deep);
    }
    /* Portraits — quinconce magazine */
    .fu-gallery__diptyque--portraits .fu-gallery__diptyque-left,
    .fu-gallery__diptyque--portraits .fu-gallery__diptyque-right {
      aspect-ratio: 4 / 5;
    }
    @media (min-width: 768px) {
      .fu-gallery__diptyque--portraits .fu-gallery__diptyque-left {
        aspect-ratio: 3 / 4;
        align-self: start;
        max-height: 78%;
      }
      .fu-gallery__diptyque--portraits .fu-gallery__diptyque-right {
        aspect-ratio: 4 / 5;
        align-self: end;
      }
    }
    /* Landscapes — 50/50, aspect 3/2 par photo (les deux ensemble forment
       un panorama 3/1 visuel). */
    .fu-gallery__diptyque--landscapes .fu-gallery__diptyque-left,
    .fu-gallery__diptyque--landscapes .fu-gallery__diptyque-right {
      aspect-ratio: 3 / 2;
    }
    .fu-gallery__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    /* ─── 3 · Manifeste ─────────────────────────────────────────────────── */
    .fu-manifeste {
      width: 100%;
      padding: clamp(5rem, 10vw, 9rem) clamp(1.5rem, 5vw, 4rem);
    }
    .fu-manifeste__inner {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(2rem, 4vw, 3.5rem);
    }
    @media (min-width: 1024px) {
      .fu-manifeste__inner {
        grid-template-columns: 1fr 1.35fr;
        column-gap: clamp(3rem, 6vw, 5rem);
        align-items: start;
      }
      .fu-manifeste__body,
      .fu-manifeste__precision {
        grid-column: 2;
      }
    }
    .fu-manifeste__body {
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 2.2vw, 1.85rem);
    }
    .fu-manifeste__para {
      font-family: var(--font-body), sans-serif;
      font-weight: 400;
      font-size: clamp(1.2rem, 1.65vw, 1.65rem);
      line-height: 1.45;
      letter-spacing: -0.005em;
      color: var(--color-cream);
      margin: 0;
    }
    .fu-manifeste__body .word {
      display: inline-block;
      opacity: 0;
      transform: translateY(10px);
      will-change: opacity, transform;
    }
    .fu-manifeste__precision {
      font-family: var(--font-body), sans-serif;
      font-weight: 300;
      font-size: clamp(0.85rem, 0.95vw, 0.95rem);
      line-height: 1.6;
      color: color-mix(in oklab, var(--color-cream) 80%, transparent);
      text-align: left;
      margin: clamp(2.5rem, 4.5vw, 4rem) 0 0;
    }

    /* ─── 4 · FAQ discrète ──────────────────────────────────────────────── */
    .fu-faq {
      width: 100%;
      padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
      border-top: 1px solid color-mix(in oklab, var(--color-cream) 14%, transparent);
    }
    .fu-faq__inner {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }
    @media (min-width: 1024px) {
      .fu-faq__inner {
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr);
        column-gap: clamp(3rem, 6vw, 5rem);
        align-items: start;
      }
    }
    .fu-faq__head {
      display: flex;
      flex-direction: column;
      gap: clamp(0.4rem, 0.8vw, 0.7rem);
    }
    .fu-faq__eyebrow {
      font-family: var(--font-mono), monospace;
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: color-mix(in oklab, var(--color-cream) 55%, transparent);
      margin: 0;
    }
    .fu-faq__title {
      font-family: var(--font-heading), sans-serif;
      font-weight: 200;
      font-size: clamp(1.8rem, 3.5vw, 3rem);
      line-height: 1.05;
      letter-spacing: -0.01em;
      color: var(--color-cream);
      margin: 0;
    }
    @media (min-width: 1024px) {
      .fu-faq__inner .faq-acc__list {
        grid-column: 2;
      }
    }

    /* ─── 5 · CTA full-width ────────────────────────────────────────────── */
    .fu-cta {
      width: 100%;
      padding: clamp(4rem, 8vw, 7rem) 0 clamp(4rem, 8vw, 7rem);
      border-top: 1px solid color-mix(in oklab, var(--color-cream) 18%, transparent);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(2rem, 4vw, 3rem);
    }
    .fu-cta__link {
      display: block;
      width: 100%;
      padding: 0 clamp(1.5rem, 5vw, 4rem);
      text-decoration: none;
      color: inherit;
    }
    .fu-cta__title {
      width: 100%;
      margin: 0;
    }
    .fu-cta__title-line {
      display: block;
      width: 100%;
      font-family: var(--font-heading), sans-serif;
      font-weight: 200;
      font-size: clamp(1.4rem, 5.5vw, 5rem);
      line-height: 1.1;
      letter-spacing: 0;
      text-transform: uppercase;
      text-align: justify;
      text-align-last: justify;
      color: var(--color-cream);
      margin: 0;
      hyphens: none;
      white-space: nowrap;
      overflow: hidden;
    }
    @media (max-width: 767px) {
      .fu-cta__title-line {
        white-space: normal;
        text-align: left;
        text-align-last: left;
      }
    }
    .fu-cta__pill-red {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      padding: 0.85rem 1.6rem;
      background-color: var(--color-red);
      color: var(--color-cream);
      border-radius: 9999px;
      font-family: var(--font-body), sans-serif;
      font-weight: 600;
      font-size: clamp(0.9rem, 1.05vw, 1rem);
      letter-spacing: 0.01em;
      text-decoration: none;
      transition: transform 0.35s var(--ease-out-editorial);
      will-change: transform;
    }
    @media (hover: hover) {
      .fu-cta__pill-red:hover,
      .fu-cta__pill-red:focus-visible {
        transform: scale(1.04);
      }
    }
    .fu-cta__pill-dot {
      display: inline-block;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background-color: var(--color-cream);
      flex-shrink: 0;
    }
    .fu-cta__pill-label {
      white-space: nowrap;
    }
    .fu-cta__pill-arrow {
      width: 14px;
      height: 14px;
      display: inline-block;
      object-fit: contain;
      flex-shrink: 0;
    }
    .fu-gallery,
    .fu-manifeste,
    .fu-faq,
    .fu-cta {
      box-sizing: border-box;
    }
  </style>
</BaseLayout>
