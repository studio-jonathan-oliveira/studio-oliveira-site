---
/*
 * /architecture-paysagere/domaine-caractere — page typologie 2026-05-19.
 *
 * Structure identique aux pilotes micro-urbain + coeur-urbain. Voir
 * frange-urbaine.astro pour la doc détaillée (même squelette).
 *
 * H1 split : ['DOMAINES &', 'CARACTERE'] — décision Morgan 2026-05-19,
 * le « & » de la marque est conservé sur la 1re ligne. L'accent sur le
 * E final de « CARACTERE » reste retiré (esthétique designbyad signée
 * Jonathan, comme « COEUR » sans diphtongue Œ).
 *
 * Hero photo : carousel home (cf. brief Morgan 2026-05-19).
 * Source : public/typologies/04-domaine-caractere@2x.jpg → copiée dans
 * src/assets/typologies/domaine-caractere/01-hero-home.jpg.
 *
 * Contenus en placeholder explicite (rule CLAUDE.md §5).
 * Cf. _brief/contenus-manquants.md sous TYPOLOGIE-DOMAINE-CARACTERE-*.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import TypologieHero from '@/components/astro/TypologieHero.astro';
import FaqAccordion from '@/components/islands/FaqAccordion';
import { SITE } from '@/lib/site-config';
import {
  jsonLdGraph,
  breadcrumbs,
  localBusiness,
  organization,
  service as serviceSchema,
  faqPage,
} from '@/lib/schema-org';

import heroPhoto from '@/assets/typologies/domaine-caractere/01-hero-home.jpg';

const typologie = SITE.typologies.find((t) => t.slug === 'domaine-caractere')!;

const valeurs = [
  '[À FOURNIR : secteur géographique domaine caractère]',
  '[À FOURNIR : moyenne surface jardin]',
  '[À FOURNIR : contexte environnemental]',
  '[À FOURNIR : complexité spatiale et environnementale]',
] as const;

const manifeste = {
  bloc1: '[À FOURNIR PAR JONATHAN : 1er paragraphe manifeste domaine caractère ~30-40 mots]',
  bloc2: '[À FOURNIR PAR JONATHAN : 2e paragraphe manifeste domaine caractère ~30-40 mots]',
  precision: '[À FOURNIR PAR JONATHAN : précision technique domaine caractère ~60-80 mots]',
};

const faq = [
  {
    question: "Pourquoi facturer une étude alors que beaucoup de paysagistes l'offrent ?",
    answer:
      "Parce que c'est le cœur du métier. L'étude comprend le plan masse, les plans de plantations, le DCE, la mise en concurrence des entreprises et le suivi de chantier. Le chiffrage travaux vient ensuite, précisément.",
  },
  {
    question: `Est-ce que le prix d'étude (${typologie.prixEtude}) est ferme ?`,
    answer:
      "Oui — le prix est défini dès la signature du devis, en fonction de la typologie. Aucun ajout en cours d'étude sauf demande explicite du client (extension de périmètre, options, géomètre complémentaire).",
  },
  {
    question: 'Vous réalisez les travaux vous-mêmes ?',
    answer:
      'Non. Je conçois et je coordonne — je sélectionne et je pilote des entreprises mises en concurrence sur chaque lot (terrassement, maçonnerie paysagère, arrosage, éclairage, plantations).',
  },
];

const breadcrumbItems = [
  { name: 'Accueil', item: '/' },
  { name: 'Architecture paysagère', item: '/architecture-paysagere' },
  { name: typologie.nomProprietaire, item: `/architecture-paysagere/${typologie.slug}` },
];

const schema = jsonLdGraph([
  organization(),
  localBusiness(),
  serviceSchema({
    name: typologie.h1Seo,
    slug: typologie.slug,
    description: `${typologie.h1Seo} — Studio J Oliveira, designer paysagiste biophilique. Étude ${typologie.prixEtude}, budget travaux ${typologie.budgetTravaux}.`,
    priceRangeMin: typologie.coutEtudeNumeric,
    priceRangeMax: typologie.coutEtudeNumeric,
  }),
  faqPage(faq),
  breadcrumbs(breadcrumbItems),
]);
---

<BaseLayout
  title={`${typologie.h1Seo} — Domaines & Caractère`}
  description={`${typologie.h1Seo} avec le Studio J Oliveira — château, manoir, domaine familial. Étude ${typologie.prixEtude}, budget travaux ${typologie.budgetTravaux}. Studio biophilique à Brive‑la‑Gaillarde.`}
  darkHero
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={schema} />
  </Fragment>

  {/* ═════════ 1 · HERO — composant partagé `<TypologieHero>` ═══════════ */}
  <TypologieHero
    photo={heroPhoto}
    alt="Domaine & Caractère — projet Studio J Oliveira (visuel home carousel)"
    h1Lines={['DOMAINES &', 'CARACTERE']}
    valeurs={valeurs}
    sectionLabel="Domaines & Caractère"
    photoPosition="center 80%"
  />

  {
    /* ═════════ 2 · GALERIE — à compléter quand Morgan aura sélectionné
       les images 02, 03, etc. dans ses dossiers. Section omise pour
       l'instant (cf. frange-urbaine.astro). */
  }

  {/* ═════════ 3 · MANIFESTE typologie ════════════════════════════════════ */}
  <section
    id="manifeste"
    data-section-label="Manifeste"
    data-theme="dark"
    class="dc-manifeste bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="manifeste-title"
  >
    <div class="dc-manifeste__inner">
      <h2 id="manifeste-title" class="sr-only">La typologie domaines &amp; caractère</h2>
      <div
        class="dc-manifeste__body"
        data-words-fade
        data-words-fade-stagger="0.006"
        data-words-fade-window="0.05,0.5"
      >
        <p class="dc-manifeste__para">{manifeste.bloc1}</p>
        <p class="dc-manifeste__para">{manifeste.bloc2}</p>
      </div>
      <p class="dc-manifeste__precision">{manifeste.precision}</p>
    </div>
  </section>

  {/* ═════════ 4 · FAQ discrète ══════════════════════════════════════════ */}
  <section
    id="faq"
    data-section-label="FAQ"
    data-theme="dark"
    class="dc-faq bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="faq-title"
  >
    <div class="dc-faq__inner">
      <p class="dc-faq__eyebrow">Questions fréquentes</p>
      <h2 id="faq-title" class="dc-faq__title">Avant d'appeler.</h2>
      <FaqAccordion items={faq} client:visible />
    </div>
  </section>

  {/* ═════════ 5 · CTA full-width « DECOUVRIR LES PROJETS DOMAINES & CARACTERE » */}
  <section
    data-theme="dark"
    class="dc-cta bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="cta-title"
  >
    <a href="/realisations" class="dc-cta__link" data-cursor-label="VOIR">
      <h2
        id="cta-title"
        class="dc-cta__title"
        data-justify-multi
        data-justify-amp="50"
        data-justify-line-step="0.15"
        data-justify-line-window="0.55"
      >
        <span class="dc-cta__title-line" data-justify-line data-justify-direction="from-right">
          DECOUVRIR LES PROJETS DOMAINES & CARACTERE
        </span>
      </h2>
    </a>
    <a href="/demarrer-un-projet" class="dc-cta__pill-red" data-magnetic="0.2" data-cursor-skip>
      <span class="dc-cta__pill-dot" aria-hidden="true"></span>
      <span class="dc-cta__pill-label">Démarrer un projet</span>
      <img
        src="/brand/fleche-white.webp"
        alt=""
        aria-hidden="true"
        class="dc-cta__pill-arrow"
        width="32"
        height="32"
      />
    </a>
  </section>

  <style is:global>
    /* /architecture-paysagere/domaine-caractere — préfixe `dc-`. Manifeste
       / FAQ / CTA en copie directe de frange-urbaine (cf. ce fichier
       pour la doc). Hero dans `<TypologieHero>` partagé. */

    /* ─── 3 · Manifeste ─────────────────────────────────────────────────── */
    .dc-manifeste {
      width: 100%;
      padding: clamp(5rem, 10vw, 9rem) clamp(1.5rem, 5vw, 4rem);
    }
    .dc-manifeste__inner {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(2rem, 4vw, 3.5rem);
    }
    @media (min-width: 1024px) {
      .dc-manifeste__inner {
        grid-template-columns: 1fr 1.35fr;
        column-gap: clamp(3rem, 6vw, 5rem);
        align-items: start;
      }
      .dc-manifeste__body,
      .dc-manifeste__precision {
        grid-column: 2;
      }
    }
    .dc-manifeste__body {
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 2.2vw, 1.85rem);
    }
    .dc-manifeste__para {
      font-family: var(--font-body), sans-serif;
      font-weight: 400;
      font-size: clamp(1.2rem, 1.65vw, 1.65rem);
      line-height: 1.45;
      letter-spacing: -0.005em;
      color: var(--color-cream);
      margin: 0;
    }
    .dc-manifeste__body .word {
      display: inline-block;
      opacity: 0;
      transform: translateY(10px);
      will-change: opacity, transform;
    }
    .dc-manifeste__precision {
      font-family: var(--font-body), sans-serif;
      font-weight: 300;
      font-size: clamp(0.85rem, 0.95vw, 0.95rem);
      line-height: 1.6;
      color: color-mix(in oklab, var(--color-cream) 80%, transparent);
      text-align: left;
      margin: clamp(2.5rem, 4.5vw, 4rem) 0 0;
    }

    /* ─── 4 · FAQ discrète ──────────────────────────────────────────────── */
    .dc-faq {
      width: 100%;
      padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
      border-top: 1px solid color-mix(in oklab, var(--color-cream) 14%, transparent);
    }
    .dc-faq__inner {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }
    @media (min-width: 1024px) {
      .dc-faq__inner {
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr);
        column-gap: clamp(3rem, 6vw, 5rem);
        align-items: start;
      }
    }
    .dc-faq__eyebrow {
      font-family: var(--font-mono), monospace;
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: color-mix(in oklab, var(--color-cream) 55%, transparent);
      margin: 0;
    }
    .dc-faq__title {
      grid-column: 1;
      font-family: var(--font-heading), sans-serif;
      font-weight: 200;
      font-size: clamp(1.8rem, 3.5vw, 3rem);
      line-height: 1.05;
      letter-spacing: -0.01em;
      color: var(--color-cream);
      margin: clamp(0.5rem, 1vw, 0.85rem) 0 0;
    }
    @media (min-width: 1024px) {
      .dc-faq__eyebrow,
      .dc-faq__title {
        grid-column: 1;
      }
    }
    /* FAQ : la liste est rendue par <FaqAccordion> (classes `.faq-acc__*`
       dans global.css). On garde juste le positionnement grid du wrapper
       sur desktop pour que l'accordéon prenne la colonne droite. */
    @media (min-width: 1024px) {
      .dc-faq__inner > .faq-acc__list {
        grid-column: 2;
        grid-row: 1 / span 2;
      }
    }

    /* ─── 5 · CTA full-width ────────────────────────────────────────────── */
    .dc-cta {
      width: 100%;
      padding: clamp(4rem, 8vw, 7rem) 0 clamp(4rem, 8vw, 7rem);
      border-top: 1px solid color-mix(in oklab, var(--color-cream) 18%, transparent);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(2rem, 4vw, 3rem);
    }
    .dc-cta__link {
      display: block;
      width: 100%;
      padding: 0 clamp(1.5rem, 5vw, 4rem);
      text-decoration: none;
      color: inherit;
    }
    .dc-cta__title {
      width: 100%;
      margin: 0;
    }
    .dc-cta__title-line {
      display: block;
      width: 100%;
      font-family: var(--font-heading), sans-serif;
      font-weight: 200;
      font-size: clamp(1.4rem, 5.5vw, 5rem);
      line-height: 1.1;
      letter-spacing: 0;
      text-transform: uppercase;
      text-align: justify;
      text-align-last: justify;
      color: var(--color-cream);
      margin: 0;
      hyphens: none;
      white-space: nowrap;
      overflow: hidden;
    }
    @media (max-width: 767px) {
      .dc-cta__title-line {
        white-space: normal;
        text-align: left;
        text-align-last: left;
      }
    }
    .dc-cta__pill-red {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      padding: 0.85rem 1.6rem;
      background-color: var(--color-red);
      color: var(--color-cream);
      border-radius: 9999px;
      font-family: var(--font-body), sans-serif;
      font-weight: 600;
      font-size: clamp(0.9rem, 1.05vw, 1rem);
      letter-spacing: 0.01em;
      text-decoration: none;
      transition: transform 0.35s var(--ease-out-editorial);
      will-change: transform;
    }
    @media (hover: hover) {
      .dc-cta__pill-red:hover,
      .dc-cta__pill-red:focus-visible {
        transform: scale(1.04);
      }
    }
    .dc-cta__pill-dot {
      display: inline-block;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background-color: var(--color-cream);
      flex-shrink: 0;
    }
    .dc-cta__pill-label {
      white-space: nowrap;
    }
    .dc-cta__pill-arrow {
      width: 14px;
      height: 14px;
      display: inline-block;
      object-fit: contain;
      flex-shrink: 0;
    }
    .dc-manifeste,
    .dc-faq,
    .dc-cta {
      box-sizing: border-box;
    }
  </style>
</BaseLayout>
