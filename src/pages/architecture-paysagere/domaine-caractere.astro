---
/*
 * /architecture-paysagere/domaine-caractere — page typologie (refonte
 * 2026-05-22, alignée sur le pattern unifié `frange-urbaine.astro`).
 *
 * H1 split : ['DOMAINES &', 'CARACTERE'] — décision Morgan 2026-05-19,
 * le « & » de la marque est conservé sur la 1re ligne. L'accent sur le
 * E final de « CARACTERE » reste retiré (esthétique designbyad signée
 * Jonathan, comme « COEUR » sans diphtongue Œ).
 *
 * Photos fournies par Morgan 2026-05-22 (`_assets/domaine-caractere/`),
 * nommage numérique pilote l'ordre d'affichage. Le `05-maison.jpg`
 * source a été renommé `06-maison.jpg` côté destination pour combler
 * le trou de numérotation (Morgan a clarifié 2026-05-22 que `05-paysage`
 * est le vrai 05).
 *
 * Galerie — pattern frange-urbaine étendu (5 blocs vs 4, 7 photos vs 6) :
 *   1. Large landscape full-width   : 02-villa (portrait cover-crop)
 *   2. Large landscape full-width   : 03-maison (landscape natif)
 *   3. Diptyque quinconce portraits : 04-bleu small + 05-paysage large
 *   4. Large landscape full-width   : 06-maison (landscape natif)
 *   5. Diptyque quinconce inverse   : 07-maison large + 08-chemin small
 *
 * Specs + manifeste en placeholder explicite (rule CLAUDE.md §5).
 * Cf. _brief/contenus-manquants.md sous TYPOLOGIE-DOMAINE-CARACTERE-*.
 * Morgan fournira le contenu verbatim dans un prochain passage.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import TypologieHero from '@/components/astro/TypologieHero.astro';
import TypologieFaq from '@/components/astro/TypologieFaq.astro';
import { SITE } from '@/lib/site-config';
import {
  jsonLdGraph,
  breadcrumbs,
  localBusiness,
  organization,
  service as serviceSchema,
  faqPage,
} from '@/lib/schema-org';

import heroPhoto from '@/assets/typologies/domaine-caractere/01-hero.jpg';
// Galerie — ordre piloté par le préfixe numérique (Morgan 2026-05-22).
import gal02 from '@/assets/typologies/domaine-caractere/02-villa.jpg';
import gal03 from '@/assets/typologies/domaine-caractere/03-maison.jpg';
import gal04 from '@/assets/typologies/domaine-caractere/04-bleu.jpg';
import gal05 from '@/assets/typologies/domaine-caractere/05-paysage.jpg';
import gal06 from '@/assets/typologies/domaine-caractere/06-maison.jpg';
import gal07 from '@/assets/typologies/domaine-caractere/07-maison.jpg';
import gal08 from '@/assets/typologies/domaine-caractere/08-chemin.jpg';

const typologie = SITE.typologies.find((t) => t.slug === 'domaine-caractere')!;

// 4 valeurs droite — partiellement verbatim Morgan 2026-05-22 (secteur
// seulement, les 3 autres restent en placeholder en attendant Morgan).
// Les 4 labels sont figés et viennent du composant `<TypologieHero>`.
const valeurs = [
  'Urbain / péri urbain / province / campagne',
  'Plus de 1500 m²',
  'Architecture spécifique / multiples dépendances / valeur patrimoniale forte',
  '[À FOURNIR : complexité spatiale et environnementale]',
] as const;

// Manifeste — texte VERBATIM Jonathan/Morgan 2026-05-22. Cette typologie
// a 3 blocs (vs 2 sur les autres) — la structure est étendue ici uniquement.
// Typo « font partis » conservée (devrait être « font partie »).
const manifeste = {
  bloc1:
    'La typologie domaine et caractère est une typologie spéciale car elle considère une dimension architecturale très affirmée.',
  bloc2:
    'Châteaux, manoirs, propriétés familiales aux multiples dépendances font partis des propriétés destinées à cette typologie.',
  bloc3:
    "L'aménagement des espaces s'imprègne très fortement de l'environnement, de l'architecture et des usagers résidents ou de passage.",
  precision:
    "L'accent de cette typologie est porté sur un dialogue très précis entre architecture - environnement - usager avec une identité forte qui doit être gage d'un résultat logique et harmonieux d'un ensemble uni.",
};

// FAQ — verbatim Morgan/Jonathan 2026-05-21 (3 Q/R communes aux 4 pages
// typologies). Typos conservées tel quel : `strucurer`, `aloué`,
// `compte rendus`, `tranquilité`, `établit`, `forfait`, `puission`.
const faq = [
  {
    question: "Pourquoi facturer une étude alors que beaucoup de paysagistes l'offrent ?",
    answer:
      "L'étude d'un projet est un processus obligatoire qui permet de comprendre un projet, de le strucurer efficacement et d'anticiper les travaux et le budget qui lui sera aloué. Le studio n'a pas de standard matériaux, styles, tendances et autres. Il construit, de la conception jusqu'à la livraison, l'entièreté sur-mesure selon les caractéristiques du projet, de son environnement et de ses usagers.\n\nMon travail repose sur la réflexion, l'anticipation et le pilotage. Je ne réalise pas sur le chantier le projet, je suis le chef d'orchestre qui pense, accompagne et dirige le projet pour le rendre à la hauteur de vos attentes.",
  },
  {
    question: 'Comment se compose une étude ?',
    answer:
      "Il y a 3 phases : l'étude préliminaire, l'étude projet et le suivi de chantier.\n\nL'étude préliminaire : elle recadre le contexte du projet et structure les orientations de projet. C'est une synthèse de la commande et de la structuration des axes directeurs du projet avec une budgétisation des grands lots travaux.\n\nL'étude projet : elle rentre dans le détail de conception suite à la validation de l'étude préliminaire. Dans cette phase, le studio développe, organise, et consulte les entreprises et artisans pour le chiffrage précis des travaux.\n\nLe suivi de chantier : c'est la partie pilotage chantier. Elle est importante car elle permet de garantir un résultat final entre les intentions de projet et la réalisation. Le studio gère les compte rendus, le suivi financier ainsi que le pilotage des travaux avec les différentes entreprises sur le chantier. Vous payez une tranquilité d'esprit et de la disponibilité.",
  },
  {
    question: "Quel est le prix de l'étude pour cette typologie ?",
    answer:
      "En fonction de la typologie de votre propriété, le studio a établit des forfait de base.\n\nViennent s'ajouter à ce forfait de base des frais correspondant aux déplacements du studio (frais d'essence, péages, ...) en fonction de votre emplacement et du nombre de déplacements prévus par le besoin du projet.\n\nPour connaître le montant exact de votre étude, je vous invite à me contacter afin que nous puission échanger ensemble de votre projet pour définir ensemble tous les paramètres de l'étude.",
  },
];

const breadcrumbItems = [
  { name: 'Accueil', item: '/' },
  { name: 'Architecture paysagère', item: '/architecture-paysagere' },
  { name: typologie.nomProprietaire, item: `/architecture-paysagere/${typologie.slug}` },
];

const schema = jsonLdGraph([
  organization(),
  localBusiness(),
  serviceSchema({
    name: typologie.h1Seo,
    slug: typologie.slug,
    description: `${typologie.h1Seo} — Studio J Oliveira, designer paysagiste biophilique. Étude ${typologie.prixEtude}, budget travaux ${typologie.budgetTravaux}.`,
    priceRangeMin: typologie.coutEtudeNumeric,
    priceRangeMax: typologie.coutEtudeNumeric,
  }),
  faqPage(faq),
  breadcrumbs(breadcrumbItems),
]);
---

<BaseLayout
  title={`${typologie.h1Seo} — Domaines & Caractère`}
  description={`${typologie.h1Seo} avec le Studio J Oliveira — château, manoir, domaine familial. Étude ${typologie.prixEtude}, budget travaux ${typologie.budgetTravaux}. Studio biophilique à Brive‑la‑Gaillarde.`}
  darkHero
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={schema} />
  </Fragment>

  {/* ═════════ 1 · HERO — composant partagé `<TypologieHero>` ═══════════ */}
  <TypologieHero
    photo={heroPhoto}
    alt="Domaine & Caractère — jardin tropical premium avec allée minérale, palmiers et pavillon central"
    h1Lines={['DOMAINES &', 'CARACTERE']}
    valeurs={valeurs}
    sectionLabel="Domaines & Caractère"
  />

  {
    /* ═════════ 2 · GALERIE — 7 photos rythme magazine ════════════════════
     Ordre piloté par le préfixe numérique (Morgan 2026-05-22).
       (1) Large landscape full-width    : 02-villa (portrait cover-crop)
       (2) Large landscape full-width    : 03-maison (landscape natif)
       (3) Diptyque quinconce portraits  : 04-bleu small + 05-paysage large
       (4) Large landscape full-width    : 06-maison (landscape natif)
       (5) Diptyque quinconce inverse    : 07-maison large + 08-chemin small
     Pattern frange-urbaine étendu : alternance L · L · D · L · D.
     Gouttières noires généreuses, aucun bord-à-bord. */
  }
  <section
    data-theme="dark"
    class="dc-gallery bg-[var(--color-black-deep)]"
    aria-label="Sélection de projets domaines et caractère"
  >
    <figure class="dc-gallery__large" data-reveal="image-rise">
      <Image
        src={gal02}
        alt="Projet domaines et caractère — villa italienne ocre avec pergola fleurie sur balustrade en pierre"
        widths={[960, 1440, 1800]}
        sizes="(min-width: 1024px) 92vw, 96vw"
        quality={92}
        format="webp"
        loading="lazy"
        class="dc-gallery__img"
      />
    </figure>

    <figure class="dc-gallery__large" data-reveal="image-rise">
      <Image
        src={gal03}
        alt="Projet domaines et caractère — jardin japonais zen avec maison traditionnelle et buis sculptés"
        widths={[960, 1440, 1800]}
        sizes="(min-width: 1024px) 92vw, 96vw"
        quality={92}
        format="webp"
        loading="lazy"
        class="dc-gallery__img"
      />
    </figure>

    <div class="dc-gallery__diptyque dc-gallery__diptyque--top">
      <figure class="dc-gallery__diptyque-left" data-reveal="image-rise">
        <Image
          src={gal04}
          alt="Projet domaines et caractère — jardin Majorelle, façade bleu cobalt et cactus sculpturaux"
          widths={[480, 720, 1100]}
          sizes="(min-width: 1024px) 38vw, 92vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="dc-gallery__img"
        />
      </figure>
      <figure class="dc-gallery__diptyque-right" data-reveal="image-rise">
        <Image
          src={gal05}
          alt="Projet domaines et caractère — vue mer méditerranéenne sous pin parasol depuis une maison à toit ocre"
          widths={[640, 960, 1300]}
          sizes="(min-width: 1024px) 54vw, 96vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="dc-gallery__img"
        />
      </figure>
    </div>

    <figure class="dc-gallery__large" data-reveal="image-rise">
      <Image
        src={gal06}
        alt="Projet domaines et caractère — maison vernaculaire en pierre dans une prairie d'oliviers et herbes folles"
        widths={[960, 1440, 1800]}
        sizes="(min-width: 1024px) 92vw, 96vw"
        quality={92}
        format="webp"
        loading="lazy"
        class="dc-gallery__img"
      />
    </figure>

    <div class="dc-gallery__diptyque dc-gallery__diptyque--bot">
      <figure class="dc-gallery__diptyque-left" data-reveal="image-rise">
        <Image
          src={gal07}
          alt="Projet domaines et caractère — pavillon néoclassique à fronton triangulaire encadré de cyprès"
          widths={[640, 960, 1300]}
          sizes="(min-width: 1024px) 54vw, 96vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="dc-gallery__img"
        />
      </figure>
      <figure class="dc-gallery__diptyque-right" data-reveal="image-rise">
        <Image
          src={gal08}
          alt="Projet domaines et caractère — allée pavée romaine bordée de pins parasols et de cyprès"
          widths={[480, 720, 1100]}
          sizes="(min-width: 1024px) 38vw, 92vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="dc-gallery__img"
        />
      </figure>
    </div>
  </section>

  {/* ═════════ 3 · MANIFESTE typologie ════════════════════════════════════ */}
  <section
    id="manifeste"
    data-section-label="Manifeste"
    data-theme="dark"
    class="dc-manifeste bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="manifeste-title"
  >
    <div class="dc-manifeste__inner">
      <h2 id="manifeste-title" class="sr-only">La typologie domaines &amp; caractère</h2>
      <div
        class="dc-manifeste__body"
        data-words-fade
        data-words-fade-stagger="0.006"
        data-words-fade-window="0.05,0.5"
      >
        <p class="dc-manifeste__para">{manifeste.bloc1}</p>
        <p class="dc-manifeste__para">{manifeste.bloc2}</p>
        <p class="dc-manifeste__para">{manifeste.bloc3}</p>
      </div>
      <p class="dc-manifeste__precision">{manifeste.precision}</p>
    </div>
  </section>

  {/* ═════════ 4 · FAQ — composant partagé `<TypologieFaq>` ═════════════ */}
  <TypologieFaq items={faq} />

  {/* ═════════ 5 · CTA full-width « DECOUVRIR LES PROJETS DOMAINES & CARACTERE » */}
  <section
    data-theme="dark"
    class="dc-cta bg-[var(--color-black-deep)] text-[var(--color-cream)]"
    aria-labelledby="cta-title"
  >
    <a href="/realisations" class="dc-cta__link" data-cursor-label="VOIR">
      <h2
        id="cta-title"
        class="dc-cta__title"
        data-justify-multi
        data-justify-amp="50"
        data-justify-line-step="0.15"
        data-justify-line-window="0.55"
      >
        <span class="dc-cta__title-line" data-justify-line data-justify-direction="from-right">
          DECOUVRIR LES PROJETS DOMAINES & CARACTERE
        </span>
      </h2>
    </a>
    <a href="/demarrer-un-projet" class="dc-cta__pill-red" data-magnetic="0.2" data-cursor-skip>
      <span class="dc-cta__pill-dot" aria-hidden="true"></span>
      <span class="dc-cta__pill-label">Démarrer un projet</span>
      <img
        src="/brand/fleche-white.webp"
        alt=""
        aria-hidden="true"
        class="dc-cta__pill-arrow"
        width="32"
        height="32"
      />
    </a>
  </section>

  <style is:global>
    /* /architecture-paysagere/domaine-caractere — préfixe `dc-`. Galerie /
       manifeste / CTA en copie directe de frange-urbaine (cf. ce fichier
       pour la doc). Hero dans `<TypologieHero>` partagé, FAQ dans
       `<TypologieFaq>` partagé. */

    /* ─── 2 · Galerie magazine ──────────────────────────────────────────── */
    .dc-gallery {
      width: 100%;
      padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 3vw, 2.5rem);
    }
    /* Large landscape — pleine largeur, ratio cinéma allégé. Utilisé pour
       02-villa (P cover-crop), 03-maison, 06-maison. Photos portrait
       cover-croppées top+bottom. */
    .dc-gallery__large {
      margin: 0;
      width: 100%;
      aspect-ratio: 3 / 2;
      overflow: hidden;
      background-color: var(--color-black-deep);
    }
    @media (min-width: 1024px) {
      .dc-gallery__large {
        aspect-ratio: 16 / 10;
      }
    }
    /* Diptyques quinconce — 2 variantes :
       - top : small-gauche 38% + large-droite 54% avec décalage vertical
         magazine (4-bleu + 5-paysage).
       - bot : large-gauche 54% + small-droite 38%, miroir du top
         (7-maison + 8-chemin). */
    .dc-gallery__diptyque {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(1.25rem, 3vw, 2.5rem);
    }
    @media (min-width: 768px) {
      .dc-gallery__diptyque--top {
        grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
        align-items: stretch;
      }
      .dc-gallery__diptyque--bot {
        grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr);
        align-items: stretch;
      }
    }
    .dc-gallery__diptyque-left,
    .dc-gallery__diptyque-right {
      margin: 0;
      overflow: hidden;
      background-color: var(--color-black-deep);
    }
    /* --top : petit-gauche / grand-droite */
    .dc-gallery__diptyque--top .dc-gallery__diptyque-left,
    .dc-gallery__diptyque--top .dc-gallery__diptyque-right {
      aspect-ratio: 4 / 5;
    }
    @media (min-width: 768px) {
      .dc-gallery__diptyque--top .dc-gallery__diptyque-left {
        aspect-ratio: 3 / 4;
        align-self: start;
        max-height: 78%;
      }
      .dc-gallery__diptyque--top .dc-gallery__diptyque-right {
        aspect-ratio: 4 / 5;
        align-self: end;
      }
    }
    /* --bot : quinconce inverse (miroir du top) */
    .dc-gallery__diptyque--bot .dc-gallery__diptyque-left,
    .dc-gallery__diptyque--bot .dc-gallery__diptyque-right {
      aspect-ratio: 4 / 5;
    }
    @media (min-width: 768px) {
      .dc-gallery__diptyque--bot .dc-gallery__diptyque-left {
        aspect-ratio: 4 / 5;
        align-self: start;
      }
      .dc-gallery__diptyque--bot .dc-gallery__diptyque-right {
        aspect-ratio: 3 / 4;
        align-self: end;
        max-height: 78%;
      }
    }
    .dc-gallery__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    /* ─── 3 · Manifeste ─────────────────────────────────────────────────── */
    .dc-manifeste {
      width: 100%;
      padding: clamp(5rem, 10vw, 9rem) clamp(1.5rem, 5vw, 4rem);
    }
    .dc-manifeste__inner {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(2rem, 4vw, 3.5rem);
    }
    @media (min-width: 1024px) {
      .dc-manifeste__inner {
        grid-template-columns: 1fr 1.35fr;
        column-gap: clamp(3rem, 6vw, 5rem);
        align-items: start;
      }
      .dc-manifeste__body,
      .dc-manifeste__precision {
        grid-column: 2;
      }
    }
    .dc-manifeste__body {
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 2.2vw, 1.85rem);
    }
    .dc-manifeste__para {
      font-family: var(--font-body), sans-serif;
      font-weight: 400;
      font-size: clamp(1.2rem, 1.65vw, 1.65rem);
      line-height: 1.45;
      letter-spacing: -0.005em;
      color: var(--color-cream);
      margin: 0;
    }
    .dc-manifeste__body .word {
      display: inline-block;
      opacity: 0;
      transform: translateY(10px);
      will-change: opacity, transform;
    }
    .dc-manifeste__precision {
      font-family: var(--font-body), sans-serif;
      font-weight: 300;
      font-size: clamp(0.85rem, 0.95vw, 0.95rem);
      line-height: 1.6;
      color: color-mix(in oklab, var(--color-cream) 80%, transparent);
      text-align: left;
      margin: clamp(2.5rem, 4.5vw, 4rem) 0 0;
    }

    /* ─── 4 · FAQ ── désormais géré par `<TypologieFaq>` (composant
       partagé, refactor 2026-05-21). Plus de CSS FAQ ici. */

    /* ─── 5 · CTA full-width ────────────────────────────────────────────── */
    .dc-cta {
      width: 100%;
      padding: clamp(4rem, 8vw, 7rem) 0 clamp(4rem, 8vw, 7rem);
      border-top: 1px solid color-mix(in oklab, var(--color-cream) 18%, transparent);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(2rem, 4vw, 3rem);
    }
    .dc-cta__link {
      display: block;
      width: 100%;
      padding: 0 clamp(1.5rem, 5vw, 4rem);
      text-decoration: none;
      color: inherit;
    }
    .dc-cta__title {
      width: 100%;
      margin: 0;
    }
    .dc-cta__title-line {
      display: block;
      width: 100%;
      font-family: var(--font-heading), sans-serif;
      font-weight: 200;
      font-size: clamp(1.4rem, 5.5vw, 5rem);
      line-height: 1.1;
      letter-spacing: 0;
      text-transform: uppercase;
      text-align: justify;
      text-align-last: justify;
      color: var(--color-cream);
      margin: 0;
      hyphens: none;
      white-space: nowrap;
      overflow: hidden;
    }
    @media (max-width: 767px) {
      .dc-cta__title-line {
        white-space: normal;
        text-align: left;
        text-align-last: left;
      }
    }
    .dc-cta__pill-red {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      padding: 0.85rem 1.6rem;
      background-color: var(--color-red);
      color: var(--color-cream);
      border-radius: 9999px;
      font-family: var(--font-body), sans-serif;
      font-weight: 600;
      font-size: clamp(0.9rem, 1.05vw, 1rem);
      letter-spacing: 0.01em;
      text-decoration: none;
      transition: transform 0.35s var(--ease-out-editorial);
      will-change: transform;
    }
    @media (hover: hover) {
      .dc-cta__pill-red:hover,
      .dc-cta__pill-red:focus-visible {
        transform: scale(1.04);
      }
    }
    .dc-cta__pill-dot {
      display: inline-block;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background-color: var(--color-cream);
      flex-shrink: 0;
    }
    .dc-cta__pill-label {
      white-space: nowrap;
    }
    .dc-cta__pill-arrow {
      width: 14px;
      height: 14px;
      display: inline-block;
      object-fit: contain;
      flex-shrink: 0;
    }
    .dc-gallery,
    .dc-manifeste,
    .dc-cta {
      box-sizing: border-box;
    }
  </style>
</BaseLayout>
