---
/*
 * /architecture-paysagere/domaine-caractere — DA finale beige/noir 2026-06-04
 * (trames « modif finales »). Même patron que coeur-urbain (pilote validé).
 * Hero beige typographique, galerie beige + Définir/Comprendre, FAQ beige
 * + marquee. Contenu Jonathan VERBATIM (3 blocs manifeste).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import TypologieHero from '@/components/astro/TypologieHero.astro';
import TypologieFaq from '@/components/astro/TypologieFaq.astro';
import { SITE } from '@/lib/site-config';
import {
  jsonLdGraph,
  breadcrumbs,
  localBusiness,
  organization,
  service as serviceSchema,
  faqPage,
} from '@/lib/schema-org';

// Galerie — ordre piloté par le préfixe numérique (Morgan 2026-05-22).
import gal02 from '@/assets/typologies/domaine-caractere/02-villa.jpg';
import gal03 from '@/assets/typologies/domaine-caractere/03-maison.jpg';
import gal04 from '@/assets/typologies/domaine-caractere/04-bleu.jpg';
import gal05 from '@/assets/typologies/domaine-caractere/05-paysage.jpg';
import gal06 from '@/assets/typologies/domaine-caractere/06-maison.jpg';
import gal07 from '@/assets/typologies/domaine-caractere/07-maison.jpg';
import gal08 from '@/assets/typologies/domaine-caractere/08-chemin.jpg';

const typologie = SITE.typologies.find((t) => t.slug === 'domaine-caractere')!;

// 4 valeurs droite — verbatim Morgan 2026-05-22. La liste longue (index 2) est
// scindée en 2 lignes équilibrées via « \n » après « Maison de campagne »
// (Morgan 2026-06-08) — rendu par white-space: pre-line dans TypologieHero.
const valeurs = [
  'Urbain / péri urbain / province / campagne / front de mer',
  'plus de 1500 m² (hors cas spécifique)',
  "Châteaux / Manoirs / Maisons de caractère / Maisons d'architecte / Maison de campagne\nDomaines familiaux / Bord de mer / Domaines viticoles / Aras / Gîtes / Maisons d'hôtes",
  'Surface / architecture et urbanisme',
] as const;

// Manifeste VERBATIM Jonathan (3 blocs + precision). « font partis » conservé.
const manifeste = {
  bloc1:
    'La typologie domaine et caractère est une typologie spéciale car elle considère une dimension architecturale très affirmée.',
  bloc2:
    'Châteaux, manoirs, propriétés familiales aux multiples dépendances font partis des propriétés destinées à cette typologie.',
  bloc3:
    "L'aménagement des espaces s'imprègne très fortement de l'environnement, de l'architecture et des usagers résidents ou de passage.",
  precision:
    "L'accent de cette typologie est porté sur un dialogue très précis entre architecture - environnement - usager avec une identité forte qui doit être gage d'un résultat logique et harmonieux d'un ensemble uni.",
};

// FAQ — 3 Q/R VERBATIM trame (communes aux 4 typologies).
const faq = [
  {
    question: 'Comment se compose une étude ?',
    answer:
      "Il y a 3 phases : l'étude préliminaire, l'étude projet et le suivi de chantier.\n\nL'étude préliminaire : elle recadre le contexte du projet et structure les orientations de projet. C'est une synthèse de la commande et de la structuration des axes directeurs du projet avec une budgétisation des grands lots travaux.\n\nL'étude projet : elle rentre dans le détail de conception suite à la validation de l'étude préliminaire. Dans cette phase, le studio développe, organise, et consulte les entreprises et artisans pour le chiffrage précis des travaux.\n\nLe suivi de chantier : c'est la partie pilotage chantier. Elle est importante car elle permet de garantir un résultat final entre les intentions de projet et la réalisation. Le studio gère les compte rendus, le suivi financier ainsi que le pilotage des travaux avec les différentes entreprises sur le chantier. Vous payez une tranquilité d'esprit et de la disponibilité.",
  },
  {
    question: "Quels sont les livrables d'une étude ?",
    answer:
      "Étude préliminaire : étude du contexte projet, étude règlementaire et urbanisme, étude fonctionnelle et besoins, synthèse graphique, étude estimative budgétaire.\n\nÉtude projet : conception paysagère, étude végétales, dossier de consultation des entreprise, détails techniques, consultation des entreprises, dossier de réalisation.\n\nSuivi de chantier : comptes rendus de chantier, suivi d'avancement, validation des ouvrages, suivi financier, réception des travaux.",
  },
  {
    question: "Quel est le prix de l'étude pour cette typologie ?",
    answer:
      "En fonction de la typologie des jardins, le studio a établit des forfaits de base.\n\nViennent s'ajouter à ces forfaits de base :\n- des frais correspondant aux déplacements du studio (frais d'essence, péages, ...)\n- la mission géomètre\nen fonction de votre emplacement et des nécessité du projet et de l'étude.\n\nPour connaître le montant exact de votre étude, je vous invite à me contacter (ou remplir le formulaire via l'onglet \"démarrer un projet\" en haut de la page) afin que nous puissions échanger ensemble et définir tous les paramètres liés à votre projet.",
  },
];

const breadcrumbItems = [
  { name: 'Accueil', item: '/' },
  { name: 'Projets', item: '/projets' },
  { name: typologie.nomProprietaire, item: `/architecture-paysagere/${typologie.slug}` },
];

const schema = jsonLdGraph([
  organization(),
  localBusiness(),
  serviceSchema({
    name: typologie.h1Seo,
    slug: typologie.slug,
    description: `${typologie.h1Seo} — Studio J Oliveira, designer paysagiste biophilique. Étude ${typologie.prixEtude}, budget travaux ${typologie.budgetTravaux}.`,
    priceRangeMin: typologie.coutEtudeNumeric,
    priceRangeMax: typologie.coutEtudeNumeric,
  }),
  faqPage(faq),
  breadcrumbs(breadcrumbItems),
]);
---

<BaseLayout
  title={`${typologie.h1Seo} — Domaines & Caractère`}
  description={`${typologie.h1Seo} avec le Studio J Oliveira — château, manoir, domaine familial. Étude ${typologie.prixEtude}, budget travaux ${typologie.budgetTravaux}. Studio biophilique à Brive‑la‑Gaillarde.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={schema} />
  </Fragment>

  {/* ═════════ 1 · HERO beige typographique + specs ═══════════════════════ */}
  <TypologieHero
    h1Lines={['Domaine', '& Caractère']}
    valeurs={valeurs}
    sectionLabel="Domaines & Caractère"
  />

  {/* ═════════ 2 · GALERIE beige + manifeste Définir / Comprendre ═════════ */}
  <section
    data-theme="dark"
    class="dc-gallery"
    aria-label="Sélection de projets domaines et caractère"
  >
    <figure class="dc-gallery__large dc-gallery__large--natural" data-reveal="image-rise">
      <Image
        src={gal02}
        alt="Projet domaines et caractère — villa italienne ocre avec pergola fleurie sur balustrade en pierre"
        widths={[960, 1440, 1800]}
        sizes="(min-width: 1024px) 92vw, 96vw"
        quality={92}
        format="webp"
        loading="lazy"
        class="dc-gallery__img"
      />
    </figure>

    {/* Manifeste « Définir » (3 blocs) */}
    <div class="dc-manifeste dc-manifeste--definir">
      <h2 class="dc-manifeste__title">Définir</h2>
      <div
        class="dc-manifeste__body"
        data-words-fade
        data-words-fade-stagger="0.006"
        data-words-fade-window="0.05,0.5"
      >
        <p class="dc-manifeste__para">{manifeste.bloc1}</p>
        <p class="dc-manifeste__para">{manifeste.bloc2}</p>
        <p class="dc-manifeste__para">{manifeste.bloc3}</p>
      </div>
    </div>

    <figure class="dc-gallery__large" data-reveal="image-rise">
      <Image
        src={gal03}
        alt="Projet domaines et caractère — jardin japonais zen avec maison traditionnelle et buis sculptés"
        widths={[960, 1440, 1800]}
        sizes="(min-width: 1024px) 92vw, 96vw"
        quality={92}
        format="webp"
        loading="lazy"
        class="dc-gallery__img"
      />
    </figure>

    <div class="dc-gallery__diptyque dc-gallery__diptyque--top">
      <figure class="dc-gallery__diptyque-left" data-reveal="image-rise">
        <Image
          src={gal04}
          alt="Projet domaines et caractère — jardin Majorelle, façade bleu cobalt et cactus sculpturaux"
          widths={[480, 720, 1100]}
          sizes="(min-width: 1024px) 38vw, 92vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="dc-gallery__img"
        />
      </figure>
      <figure class="dc-gallery__diptyque-right" data-reveal="image-rise">
        <Image
          src={gal05}
          alt="Projet domaines et caractère — vue mer méditerranéenne sous pin parasol depuis une maison à toit ocre"
          widths={[640, 960, 1300]}
          sizes="(min-width: 1024px) 54vw, 96vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="dc-gallery__img"
        />
      </figure>
    </div>

    <figure class="dc-gallery__large" data-reveal="image-rise">
      <Image
        src={gal06}
        alt="Projet domaines et caractère — maison vernaculaire en pierre dans une prairie d'oliviers et herbes folles"
        widths={[960, 1440, 1800]}
        sizes="(min-width: 1024px) 92vw, 96vw"
        quality={92}
        format="webp"
        loading="lazy"
        class="dc-gallery__img"
      />
    </figure>

    <div class="dc-gallery__diptyque dc-gallery__diptyque--bot">
      <figure class="dc-gallery__diptyque-left" data-reveal="image-rise">
        <Image
          src={gal07}
          alt="Projet domaines et caractère — pavillon néoclassique à fronton triangulaire encadré de cyprès"
          widths={[640, 960, 1300]}
          sizes="(min-width: 1024px) 54vw, 96vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="dc-gallery__img"
        />
      </figure>
      <figure class="dc-gallery__diptyque-right" data-reveal="image-rise">
        <Image
          src={gal08}
          alt="Projet domaines et caractère — allée pavée romaine bordée de pins parasols et de cyprès"
          widths={[480, 720, 1100]}
          sizes="(min-width: 1024px) 38vw, 92vw"
          quality={92}
          format="webp"
          loading="lazy"
          class="dc-gallery__img"
        />
      </figure>
    </div>

    {/* Manifeste « Comprendre » */}
    <div class="dc-manifeste dc-manifeste--comprendre">
      <h2 class="dc-manifeste__title">Comprendre</h2>
      <p class="dc-manifeste__para">{manifeste.precision}</p>
    </div>
  </section>

  {/* ═════════ 3 · FAQ beige + marquee ═══════════════════════════════════ */}
  <TypologieFaq items={faq} />

  <style is:global>
    /* /architecture-paysagere/domaine-caractere — DA finale beige/noir. */
    .dc-gallery {
      width: 100%;
      background-color: var(--color-ink);
      color: var(--color-cream);
      padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 3vw, 2.5rem);
    }
    .dc-gallery__large {
      margin: 0;
      width: 100%;
      aspect-ratio: 3 / 2;
      overflow: hidden;
      border-radius: clamp(12px, 1.5vw, 22px);
      background-color: color-mix(in oklab, var(--color-cream) 6%, var(--color-ink));
    }
    @media (min-width: 1024px) {
      .dc-gallery__large {
        aspect-ratio: 16 / 10;
      }
    }
    /* Variante --natural : 1re photo conservée dans son ratio d'origine
       (retour Jonathan 2026-05-22) — pas de crop. */
    .dc-gallery__large--natural {
      aspect-ratio: auto;
    }
    .dc-gallery__diptyque {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(1.25rem, 3vw, 2.5rem);
    }
    @media (min-width: 768px) {
      .dc-gallery__diptyque--top {
        grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
        align-items: stretch;
      }
      .dc-gallery__diptyque--bot {
        grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr);
        align-items: stretch;
      }
    }
    .dc-gallery__diptyque-left,
    .dc-gallery__diptyque-right {
      margin: 0;
      overflow: hidden;
      border-radius: clamp(12px, 1.5vw, 22px);
      background-color: color-mix(in oklab, var(--color-cream) 6%, var(--color-ink));
      aspect-ratio: 4 / 5;
    }
    @media (min-width: 768px) {
      .dc-gallery__diptyque--top .dc-gallery__diptyque-left {
        aspect-ratio: 3 / 4;
        align-self: start;
        max-height: 78%;
      }
      .dc-gallery__diptyque--top .dc-gallery__diptyque-right {
        aspect-ratio: 4 / 5;
        align-self: end;
      }
      .dc-gallery__diptyque--bot .dc-gallery__diptyque-left {
        aspect-ratio: 4 / 5;
        align-self: start;
      }
      .dc-gallery__diptyque--bot .dc-gallery__diptyque-right {
        aspect-ratio: 3 / 4;
        align-self: end;
        max-height: 78%;
      }
    }
    .dc-gallery__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }
    .dc-gallery__large--natural .dc-gallery__img {
      height: auto;
    }

    .dc-manifeste {
      width: 100%;
      padding: clamp(2.5rem, 6vw, 5rem) 0;
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }
    @media (min-width: 1024px) {
      .dc-manifeste {
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr);
        column-gap: clamp(3rem, 6vw, 5rem);
        align-items: start;
      }
    }
    .dc-manifeste__title {
      font-family: var(--font-heading), sans-serif;
      font-weight: 900;
      font-size: clamp(2rem, 4.5vw, 4rem);
      line-height: 1;
      letter-spacing: -0.01em;
      color: var(--color-cream);
      margin: 0;
      text-transform: none;
    }
    .dc-manifeste__body {
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 2.2vw, 1.85rem);
    }
    .dc-manifeste__para {
      font-family: var(--font-body), sans-serif;
      font-weight: 200;
      font-size: clamp(1.1rem, 1.5vw, 1.5rem);
      line-height: 1.5;
      letter-spacing: -0.005em;
      color: var(--color-cream);
      margin: 0;
    }
    .dc-manifeste__body .word {
      display: inline-block;
      opacity: 0;
      transform: translateY(10px);
      will-change: opacity, transform;
    }
    .dc-gallery,
    .dc-manifeste {
      box-sizing: border-box;
    }
  </style>
</BaseLayout>
