---
/*
 * Démarrer un projet — page de qualification (refonte 2026-04-28).
 * Migration de la section méthode 3 étapes depuis la home (#methode) vers
 * une route dédiée. Le CTA fin de home et la pill Header pointent ici.
 *
 * Contenu : strictement identique à l'ancienne section, plus une intro hero
 * courte et un CTA final vers /contact (formulaire).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaLink from '@/components/astro/CtaLink.astro';
import { SITE } from '@/lib/site-config';
import { jsonLdGraph, breadcrumbs, localBusiness, organization, person } from '@/lib/schema-org';

const methode = [
  {
    num: '01',
    titre: 'Appel de découverte',
    duree: '15 à 25 minutes',
    description:
      'Premier échange téléphonique. On qualifie votre projet, le site, vos attentes. Vous repartez avec une lecture claire de la suite.',
  },
  {
    num: '02',
    titre: "Rendez-vous d'étude",
    duree: '1 h 45 à 2 h',
    description:
      'Sur place ou en visioconférence. Diagnostic approfondi du lieu et du programme. Orientations conceptuelles posées ensemble.',
  },
  {
    num: '03',
    titre: 'Validation à distance',
    duree: '15 minutes',
    description:
      "Cadrage final : périmètre d'étude, livrables, calendrier. Signature et lancement.",
  },
];

const schema = jsonLdGraph([
  organization(),
  person(),
  localBusiness(),
  breadcrumbs([
    { name: 'Accueil', item: '/' },
    { name: 'Démarrer un projet', item: '/demarrer-un-projet' },
  ]),
  {
    '@type': 'WebPage',
    name: 'Démarrer un projet — Studio J Oliveira',
    url: `${SITE.url}/demarrer-un-projet`,
    description:
      'Trois temps de qualification pour engager une étude de design biophilique avec le Studio J Oliveira.',
  },
]);
---

<BaseLayout
  title="Démarrer un projet"
  description="Trois temps de qualification pour engager une étude avec le Studio J Oliveira — appel de découverte, rendez-vous d'étude, validation."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />

  <section
    id="methode"
    data-section-label="Méthode"
    data-theme="dark"
    class="bg-[var(--color-ink)] text-[var(--color-cream)]"
    aria-labelledby="methode-title"
  >
    <div class="mx-auto max-w-7xl px-6 py-32 md:px-10 md:py-44">
      <!-- Header en 2 colonnes : eyebrow/titre gauche · tagline droite -->
      <div class="mb-16 grid gap-10 md:mb-24 md:grid-cols-12 md:gap-16" data-reveal="up">
        <div class="md:col-span-7">
          <p class="font-mono text-xs tracking-[0.26em] text-[var(--color-cream)]/70 uppercase">
            Avant de commencer
          </p>
          <h1
            id="methode-title"
            data-mask-reveal
            data-mask-stagger="0.14"
            class="mt-5 font-[family-name:var(--font-heading)] text-[length:var(--text-5xl)] leading-[1.02] text-[var(--color-cream)] md:text-[length:var(--text-hero)]"
          >
            <span data-mask-line class="block pb-[0.05em]">Trois temps</span>
            <span data-mask-line class="block pb-[0.12em]">de qualification.</span>
          </h1>
        </div>
        <div class="md:col-span-5 md:self-end">
          <p class="methode-tagline" data-reveal="up" data-reveal-delay="0.15">
            Écouter avant de proposer · qualifier avant de chiffrer
          </p>
          <p
            class="mt-6 max-w-md text-[length:var(--text-base)] leading-relaxed text-[var(--color-cream)]/65"
            data-reveal="up"
            data-reveal-delay="0.25"
          >
            Avant toute étude, le studio vous engage dans un parcours en trois étapes — découvrir le
            projet, lire le lieu, cadrer les attentes.
          </p>
        </div>
      </div>

      <!-- Bandeau résumé visuel — durées + total signature -->
      <div class="methode-summary" data-reveal="up" data-reveal-delay="0.2" aria-hidden="true">
        <span class="methode-summary-step">
          <span class="methode-summary-num">01</span>
          <span class="methode-summary-time">15–25 min</span>
        </span>
        <span class="methode-summary-arrow">→</span>
        <span class="methode-summary-step">
          <span class="methode-summary-num">02</span>
          <span class="methode-summary-time">1 h 45–2 h</span>
        </span>
        <span class="methode-summary-arrow">→</span>
        <span class="methode-summary-step">
          <span class="methode-summary-num">03</span>
          <span class="methode-summary-time">15 min</span>
        </span>
        <span class="methode-summary-total"><em>≈ 2 h 30</em> au total</span>
      </div>

      <ol
        data-reveal-stagger="0.14"
        data-reveal="up"
        class="grid grid-cols-1 gap-px bg-[var(--color-cream)]/10 md:grid-cols-3"
      >
        {
          methode.map((step) => (
            <li class="methode-card flex flex-col bg-[var(--color-ink)] p-10 md:p-14">
              <p class="display methode-num text-[var(--color-cream)]/22 italic">{step.num}</p>
              <p class="mt-10 font-mono text-[10px] tracking-[0.26em] text-[var(--color-cream)]/70 uppercase">
                {step.duree}
              </p>
              <h3 class="mt-3 font-[family-name:var(--font-heading)] text-[length:var(--text-2xl)] leading-tight text-[var(--color-cream)]">
                {step.titre}
              </h3>
              <p class="mt-5 text-sm leading-relaxed text-[var(--color-cream)]/70">
                {step.description}
              </p>
              <span class="methode-card-line" aria-hidden="true" />
            </li>
          ))
        }
      </ol>

      <!-- CTA final → formulaire contact -->
      <div class="mt-20 flex flex-col items-start gap-6 md:mt-28">
        <p
          class="max-w-2xl text-[length:var(--text-lg)] leading-relaxed text-[var(--color-cream)]/80"
        >
          Le parcours commence par un appel court. Choisissez un créneau et nous engagerons la
          conversation.
        </p>
        <CtaLink
          href="/contact"
          label="Réserver un appel découverte"
          tone="dark"
          size="lg"
          magnetic={0.32}
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* CSS migré de la home (index.astro) — section méthode autonome maintenant. */

  .methode-summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    margin: 4rem auto 5rem;
    padding: 2.5rem clamp(1rem, 3vw, 3rem);
    border-top: 1px solid color-mix(in oklab, var(--color-cream) 12%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--color-cream) 12%, transparent);
    max-width: 1100px;
    color: var(--color-cream);
  }
  .methode-summary-step {
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .methode-summary-num {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.28em;
    color: color-mix(in oklab, var(--color-cream) 55%, transparent);
  }
  .methode-summary-time {
    font-family: var(--font-heading), sans-serif;
    font-size: clamp(1.1rem, 1.6vw, 1.6rem);
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .methode-summary-arrow {
    font-family: var(--font-mono), ui-monospace, monospace;
    color: var(--color-laterite);
    font-size: 1.25rem;
  }
  .methode-summary-total {
    margin-left: auto;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-cream) 65%, transparent);
  }
  .methode-summary-total em {
    font-family: var(--font-display), serif;
    font-style: italic;
    font-size: 1.4rem;
    color: var(--color-cream);
    letter-spacing: 0;
    margin-right: 0.5rem;
  }
  @media (max-width: 767px) {
    .methode-summary {
      flex-direction: column;
      align-items: flex-start;
    }
    .methode-summary-arrow {
      display: none;
    }
    .methode-summary-total {
      margin: 1rem 0 0;
    }
  }

  .methode-card {
    min-height: clamp(360px, 42vh, 520px);
    position: relative;
  }
  .methode-num {
    font-size: clamp(4rem, 9vw, 9rem);
    line-height: 0.85;
  }
  .methode-card-line {
    margin-top: auto;
    display: block;
    width: 40px;
    height: 1px;
    background-color: color-mix(in oklab, var(--color-laterite) 80%, transparent);
    padding-top: 1.5rem;
  }

  .methode-tagline {
    font-family: var(--font-heading), sans-serif;
    font-weight: 500;
    font-size: clamp(1rem, 1.4vw, 1.35rem);
    line-height: 1.35;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-align: justify;
    text-align-last: justify;
    color: var(--color-cream);
    hyphens: none;
    max-width: 100%;
  }
</style>
