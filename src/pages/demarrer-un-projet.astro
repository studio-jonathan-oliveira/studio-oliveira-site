---
/*
 * /demarrer-un-projet — refonte trame Jonathan 2026-05-22.
 *
 * Page de conversion principale du site (cible du CTA « Démarrer un projet »
 * sitewide). Architecture orchestrée :
 *
 *   1. <DemarrerHero>      — photo full-bleed + bloc ink intro 2 paragraphes
 *   2. <DemarrerStep>      — "L'APPEL DE QUALIFICATION" + 3 accordéons
 *   3. <DemarrerStep>      — "L'APPEL DE VALIDATION" + 2 accordéons
 *   4. <DemarrerRedBlock>  — bandeau rouge invite + formulaire (bloc continu)
 *
 * Verbatim Jonathan préservé, coquilles évidentes corrigées (« adptée »,
 * « permette », « part de son d'expérience », « vous permettra au studio »,
 * « vos question », espace avant virgule « studio , pour »).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import DemarrerHero from '@/components/astro/DemarrerHero.astro';
import DemarrerSteps from '@/components/astro/DemarrerSteps.astro';
import DemarrerContactCta from '@/components/astro/DemarrerContactCta.astro';
import DemarrerRedBlock from '@/components/astro/DemarrerRedBlock.astro';
import { SITE } from '@/lib/site-config';
import { jsonLdGraph, breadcrumbs, localBusiness, organization, person } from '@/lib/schema-org';

const intro = {
  accroche:
    'Maintenant que vous avez découvert et exploré votre typologie de jardin et de propriété, continuez le chemin vers la rencontre avec le studio !',
  invite: "Prenons le temps d'échanger ensemble autour de votre projet, en 2 temps.",
};

const qualification = [
  {
    question: 'Comprendre le projet',
    answer:
      "Le studio réserve ce premier échange pour comprendre le projet dans son contexte environnemental et géographique.\n\nCela lui permet de définir précisément la typologie de votre propriété.\n\nMunissez-vous d'un plan de votre propriété (si vous en avez), sinon calculez les surfaces correspondant aux emprises de votre projet.",
  },
  {
    question: 'Structurer la commande',
    answer:
      "Une fois le contexte compris et défini, le studio écoute vos besoins, vos envies, vos souhaits.\n\nCe moment sert à structurer l'approche sensible et réaliste de votre projet, lister ses potentiels et contraintes, projeter grossièrement les lignes directrices de l'aménagement. Cet échange permettra au studio de vous faire part de son expérience.\n\nMunissez-vous de votre côté d'un dossier d'ambiances, souhaits, tendances et inspirations qui vous font rêver. Le jardin doit être à votre image et le studio doit le cerner pour s'en rapprocher.",
  },
  {
    question: "Qualifier l'étude adaptée",
    answer:
      "L'ensemble des informations récoltées permettra au studio de définir la typologie exacte de votre projet et de proposer l'étude adaptée.\n\nLe studio communique au client la marche à suivre suivant la typologie de l'étude, le programme et le temps à y consacrer. Tout est explicité en amont, en toute transparence.\n\nVous repartez avec des informations claires et précises pour lancer votre projet.",
  },
] as const;

const validation = [
  {
    question: 'Le point',
    answer:
      "Après un temps de réflexion, ce second échange permet de lever des points flous ou encore des doutes concernant l'étude.\n\nLe studio prend le temps de répondre à vos questions et d'ajuster les derniers points pour composer la meilleure solution à votre projet.",
  },
  {
    question: 'La validation',
    answer:
      "Cet échange permet enfin de valider les termes du contrat d'étude et enclencher les étapes suivantes de l'étude.\n\nLa validation de l'étude déclenche le premier déplacement du studio, pour l'approche sensible et technique sur site et démarrer la phase étude préliminaire.",
  },
] as const;

const invite =
  'Anticipez le premier échange avec le studio : parlez-nous de votre projet en amont et le studio prendra le temps de revenir vers vous.';

const schema = jsonLdGraph([
  organization(),
  person(),
  localBusiness(),
  breadcrumbs([
    { name: 'Accueil', item: '/' },
    { name: 'Démarrer un projet', item: '/demarrer-un-projet' },
  ]),
  {
    '@type': 'ContactPage',
    name: 'Démarrer un projet — Studio J Oliveira',
    url: `${SITE.url}/demarrer-un-projet`,
    description:
      'Engager une étude avec le Studio J Oliveira en deux temps — appel de qualification puis appel de validation.',
  },
]);
---

<BaseLayout
  title="Démarrer un projet"
  description="Engager une étude avec le Studio J Oliveira : appel de qualification, appel de validation, puis lancement de l'étude préliminaire."
  darkHero
>
  <script type="application/ld+json" set:html={schema} is:inline />

  <DemarrerHero intro={intro} />

  <DemarrerSteps
    steps={[
      {
        id: 'qualification',
        eyebrow: "L'appel de",
        title: 'Qualification',
        sectionLabel: 'Qualification',
        accordions: qualification,
      },
      {
        id: 'validation',
        eyebrow: "L'appel de",
        title: 'Validation',
        sectionLabel: 'Validation',
        accordions: validation,
      },
    ]}
  />

  <DemarrerContactCta />

  <DemarrerRedBlock invite={invite} />

  {
    /* Exception DA : sur /demarrer le footer est NOIR (décision Morgan —
     beige partout sauf cette page). Override page-level du footer global. */
  }
  <style is:global>
    body.is-demarrer .site-footer {
      background-color: var(--color-ink);
      color: var(--color-cream);
    }
    body.is-demarrer .site-footer__heading,
    body.is-demarrer .site-footer__navlink,
    body.is-demarrer .site-footer__typo-title,
    body.is-demarrer .site-footer__typo-link--active {
      color: var(--color-cream);
    }
    body.is-demarrer .site-footer__address,
    body.is-demarrer .site-footer__national,
    body.is-demarrer .site-footer__typo-link {
      color: color-mix(in oklab, var(--color-cream) 82%, transparent);
    }
    body.is-demarrer .site-footer__legal {
      color: color-mix(in oklab, var(--color-cream) 55%, transparent);
    }
    /* Logo : tuile violette + wordmark noir (accent DA /demarrer). */
    body.is-demarrer .site-footer__logo {
      background-color: var(--color-violet);
    }
    body.is-demarrer .site-footer__logo-mark {
      background-color: var(--color-ink);
    }
  </style>
</BaseLayout>
