---
/*
 * /lcd-atypiques — Locations Courte Durée atypiques (Jungle Rooms, airbnb signature).
 * URL conservée par fidélité cahier Jonathan (PDF l.728), mais label affiché
 * = « Locations signature » (feedback Morgan 2026-04-23 : LCD pas clair).
 *
 * Refonte 2026-04-23 : hero immersif forest + galerie projets réels +
 * section démarche forest texturée (feedback Morgan : « page fade, vide »).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/astro/Section.astro';
import CtaLink from '@/components/astro/CtaLink.astro';
import { Image } from 'astro:assets';
import { jsonLdGraph, organization, localBusiness, breadcrumbs, service } from '@/lib/schema-org';

// Assets : Jungle Room + Airbnb (signature LCD atypiques)
import heroJungle from '@/assets/projets/jungle-room/01-salon.webp';
import imgJungle02 from '@/assets/projets/jungle-room/02.webp';
import imgJungle03 from '@/assets/projets/jungle-room/03.webp';
import imgAirbnb01 from '@/assets/projets/airbnb/01-cover.webp';
import imgAirbnb02 from '@/assets/projets/airbnb/02.webp';
import imgAirbnb03 from '@/assets/projets/airbnb/03.webp';
import imgAirbnb04 from '@/assets/projets/airbnb/04.webp';
import imgAirbnb05 from '@/assets/projets/airbnb/05.webp';

// 3 étapes de la démarche LCD (structure factuelle, contenu détaillé [À FOURNIR])
const etapes = [
  {
    num: '01',
    titre: 'Lecture du lieu',
    description:
      'Analyse du bâti existant, des contraintes techniques (lumière, hygrométrie, circulation), du public cible et du positionnement de la location sur sa plateforme.',
  },
  {
    num: '02',
    titre: 'Composition immersive',
    description:
      'Scénographie végétale complète — plantes naturelles ou artificielles premium selon contraintes, mobilier, textures, luminaires. Le lieu devient un univers narratif.',
  },
  {
    num: '03',
    titre: 'Mise en œuvre',
    description:
      "Sélection et pilotage des artisans, installation du décor, mise en scène finale. Suivi de l'impact sur les réservations les premiers mois si souhaité.",
  },
];

const galerie = [
  { src: imgJungle02, alt: 'Jungle Room — décor immersif', legende: 'Jungle Room, Agde' },
  { src: imgAirbnb01, alt: 'Airbnb signature — entrée végétalisée', legende: 'Airbnb signature' },
  { src: imgAirbnb02, alt: 'Airbnb signature — espace de vie' },
  { src: imgJungle03, alt: 'Jungle Room — détail végétal' },
  { src: imgAirbnb03, alt: 'Airbnb signature — chambre' },
  { src: imgAirbnb04, alt: 'Airbnb signature — détail décor' },
  { src: imgAirbnb05, alt: 'Airbnb signature — ambiance' },
];

const schema = jsonLdGraph([
  organization(),
  localBusiness(),
  service({
    name: 'Décoration végétale pour locations atypiques',
    slug: 'lcd-atypiques',
    path: '/lcd-atypiques',
    description:
      'Décors végétalisés immersifs pour locations courte durée à forte identité — Jungle Rooms, airbnb signature, logements narratifs. Plantes naturelles et artificielles, conception et installation.',
  }),
  breadcrumbs([
    { name: 'Accueil', item: '/' },
    { name: 'Locations signature', item: '/lcd-atypiques' },
  ]),
]);
---

<BaseLayout
  title="Décoration végétale pour airbnb atypique — Locations signature"
  description="Studio J Oliveira — décors végétalisés immersifs pour locations courte durée atypiques. Jungle Rooms, airbnb signature. Plantes naturelles et artificielles, design biophilique."
  darkHero
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={schema} is:inline />
  </Fragment>

  {/* ───── HERO immersif forest avec Jungle Room ───── */}
  <section
    id="hero"
    data-section-label="Locations signature"
    data-theme="dark"
    class="lcd-hero relative isolate overflow-hidden bg-[var(--color-forest)] text-[var(--color-cream)]"
  >
    <div class="absolute inset-0 -z-10">
      <Image
        src={heroJungle}
        alt=""
        widths={[960, 1440, 1920, 2560]}
        sizes="100vw"
        quality={80}
        format="webp"
        class="lcd-hero-img h-full w-full object-cover object-center"
        loading="eager"
        data-hero-zoom
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-[var(--color-forest)]/95 via-[var(--color-forest)]/45 to-transparent"
        aria-hidden="true"
      >
      </div>
    </div>

    <div class="relative flex min-h-[100svh] flex-col justify-end">
      <div class="mx-auto w-full max-w-[1400px] px-6 pt-40 pb-24 md:px-10 md:pt-48 md:pb-32">
        <p class="font-mono text-[11px] tracking-[0.26em] text-[var(--color-cream)]/55 uppercase">
          <span class="text-[var(--color-cream)]/50">Locations courte durée</span>
          &nbsp;·&nbsp; Signature atypique
        </p>
        <h1
          data-mask-reveal
          data-mask-stagger="0.14"
          class="mt-8 font-[family-name:var(--font-heading)] leading-[1.02] tracking-tight"
        >
          <span data-mask-line class="block pb-[0.05em] text-[length:var(--text-4xl)] italic">
            Locations
          </span>
          <span
            data-mask-line
            class="block pb-[0.18em] text-[length:var(--text-5xl)] md:text-[length:var(--text-hero)]"
            style="font-weight: 500; letter-spacing: -0.012em; line-height: 0.96;"
          >
            SIGNATURE.
          </span>
        </h1>
        <p
          data-reveal="up"
          data-reveal-delay="0.4"
          class="mt-10 max-w-xl text-[length:var(--text-lg)] leading-relaxed text-[var(--color-cream)]/85"
        >
          Un airbnb à forte identité n'est pas une location — c'est un univers. Le studio conçoit
          des décors végétalisés immersifs qui transforment un hébergement en expérience mémorable,
          génératrice de réservations et de recommandations.
        </p>
      </div>
    </div>
  </section>

  {/* ───── MANIFESTE court ───── */}
  <Section variant="cream" space="compact" id="positionnement" sectionLabel="Positionnement">
    <div class="mx-auto max-w-3xl py-20 md:py-28" data-reveal="up">
      <p class="font-mono text-[11px] tracking-[0.26em] text-[var(--color-forest)]/55 uppercase">
        <span class="text-[var(--color-forest)]/40">02</span> &nbsp;·&nbsp; Le positionnement
      </p>
      <p
        class="mt-8 font-[family-name:var(--font-heading)] text-[length:var(--text-3xl)] leading-[1.18] text-[var(--color-forest)] md:text-[length:var(--text-4xl)]"
      >
        À la croisée du <a
          href="/pros"
          class="border-b border-[var(--color-forest)]/40 hover:border-[var(--color-forest)] hover:text-[var(--color-forest)]/55"
          ><em class="italic">design pour professionnels</em></a
        >
        et des <a
          href="/realisations"
          class="border-b border-[var(--color-forest)]/40 hover:border-[var(--color-forest)] hover:text-[var(--color-forest)]/55"
          ><em class="italic">projets réalisés</em></a
        >
        à forte signature narrative — la location atypique demande une
        <em class="text-[var(--color-forest)]/55 italic">écriture végétale dédiée</em>,
        spectaculaire mais habitable.
      </p>
    </div>
  </Section>

  {/* ───── BANDE KEYWORDS (mots du manifeste) ───── */}
  <section class="bg-[var(--color-cream)] px-6 pb-20 md:px-10 md:pb-28" aria-hidden="true">
    <p
      class="page-keywords-band page-keywords-band--light"
      data-reveal="up"
      data-justify-scroll
      data-justify-amp="20"
      data-justify-seed="11"
    >
      Univers <span aria-hidden="true">·</span>
      Immersif <span aria-hidden="true">·</span>
      Narratif <span aria-hidden="true">·</span>
      Spectaculaire <span aria-hidden="true">·</span>
      Habitable
    </p>
  </section>

  {/* ───── GALERIE projets réels (Jungle Room + Airbnb) ───── */}
  <Section variant="cream" id="galerie" sectionLabel="Galerie" labelledBy="galerie-title">
    <div class="mb-12 max-w-3xl" data-reveal="up">
      <p class="font-mono text-[11px] tracking-[0.26em] text-[var(--color-forest)]/55 uppercase">
        <span class="text-[var(--color-forest)]/40">03</span> &nbsp;·&nbsp; Galerie
      </p>
      <h2
        id="galerie-title"
        class="mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-4xl)] leading-[1.02] md:text-[length:var(--text-5xl)]"
      >
        <em class="text-[var(--color-forest)]/55 italic">Jungle Rooms</em><br />
        & airbnb signature.
      </h2>
    </div>

    <div class="lcd-gallery grid grid-cols-1 gap-4 md:grid-cols-12 md:gap-6" data-lcd-gallery>
      {
        galerie.map((item, i) => (
          <figure
            class:list={[
              'lcd-gallery-item overflow-hidden',
              i === 0 && 'md:col-span-7 md:row-span-2',
              i === 1 && 'md:col-span-5',
              i === 2 && 'md:col-span-5',
              i === 3 && 'md:col-span-4',
              i === 4 && 'md:col-span-4',
              i === 5 && 'md:col-span-4',
              i === 6 && 'md:col-span-12',
            ]}
          >
            <Image
              src={item.src}
              alt={item.alt}
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 768px) 50vw, 92vw"
              quality={80}
              format="webp"
              class="lcd-gallery-img h-full w-full object-cover"
              loading={i < 2 ? 'eager' : 'lazy'}
            />
            {item.legende && (
              <figcaption class="mt-3 font-mono text-[10px] tracking-[0.26em] text-[var(--color-forest)]/55 uppercase">
                {item.legende}
              </figcaption>
            )}
          </figure>
        ))
      }
    </div>
  </Section>

  {/* ───── RESPIRATION full-bleed entre Galerie et Démarche ───── */}
  <section
    class="page-respiration relative overflow-hidden bg-[var(--color-cream)]"
    aria-hidden="true"
    data-theme="light"
  >
    <div class="page-respiration-frame">
      <Image
        src={imgJungle03}
        alt=""
        widths={[960, 1440, 1920, 2560]}
        sizes="100vw"
        quality={85}
        format="webp"
        class="h-full w-full object-cover object-center"
        loading="lazy"
      />
    </div>
  </section>

  {/* ───── 04 · DÉMARCHE forest immersif ───── */}
  <section
    id="demarche"
    data-section-label="Démarche"
    class="lcd-demarche relative isolate overflow-hidden bg-[var(--color-cream)] text-[var(--color-ink)]"
    data-theme="light"
    aria-labelledby="demarche-title"
  >
    <div class="absolute inset-0 -z-10">
      <Image
        src={imgJungle02}
        alt=""
        widths={[960, 1440, 1920]}
        sizes="100vw"
        quality={60}
        format="webp"
        class="h-full w-full object-cover object-center"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-[var(--color-cream)]/82" aria-hidden="true"></div>
      <div class="lcd-demarche-halo" aria-hidden="true"></div>
    </div>

    <div class="mx-auto max-w-7xl px-6 py-24 md:px-10 md:py-32">
      <div class="mb-16 max-w-3xl" data-reveal="up">
        <p class="font-mono text-[11px] tracking-[0.26em] text-[var(--color-ink)]/55 uppercase">
          <span class="text-[var(--color-ink)]/40">04</span> &nbsp;·&nbsp; Démarche
        </p>
        <h2
          id="demarche-title"
          class="mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-4xl)] leading-[1.02] md:text-[length:var(--text-5xl)]"
        >
          Un univers,<br />
          pas une <em class="text-[var(--color-ink)]/55 italic">décoration</em>.
        </h2>
      </div>

      <ol
        class="grid grid-cols-1 gap-px bg-[var(--color-ink)]/10 md:grid-cols-3"
        data-reveal-stagger="0.12"
        data-reveal="up"
      >
        {
          etapes.map((etape) => (
            <li class="bg-[var(--color-cream)]/85 p-8 backdrop-blur-sm md:p-10">
              <p class="font-mono text-[10px] tracking-[0.26em] text-[var(--color-ink)]/55 uppercase">
                Étape {etape.num}
              </p>
              <h3 class="mt-5 font-[family-name:var(--font-heading)] text-[length:var(--text-2xl)] leading-tight">
                <em class="italic">{etape.titre}</em>
              </h3>
              <p class="mt-4 text-sm leading-relaxed text-[var(--color-ink)]/80">
                {etape.description}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ───── CTA final forest ───── */}
  <Section variant="forest" topDivider id="contact-cta" sectionLabel="Contact">
    <div class="mx-auto max-w-4xl text-center" data-reveal="slow">
      <p class="font-mono text-xs tracking-[0.26em] text-[var(--color-ink)]/55 uppercase">
        <span class="text-[var(--color-ink)]/40">05</span> &nbsp;·&nbsp; Engager la conversation
      </p>
      <h2
        class="mt-8 font-[family-name:var(--font-heading)] text-[length:var(--text-5xl)] leading-[1.02]"
      >
        Un projet de <em class="text-[var(--color-ink)]/55 italic">location signature</em> ?
      </h2>
      <p
        class="mx-auto mt-10 max-w-xl text-[length:var(--text-base)] leading-relaxed text-[var(--color-ink)]/70"
      >
        Décrivez votre lieu, son positionnement, vos envies — je propose une écriture végétale qui
        transforme votre location en expérience.
      </p>
      <div class="mt-12 flex flex-col items-center justify-center gap-6 md:flex-row md:gap-10">
        <CtaLink href="/contact" label="Démarrer un projet" tone="dark" size="lg" magnetic={0} />
      </div>
    </div>
  </Section>

  <style>
    .lcd-hero-img {
      transform: scale(1.06);
      transform-origin: center;
      will-change: transform, filter;
    }

    /* Halo cream dans la section démarche (palette monochrome) */
    .lcd-demarche-halo {
      position: absolute;
      top: -20%;
      right: -15%;
      width: 70%;
      height: 70%;
      background: radial-gradient(
        circle at center,
        color-mix(in oklab, var(--color-ink) 18%, transparent) 0%,
        transparent 65%
      );
      pointer-events: none;
      opacity: 0.8;
    }

    /* Galerie bento — chaque tuile garde un aspect ratio agréable */
    .lcd-gallery-item {
      background-color: var(--color-forest);
    }
    .lcd-gallery-item:first-child {
      aspect-ratio: 1 / 1;
    }
    @media (min-width: 768px) {
      .lcd-gallery-item {
        aspect-ratio: 4 / 3;
      }
      .lcd-gallery-item:first-child {
        aspect-ratio: auto;
      }
      .lcd-gallery-item:last-child {
        aspect-ratio: 21 / 9;
      }
    }
    .lcd-gallery-img {
      transform: scale(1.04);
      transition: transform 1.2s var(--ease-out-editorial);
    }
    .lcd-gallery-item:hover .lcd-gallery-img,
    .lcd-gallery-item:focus-within .lcd-gallery-img {
      transform: scale(1.1);
    }

    /* Reveal CSS pure (alternative à data-reveal-stagger qui bug sur grids
       avec aspect-ratio — cf. .claude/guides/page-conventions.md §13.4). */
    [data-lcd-gallery] .lcd-gallery-item {
      opacity: 0;
      transform: translateY(40px) scale(1);
      transition:
        opacity 1s var(--ease-out-editorial),
        transform 1s var(--ease-out-editorial);
    }
    [data-lcd-gallery].is-revealed .lcd-gallery-item {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    [data-lcd-gallery].is-revealed .lcd-gallery-item:nth-child(1) {
      transition-delay: 0s;
    }
    [data-lcd-gallery].is-revealed .lcd-gallery-item:nth-child(2) {
      transition-delay: 0.08s;
    }
    [data-lcd-gallery].is-revealed .lcd-gallery-item:nth-child(3) {
      transition-delay: 0.16s;
    }
    [data-lcd-gallery].is-revealed .lcd-gallery-item:nth-child(4) {
      transition-delay: 0.24s;
    }
    [data-lcd-gallery].is-revealed .lcd-gallery-item:nth-child(5) {
      transition-delay: 0.32s;
    }
    [data-lcd-gallery].is-revealed .lcd-gallery-item:nth-child(6) {
      transition-delay: 0.4s;
    }
    [data-lcd-gallery].is-revealed .lcd-gallery-item:nth-child(7) {
      transition-delay: 0.48s;
    }
  </style>

  <script>
    function initLcdGalleryObserver() {
      const grid = document.querySelector<HTMLElement>('[data-lcd-gallery]');
      if (!grid || grid.dataset.observerWired === 'true') return;
      grid.dataset.observerWired = 'true';
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              grid.classList.add('is-revealed');
              observer.disconnect();
              break;
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
      );
      observer.observe(grid);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLcdGalleryObserver, { once: true });
    } else {
      initLcdGalleryObserver();
    }
    document.addEventListener('astro:page-load', initLcdGalleryObserver);
  </script>
</BaseLayout>
