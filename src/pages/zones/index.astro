---
/*
 * /zones — index des zones d'intervention.
 *
 * Page hub qui liste les 3 zones (Brive, Bordeaux, Limoges) et alimente
 * le breadcrumb des pages /zones/[slug]. Capte les requêtes génériques
 * "zones d'intervention paysagiste Nouvelle-Aquitaine".
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/astro/Section.astro';
import CtaLink from '@/components/astro/CtaLink.astro';
import { ZONES } from '@/data/zones-content';
import { fetch } from '@/lib/sanity';
import { locationsAllQuery } from '@/lib/queries';
import { jsonLdGraph, organization, localBusiness, breadcrumbs } from '@/lib/schema-org';

// Cartes zones depuis Sanity si peuplé, sinon fallback statique (lossless).
interface ZoneCard {
  slug: string;
  ville: string;
  role: string;
  departement: string;
  codeDepartement: string;
  introLead: string;
}
const sanityZones = await fetch<ZoneCard[]>(locationsAllQuery, {}, []);
const zones: ZoneCard[] = sanityZones.length > 0 ? sanityZones : ZONES;

const schema = jsonLdGraph([
  organization(),
  localBusiness(),
  breadcrumbs([
    { name: 'Accueil', item: '/' },
    { name: 'Zones d’intervention', item: '/zones' },
  ]),
  {
    '@type': 'ItemList',
    itemListElement: zones.map((z, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `Paysagiste designer à ${z.ville}`,
      url: `https://www.jonathanoliveira.fr/zones/${z.slug}`,
    })),
  },
]);
---

<BaseLayout
  title="Zones d’intervention — Paysagiste designer en Nouvelle-Aquitaine"
  description="Studio J Oliveira intervient à Brive-la-Gaillarde (siège), Bordeaux et Limoges. Conception de jardin, aménagement paysager et design biophilique en Corrèze, Gironde et Haute-Vienne."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={schema} />
  </Fragment>

  <Section variant="cream" space="hero" id="hero" class="pt-40 md:pt-48">
    <div class="max-w-3xl">
      <p class="font-mono text-xs tracking-[0.22em] text-[var(--color-cream)]/55 uppercase">
        Couverture territoriale · Nouvelle-Aquitaine
      </p>
      <h1
        class="mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-4xl)] leading-[1.04] tracking-tight md:text-[length:var(--text-5xl)]"
        style="font-weight: 500; letter-spacing: -0.012em;"
      >
        Zones d’intervention du studio
      </h1>
      <p
        class="mt-8 max-w-2xl text-[length:var(--text-lg)] leading-relaxed text-[var(--color-cream)]/85"
      >
        Trois points d’ancrage — Brive-la-Gaillarde (siège), Bordeaux et Limoges — et une zone
        d’intervention élargie sur la Corrèze, le Lot, la Dordogne, la Gironde et la Haute-Vienne.
        Conception de jardin sur mesure, aménagement paysager et design biophilique pour
        particuliers et professionnels.
      </p>
    </div>
  </Section>

  <Section variant="cream" space="default" id="zones">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-3">
      {
        zones.map((z) => (
          <a
            href={`/zones/${z.slug}`}
            class="group block border-t border-[var(--color-cream)]/15 pt-6 transition-colors hover:border-[var(--color-laterite)]"
          >
            <p class="font-mono text-xs tracking-[0.18em] text-[var(--color-cream)]/55 uppercase">
              {z.role === 'siege'
                ? 'Siège'
                : z.role === 'bureau-etudes'
                  ? 'Bureau d’études'
                  : 'Zone d’intervention'}{' '}
              · {z.departement} ({z.codeDepartement})
            </p>
            <h2
              class="mt-4 font-[family-name:var(--font-heading)] text-[length:var(--text-2xl)] leading-tight tracking-tight"
              style="font-weight: 500;"
            >
              {z.ville}
            </h2>
            <p class="mt-4 text-[length:var(--text-base)] leading-relaxed text-[var(--color-cream)]/80">
              {z.introLead}
            </p>
            <p class="mt-6 font-mono text-xs tracking-[0.18em] text-[var(--color-laterite)] uppercase transition-colors group-hover:text-[var(--color-cream)]">
              Voir la zone
            </p>
          </a>
        ))
      }
    </div>
  </Section>

  <Section variant="laterite" space="spacious" id="cta">
    <div class="max-w-2xl">
      <p class="font-mono text-xs tracking-[0.22em] text-[var(--color-cream)]/65 uppercase">
        Hors zone listée ?
      </p>
      <h2
        class="mt-6 font-[family-name:var(--font-heading)] text-[length:var(--text-3xl)] leading-tight tracking-tight md:text-[length:var(--text-4xl)]"
        style="font-weight: 500;"
      >
        Le studio étudie chaque demande au cas par cas.
      </h2>
      <p class="mt-6 text-[length:var(--text-lg)] leading-relaxed text-[var(--color-cream)]/85">
        Un projet en dehors de Brive, Bordeaux ou Limoges peut être pris en charge selon la
        typologie et le budget — frais de déplacement intégrés au devis d’étude.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3">
        <CtaLink href="/demarrer-un-projet" label="Démarrer un projet" tone="dark" size="lg" />
        <CtaLink href="/contact" label="Contact direct" tone="dark" size="md" />
      </div>
    </div>
  </Section>
</BaseLayout>
