# URL publique du site (utilisée pour sitemap, canonical, OG)
PUBLIC_SITE_URL=https://www.jonathanoliveira.fr

# Sanity CMS — projet à créer via `npm create sanity@latest`
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Token read-only pour build SSG (Sanity → site.next.js.dev/settings/api)
SANITY_API_TOKEN=
# Secret du webhook Sanity → Vercel rebuild
SANITY_WEBHOOK_SECRET=

# Resend — emails transactionnels (formulaire contact)
RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@jonathanoliveira.fr
RESEND_TO_EMAIL=jonathan@jonathanoliveira.fr

# Cloudflare Turnstile — anti-spam formulaire
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Plausible Analytics (RGPD-friendly, pas de bannière cookie)
PUBLIC_PLAUSIBLE_DOMAIN=jonathanoliveira.fr

# Vercel Blob — stockage assets lourds (séquences Twinmotion)
VERCEL_BLOB_READ_WRITE_TOKEN=
