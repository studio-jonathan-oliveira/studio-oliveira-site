# URL publique du site (utilisée pour sitemap, canonical, OG)
PUBLIC_SITE_URL=https://www.studiojonathanoliveira.fr

# ───────────────────────── Sanity CMS ─────────────────────────
# Projet à créer une fois (cf. _brief/deploiement-sanity.md). Le SITE (Astro)
# et le STUDIO (package sanity/) partagent projectId + dataset.
#
# 1) ID du projet Sanity (visible sur sanity.io/manage) — partagé site + studio.
PUBLIC_SANITY_PROJECT_ID=
# 2) Dataset (par défaut "production").
PUBLIC_SANITY_DATASET=production
# 3) Token de LECTURE (rôle "Viewer") généré sur sanity.io/manage → API → Tokens.
#    Sert au build SSG du site à lire le contenu publié. NE PAS exposer (server-only).
SANITY_API_TOKEN=
#
# (Optionnel) Le Studio (sanity/) lit d'abord SANITY_STUDIO_*, sinon retombe sur
# PUBLIC_SANITY_*. En général il suffit de renseigner les PUBLIC_* ci-dessus.
# SANITY_STUDIO_PROJECT_ID=
# SANITY_STUDIO_DATASET=production
#
# Rebuild auto à la publication : on utilise un « Deploy Hook » Vercel (URL générée
# dans Vercel → Settings → Git → Deploy Hooks) collée dans Sanity → API → Webhooks.
# Aucune variable d'env côté site requise pour ça.

# Resend — emails transactionnels (formulaire contact)
RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@studiojonathanoliveira.fr
RESEND_TO_EMAIL=jonathan@studiojonathanoliveira.fr

# Cloudflare Turnstile — anti-spam formulaire
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics : Vercel Analytics + Speed Insights — activés via le dashboard
# Vercel (Settings → Analytics). Gratuit jusqu'à ~10k events/mois. Aucune
# variable d'environnement requise.
# Si on bascule un jour vers Plausible : PUBLIC_PLAUSIBLE_DOMAIN=studiojonathanoliveira.fr

# Vercel Blob — stockage assets lourds (séquences Twinmotion)
VERCEL_BLOB_READ_WRITE_TOKEN=
